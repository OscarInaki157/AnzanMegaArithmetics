        display: flex;
        flex-direction: row;
        gap: 1rem; /* Espacio entre los dos campos */
        width: 100%;
    }

    .valor-input {
        width: 60%;
        display: flex;
        flex-direction: column;
    }


    .hidden-field {
        display: none !important;
    }

    .contenedorColores {
        display: flex;
        flex-direction: row;
        margin-top: 0.6rem;
    }

    .color {
        width: 50%;
    }

    body {
        background-color: var(--color-bg);
        color: var(--color-tex);
    }

    h2 {
        text-align: center;
        color: var(--color-light);
        font-weight: 600;
        font-size: clamp(1.4rem, 2vw, 1.7rem);
    }

    form#formConfigSR input[type="range"] {
        background-color: #292c4f;
    }

    .form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #444;
        width: 100%;
    }

        .form-header h2 {
            margin: 0;
            font-size: clamp(1.4rem, 2vw, 1.7rem);
            font-weight: 600;
            color: white;
        }


    .formulario-flash {
        max-width: 85%;
        margin: 0 auto;
        padding: 1.3rem;
        border-radius: 1rem;
        background-color: var(--bg-color);
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.4);
        animation: fadeIn 0.4s ease;
    }


    .checks {
        flex-direction: row;
        display: flex;
        gap: 2rem;
        padding: 0.5rem;
        align-items: center;
    }

    .top-bar-config {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        max-width: 85%;
        margin: -1rem auto 1rem auto;
        padding: 0 1rem;
    }

        .top-bar-config h2 {
            margin: 0;
            font-size: clamp(1.4rem, 2vw, 1.7rem);
            font-weight: 600;
            color: var(--color-light);
        }

    .form-grid {
        display: flex;
        flex-wrap: wrap;
    }

    .form-column {
        flex: 1 1 49%;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    form#formConfigSR label {
        display: block;
        margin-bottom: 0.4rem;
        font-weight: 600;
        font-size: 1rem;
    }

    form#formConfigSR select,
    form#formConfigSR input[type="number"] {
        width: 60%;
        padding: 0.5rem 0.6rem;
        border: none;
        border-radius: 0.5rem;
        background-color: #292c4f;
        color: white;
        font-size: 1rem;
    }

    form#formConfigSR input[type="radio"] {
        accent-color: var(--color-primary);
        transform: scale(1.1);
    }

    .btn.btn-primary {
        background: #28a745;
        color: white;
        padding: 0.9rem 1.5rem;
        font-size: 1.1rem;
        font-weight: bold;
        border: none;
        border-radius: 0.6rem;
        cursor: pointer;
        transition: all 0.3s ease;
        width: 100%;
        box-shadow: 0 4px 12px rgba(76, 175, 80, 0.4);
        text-shadow: 0 1px 1px rgba(0, 0, 0, 0.2);
        letter-spacing: 0.5px;
    }

        .btn.btn-primary:hover {
            background: #2ecc71;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(46, 204, 113, 0.5);
        }

    .btn-dashboard {
        background-color: var(--color-primary);
        color: white;
        padding: 0.7rem 1.5rem;
        border: none;
        border-radius: 0.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(76, 76, 255, 0.3);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
    }


        .btn-dashboard i {
            font-size: 1.1rem;
        }

    .dashboard-button-wrapper {
        display: flex;
        justify-content: center;
        margin-bottom: 2rem;
    }

    .btn-dashboard:hover {
        background-color: var(--color-primary-dark);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(76, 76, 255, 0.5);
    }

    .dropdown-toggle {
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 1.4rem;
        color: #ccc;
        user-select: none;
    }

    .dropdown-options {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background-color: #1b1e3c;
        border: 1px solid #555;
        border-radius: 0.5rem;
        margin-top: 6px;
        z-index: 10;
        display: none;
        max-height: 180px;
        overflow-y: auto;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.5);
    }

    .option {
        padding: 10px 15px;
        font-size: 0.95rem;
        color: var(--color-light);
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .option:hover {
            background-color: var(--color-primary-dark);
        }

        .option.special {
            font-weight: bold;
            background-color: #292c4f;
            color: var(--color-primary);
        }

            .option.special:hover {
                background-color: #3737e8;
                color: white;
            }

    .input-error {
        border: 2px solid var(--color-danger) !important;
    }

    .elslider {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 60%;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }



    @@media (max-width: 768px) {

        .contenedorValores {
            flex-direction: column;
            gap: 1rem;
        }

        .valor-input {
            width: 100%;
        }

        .form-header {
            flex-direction: column;
        }

        .form-grid {
            flex-direction: column;
        }

        .btn-dashboard {
            width: 100%;
            margin-bottom: 1rem;
        }

        .btn.btn-primary {
            font-size: 1rem;
        }

        .top-bar-config {
            flex-direction: column-reverse;
            align-items: center;
            text-align: center;
        }

            .top-bar-config h2 {
                width: 100%;
            }

            .top-bar-config .btn-dashboard {
                width: auto;
                margin: 0 auto;
            }

        form#formConfigSR select,
        form#formConfigSR input[type="number"] {
            width: 100%;
        }

        .elslider {
            width: 100%;
        }

        .tag-input {
            width: 100%;
        }
    }
</style>

<script>
    function regresarAlDashboard() {
        window.location.href = '@Url.Action("Memorizacion", "Dashboard")';
    }

    document.addEventListener("DOMContentLoaded", () => {

       

        // ==========================================
        // 2. LÓGICA DE CANTIDAD, INICIO Y FINAL
        // ==========================================
        const inputCantidad = document.getElementById("cantidadEjercicios");
        const inputInicial = document.getElementById("valorInicial");
        const inputFinal = document.getElementById("valorFinal");

        function calcularValorFinal() {
            let cantidad = parseInt(inputCantidad.value) || 1;
            let inicial = parseInt(inputInicial.value) || 1;

            if (inicial < 1) {
                inicial = 1;
                inputInicial.value = inicial;
            }

            let final = inicial + cantidad - 1;

            if (final > 20) {
                final = 20;
                cantidad = final - inicial + 1;

                if (cantidad < 1) {
                    inicial = 20;
                    inputInicial.value = inicial;
                    cantidad = 1;
                }
                inputCantidad.value = cantidad;
            }

            inputFinal.value = final;
        }

        function calcularCantidad() {
            let inicial = parseInt(inputInicial.value) || 1;
            let final = parseInt(inputFinal.value) || 1;

            if (inicial < 1) {
                inicial = 1;
                inputInicial.value = inicial;
            }

            if (final < inicial) final = inicial;
            if (final > 20) final = 20;

            inputFinal.value = final;

            let nuevaCantidad = final - inicial + 1;
            inputCantidad.value = nuevaCantidad;
        }

        inputCantidad.addEventListener("input", calcularValorFinal);
        inputInicial.addEventListener("input", calcularValorFinal);
        inputFinal.addEventListener("input", calcularCantidad);

        calcularValorFinal();

        // ==========================================
        // 3. LÓGICA DE TIPOS DE PREGUNTA Y RESPUESTA
        // ==========================================
        const selectPregunta = document.getElementById("tipoPregunta");
        const selectRespuesta = document.getElementById("tipoRespuesta");

        // Guardamos el valor que viene del modelo para mantenerlo seleccionado si aplica
        const respuestaDesdeModelo = '@(Model.TipoRespuesta ?? "")';

        // Diccionario con las reglas exactas que pediste
        const opcionesPorPregunta = {
            "Número": ["Nombre", "Imagen", "Nombre e Imagen"],
            "Imagen": ["Número", "Nombre", "Número y Nombre"],
            "Nombre": ["Número", "Imagen", "Número e Imagen"]
        };

        function actualizarRespuestas() {
            const preguntaSeleccionada = selectPregunta.value;
            const opcionesDisponibles = opcionesPorPregunta[preguntaSeleccionada] || [];

            // Limpiar las opciones actuales
            selectRespuesta.innerHTML = "";

            // Llenar con las nuevas opciones correspondientes
            opcionesDisponibles.forEach(opcion => {
                const nuevaOpcion = document.createElement("option");
                nuevaOpcion.value = opcion;
                nuevaOpcion.textContent = opcion;

                // Seleccionar automáticamente si coincide con la respuesta del modelo
                if (opcion === respuestaDesdeModelo) {
                    nuevaOpcion.selected = true;
                }

                selectRespuesta.appendChild(nuevaOpcion);
            });
        }

        // Escuchar cambios en el select de Tipo de Pregunta
        selectPregunta.addEventListener("change", actualizarRespuestas);

        // Inicializar el select de respuestas al cargar la página
        actualizarRespuestas();
    });
</script>