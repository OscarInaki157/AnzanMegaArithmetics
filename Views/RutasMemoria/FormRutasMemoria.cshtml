@model AnzanMegaArithmetics.Models.ConfRutasModel
@{
    ViewBag.Title = "Rutas de Memoria";
    Layout = "_LayoutMemoria";

    // Valores por defecto
    var cantidad = Model.CantidadEjercicios > 0 ? Model.CantidadEjercicios : 10;
    var valorInicial = Model.ValorInicial > 0 ? Model.ValorInicial : 1;
    var valorFinal = Model.ValorFinal > 0 ? Model.ValorFinal : 10;
    var tiempo = Model.TiempoMeditacion > 0 ? Model.TiempoMeditacion : 3;

    string velocidadStr = string.IsNullOrWhiteSpace(Model.VelocidadPreguntas) ? "0" : Model.VelocidadPreguntas.Replace(",", ".");
    double velocidadVal = 0;
    double.TryParse(velocidadStr, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out velocidadVal);
}

<div class="top-bar-config">
    <button type="button" class="btn-dashboard" onclick="regresarAlDashboard()">
        <i class="fas fa-home"></i> Regresar al Dashboard
    </button>
</div>

<div class="tabs">
    <div class="tab-buttons">
        <button type="button" class="tab-btn active" onclick="mostrarTab('tab1', this)">Modo Práctica</button>
        <button type="button" class="tab-btn" onclick="mostrarTab('tab2', this)">Modo Didáctico</button>
    </div>

    <form method="post" asp-controller="RutasMemoria" asp-action="ConcentracionRutas" id="tab1" class="formulario-flash tab-content active">

        <div class="form-header">
            <h2 style="color:white">Ajustes Rutas de Memoria Práctica</h2>
        </div>

        <div class="form-grid">
            <div class="form-column">

                <div>
                    <label for="cantidadEjercicios">Número de ejercicios:</label>
                    <input type="number" name="CantidadEjercicios" id="cantidadEjercicios" min="1" max="20" value="@cantidad" required />
                </div>

                <div>
                    <div class="contenedorValores">
                        <div class="valor-input">
                            <label for="valorInicial">Valor inicial:</label>
                            <input type="number" name="ValorInicial" id="valorInicial" min="1" value="@valorInicial" required style="width: 100%;" />
                        </div>
                        <div class="valor-input">
                            <label for="valorFinal">Valor final:</label>
                            <input type="number" name="ValorFinal" id="valorFinal" min="1" value="@valorFinal" required style="width: 100%;" />
                        </div>
                    </div>
                </div>

                <div>
                    <label for="modalidad">Modalidad:</label>
                    <select name="Modalidad" id="modalidad">
                        <option value="Secuencial" selected="@(Model.Modalidad == "Secuencial")">Secuencial</option>
                        <option value="Aleatorio" selected="@(Model.Modalidad == "Aleatorio")">Aleatorio</option>
                    </select>
                </div>

                <div>
                    <label for="categoriaEjercicios">Categoría de los ejercicios:</label>
                    <select name="CategoriaEjercicios" id="categoriaEjercicios">
                        <option value="Lista básica" selected="@(Model.CategoriaEjercicios == "Lista básica")">Lista básica</option>
                        <option value="Viaje a América" selected="@(Model.CategoriaEjercicios == "Viaje a América")">Viaje a América</option>
                    </select>
                </div>

            </div>

            <div class="form-column">

                <div>
                    <label for="velocidadPreguntas">Velocidad de las preguntas:</label>
                    <select name="VelocidadPreguntas" id="velocidadPreguntas" required>
                        <option value="0" selected="@(velocidadVal == 0)">0 (sin límite)</option>
                        @for (int i = 1; i <= 20; i++)
                        {
                            <option value="@i" selected="@(velocidadVal == i)">@i</option>
                        }
                    </select>
                    <small style="display: block; margin-top: 0.3rem; color: #aaa; font-size: 0.8rem;">
                        Tiempo para responder (segundos). 0 = sin límite.
                    </small>
                </div>

                <div>
                    <div class="contenedorValores">
                        <div class="valor-input">
                            <label for="tipoPregunta">Tipo de pregunta:</label>
                            <select name="TipoPregunta" id="tipoPregunta" style="width: 100%;">
                                <option value="Número" selected="@(Model.TipoPregunta == "Número")">Número</option>
                                <option value="Imagen" selected="@(Model.TipoPregunta == "Imagen")">Imagen</option>
                                <option value="Nombre" selected="@(Model.TipoPregunta == "Nombre")">Nombre</option>
                            </select>
                        </div>
                        <div class="valor-input">
                            <label for="tipoRespuesta">Tipo de respuesta:</label>
                            <select name="TipoRespuesta" id="tipoRespuesta" style="width: 100%;"></select>
                        </div>
                    </div>
                </div>

                <div>
                    <label for="tiempoMeditacion">Tiempo de concentración:</label>
                    <select name="TiempoMeditacion" id="tiempoMeditacion" required>
                        @foreach (var val in new[] { 0, 3, 5, 8, 10 })
                        {
                            <option value="@val" selected="@(tiempo == val)">@val @(val == 0 ? "(sin concentración)" : "segundos")</option>
                        }
                    </select>
                </div>

            </div>
        </div>

        <button type="submit" class="btn btn-primary" style="margin-top:1rem;">☄️ Iniciar ejercicios</button>

    </form>

    <form method="post" asp-action="ConcentracionGaleria" id="tab2" class="formulario-flash tab-content">
        <div class="form-header">
            <h2 style="color:white">Ajustes Rutas de Memoria Didáctico</h2>
        </div>

        <div class="form-grid">
            <div class="form-column">

                <div>
                    <label for="cantidadEjercicios">Número de ejercicios:</label>
                    <input type="number" name="CantidadEjercicios" id="cantidadEjercicios" min="1" max="20" value="@cantidad" required />
                </div>


                <div>
                    <label for="categoriaEjercicios">Categoría de los ejercicios:</label>
                    <select name="CategoriaEjercicios" id="categoriaEjercicios">
                        <option value="Lista básica" selected="@(Model.CategoriaEjercicios == "Lista básica")">Lista básica</option>
                        <option value="Viaje a América" selected="@(Model.CategoriaEjercicios == "Viaje a América")">Viaje a América</option>
                    </select>
                </div>

            </div>

            <div class="form-column">

                <div>
                    <label for="tiempoMeditacion">Tiempo de concentración:</label>
                    <select name="TiempoMeditacion" id="tiempoMeditacion" required>
                        @foreach (var val in new[] { 0, 3, 5, 8, 10 })
                        {
                            <option value="@val" selected="@(tiempo == val)">@val @(val == 0 ? "(sin concentración)" : "segundos")</option>
                        }
                    </select>
                </div>

            </div>
        </div>

        <button type="submit" class="btn btn-primary" style="margin-top:1rem;">☄️ Iniciar ejercicios</button>

        
    </form>

</div>

<style>
    .contenedorValores {
        display: flex;
        flex-direction: row;
        gap: 1rem;
        width: 100%;
    }

    .valor-input {
        width: 45%;
        display: flex;
        flex-direction: column;
    }
    .form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #444;
    }

        .form-header h2 {
            margin: 0;
            font-size: clamp(1.4rem, 2vw, 1.7rem);
            font-weight: 600;
        }

    body {
        background-color: var(--color-bg);
        color: var(--color-tex);
    }

    h2 {
        text-align: center;
        color: var(--color-light);
        font-weight: 600;
        font-size: clamp(1.4rem, 2vw, 1.7rem);
    }

    form#formConfigSR input[type="range"] {
        background-color: #292c4f;
    }


    .formulario-flash {
        max-width: 100%;
        padding: 1.3rem;
        border-radius: 0 1rem 1rem 1rem;
        background-color: var(--bg-color);
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.4);
        animation: fadeIn 0.4s ease;
    }

    .top-bar-config {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        max-width: 85%;
        margin: -1rem auto 1rem auto;
        padding: 0 1rem;
    }

        .top-bar-config h2 {
            margin: 0;
            font-size: clamp(1.4rem, 2vw, 1.7rem);
            font-weight: 600;
            color: var(--color-light);
        }

    .form-grid {
        display: flex;
        flex-wrap: wrap;
    }

    .form-column {
        flex: 1 1 49%;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .formulario-flash label {
        display: block;
        margin-bottom: 0.4rem;
        font-weight: 600;
        font-size: 1rem;
    }

    .formulario-flash select,
    .formulario-flash input[type="number"] {
        width: 60%;
        padding: 0.5rem 0.6rem;
        border: none;
        border-radius: 0.5rem;
        background-color: #292c4f;
        color: white;
        font-size: 1rem;
    }

    .formulario-flash input[type="radio"] {
        accent-color: var(--color-primary);
        transform: scale(1.1);
    }

    .btn.btn-primary {
        color: white;
        padding: 1.2rem 1rem;
        font-size: 1.1rem;
        font-weight: bold;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: transform 0.2s ease, background-color 0.3s ease, box-shadow 0.3s ease;
        width: 100%;
        background: #28a745;
        box-shadow: 0 4px 12px rgba(76, 175, 80, 0.4);
    }

        .btn.btn-primary:hover {
            background: #2ecc71;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(46, 204, 113, 0.5);
        }

    .btn-dashboard {
        background-color: var(--color-primary);
        color: white;
        padding: 0.7rem 1.5rem;
        border: none;
        border-radius: 0.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(76, 76, 255, 0.3);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
    }


        .btn-dashboard i {
            font-size: 1.1rem;
        }

    .dashboard-button-wrapper {
        display: flex;
        justify-content: center;
        margin-bottom: 2rem;
    }

    .btn-dashboard:hover {
        background-color: var(--color-primary-dark);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(76, 76, 255, 0.5);
    }

    .tag-input {
        border: 1px solid #555;
        border-radius: 0.5rem;
        padding: 0.6rem 0.8rem;
        background-color: #292c4f;
        position: relative;
        cursor: pointer;
        min-height: 48px;
        width: 60%;
    }

    .tags-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tag {
        background-color: var(--color-primary);
        color: white;
        padding: 5px 12px;
        border-radius: 999px;
        display: flex;
        align-items: center;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.2s ease;
        cursor: pointer;
    }

        .tag:hover {
            background-color: var(--color-primary-dark);
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(76, 76, 255, 0.5);
            transition: all 0.2s ease;
        }


        .tag .remove {
            margin-left: 8px;
            font-weight: bold;
            cursor: pointer;
        }

    .dropdown-toggle {
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 1.4rem;
        color: #ccc;
        user-select: none;
    }

    .dropdown-options {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background-color: #1b1e3c;
        border: 1px solid #555;
        border-radius: 0.5rem;
        margin-top: 6px;
        z-index: 10;
        display: none;
        max-height: 180px;
        overflow-y: auto;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.5);
    }

    .option {
        padding: 10px 15px;
        font-size: 0.95rem;
        color: var(--color-light);
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .option:hover {
            background-color: var(--color-primary-dark);
        }

        .option.special {
            font-weight: bold;
            background-color: #292c4f;
            color: var(--color-primary);
        }

            .option.special:hover {
                background-color: #3737e8;
                color: white;
            }

    .input-error {
        border: 2px solid var(--color-danger) !important;
    }

    .elslider {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 60%;
    }


    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .toggle-container {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 1rem;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 3rem;
        height: 2rem;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
            position: absolute;
            left: 0;
            top: 0;
        }

            .switch input[type="checkbox"] {
                z-index: 1;
                width: 100%;
                height: 100%;
            }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #555;
        transition: .4s;
        border-radius: 34px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 1.5rem;
            width: 1.5rem;
            left: 4px;
            bottom: 4px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: var(--color-primary);
    }

        input:checked + .slider:before {
            transform: translateX(1rem);
        }

    .estado-texto {
        font-weight: bold;
        font-size: 1rem;
        color: var(--color-light);
    }

    .tabs {
        width: 85%;
        margin-top: 2rem;
        justify-self: center;
    }

    /* --- Estilos con Tonalidad Dashboard --- */
    .tab-buttons {
        display: flex;
        gap: 0.6rem;
        margin-bottom: 0; /* Pegado al contenido para mejor flujo */
        border-bottom: 2px solid rgba(76, 76, 255, 0.1);
    }

    .tab-btn {
        background: rgba(41, 44, 79, 0.6); /* El fondo oscuro que ya usas, pero traslúcido */
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 0.7rem 1.3rem;
        font-size: 0.95rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.6);
        cursor: pointer;
        border-radius: 8px 8px 0 0;
        transition: all 0.3s ease;
        margin-bottom: -2px; /* Para que el borde activo monte sobre la línea base */
    }

        .tab-btn:hover {
            background: rgba(76, 76, 255, 0.15); /* Azul muy tenue */
            color: white;
        }

        .tab-btn.active {
            /* Usamos el color de tu botón dashboard */
            background-color: var(--color-primary);
            color: white;
            border-color: var(--color-primary);
            /* Glow sutil con el mismo tono azul */
            box-shadow: 0 4px 12px rgba(76, 76, 255, 0.4);
            /* Un degradado lineal para que no sea un color plano y aburrido */
            background-image: linear-gradient(180deg, rgba(255,255,255,0.1) 0%, rgba(0,0,0,0) 100%);
            transform: none; /* Mantenerlo estable */
            z-index: 2;
        }


    .tab-content {
        display: none;
    }

        .tab-content.active {
            display: block;
        }



    @@media (max-width: 768px) {

        .valor-input{
            width:100%;
        }

        .tab-btn {
            padding: 1rem 0.4rem;
        }

        .tab-buttons {
            gap: 0.4rem;
        }

        .form-header {
            flex-direction: column;
            gap: 1rem;
            text-align: center;
        }

        .form-grid {
            flex-direction: column;
        }

        .btn-dashboard {
            width: 100%;
            margin-bottom: 1rem;
        }

        .btn.btn-primary {
            font-size: 1rem;
        }

        .top-bar-config {
            flex-direction: column-reverse;
            align-items: center;
            text-align: center;
        }

            .top-bar-config h2 {
                width: 100%;
            }

            .top-bar-config .btn-dashboard {
                width: auto;
                margin: 0 auto;
            }

        .formulario-flash select,
        .formulario-flash input[type="number"] {
            width: 100%;
        }

        .elslider {
            width: 100%;
        }

        .tag-input {
            width: 100%;
        }

        .switch {
            width: 5rem;
        }

        input:checked + .slider:before {
            transform: translateX(1rem);
        }

        .contenedorValores {
            flex-direction: column;
            gap: 1rem;
        }
    }
</style>

<script>
    function regresarAlDashboard() {
        window.location.href = '@Url.Action("Memorizacion", "Dashboard")';
    }

    // ==========================================
    // 1. LÓGICA DE PESTAÑAS (TABS)
    // ==========================================
    function mostrarTab(id, btn) {
        // Ocultar todos los formularios/contenidos
        document.querySelectorAll(".tab-content").forEach(el => el.classList.remove("active"));
        // Quitar el estado "activo" de todos los botones
        document.querySelectorAll(".tab-btn").forEach(el => el.classList.remove("active"));

        // Activar el tab destino y su botón correspondiente
        const targetTab = document.getElementById(id);
        if (targetTab) {
            targetTab.classList.add("active");
            btn.classList.add("active");
            // Guardar la selección en el navegador para mantenerla al recargar
            localStorage.setItem("tabRutasActivo", id);
        }
    }

    document.addEventListener("DOMContentLoaded", () => {

       // Leer el último tab abierto o poner el tab1 por defecto
        let tabIdDestino = localStorage.getItem("tabRutasActivo") || "tab1";

        // Buscar el botón que abre ese tab específico
        const botonDestino = document.querySelector(`.tab-btn[onclick*="${tabIdDestino}"]`);

        // Activar la pestaña
        if (botonDestino) {
            mostrarTab(tabIdDestino, botonDestino);
        }

        // ==========================================
        // 2. LÓGICA DE CANTIDAD, INICIO Y FINAL
        // ==========================================
        const inputCantidad = document.getElementById("cantidadEjercicios");
        const inputInicial = document.getElementById("valorInicial");
        const inputFinal = document.getElementById("valorFinal");

        function calcularValorFinal() {
            let cantidad = parseInt(inputCantidad.value) || 1;
            let inicial = parseInt(inputInicial.value) || 1;

            if (inicial < 1) {
                inicial = 1;
                inputInicial.value = inicial;
            }

            let final = inicial + cantidad - 1;

            if (final > 20) {
                final = 20;
                cantidad = final - inicial + 1;

                if (cantidad < 1) {
                    inicial = 20;
                    inputInicial.value = inicial;
                    cantidad = 1;
                }
                inputCantidad.value = cantidad;
            }

            inputFinal.value = final;
        }

        function calcularCantidad() {
            let inicial = parseInt(inputInicial.value) || 1;
            let final = parseInt(inputFinal.value) || 1;

            if (inicial < 1) {
                inicial = 1;
                inputInicial.value = inicial;
            }

            if (final < inicial) final = inicial;
            if (final > 20) final = 20;

            inputFinal.value = final;

            let nuevaCantidad = final - inicial + 1;
            inputCantidad.value = nuevaCantidad;
        }

        inputCantidad.addEventListener("input", calcularValorFinal);
        inputInicial.addEventListener("input", calcularValorFinal);
        inputFinal.addEventListener("input", calcularCantidad);

        calcularValorFinal();

        // ==========================================
        // 3. LÓGICA DE TIPOS DE PREGUNTA Y RESPUESTA
        // ==========================================
        const selectPregunta = document.getElementById("tipoPregunta");
        const selectRespuesta = document.getElementById("tipoRespuesta");

        // Guardamos el valor que viene del modelo para mantenerlo seleccionado si aplica
        const respuestaDesdeModelo = '@(Model.TipoRespuesta ?? "")';

        // Diccionario con las reglas exactas que pediste
        const opcionesPorPregunta = {
            "Número": ["Nombre", "Imagen", "Nombre e Imagen"],
            "Imagen": ["Número", "Nombre", "Número y Nombre"],
            "Nombre": ["Número", "Imagen", "Número e Imagen"]
        };

        function actualizarRespuestas() {
            const preguntaSeleccionada = selectPregunta.value;
            const opcionesDisponibles = opcionesPorPregunta[preguntaSeleccionada] || [];

            // Limpiar las opciones actuales
            selectRespuesta.innerHTML = "";

            // Llenar con las nuevas opciones correspondientes
            opcionesDisponibles.forEach(opcion => {
                const nuevaOpcion = document.createElement("option");
                nuevaOpcion.value = opcion;
                nuevaOpcion.textContent = opcion;

                // Seleccionar automáticamente si coincide con la respuesta del modelo
                if (opcion === respuestaDesdeModelo) {
                    nuevaOpcion.selected = true;
                }

                selectRespuesta.appendChild(nuevaOpcion);
            });
        }

        // Escuchar cambios en el select de Tipo de Pregunta
        selectPregunta.addEventListener("change", actualizarRespuestas);

        // Inicializar el select de respuestas al cargar la página
        actualizarRespuestas();
    });
</script>