@model AnzanMegaArithmetics.Models.ConfRutasModel
@{
    ViewBag.Title = "Rutas de Memoria";
    Layout = "_LayoutMemoria";

    // Valores por defecto
    var cantidad = Model.CantidadEjercicios > 0 ? Model.CantidadEjercicios : 10;
    var valorInicial = Model.ValorInicial > 0 ? Model.ValorInicial : 1;
    var valorFinal = Model.ValorFinal > 0 ? Model.ValorFinal : 10;
    var tiempo = Model.TiempoMeditacion > 0 ? Model.TiempoMeditacion : 3;

    string velocidadStr = string.IsNullOrWhiteSpace(Model.VelocidadPreguntas) ? "0" : Model.VelocidadPreguntas.Replace(",", ".");
    double velocidadVal = 0;
    double.TryParse(velocidadStr, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out velocidadVal);
}

<form method="post" asp-controller="RutasMemoria" asp-action="ConcentracionRutas" id="formConfigSR" class="formulario-flash">

    <div class="form-header">
        <button type="button" class="btn-dashboard" onclick="regresarAlDashboard()">
            <i class="fas fa-home"></i> Regresar al Dashboard
        </button>
        <h2>Ajustes Rutas de Memoria</h2>
    </div>

    <div class="form-grid">
        <div class="form-column">

            <div>
                <label for="cantidadEjercicios">Número de ejercicios:</label>
                <input type="number" name="CantidadEjercicios" id="cantidadEjercicios" min="1" max="20" value="@cantidad" required />
            </div>

            <div>
                <div class="contenedorValores">
                    <div class="valor-input">
                        <label for="valorInicial">Valor inicial:</label>
                        <input type="number" name="ValorInicial" id="valorInicial" min="1" value="@valorInicial" required />
                    </div>
                    <div class="valor-input">
                        <label for="valorFinal">Valor final:</label>
                        <input type="number" name="ValorFinal" id="valorFinal" min="1" value="@valorFinal" required />
                    </div>
                </div>
            </div>

            <div>
                <label for="modalidad">Modalidad:</label>
                <select name="Modalidad" id="modalidad">
                    <option value="Secuencial" selected="@(Model.Modalidad == "Secuencial")">Secuencial</option>
                    <option value="Aleatorio" selected="@(Model.Modalidad == "Aleatorio")">Aleatorio</option>
                </select>
            </div>

            <div>
                <label for="categoriaEjercicios">Categoría de los ejercicios:</label>
                <select name="CategoriaEjercicios" id="categoriaEjercicios">
                    <option value="Lista básica" selected="@(Model.CategoriaEjercicios == "Lista básica")">Lista básica</option>
                    <option value="Viaje a América" selected="@(Model.CategoriaEjercicios == "Viaje a América")">Viaje a América</option>
                </select>
            </div>

        </div>

        <div class="form-column">

            <div>
                <label for="velocidadPreguntas">Velocidad de las preguntas:</label>
                <select name="VelocidadPreguntas" id="velocidadPreguntas" required>
                    <option value="0" selected="@(velocidadVal == 0)">0 (sin límite)</option>
                    @for (int i = 1; i <= 20; i++)
                    {
                        <option value="@i" selected="@(velocidadVal == i)">@i</option>
                    }
                </select>
                <small style="display: block; margin-top: 0.3rem; color: #aaa; font-size: 0.8rem;">
                    Tiempo para responder (segundos). 0 = sin límite.
                </small>
            </div>

            <div>
                <div class="contenedorValores">
                    <div class="valor-input">
                        <label for="tipoPregunta">Tipo de pregunta:</label>
                        <select name="TipoPregunta" id="tipoPregunta">
                            <option value="Número" selected="@(Model.TipoPregunta == "Número")">Número</option>
                            <option value="Imagen" selected="@(Model.TipoPregunta == "Imagen")">Imagen</option>
                            <option value="Nombre" selected="@(Model.TipoPregunta == "Nombre")">Nombre</option>
                        </select>
                    </div>
                    <div class="valor-input">
                        <label for="tipoRespuesta">Tipo de respuesta:</label>
                        <select name="TipoRespuesta" id="tipoRespuesta"></select>
                    </div>
                </div>
            </div>

            <div>
                <label for="tiempoMeditacion">Tiempo de concentración:</label>
                <select name="TiempoMeditacion" id="tiempoMeditacion" required>
                    @foreach (var val in new[] { 0, 3, 5, 8, 10 })
                    {
                        <option value="@val" selected="@(tiempo == val)">@val @(val == 0 ? "(sin concentración)" : "segundos")</option>
                    }
                </select>
            </div>

            <div style="margin-top: auto;">
                <button type="submit" class="btn btn-primary">☄️ Iniciar ejercicios</button>
            </div>

        </div>
    </div>
</form>

<style>

