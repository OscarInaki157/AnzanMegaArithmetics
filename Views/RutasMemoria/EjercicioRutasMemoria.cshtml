        border: 1px solid #aeb2d5;
        padding: 0.6rem 1.2rem;
        border-radius: 0.5rem;
        cursor: pointer;
        margin-top: 1.5rem;
        font-size: 1.2rem;
        transition: all 0.3s ease;
        display: block;
        width: max-content;
        margin-left: auto;
        margin-right: auto;
    }

        .btn-regresar:hover {
            background-color: rgba(174, 178, 213, 0.15);
            color: white;
            border-color: white;
        }

