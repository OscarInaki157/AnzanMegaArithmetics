        width: 100%;
        animation: fadeIn 0.4s ease;
    }

    .subtitulo-paso {
        font-size: 1.1rem;
        color: var(--color-light);
        margin: 0;
        text-align: center;
        font-weight: 500;
        margin-bottom:1rem;
    }

    .btn-regresar {
