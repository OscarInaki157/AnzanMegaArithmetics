@model AnzanMegaArithmetics.Models.EjercicioRMViewModel
@{
    ViewBag.Title = "Ejercicio de Rutas de Memoria";
    Layout = "_LayoutMemoria";

    var ejercicioActual = Model.EjercicioActual;
    var configuracion = Model.Configuracion;
    var numeroEjercicio = Model.NumeroEjercicio;
    var totalEjercicios = Model.TotalEjercicios;
    var velocidad = Model.VelocidadPregunta;

    var porcentaje = (numeroEjercicio * 100) / totalEjercicios;

    bool reqNumero = configuracion.TipoRespuesta.Contains("Número");
    bool reqImagen = configuracion.TipoRespuesta.Contains("Imagen");
    bool reqNombre = configuracion.TipoRespuesta.Contains("Nombre");

    // Nueva variable para saber si es modalidad de 2 pasos
    bool esDoble = (reqNumero && reqImagen) || (reqNumero && reqNombre) || (reqImagen && reqNombre);
}

<div class="top-bar">
    <form id="formFinalizar" class="form-fin" asp-action="FinalizarEjercicio" method="post">
        <button type="submit" class="btn-finalizar">
            ❌ <span>Finalizar</span>
        </button>
    </form>

    <div class="barra-progreso-contenedor">
        <div class="barra-progreso">
            <div class="progreso-interno" style="width:@porcentaje%"></div>
            <span class="progreso-texto">@numeroEjercicio / @totalEjercicios</span>
        </div>
    </div>

    <div class="info-tiempo">
        @if (velocidad > 0)
        {
            <span>⏱ <span id="contador" class="contador">@velocidad.ToString("0.0")</span> s</span>
        }
        else
        {
            <span class="modo-libre" style="font-size: 1.8rem;">⏱ <strong>♾️</strong></span>
        }
    </div>
</div>

<div class="ejercicio-wrapper">
    <img src="/Content/Images/logosr.png" class="cerebro-marca izquierdo" />
    <img src="/Content/Images/logosr.png" class="cerebro-marca derecho" />

    <div class="pantalla-dividida">

        @* PREGUNTA (IZQUIERDA) *@
        <div class="izquierda">
            <div class="contenedor-pregunta">
                <div class="elemento-pregunta activa">
                    @if (configuracion.TipoPregunta == "Número")
                    {
                        <span class="numero-pregunta">@ejercicioActual.ElementoPregunta.Numero</span>
                    }
                    else if (configuracion.TipoPregunta == "Imagen")
                    {
                        <img src="@ejercicioActual.ElementoPregunta.ImagenURL" class="figura-pregunta" />
                    }
                    else if (configuracion.TipoPregunta == "Nombre")
                    {
                        <span class="nombre-pregunta">@ejercicioActual.ElementoPregunta.Nombre</span>
                    }
                </div>
            </div>
        </div>

        @* RESPUESTAS (DERECHA) *@
        <div class="derecha">
            <h2 class="titulo-seccion" style="margin-bottom: 1rem;">Selecciona la respuesta</h2>

            @{
                // Calculamos los números de paso de forma limpia antes de imprimir el HTML
                int stepCounter = 1;
                int pasoNumero = reqNumero ? stepCounter++ : 0;
                int pasoImagen = reqImagen ? stepCounter++ : 0;
                int pasoNombre = reqNombre ? stepCounter++ : 0;
            }

            @if (reqNumero)
            {
                <div id="paso-@pasoNumero" class="bloque-paso" style="@(pasoNumero > 1 ? "display:none;" : "")">
                    @if (esDoble)
                    {
                        <h3 class="subtitulo-paso">Paso @pasoNumero: Selecciona el Número</h3>
                    }

                    <div class="contenedor-respuestas">
                        @foreach (var op in ejercicioActual.ListaOpciones.OrderBy(x => Guid.NewGuid()))
                        {
                            <div class="opcion-respuesta paso-@pasoNumero-opcion" data-id="@op.Numero" onclick="seleccionarOpcionDoble(this, @pasoNumero)">
                                <span class="numero-respuesta">@op.Numero</span>
                            </div>
                        }
                    </div>
                    @if (pasoNumero > 1)
                    {
                        <button type="button" class="btn-regresar" onclick="irAPaso(@(pasoNumero - 1))">⬅️ Cambiar selección anterior</button>
                    }
                </div>
            }

            @if (reqImagen)
            {
                <div id="paso-@pasoImagen" class="bloque-paso" style="@(pasoImagen > 1 ? "display:none;" : "")">
                    @if (esDoble)
                    {
                        <h3 class="subtitulo-paso">Paso @pasoImagen: Selecciona la Imagen</h3>
                    }

                    <div class="contenedor-respuestas">
                        @foreach (var op in ejercicioActual.ListaOpciones.OrderBy(x => Guid.NewGuid()))
                        {
                            <div class="opcion-respuesta paso-@pasoImagen-opcion" data-id="@op.Numero" onclick="seleccionarOpcionDoble(this, @pasoImagen)">
                                <img src="@op.ImagenURL" class="figura-respuesta" />
                            </div>
                        }
                    </div>
                    @if (pasoImagen > 1)
                    {
                        <button type="button" class="btn-regresar" onclick="irAPaso(@(pasoImagen - 1))">⬅️ Cambiar selección anterior</button>
                    }
                </div>
            }

            @if (reqNombre)
            {
                <div id="paso-@pasoNombre" class="bloque-paso" style="@(pasoNombre > 1 ? "display:none;" : "")">
                    @if (esDoble)
                    {
                        <h3 class="subtitulo-paso">Paso @pasoNombre: Selecciona el Nombre</h3>
                    }

                    <div class="contenedor-respuestas">
                        @foreach (var op in ejercicioActual.ListaOpciones.OrderBy(x => Guid.NewGuid()))
                        {
                            <div class="opcion-respuesta paso-@pasoNombre-opcion" data-id="@op.Numero" onclick="seleccionarOpcionDoble(this, @pasoNombre)">
                                <span class="nombre-respuesta">@op.Nombre</span>
                            </div>
                        }
                    </div>
                    @if (pasoNombre > 1)
                    {
                        <button type="button" class="btn-regresar" onclick="irAPaso(@(pasoNombre - 1))">⬅️ Cambiar selección anterior</button>
                    }
                </div>
            }
        </div>

    </div>

    <form class="form-respuesta-barra" id="formEjercicio" asp-action="EjercicioRutasMemoria" method="post">
        <input type="hidden" name="RespuestaUsuario" id="respuestaUsuario" value="[]" readonly />
        <input type="hidden" name="TiempoRespuesta" id="tiempoRespuesta" value="0" readonly />
        <button type="button" id="btnEnviar" onclick="enviarFormulario()">Enviar respuesta</button>
    </form>
</div>

<style>

