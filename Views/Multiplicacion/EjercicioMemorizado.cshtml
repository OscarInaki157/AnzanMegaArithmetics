@using System.Text.Json
@model List<AnzanMegaArithmetics.Models.EjercicioCompetenciaModel>
@{
    ViewBag.Title = "Memorización de Multiplicaciones";
    Layout = "_LayoutCompetencia";

    var tiempoMemoria = (double)(ViewBag.TiempoMemoriaSeg ?? 15);

    var mostrarContador = (bool)(ViewBag.MostrarContador ?? true);
}

<div class="top-bar">
    <form method="post" action="/Multiplicacion/FinalizarMemorizada" class="form-fin" id="FormFinalizar" onsubmit="return copiarRespuestasAlFormulario()">
        <button type="submit" class="btn-finalizar">
            ❌ <span>Finalizar</span>
        </button>

        @for (int i = 0; i < Model.Count; i++)
        {
            <input type="hidden" name="RespuestasUsuario[@i]" id="hiddenRespuesta_@i" />
        }
    </form>

    <div class="info-tiempo">
        @if (mostrarContador)
        {
            <span>⏱ <span id="cronometro" class="contador">--:--</span></span>
        }
    </div>
    
    <button id="btnSaltarMemorizacion" type="button" class="btn-finalizar" style="background-color:#4c4cff; box-shadow:none;">
        ▶️ <span class="btn-text">Finalizar Tiempo</span>
    </button>
</div>

<img src="/Content/Images/logosr.png" class="cerebro-marca izquierdo" />
<img src="/Content/Images/logosr.png" class="cerebro-marca derecho" />

<div class="grid-ejercicios">
    @for (int i = 0; i < Model.Count; i++)
    {
        <div class="ejercicio-mini" id="ejMini_@i">
            <div class="mini-operacion">
                <div class="linea1" id="linea1_@i">@Model[i].Multiplicando</div>
                <div class="linea2" id="linea2_@i">× @Model[i].Multiplicador</div>
                <hr class="linea-operacion" />
                <input type="text" class="respuesta-mini" id="respuestaMini_@i" readonly />
            </div>
        </div>
    }
</div>

<div class="alinear">
    <div class="ejercicio-actual" id="ejercicioActualContainer">
        <div class="marcadores" id="marcadores" style="visibility: hidden;"></div>
        <div class="contenido-ejercicio" id="contenidoEjercicio"></div>
    </div>
</div>


<script>
    const ejercicios = @Html.Raw(JsonSerializer.Serialize(Model));
    let actual = 0;
    let respuestasUsuario = Array(ejercicios.length).fill("");
    let respondidos = Array(ejercicios.length).fill(false);
    let tiempoRestante = @tiempoMemoria;
    let mostrarContador = @(ViewBag.MostrarContador.ToString().ToLower());
    let cronometro = document.getElementById("cronometro");
    let modoRespuesta = false;

    function iniciarMemorizacion() {

            document.querySelectorAll('.ejercicio-mini').forEach(el => {
                el.classList.remove('activo', 'resuelto');
            });

            document.getElementById("contenidoEjercicio").innerHTML = "";

            if (mostrarContador && cronometro) {
                actualizarCronometro(tiempoRestante);
            }


            const intervalo = setInterval(() => {
                if (!modoRespuesta) {
                    tiempoRestante--;

                    if (mostrarContador && cronometro) {
                        actualizarCronometro(tiempoRestante);
                    }

                    if (tiempoRestante <= 0) {
                        modoRespuesta = true;
                        clearInterval(intervalo);

                        // Deshabilitar el botón cuando el tiempo termine
                        const btn = document.getElementById("btnSaltarMemorizacion");
                        btn.disabled = true;
                        btn.style.opacity = "0.7";
                        btn.style.cursor = "not-allowed";

                        ocultarOperaciones();
                        if (mostrarContador && cronometro) {
                            cronometro.textContent = "Responde";
                            cronometro.classList.add("modo-libre");
                        }
                        mostrarEjercicio();
                        habilitarInput();
                    }
                }
            }, 1000);
    }



    function actualizarCronometro(t) {
        if (cronometro) {
            const min = Math.floor(t / 60);
            const seg = (t % 60).toString().padStart(2, '0');
            cronometro.textContent = `${min}:${seg}`;
        }
    }

    function mostrarEjercicio() {
        const ej = ejercicios[actual];
        const contenedor = document.getElementById("contenidoEjercicio");
        contenedor.innerHTML = `
            <div style="display: flex; flex-direction: column; align-items: center; font-size: 2.5rem; width: 100%;">
                <div style="font-size: 2rem; margin-bottom: 0.5rem;">Ejercicio ${actual + 1}</div>
                <input type="text" id="respuestaActual" class="input-respuesta" disabled onkeydown="registrarTecla(event)" autocomplete="off" />
            </div>
        `;

        // Resaltar el ejercicio actual en el grid
        document.querySelectorAll('.ejercicio-mini').forEach((el, index) => {
            el.classList.remove('activo');
            if (index === actual) {
                el.classList.add('activo');
            }
        });
    }

    function ocultarOperaciones() {
        ejercicios.forEach((ej, i) => {
            const mul1 = "*".repeat(ej.Multiplicando.length);
            const mul2 = "*".repeat(ej.Multiplicador.length);
            document.getElementById(`linea1_${i}`).textContent = mul1;
            document.getElementById(`linea2_${i}`).textContent = "× " + mul2;
        });
    }


    function habilitarInput() {
        const input = document.getElementById("respuestaActual");
        input.disabled = false;
        input.focus();
    }

    function registrarTecla(e) {
        const input = document.getElementById("respuestaActual");
        if (respondidos[actual]) {
            e.preventDefault();
            return;
        }

        if (e.key === "Enter") {
            confirmarRespuesta();
            return;
        }

        // Solo permitir números
        if (!/[0-9]/.test(e.key) && e.key !== "Backspace") {
            e.preventDefault();
            return;
        }
    }

    function confirmarRespuesta() {
        const valor = document.getElementById("respuestaActual").value;
        respuestasUsuario[actual] = valor;
        respondidos[actual] = true;

        const miniInput = document.getElementById(`respuestaMini_${actual}`);
        if (miniInput) miniInput.value = valor;

        // Marcar como resuelto
        document.getElementById(`ejMini_${actual}`).classList.add('resuelto');
        document.getElementById(`ejMini_${actual}`).classList.remove('activo');

        document.getElementById("respuestaActual").disabled = true;
        siguienteEjercicio();
    }

    function siguienteEjercicio() {
        if (actual < ejercicios.length - 1) {
            actual++;
            mostrarEjercicio();
            if (respondidos[actual]) {
                const input = document.getElementById("respuestaActual");
                input.value = respuestasUsuario[actual];
                input.disabled = true;
            } else {
                habilitarInput();
            }
        } else {
            // Cuando terminamos todos los ejercicios, quitamos el resaltado
            document.querySelectorAll('.ejercicio-mini').forEach(el => {
                el.classList.remove('activo');
            });
        }
    }

    function copiarRespuestasAlFormulario() {
        respuestasUsuario.forEach((resp, i) => {
            const input = document.getElementById(`hiddenRespuesta_${i}`);
            if (input) input.value = resp;
        });
        return true;
    }

    function finalizar() {
        copiarRespuestasAlFormulario();
        document.getElementById("FormFinalizar").submit();
    }

    document.addEventListener("DOMContentLoaded", iniciarMemorizacion);

     function saltarMemorizacion() {
        if (modoRespuesta) return;

        // Forzar el fin del tiempo de memorización
        tiempoRestante = 0;

        // Actualizar UI
        if (mostrarContador && cronometro) {
            cronometro.textContent = "Responde";
            cronometro.classList.add("modo-libre");
        }

        // Deshabilitar el botón
        const btn = document.getElementById("btnSaltarMemorizacion");
        btn.disabled = true;
        btn.style.opacity = "0.7";
        btn.style.cursor = "not-allowed";

        ocultarOperaciones();
        mostrarEjercicio();
        habilitarInput();
    }

    document.getElementById("btnSaltarMemorizacion").addEventListener("click", saltarMemorizacion);
</script>

<style>

