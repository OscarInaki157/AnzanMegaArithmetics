@using System.Text.Json
@model List<AnzanMegaArithmetics.Models.EjercicioCompetenciaModel>
@{
    ViewBag.Title = "Memorización de Multiplicaciones";
    Layout = "_LayoutCompetencia";

    var tiempoMemoria = (double)(ViewBag.TiempoMemoriaSeg ?? 15);

    var mostrarContador = (bool)(ViewBag.MostrarContador ?? true);
}

<div class="top-bar">
    <form method="post" action="/Multiplicacion/FinalizarMemorizada" class="form-fin" id="FormFinalizar" onsubmit="return copiarRespuestasAlFormulario()">
        <button type="submit" class="btn-finalizar">
            ✅ <span>Enviar respuestas</span>
        </button>

        @for (int i = 0; i < Model.Count; i++)
        {
            <input type="hidden" name="RespuestasUsuario[@i]" id="hiddenRespuesta_@i" />
        }
    </form>

    <div class="info-tiempo">
        @if (mostrarContador)
        {
            <span>⏱ <span id="cronometro" class="contador">--:--</span></span>
        }
    </div>

    <form method="get" asp-action="FormCompetenciaMulti">
        <button type="submit" class="btn-finalizar">⚙️ Configuración</button>
    </form>
    
    <button id="btnSaltarMemorizacion" type="button" class="btn-finalizar">
        ⏱️ <span class="btn-text">Finalizar tiempo</span>
    </button>
</div>

<img src="/Content/Images/logosr.png" class="cerebro-marca izquierdo" />
<img src="/Content/Images/logosr.png" class="cerebro-marca derecho" />

<div class="grid-ejercicios">
    @for (int i = 0; i < Model.Count; i++)
    {
        <div class="ejercicio-mini" id="ejMini_@i">
            <div class="mini-operacion">
                <div class="linea1" id="linea1_@i">@Model[i].Multiplicando</div>
                <div class="linea2" id="linea2_@i">× @Model[i].Multiplicador</div>
                <hr class="linea-operacion" />
                <input type="text" class="respuesta-mini" id="respuestaMini_@i" readonly />
            </div>
        </div>
    }
</div>

<div class="alinear">
    <div class="ejercicio-actual" id="ejercicioActualContainer">
        <div class="marcadores" id="marcadores" style="visibility: hidden;"></div>
        <div class="contenido-ejercicio" id="contenidoEjercicio"></div>
    </div>
</div>


<script>
    const ejercicios = @Html.Raw(JsonSerializer.Serialize(Model));
    let actual = 0;
    let respuestasUsuario = Array(ejercicios.length).fill("");
    let respondidos = Array(ejercicios.length).fill(false);
    let tiempoRestante = @tiempoMemoria;
    let mostrarContador = @(ViewBag.MostrarContador.ToString().ToLower());
    let cronometro = document.getElementById("cronometro");
    let modoRespuesta = false;

    let tiempoInicioTotal = Date.now();
    let tiempoLimiteMs = @tiempoMemoria * 1000;
    let tiempoUtilizadoMs = 0; 
    window.formularioEnviado = false;

    function iniciarMemorizacion() {
        document.querySelectorAll('.ejercicio-mini').forEach(el => {
            el.classList.remove('activo', 'resuelto');
        });

        document.getElementById("contenidoEjercicio").innerHTML = "";

        if (mostrarContador && cronometro) {
            actualizarCronometro(tiempoRestante);
        }

        const intervalo = setInterval(() => {
            if (!modoRespuesta) {
                tiempoRestante--;

                if (mostrarContador && cronometro) {
                    actualizarCronometro(tiempoRestante);
                }

                if (tiempoRestante <= 0) {
                    modoRespuesta = true;
                    clearInterval(intervalo);

                    
                    tiempoUtilizadoMs = tiempoLimiteMs;

                    
                    const btn = document.getElementById("btnSaltarMemorizacion");
                    btn.disabled = true;
                    btn.style.opacity = "0.7";
                    btn.style.cursor = "not-allowed";

                    ocultarOperaciones();
                    if (mostrarContador && cronometro) {
                        cronometro.textContent = "Responde";
                        cronometro.classList.add("modo-libre");
                    }
                    mostrarEjercicio();
                    habilitarInput();
                }
            }
        }, 1000);
    }

    function actualizarCronometro(t) {
        if (cronometro) {
            const min = Math.floor(t / 60);
            const seg = (t % 60).toString().padStart(2, '0');
            cronometro.textContent = `${min}:${seg}`;
        }
    }

    // --- ACTUALIZACIÓN DE FUNCIÓN EXISTENTE ---
        function mostrarEjercicio() {
            const ej = ejercicios[actual];
            const contenedor = document.getElementById("contenidoEjercicio");

            // Inyectamos estructura flex: Input a la izquierda, Teclado a la derecha
            contenedor.innerHTML = `
                <div class="contenedor-respuesta-memorizada">
                    <div class="seccion-input-memorizada">
                        <div style="font-size: 2rem; margin-bottom: 0.5rem; color:white; font-weight:normal;">Ejercicio ${actual + 1}</div>
                        @* Añadimos inputmode="none" para evitar teclado nativo en móvil *@
                        <input type="text" id="respuestaActual" class="input-respuesta memorizada" disabled onkeydown="registrarTecla(event)" autocomplete="off" inputmode="none" />
                    </div>

                    <div class="seccion-teclado-memorizada">
                        @* Teclado Grid estándar 3x4 (sin Anterior/Siguiente) *@
                        <div class="teclado-grid memorizada">
                            <button type="button" class="tecla">7</button>
                            <button type="button" class="tecla">8</button>
                            <button type="button" class="tecla">9</button>
                            <button type="button" class="tecla">4</button>
                            <button type="button" class="tecla">5</button>
                            <button type="button" class="tecla">6</button>
                            <button type="button" class="tecla">1</button>
                            <button type="button" class="tecla">2</button>
                            <button type="button" class="tecla">3</button>
                            <button type="button" class="tecla borrar" aria-label="Borrar">🗑️</button>
                            <button type="button" class="tecla">0</button>
                            <button type="button" class="tecla enviar" aria-label="Enviar">✅</button>
                        </div>
                    </div>
                </div>
            `;

            document.querySelectorAll('.ejercicio-mini').forEach((el, index) => {
                el.classList.remove('activo');
                if (index === actual) {
                    el.classList.add('activo');
                }
            });

            // Inicializar listeners del teclado virtual recién inyectado
            inicializarTecladoVirtualMemorizada();
        }

        // --- NUEVA FUNCIÓN A AÑADIR AL FINAL DEL SCRIPT ---
        function inicializarTecladoVirtualMemorizada() {
            document.querySelectorAll('.teclado-grid.memorizada .tecla').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();

                    const inputActual = document.getElementById("respuestaActual");
                    if (!inputActual || inputActual.disabled) return; // No hacer nada si está deshabilitado

                    const teclaValor = btn.textContent.trim();
                    let valorActual = inputActual.value;

                    // Manejo de botones especiales
                    if (btn.classList.contains('borrar')) {
                        inputActual.value = valorActual.slice(0, -1);
                    }
                    else if (btn.classList.contains('enviar')) {
                        confirmarRespuesta(); // Llama a la función definitiva

                        // Efecto visual rápido
                        btn.classList.add('presionada');
                        setTimeout(() => btn.classList.remove('presionada'), 100);
                        return;
                    }
                    else if (!isNaN(teclaValor)) {
                        // Es un número normal (Lógica estándar LTR para Memorizada)
                        inputActual.value = valorActual + teclaValor;
                    }

                    // Efecto visual del botón presionado
                    btn.classList.add('presionada');
                    setTimeout(() => btn.classList.remove('presionada'), 100);

                    // Mantener el foco en PC, evitar en móvil
                    const esTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
                    if (!esTouch) {
                        inputActual.focus();
                    }
                });
            });
        }

    function ocultarOperaciones() {
        ejercicios.forEach((ej, i) => {
            const mul1 = "*".repeat(ej.Multiplicando.length);
            const mul2 = "*".repeat(ej.Multiplicador.length);
            document.getElementById(`linea1_${i}`).textContent = mul1;
            document.getElementById(`linea2_${i}`).textContent = "× " + mul2;
        });
    }

    function habilitarInput() {
        const input = document.getElementById("respuestaActual");
        input.disabled = false;
        input.focus();
    }

    function registrarTecla(e) {
        const input = document.getElementById("respuestaActual");
        if (respondidos[actual]) {
            e.preventDefault();
            return;
        }

        if (e.key === "Enter") {
            confirmarRespuesta();
            return;
        }

        // Solo permitir números
        if (!/[0-9]/.test(e.key) && e.key !== "Backspace") {
            e.preventDefault();
            return;
        }
    }

    function confirmarRespuesta() {
        const valor = document.getElementById("respuestaActual").value;
        respuestasUsuario[actual] = valor;
        respondidos[actual] = true;

        const miniInput = document.getElementById(`respuestaMini_${actual}`);
        if (miniInput) miniInput.value = valor;

        document.getElementById(`ejMini_${actual}`).classList.add('resuelto');
        document.getElementById(`ejMini_${actual}`).classList.remove('activo');

        document.getElementById("respuestaActual").disabled = true;


        if (actual === ejercicios.length - 1) {
            finalizar();
        } else {
            siguienteEjercicio();
        }

    }

    function siguienteEjercicio() {
        if (actual < ejercicios.length - 1) {
            actual++;
            mostrarEjercicio();
            if (respondidos[actual]) {
                const input = document.getElementById("respuestaActual");
                input.value = respuestasUsuario[actual];
                input.disabled = true;
            } else {
                habilitarInput();
            }
        } else {
           
            document.querySelectorAll('.ejercicio-mini').forEach(el => {
                el.classList.remove('activo');
            });
        }
    }

    function agregarTiempoRealAlFormulario() {
        let tiempoTranscurridoMs;

        if (modoRespuesta && tiempoUtilizadoMs > 0) {
           
            tiempoTranscurridoMs = tiempoUtilizadoMs;
        } else {
           
            tiempoTranscurridoMs = Date.now() - tiempoInicioTotal;

            
            if (tiempoTranscurridoMs > tiempoLimiteMs) {
                tiempoTranscurridoMs = tiempoLimiteMs;
            }
        }

        let inputTiempo = document.getElementById("hiddenTiempoReal");
        if (!inputTiempo) {
            inputTiempo = document.createElement('input');
            inputTiempo.type = 'hidden';
            inputTiempo.name = 'TiempoRealMs';
            inputTiempo.id = 'hiddenTiempoReal';
            document.getElementById("FormFinalizar").appendChild(inputTiempo);
        }
        inputTiempo.value = tiempoTranscurridoMs;

        console.log(`Tiempo enviado: ${tiempoTranscurridoMs}ms`);
    }

    function copiarRespuestasAlFormulario() {
        respuestasUsuario.forEach((resp, i) => {
            const input = document.getElementById(`hiddenRespuesta_${i}`);
            if (input) input.value = resp;
        });

        agregarTiempoRealAlFormulario();
        return true;
    }

    function finalizar() {
        if (!window.formularioEnviado) {
            window.formularioEnviado = true;
            copiarRespuestasAlFormulario();
            document.getElementById("FormFinalizar").submit();
        }
    }

    document.getElementById("FormFinalizar").addEventListener("submit", function (e) {
        e.preventDefault();
        finalizar();
    });

    document.addEventListener("DOMContentLoaded", iniciarMemorizacion);

    function saltarMemorizacion() {
        if (modoRespuesta) return;

       
        tiempoUtilizadoMs = Date.now() - tiempoInicioTotal;

      
        tiempoRestante = 0;
        modoRespuesta = true;

        if (mostrarContador && cronometro) {
            cronometro.textContent = "Responde";
            cronometro.classList.add("modo-libre");
        }

        const btn = document.getElementById("btnSaltarMemorizacion");
        btn.disabled = true;
        btn.style.opacity = "0.7";
        btn.style.cursor = "not-allowed";

        ocultarOperaciones();
        mostrarEjercicio();
        habilitarInput();
    }

    document.getElementById("btnSaltarMemorizacion").addEventListener("click", saltarMemorizacion);
</script>

<style>
    /* Contenedor principal inyectado en modo respuesta */
    .contenedor-respuesta-memorizada {
        display: flex;
        gap: 3rem; /* Espaciado entre input y teclado */
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 900px;
        margin-top: 2rem;
        flex-direction:row;
    }

    .seccion-input-memorizada {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* Estilo específico para el input en Memorizada */
    .input-respuesta.memorizada {
        font-size: 4rem; /* Un poco más grande al no haber operación arriba */
        padding: 1rem;
        width: 100%;
        max-width: 400px;
    }

    .seccion-teclado-memorizada {
        background-color: #1b1e3c; /* Fondo oscuro idéntico a competencia */
        padding: 1.5rem;
        border-radius: 20px;
        box-shadow: 0 0 20px rgba(0,0,0,0.4);
    }

    /* Grid estándar 3x4 */
    .teclado-grid.memorizada {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.8rem;
        width: 280px;
    }

    .tecla {
        font-size: 2rem;
        padding: 0.8rem 0;
        border-radius: 12px;
        border: none;
        background-color: #4c4cff;
        color: white;
        cursor: pointer;
        box-shadow: 0 4px 0px #3737e8;
        transition: all 0.1s;
        font-weight: bold;
        text-align: center;
        width: 100%; /* Asegura que el botón llene su celda en el grid */
    }

        .tecla:active, .tecla.presionada {
            transform: translateY(4px);
            box-shadow: none;
            background-color: #a6a6ff;
        }

        .tecla.borrar {
            background-color: #df312c;
            box-shadow: 0 4px 0px #b22222;
        }

        .tecla.enviar {
            background-color: #28a745;
            box-shadow: 0 4px 0px #1e7e34;
        }

    .cerebro-marca {
        position: fixed;
        top: 30%;
        width: 25rem;
        opacity: 0.1;
        z-index: -1;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    .izquierdo {
        left: 0;
        transform: translateX(-55%);
    }

    .derecho {
        right: 0;
        transform: translateX(55%);
    }

    .ejercicio-mini.activo {
        background-color: var(--color-primary);
        transform: scale(1.05);
        box-shadow: 0 0 15px rgba(76, 76, 255, 0.6);
        transition: all 0.3s ease;
    }

    .ejercicio-mini.resuelto {
        background-color: #28a745;
        opacity: 0.8;
    }

    #btnSaltarMemorizacion:disabled {
        transform: none !important;
        box-shadow: none !important;
        opacity: 0.7;
        cursor: not-allowed;
    }

    /* Estilo para el texto del botón */
    #btnSaltarMemorizacion .btn-text {
        margin-left: 0.3rem;
    }

    #btnSaltarMemorizacion {
        color: white;
        padding: 0.6rem 1.2rem;
        border: none;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        background-color: #00ff88;
        box-shadow: 0 0 10px rgba(0, 255, 136, 0.5);
    }

        #btnSaltarMemorizacion:hover {
            background-color: #00e077;
            transform: scale(1.05);
        }


    .controles-ejercicio {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        margin-top: 1rem;
        flex-wrap: wrap;
        margin-bottom: 0;
    }

    .btn-control {
        background-color: #4c4cff;
        color: white;
        padding: 0.6rem 1.2rem;
        font-size: 1rem;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        font-weight: bold;
        transition: all 0.3s ease;
        box-shadow: 0 0 8px rgba(76, 76, 255, 0.5);
    }

        .btn-control:hover {
            transform: scale(1.05);
            background-color: #3a3ac2;
        }

    .btn-finalizar-central {
        background-color: #df312c;
        box-shadow: 0 0 10px rgba(255, 0, 0, 0.5);
    }

        .btn-finalizar-central:hover {
            background-color: #b22222;
        }

    /*ocultar header*/
    .page-header {
        display: none;
    }

    .main-content {
        margin-top: 0.5rem;
    }

    .page-footer {
        display: none;
    }

    .alinear {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column-reverse;
    }

    .grid-ejercicios {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
        gap: 1rem;
        margin: 1.5rem auto auto auto;
        max-width: 95%;
    }

    .ejercicio-mini {
        background-color: #2c2f50;
        padding: 0.5rem;
        border-radius: 1rem;
        text-align: center;
        font-size: 2rem;
        color: white;
        box-shadow: 0 0 10px rgba(0,0,0,0.4);
        min-height: 9rem;
        letter-spacing: 0.5rem;
    }

        .ejercicio-mini.activo {
            background-color: var(--color-primary);
            font-weight: bold;
            transform: scale(1.1);
        }

    .ejercicio-actual {
        margin: 0 auto;
        display: flex;
        justify-content: center;
        align-items: end;
        flex-direction: column;
        text-align: center;
    }


    .contenido-ejercicio {
        font-size: 2.5rem;
        font-weight: bold;
        color: white;
        letter-spacing: 0.2rem;
        margin-bottom: 1rem;
        display: flex;
        justify-content: center;
        align-items: center;
        line-height: 1.2;
        margin-top:2rem;
    }


    .marcadores {
        display: flex;
        justify-content: end;
        align-items: end;
        gap: 0.2rem;
        margin-bottom: 0;
        flex-wrap: nowrap;
    }


    .marcador {
        width: 1.5rem;
        height: 1.5rem;
        border: 2px solid white;
        border-radius: 4px;
        cursor: pointer;
    }

        .marcador.checked {
            background-color: var(--color-primary);
        }

    .controles-ejercicio {
        display: flex;
        justify-content: center;
        gap: 2rem;
        margin-bottom: 2rem;
    }

    .barra-tiempo {
        text-align: center;
        font-size: 1.2rem;
        color: var(--color-light);
        margin-top: 1rem;
    }

    .mini-operacion {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        font-family: monospace;
    }

    .linea1,
    .linea2 {
        width: 100%;
        text-align: right;
    }

    .linea-operacion {
        width: 100%;
        border: none;
        border-top: 2px solid white;
        margin-top: 0.3rem;
    }

    .top-bar {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.7rem;
        background-color: #1b1e3c;
        box-shadow: 0 0 20px rgba(0,0,0,0.3);
        border-radius: 25px;
        margin-top: -2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .form-fin {
        margin: 0;
    }

    .btn-finalizar {
        background-color: #4c4cff;
        color: white;
        padding: 0.6rem 1.2rem;
        border: none;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 0 10px rgba(76, 76, 255, 0.5);
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

        .btn-finalizar:hover {
            background-color: #3737e8;
            transform: scale(1.05);
        }

    .info-tiempo {
        font-size: 1rem;
        color: #d1d1f0;
        font-weight: 500;
    }

    .contador {
        color: #ffffff;
        font-weight: bold;
        font-size: 1.6rem;
        animation: pulse 1s infinite ease-in-out;
    }

    .modo-libre {
        color: #ffffff;
    }

    .separator {
        display: inline-block;
    }


    .input-respuesta {
        padding: 0.6rem 0.1rem;
        font-size: 2rem;
        border-radius: 10px;
        border: none;
        width: 100%;
        text-align: right;
        background-color: #ffffff;
        color: #000000;
        box-shadow: 0 0 10px rgba(76, 76, 255, 0.2);
        caret-color:transparent;
    }

    .respuesta-mini {
        margin-top: 0;
        font-size: 1.1rem;
        padding: 0.3rem;
        text-align: center;
        border-radius: 6px;
        border: none;
        background-color: #444a77;
        color: white;
        width: 100%;
        pointer-events: none;
    }

    .horizontal-contenedor {
        display: flex;
        gap: 0.4rem;
        align-items: flex-start;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

    .digito-con-marcador {
        display: flex;
        flex-direction: column;
        align-items: center;
        font-size: 2.5rem;
        font-weight: bold;
        color: white;
        font-family: monospace;
    }

        .digito-con-marcador .marcador {
            margin-bottom: 0.3rem;
        }

    .digito.iluminado {
        background-color: rgba(255, 255, 255, 0.15);
    }


    @@media (max-width: 768px) {

        .grid-ejercicios {
            grid-template-columns: 1fr 1fr;
        }

        #btnSaltarMemorizacion {
            padding: 0.6rem 0.8rem;
            font-size: 0.9rem;
        }

            #btnSaltarMemorizacion span {
                display: none;
            }

            #btnSaltarMemorizacion .btn-text {
                display: none;
            }

        .ejercicio-mini {
            letter-spacing: 0.1rem;
        }

        .contenedor-respuesta-memorizada {
            flex-direction: column;
        }
    }

</style>