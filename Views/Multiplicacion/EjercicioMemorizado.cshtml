        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 0 10px rgba(76, 76, 255, 0.5);
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

        #btnSaltarMemorizacion:hover {
