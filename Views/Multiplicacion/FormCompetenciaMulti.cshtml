@model AnzanMegaArithmetics.Models.ConfCompetenciaMultiModel
@{
    ViewBag.Title = "Competencia de Multiplicación";
    Layout = "_LayoutCompetencia";

    var tiempo = Model.TiempoMeditacion > 0 ? Model.TiempoMeditacion : 3;

}
<div class="top-bar-config">
    <form method="get" asp-controller="Dashboard" asp-action="Dashboard">
        <button type="submit" class="btn-dashboard">
            <i class="fas fa-home"></i> Regresar al dashboard
        </button>
    </form>
    <h2 style="color:white">Competencia de Multiplicación</h2>
</div>

<div class="tabs">
    <div class="tab-buttons">
        <button type="button" class="tab-btn active" onclick="mostrarTab('tab1', this)">Memoriad</button>
        <button type="button" class="tab-btn" onclick="mostrarTab('tab2', this)">Mental</button>
        <button type="button" class="tab-btn" onclick="mostrarTab('tab3', this)">Memorizada</button>
    </div>

    <!-- FORMULARIO MEMORIAD -->
    <form method="post" asp-controller="Multiplicacion" asp-action="ConcentracionCompetencia" class="formulario-flash tab-content active" id="tab1">
        <input type="hidden" name="DireccionRespuesta" value="DerechaAIzquierda" />
        <div class="form-grid">
            <div class="form-column">
                <div>
                    <label>Tipo de pregunta:</label>
                    <select name="TipoPregunta" required>
                        @foreach (var val in new[] { "2x2", "3x3", "4x4", "5x5" })
                        {
                            <option value="@val" selected="@(val == "3x3")">@val</option>
                        }
                    </select>
                </div>
                <div>
                    <label>Formato de la pregunta:</label>
                    <select name="FormatoPregunta" required>
                        <option value="Horizontal">Horizontal</option>
                        <option value="Vertical" selected>Vertical</option>
                    </select>
                </div>
            </div>
            <div class="form-column">

                <div class="toggle-container">
                    <label>¿Mostrar contador de tiempo?</label>
                    <label class="switch">
                        <input type="checkbox" name="MostrarContadorTiempo"
                               id="MostrarContadorTiempo"
                               value="true"
                               @(Model.MostrarContadorTiempo ? "checked" : "") />
                        <span class="slider"></span>
                    </label>
                    <!-- Campo oculto solo si el modelo es false -->
                    @if (!Model.MostrarContadorTiempo)
                    {
                        <input type="hidden" name="MostrarContadorTiempo" value="false" />
                    }
                </div>

                <div>
                    <label>Tiempo de concentración:</label>
                    <select name="TiempoMeditacion" required>
                        @foreach (var val in new[] { 0, 3, 5, 8, 10 })
                        {
                            <option value="@val" selected="@(val == 3)">@val</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div style="margin-top: 1rem;">
            <button type="submit" class="btn btn-primary">🏁 Iniciar competencia Memoriad</button>
        </div>
    </form>

    <!-- FORMULARIO MENTAL -->
    <form method="post" asp-controller="Multiplicacion" asp-action="ConcentracionCompetencia" class="formulario-flash tab-content" id="tab2">
        <input type="hidden" name="DireccionRespuesta" value="IzquierdaADerecha" />
        <div class="form-grid">
            <div class="form-column">
                <div>
                    <label>Tipo de pregunta:</label>
                    <select name="TipoPregunta" required>
                        @foreach (var val in new[] { "2x1", "2x2", "3x3", "4x4" })
                        {
                            <option value="@val" selected="@(val == "2x1")">@val</option>
                        }
                    </select>
                </div>
                <div>
                    <label>Formato de la pregunta:</label>
                    <select name="FormatoPregunta" required>
                        <option value="Horizontal">Horizontal</option>
                        <option value="Vertical" selected>Vertical</option>
                    </select>
                </div>
            </div>
            <div class="form-column">

                <div class="toggle-container">
                    <label>¿Mostrar contador de tiempo?</label>
                    <label class="switch">
                        <input type="checkbox" name="MostrarContadorTiempo"
                               id="MostrarContadorTiempo"
                               value="true"
                               @(Model.MostrarContadorTiempo ? "checked" : "") />
                        <span class="slider"></span>
                    </label>
                    <!-- Campo oculto solo si el modelo es false -->
                    @if (!Model.MostrarContadorTiempo)
                    {
                        <input type="hidden" name="MostrarContadorTiempo" value="false" />
                    }
                </div>

                <div>
                    <label>Tiempo de concentración:</label>
                    <select name="TiempoMeditacion" required>
                        @foreach (var val in new[] { 0, 3, 5, 8, 10 })
                        {
                            <option value="@val" selected="@(val == 3)">@val</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div style="margin-top: 1rem;">
            <button type="submit" class="btn btn-primary">🏁 Iniciar competencia Mental</button>
        </div>
    </form>

    <!-- FORMULARIO MEMORIZADA -->
    <form method="post" asp-controller="Multiplicacion" asp-action="ConcentracionMemorizada" class="formulario-flash tab-content" id="tab3">
        <input type="hidden" name="DireccionRespuesta" value="IzquierdaADerecha" />
        <div class="form-grid">
            <div class="form-column">
                <div>
                    <label>Tipo de pregunta:</label>
                    <select name="TipoPregunta" required>
                        @foreach (var val in new[] { "2x2", "3x3", "4x4" })
                        {
                            <option value="@val" selected="@(val == "2x2")">@val</option>
                        }
                    </select>
                </div>
                
                <input type="hidden" name="FormatoPregunta" value="Vertical" />
            </div>
            <div class="form-column">

                <div class="toggle-container">
                    <label>¿Mostrar contador de tiempo?</label>
                    <label class="switch">
                        <input type="checkbox" name="MostrarContadorTiempo"
                               id="MostrarContadorTiempo"
                               value="true"
                               @(Model.MostrarContadorTiempo ? "checked" : "") />
                        <span class="slider"></span>
                    </label>
                    <!-- Campo oculto solo si el modelo es false -->
                    @if (!Model.MostrarContadorTiempo)
                    {
                        <input type="hidden" name="MostrarContadorTiempo" value="false" />
                    }
                </div>

                <div>
                    <label>Tiempo de concentración:</label>
                    <select name="TiempoMeditacion" required>
                        @foreach (var val in new[] { 0, 3, 5, 8, 10 })
                        {
                            <option value="@val" selected="@(val == 3)">@val</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div style="margin-top: 1rem;">
            <button type="submit" class="btn btn-primary">🧠 Iniciar memorización</button>
        </div>
    </form>

</div>


<style>

    body {
        background-color: var(--color-bg);
        color: var(--color-tex);
    }

    h2 {
        text-align: center;
        color: var(--color-light);
        font-weight: 600;
        font-size: clamp(1.4rem, 2vw, 1.7rem);
    }

    form#formConfigSR input[type="range"] {
        background-color: #292c4f;
    }


    .formulario-flash {
        max-width: 100%;
        margin: 1rem auto 2rem auto;
        padding: 1.3rem;
        border-radius: 1rem;
        background-color: var(--bg-color);
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.4);
        animation: fadeIn 0.4s ease;
    }

    .top-bar-config {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        max-width: 85%;
        margin: -1rem auto 1rem auto;
        padding: 0 1rem;
    }

        .top-bar-config h2 {
            margin: 0;
            font-size: clamp(1.4rem, 2vw, 1.7rem);
            font-weight: 600;
            color: var(--color-light);
        }

    .form-grid {
        display: flex;
        flex-wrap: wrap;
    }

    .form-column {
        flex: 1 1 49%;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .formulario-flash label {
        display: block;
        margin-bottom: 0.4rem;
        font-weight: 600;
        font-size: 1rem;
    }

    .formulario-flash select,
    .formulario-flash input[type="number"] {
        width: 60%;
        padding: 0.5rem 0.6rem;
        border: none;
        border-radius: 0.5rem;
        background-color: #292c4f;
        color: white;
        font-size: 1rem;
    }

    .formulario-flash input[type="radio"] {
        accent-color: var(--color-primary);
        transform: scale(1.1);
    }

    .btn.btn-primary {
        background: #28a745;
        color: white;
        padding: 0.9rem 1.5rem;
        font-size: 1.1rem;
        font-weight: bold;
        border: none;
        border-radius: 0.6rem;
        cursor: pointer;
        transition: all 0.3s ease;
        width: 100%;
        box-shadow: 0 4px 12px rgba(76, 175, 80, 0.4);
        text-shadow: 0 1px 1px rgba(0, 0, 0, 0.2);
        letter-spacing: 0.5px;
    }

        .btn.btn-primary:hover {
            background: #2ecc71;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(46, 204, 113, 0.5);
        }

    .btn-dashboard {
        background-color: var(--color-primary);
        color: white;
        padding: 0.7rem 1.5rem;
        border: none;
        border-radius: 0.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(76, 76, 255, 0.3);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
    }


        .btn-dashboard i {
            font-size: 1.1rem;
        }

    .dashboard-button-wrapper {
        display: flex;
        justify-content: center;
        margin-bottom: 2rem;
    }

    .btn-dashboard:hover {
        background-color: var(--color-primary-dark);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(76, 76, 255, 0.5);
    }

    .tag-input {
        border: 1px solid #555;
        border-radius: 0.5rem;
        padding: 0.6rem 0.8rem;
        background-color: #292c4f;
        position: relative;
        cursor: pointer;
        min-height: 48px;
        width: 60%;
    }

    .tags-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tag {
        background-color: var(--color-primary);
        color: white;
        padding: 5px 12px;
        border-radius: 999px;
        display: flex;
        align-items: center;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.2s ease;
        cursor: pointer;
    }

        .tag:hover {
            background-color: var(--color-primary-dark);
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(76, 76, 255, 0.5);
            transition: all 0.2s ease;
        }


        .tag .remove {
            margin-left: 8px;
            font-weight: bold;
            cursor: pointer;
        }

    .dropdown-toggle {
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 1.4rem;
        color: #ccc;
        user-select: none;
    }

    .dropdown-options {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background-color: #1b1e3c;
        border: 1px solid #555;
        border-radius: 0.5rem;
        margin-top: 6px;
        z-index: 10;
        display: none;
        max-height: 180px;
        overflow-y: auto;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.5);
    }

    .option {
        padding: 10px 15px;
        font-size: 0.95rem;
        color: var(--color-light);
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .option:hover {
            background-color: var(--color-primary-dark);
        }

        .option.special {
            font-weight: bold;
            background-color: #292c4f;
            color: var(--color-primary);
        }

            .option.special:hover {
                background-color: #3737e8;
                color: white;
            }

    .input-error {
        border: 2px solid var(--color-danger) !important;
    }

    .elslider {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 60%;
    }


    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .toggle-container {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 1rem;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 3rem;
        height: 2rem;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
            position: absolute;
            left: 0;
            top: 0;
        }

            .switch input[type="checkbox"] {
                z-index: 1;
                width: 100%;
                height: 100%;
            }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #555;
        transition: .4s;
        border-radius: 34px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 1.5rem;
            width: 1.5rem;
            left: 4px;
            bottom: 4px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: var(--color-primary);
    }

        input:checked + .slider:before {
            transform: translateX(1rem);
        }

    .estado-texto {
        font-weight: bold;
        font-size: 1rem;
        color: var(--color-light);
    }

    .tabs {
        width: 85%;
        margin-top: 2rem;
        justify-self:center;
    }

    .tab-buttons {
        display: flex;
        gap: 1rem;
        margin-bottom: 1rem;
        border-bottom: 3px solid var(--bg-color);
    }

    .tab-btn {
        background: transparent;
        border: none;
        padding: 0.8rem 1.2rem;
        font-size: 1rem;
        font-weight: bold;
        color: white;
        cursor: pointer;
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
        background-color: #292c4f;
    }

    .tab-btn:hover{
            background-color: var(--bg-color);
            box-shadow: 0 -2px 0 var(--bg-color);
    }

        .tab-btn.active {
            background-color: var(--bg-color);
            box-shadow: 0 -2px 0 var(--bg-color);
        }

    .tab-content {
        display: none;
    }

        .tab-content.active {
            display: block;
        }



    @@media (max-width: 768px) {
        .form-grid {
            flex-direction: column;
        }

        .btn-dashboard {
            width: 100%;
            margin-bottom: 1rem;
        }

        .btn.btn-primary {
            font-size: 1rem;
        }

        .top-bar-config {
            flex-direction: column-reverse;
            align-items: center;
            text-align: center;
        }

            .top-bar-config h2 {
                width: 100%;
            }

            .top-bar-config .btn-dashboard {
                width: auto;
                margin: 0 auto;
            }

        .formulario-flash select,
        .formulario-flash input[type="number"] {
            width: 100%;
        }

        .elslider {
            width: 100%;
        }

        .tag-input {
            width: 100%;
        }

        .switch{
            width:5rem;
        }

        input:checked + .slider:before {
            transform: translateX(1rem);
        }
    }
</style>


<script>
    function mostrarTab(id, btn) {
        document.querySelectorAll(".tab-content").forEach(el => el.classList.remove("active"));
        document.querySelectorAll(".tab-btn").forEach(el => el.classList.remove("active"));

        document.getElementById(id).classList.add("active");
        btn.classList.add("active");

        // Guardar tab activo
        localStorage.setItem("tabCompetenciaActivo", id);
    }

    document.addEventListener("DOMContentLoaded", () => {
        const lastTab = localStorage.getItem("tabCompetenciaActivo");
        if (lastTab) {
            const btnMap = {
                "tab1": "Memoriad",
                "tab2": "Mental",
                "tab3": "Memorizada"
            };

            const match = Array.from(document.querySelectorAll(".tab-btn"))
                .find(b => b.textContent.includes(btnMap[lastTab]));

            if (match) mostrarTab(lastTab, match);
        }
    });

    document.addEventListener('DOMContentLoaded', function() {
        // Manejar el cambio en los switches
        document.querySelectorAll('.switch input[type="checkbox"]').forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                // Si está marcado, eliminar cualquier hidden field existente
                if(this.checked) {
                    const hiddenField = this.parentElement.querySelector('input[type="hidden"][name="MostrarContadorTiempo"]');
                    if(hiddenField) {
                        hiddenField.remove();
                    }
                }
                // Si no está marcado, asegurarse de que exista el hidden field
                else {
                    if(!this.parentElement.querySelector('input[type="hidden"][name="MostrarContadorTiempo"]')) {
                        const hiddenField = document.createElement('input');
                        hiddenField.type = 'hidden';
                        hiddenField.name = 'MostrarContadorTiempo';
                        hiddenField.value = 'false';
                        this.parentElement.appendChild(hiddenField);
                    }
                }
            });
        });
    });
</script>
