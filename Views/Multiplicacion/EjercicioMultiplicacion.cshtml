@section Scripts {
    <script>
        // --- VARIABLES GLOBALES ---
        let tiempoInicio = Date.now();
        const velocidad = parseFloat("@velocidad");
        const direccionRespuesta = "@direccion";

        const contador = document.getElementById("contador");
        const form = document.getElementById("formRespuesta");
        const inputRespuesta = document.getElementById("inputRespuesta");
        const tiempoRespuestaInput = document.getElementById("tiempoRespuesta");
        const respondidoField = document.getElementById("respondido");
        const hiddenRespuesta = document.getElementById("hiddenRespuestaUsuario");

        // --- INICIALIZACIÓN ---
        window.addEventListener('load', function() {
            tiempoInicio = Date.now();

            // Restaurar pestaña guardada o defecto
            const guardado = sessionStorage.getItem("tabSeleccionadoMultFinal") || "soroban";
            mostrarTab(guardado);

            enfocarInput();
        });

        // --- LÓGICA DE PESTAÑAS Y ENFOQUE ---
        function mostrarTab(tab) {
            sessionStorage.setItem("tabSeleccionadoMultFinal", tab);

            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));

            const btnActivo = document.querySelector(`.tab-btn[onclick*="${tab}"]`);
            if (btnActivo) btnActivo.classList.add('active');

            const contentActivo = document.getElementById(`tab-${tab}`);
            if (contentActivo) contentActivo.classList.add('active');

            // Ajuste de inputmode según el contexto
            const esTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0;

            if (esTouch) {
                // En móviles/tablets, nunca queremos el teclado nativo
                inputRespuesta.setAttribute('inputmode', 'none');
            } else {
                // En PC, queremos que reconozca la entrada numérica
                inputRespuesta.setAttribute('inputmode', 'numeric');
            }

            enfocarInput();
        }

        function enfocarInput() {
            const esTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
            if (!esTouch) {
                inputRespuesta.focus({ preventScroll: true });
            } else {
                inputRespuesta.blur(); // Evita que emerja el teclado nativo
            }
        }

        // --- LÓGICA TECLADO VIRTUAL ---
        document.querySelectorAll('.tecla').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                const teclaValor = btn.textContent.trim();
                const valorActual = inputRespuesta.value;

                if (btn.classList.contains('borrar')) {
                    if (direccionRespuesta === "DerechaAIzquierda") {
                        inputRespuesta.value = valorActual.substring(1);
                    } else {
                        inputRespuesta.value = valorActual.slice(0, -1);
                    }
                } else if (btn.classList.contains('enter')) {
                    form.dispatchEvent(new Event('submit'));
                } else if (!isNaN(teclaValor)) {
                    // Lógica para escribir de Derecha a Izquierda (Prepend) o Normal (Append)
                    if (direccionRespuesta === "DerechaAIzquierda") {
                        inputRespuesta.value = teclaValor + valorActual;
                    } else {
                        inputRespuesta.value = valorActual + teclaValor;
                    }
                }

                // Efecto visual
                btn.classList.add('presionada');
                setTimeout(() => btn.classList.remove('presionada'), 100);

                enfocarInput();
            });
        });

        // --- MANEJO DEL FORMULARIO Y TIEMPO ---
        function actualizarCamposOcultos() {
            const valor = inputRespuesta.value.trim();
            hiddenRespuesta.value = valor === "" ? "-1" : valor;
            respondidoField.value = valor !== "" ? "true" : "false";
        }

        form.addEventListener("submit", function(e) {
            e.preventDefault();

            const tiempoFin = Date.now();
            const tiempoTotalSegundos = (tiempoFin - tiempoInicio) / 1000;
            tiempoRespuestaInput.value = tiempoTotalSegundos.toFixed(2);

            actualizarCamposOcultos();
            this.submit();
        });

        // Lógica del contador de velocidad
        if (velocidad > 0 && contador) {
            let tiempo = velocidad;
            const intervalo = setInterval(() => {
                tiempo -= 0.1;
                if (tiempo <= 0) {
                    clearInterval(intervalo);
                    const tiempoFin = Date.now();
                    tiempoRespuestaInput.value = ((tiempoFin - tiempoInicio) / 1000).toFixed(2);
                    actualizarCamposOcultos();
                    form.submit();
                } else {
                    contador.textContent = tiempo.toFixed(1);
                }
            }, 100);
        }

        // --- SALIDA Y TECLADO FÍSICO ---
        function finalizarConTiempo() {
            const tiempoFin = Date.now();
            const tiempoTotalSegundos = (tiempoFin - tiempoInicio) / 1000;
            const respuesta = inputRespuesta.value.trim();

            const formFinalizar = document.createElement('form');
            formFinalizar.method = 'POST';
            formFinalizar.action = '/Multiplicacion/FinalizarMultiplicacion';
            formFinalizar.style.display = 'none';

            if (respuesta !== "") {
                const inputResp = document.createElement('input');
                inputResp.type = 'hidden';
                inputResp.name = 'respuestaUsuario';
                inputResp.value = respuesta;
                formFinalizar.appendChild(inputResp);
            }

            const inputTiempo = document.createElement('input');
            inputTiempo.type = 'hidden';
            inputTiempo.name = 'tiempoRespuesta';
            inputTiempo.value = tiempoTotalSegundos.toFixed(2);
            formFinalizar.appendChild(inputTiempo);

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.cloneNode(true);
            if (token) formFinalizar.appendChild(token);

            document.body.appendChild(formFinalizar);
            formFinalizar.submit();
        }

        // Teclado físico: Enter
        inputRespuesta.addEventListener("keypress", function(e) {
            if (e.key === "Enter") {
                e.preventDefault();
                form.dispatchEvent(new Event('submit'));
            }
        });

        // Lógica especial para escritura física de Derecha a Izquierda
        if (direccionRespuesta === "DerechaAIzquierda") {
            inputRespuesta.addEventListener("beforeinput", function(e) {
                if (e.inputType === "insertText" && /^\d$/.test(e.data)) {
                    e.preventDefault();
                    const actual = inputRespuesta.value;
                    inputRespuesta.value = e.data + actual;
                }
            });
        }

        // --- SOROBAN INTERACTIVO ---
        document.querySelectorAll("#sorobanSR .soroban-column").forEach(col => {
            const superior = col.querySelector(".bead.superior");
            const inferiores = col.querySelectorAll(".bead.inferior");

            superior.addEventListener("click", (e) => {
                e.preventDefault();
                superior.classList.toggle("activa");
                enfocarInput();
            });

            inferiores.forEach((bead, i) => {
                bead.addEventListener("click", (e) => {
                    e.preventDefault();
                    const activar = !bead.classList.contains("activa");
                    inferiores.forEach((b, j) => {
                        if ((activar && j <= i) || (!activar && j >= i)) {
                            b.classList.toggle("activa", activar);
                        }
                    });
                    enfocarInput();
                });
            });
        });
    </script>
}