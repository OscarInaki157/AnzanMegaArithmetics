@{
    ViewBag.Title = "Ejercicio de Multiplicación";
    Layout = "_LayoutMultiplicacion";

    int multiplicando = (int)ViewBag.Multiplicando;
    int multiplicador = (int)ViewBag.Multiplicador;
    float velocidad = float.Parse(ViewBag.VelocidadPreguntas.ToString());
    int ejercicioActual = ViewBag.EjercicioActual;
    int totalEjercicios = ViewBag.TotalEjercicios;
    string formato = ViewBag.FormatoPregunta?.ToString() ?? "Horizontal";
    string direccion = ViewBag.DireccionRespuesta?.ToString() ?? "IzquierdaADerecha";
    int porcentaje = (int)(((float)ejercicioActual / totalEjercicios) * 100);
}

<div class="top-bar">

    <button type="button" onclick="finalizarConTiempo()" class="btn-finalizar">
        ❌ <span>Finalizar</span>
    </button>

    <div class="barra-progreso-contenedor">
        <div class="barra-progreso">
            <div class="progreso-interno" style="width:@porcentaje%"></div>
            <span class="progreso-texto">@ejercicioActual / @totalEjercicios</span>
        </div>
    </div>

    <div class="info-tiempo">
        @if (velocidad > 0)
        {
            <span>⏱ <span id="contador" class="contador">@velocidad.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span> s</span>
        }
        else
        {
            <span class="modo-libre">⏱ <strong>♾️</strong></span>
        }
    </div>
</div>



<div class="ejercicio-wrapper">
    <img src="/Content/Images/logosr.png" class="cerebro-marca izquierdo" />
    <img src="/Content/Images/logosr.png" class="cerebro-marca derecho" />

    <div class="areaej">
        <div class="Ejercicio">
            @if (formato == "Vertical")
            {
                <h1 class="multiplicacion">@multiplicando<br />× @multiplicador</h1>
            }
            else
            {
                <h1 class="multiplicacion">@multiplicando × @multiplicador</h1>
            }

            <hr class="elhr" />

            <form method="post" asp-controller="Multiplicacion" asp-action="EnviarRespuesta" id="formRespuesta" class="Forms">
                @Html.AntiForgeryToken()
                <input type="hidden" id="respondido" name="respondido" value="false" />
                <input type="hidden" name="respuestaUsuario" id="hiddenRespuestaUsuario" value="-1" />
                <input type="hidden" id="tiempoRespuesta" name="tiempoRespuesta" value="0" />

                <input type="text"
                       inputmode="none"
                       pattern="[0-9]*"
                       id="inputRespuesta"
                       autocomplete="off"
                       class="input-respuesta"
                       autofocus
                       oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                       @(direccion == "DerechaAIzquierda" ? "dir=\"rtl\"" : "") />

                <button type="submit" class="btn-enviar-respuesta">Enviar</button>
            </form>
        </div>

        <div class="ayuda-tabs-container">
            <div class="tabs">
                <button class="tab-btn active" onclick="mostrarTab('soroban')">🧮 Soroban</button>
                <button class="tab-btn" onclick="mostrarTab('teclado')">⌨️ Teclado</button>
            </div>

            <div class="tab-content active" id="tab-soroban">
                <div class="soroban-frame">
                    <div class="barra-horizontal"></div>
                    <div class="soroban-container" id="sorobanSR">
                        @for (int col = 0; col < 9; col++)
                        {
                            <div class="soroban-column" data-col="@col">
                                <div class="palito-vertical"></div>
                                <div class="bead superior" data-valor="5"></div>
                                @for (int i = 0; i < 4; i++)
                                {
                                    <div class="bead inferior bead-inferior-@i" data-valor="1"></div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="tab-content" id="tab-teclado">
                <div class="teclado-numerico">
                    <div class="fila">
                        <button type="button" class="tecla">7</button>
                        <button type="button" class="tecla">8</button>
                        <button type="button" class="tecla">9</button>
                    </div>
                    <div class="fila">
                        <button type="button" class="tecla">4</button>
                        <button type="button" class="tecla">5</button>
                        <button type="button" class="tecla">6</button>
                    </div>
                    <div class="fila">
                        <button type="button" class="tecla">1</button>
                        <button type="button" class="tecla">2</button>
                        <button type="button" class="tecla">3</button>
                    </div>
                    <div class="fila">
                        <button type="button" class="tecla borrar">🗑️</button>
                        <button type="button" class="tecla">0</button>
                        <button type="button" class="tecla enter">✅</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


