        box-shadow: 0 0 10px rgba(255, 0, 0, 0.5);
    }

        .btn-finalizar:hover {
            background-color: #b22222;
            transform: scale(1.05);
        }

    .info-tiempo {
        font-size: 1rem;
        color: #d1d1f0;
        font-weight: 500;
    }

    .contador {
        color: #ffffff;
        font-weight: bold;
        font-size: 1.6rem;
        animation: pulse 1s infinite ease-in-out;
    }

    .modo-libre {
        color: #ffffff;
    }

    .separator {
        display: inline-block;
    }


    .input-respuesta {
        padding: 0.6rem 0.1rem;
        font-size: 3rem;
        border-radius: 10px;
        border: none;
        width: 100%;
        text-align: right;
        background-color: #ffffff;
        color: #000000;
        box-shadow: 0 0 10px rgba(76, 76, 255, 0.2);
        caret-color:transparent;
    }

    .respuesta-mini {
        margin-top: 0;
        font-size: 1.1rem;
        padding: 0.3rem;
        text-align: center;
        border-radius: 6px;
        border: none;
        background-color: #444a77;
        color: white;
        width: 100%;
        pointer-events: none;
    }

    .horizontal-contenedor {
        display: flex;
        gap: 0.4rem;
        align-items: flex-start;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

    .digito-con-marcador {
        display: flex;
        flex-direction: column;
        align-items: center;
        font-size: 2.5rem;
        font-weight: bold;
        color: white;
        font-family: monospace;
    }

        .digito-con-marcador .marcador {
            margin-bottom: 0.3rem;
        }

    .digito.iluminado {
        background-color: rgba(255, 255, 255, 0.15);
    }

    @@media (min-width: 768px) and (max-width: 1024px) {

        .alinear{
            flex-direction:column;
        }
    }




    @@media (max-width: 768px) {
        .contenedor-teclado {
            max-width: 380px; /* Evita que los botones se estiren demasiado en el celular */
            margin: 0 auto;
        }

        .teclado-grid {
            grid-template-columns: repeat(3, 1fr); /* Cambia a 2 columnas */
        }
        /* Magia CSS: Empuja estos dos botones al final de la cuadrícula */
