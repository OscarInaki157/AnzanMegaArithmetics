@using System.Text.Json
@model List<AnzanMegaArithmetics.Models.EjercicioCompetenciaModel>
@{
    ViewBag.Title = "Competencia de Multiplicación";
    Layout = "_LayoutCompetencia";

    var tiempoLimiteSeg = (double)(ViewBag.TiempoLimiteSeg ?? 900);
    var mostrarContador = (bool)(ViewBag.MostrarContador ?? true);
}

<div class="top-bar">
    <form method="post" action="/Multiplicacion/FinalizarCompetencia" class="form-fin" id="FormFinalizar" onsubmit="return copiarRespuestasAlFormulario()">
        <button type="submit" class="btn-finalizar">
            ❌ <span>Finalizar</span>
        </button>

        @for (int i = 0; i < Model.Count; i++)
        {
            <input type="hidden" name="RespuestasUsuario[@i]" id="hiddenRespuesta_@i" />
        }
    </form>


    <div class="info-tiempo">
        @if (mostrarContador)
        {
            <span>⏱ <span id="cronometro" class="contador">--:--</span></span>
        }
        @* else
        {
            <span class="modo-libre">⏱ <strong>♾️</strong></span>
        } *@
    </div>
</div>

<img src="/Content/Images/logosr.png" class="cerebro-marca izquierdo" />
<img src="/Content/Images/logosr.png" class="cerebro-marca derecho" />

<div class="grid-ejercicios">
    @for (int i = 0; i < Model.Count; i++)
    {
        <div class="ejercicio-mini" id="ejMini_@i" onclick="seleccionarEjercicio(@i)">
            <div class="mini-operacion">
                <div class="linea1">@Model[i].Multiplicando</div>
                <div class="linea2">× @Model[i].Multiplicador</div>
                <hr class="linea-operacion" />
                <input type="text" class="respuesta-mini" id="respuestaMini_@i" readonly />
            </div>
        </div>
    }
</div>


<div class="alinear">
    @* Ejercicio Actual *@
    <div class="ejercicio-actual" id="ejercicioActualContainer">
        <div class="marcadores" id="marcadores"></div>
        <div class="contenido-ejercicio" id="contenidoEjercicio"></div>
    </div>

    @* Teclado Virtual Numérico y Controles *@
    <div class="contenedor-teclado">

        @* Botones de control integrados *@
        <div class="controles-integrados">
            <button onclick="ejercicioAnterior()" class="btn-control-teclado">⬅ Anterior</button>
            <button onclick="ejercicioSiguiente()" class="btn-control-teclado">Siguiente ➡</button>
        </div>

        <hr class="divisor-teclado" />

        @* Teclado en formato CSS Grid (6x2 en PC, 2x6 en Móvil) *@
        <div class="teclado-grid">
            <button type="button" class="tecla">0</button>
            <button type="button" class="tecla">1</button>
            <button type="button" class="tecla">2</button>
            <button type="button" class="tecla">3</button>
            <button type="button" class="tecla">4</button>
            <button type="button" class="tecla borrar" aria-label="Borrar">🗑️</button>

            <button type="button" class="tecla">5</button>
            <button type="button" class="tecla">6</button>
            <button type="button" class="tecla">7</button>
            <button type="button" class="tecla">8</button>
            <button type="button" class="tecla">9</button>
            <button type="button" class="tecla enviar" aria-label="Enviar">✅</button>
        </div>

    </div>
</div>


<style>
    .teclado-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr); /* 6 columnas en PC */
        gap: 0.6rem;
    }

    .contenedor-teclado {
        background-color: #1b1e3c; /* Fondo oscuro */
        padding: 1.5rem;
        border-radius: 20px;
        box-shadow: 0 0 20px rgba(0,0,0,0.4);
        width: 100%;
        max-width: 600px; /* Ancho máximo para el teclado horizontal */
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .controles-integrados {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        width: 100%;
    }

    .btn-control-teclado {
        flex: 1; /* Ocupan 50% cada uno */
        background-color: #4c4cff;
        color: white;
        padding: 0.8rem;
        font-size: 1.1rem;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        font-weight: bold;
        transition: all 0.2s ease;
        box-shadow: 0 4px 0px #3737e8;
    }

        .btn-control-teclado:hover {
            transform: translateY(-2px);
        }

        .btn-control-teclado:active {
            transform: translateY(4px);
            box-shadow: none;
        }

    /* Línea divisoria */
    .divisor-teclado {
        border: none;
        border-top: 2px dashed #4c4cff; /* Puedes cambiar dashed por solid si prefieres */
        margin: 0.5rem 0;
        opacity: 0.5;
    }

    /* Teclado Horizontal */
    .teclado-numerico-horizontal {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }

    .fila-horizontal {
        display: flex;
        gap: 0.6rem;
        justify-content: center;
    }

    .tecla {
        font-size: 2rem;
        padding: 0.8rem 0;
        border-radius: 12px;
        border: none;
        background-color: #4c4cff;
        color: white;
        cursor: pointer;
        box-shadow: 0 4px 0px #3737e8;
        transition: all 0.1s;
        font-weight: bold;
        text-align: center;
        width: 100%; /* Asegura que el botón llene su celda en el grid */
    }

        .tecla:active, .tecla.presionada {
            transform: translateY(4px);
            box-shadow: none;
            background-color: #a6a6ff;
        }

        .tecla.borrar {
            background-color: #df312c;
            box-shadow: 0 4px 0px #b22222;
        }

        .tecla.enviar {
            background-color: #28a745;
            box-shadow: 0 4px 0px #1e7e34;
        }

    .cerebro-marca {
        position: fixed;
        top: 30%;
        width: 25rem;
        opacity: 0.1;
        z-index: -1;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    .izquierdo {
        left: 0;
        transform: translateX(-55%);
    }

    .derecho {
        right: 0;
        transform: translateX(55%);
    }

    .controles-ejercicio {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        margin-top: 1rem;
        flex-wrap: wrap;
        margin-bottom:0;
    }

    .btn-control {
        background-color: #4c4cff;
        color: white;
        padding: 0.6rem 1.2rem;
        font-size: 1rem;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        font-weight: bold;
        transition: all 0.3s ease;
        box-shadow: 0 0 8px rgba(76, 76, 255, 0.5);
        margin:3rem;
    }

        .btn-control:hover {
            transform: scale(1.05);
            background-color: #3a3ac2;
        }

    .btn-finalizar-central {
        background-color: #df312c;
        box-shadow: 0 0 10px rgba(255, 0, 0, 0.5);
    }

        .btn-finalizar-central:hover {
            background-color: #b22222;
        }

/*ocultar header*/
.page-header{
    display:none;
}

.main-content{
    margin-top:0.5rem;
}

.page-footer{
    display:none;
}

    .alinear {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: row; 
        margin-top: 3vh;
        max-width: 100%;
        gap: 2rem; 
    }

.grid-ejercicios {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
    gap: 0.5rem;
