    }


    .contenido-ejercicio {
        font-size: 2.5rem;
        font-weight: bold;
        color: white;
        letter-spacing: 0.2rem;
        /* margin-bottom: 1rem; */
        display: flex;
        justify-content: center;
        align-items: center;
        line-height:1;
    }


    .marcadores {
        display: flex;
        justify-content: end;
        align-items: end;
        gap: 0.4rem;
        margin-bottom: 0;
        flex-wrap: nowrap;
    }


.marcador {
    width: 2.5rem;
