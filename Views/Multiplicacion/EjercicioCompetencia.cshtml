@using System.Text.Json
@model List<AnzanMegaArithmetics.Models.EjercicioCompetenciaModel>
@{
    ViewBag.Title = "Competencia de Multiplicación";
    Layout = "_LayoutGeneral";

    var tiempoLimiteSeg = (double)(ViewBag.TiempoLimiteSeg ?? 900);
    var mostrarContador = (bool)(ViewBag.MostrarContador ?? true);
}

<div class="top-bar">
    <form method="post" action="/Multiplicacion/FinalizarCompetencia" class="form-fin" id="FormFinalizar" onsubmit="return copiarRespuestasAlFormulario()">
        <button type="submit" class="btn-finalizar">
            ❌ <span>Finalizar</span>
        </button>

        @for (int i = 0; i < Model.Count; i++)
        {
            <input type="hidden" name="RespuestasUsuario[@i]" id="hiddenRespuesta_@i" />
        }
    </form>


    <div class="info-tiempo">
        @if (mostrarContador)
        {
            <span>⏱ <span id="cronometro" class="contador">--:--</span></span>
        }
        else
        {
            <span class="modo-libre">⏱ <strong>Modo sin límite de tiempo</strong></span>
        }
    </div>
</div>

<div class="grid-ejercicios">
    @for (int i = 0; i < Model.Count; i++)
    {
        <div class="ejercicio-mini" id="ejMini_@i" onclick="seleccionarEjercicio(@i)">
            <div class="mini-operacion">
                <div class="linea1">@Model[i].Multiplicando</div>
                <div class="linea2">× @Model[i].Multiplicador</div>
                <hr class="linea-operacion" />
                <input type="text" class="respuesta-mini" id="respuestaMini_@i" readonly />
            </div>
        </div>
    }
</div>


<div class="alinear">
    <div class="ejercicio-actual" id="ejercicioActualContainer">
        <div class="marcadores" id="marcadores"></div>
        <div class="contenido-ejercicio" id="contenidoEjercicio"></div>
    </div>

    <div class="controles-ejercicio">
        <button onclick="ejercicioAnterior()" class="btn-control">⬅ Anterior</button>

        <button type="submit" form="FormFinalizar" class="btn-control btn-finalizar-central">❌ Finalizar</button>

        <button onclick="ejercicioSiguiente()" class="btn-control">Siguiente ➡</button>
    </div>

</div>




<style>

    .controles-ejercicio {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        margin-top: 1rem;
        flex-wrap: wrap;
        margin-bottom:0;
    }

    .btn-control {
        background-color: #4c4cff;
        color: white;
        padding: 0.6rem 1.2rem;
        font-size: 1rem;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        font-weight: bold;
        transition: all 0.3s ease;
        box-shadow: 0 0 8px rgba(76, 76, 255, 0.5);
    }

        .btn-control:hover {
            transform: scale(1.05);
            background-color: #3a3ac2;
        }

    .btn-finalizar-central {
        background-color: #df312c;
        box-shadow: 0 0 10px rgba(255, 0, 0, 0.5);
    }

        .btn-finalizar-central:hover {
            background-color: #b22222;
        }

/*ocultar header*/
.page-header{
    display:none;
}

.main-content{
    margin-top:0.5rem;
}

.page-footer{
    display:none;
}

.alinear{
    display:flex;
    justify-content:center;
    align-items:center;
    flex-direction:column-reverse;
}

.grid-ejercicios {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
    gap: 1rem;
    margin: 0.5rem auto auto auto;
    max-width: 900px;
}

.ejercicio-mini {
    background-color: #2c2f50;
    padding: 0.5rem;
    border-radius: 1rem;
    text-align: center;
    font-size: 1.2rem;
    color: white;
    box-shadow: 0 0 10px rgba(0,0,0,0.4);
}

.ejercicio-mini.activo {
    background-color: var(--color-primary);
    font-weight: bold;
    transform: scale(1.1);
}

    .ejercicio-actual {
        margin: -1rem auto;
        display: flex;
        justify-content: center;
        align-items: end;
        flex-direction: column;
        text-align: center;
    }


    .contenido-ejercicio {
        font-size: 2.5rem;
        font-weight: bold;
        color: white;
        letter-spacing: 0.2rem;
        margin-bottom: 1rem;
        display: flex;
        justify-content: center;
        align-items: center;
        line-height:1.2;
    }


    .marcadores {
        display: flex;
        justify-content: end;
        align-items: end;
        gap: 0.2rem;
        margin-bottom: 0;
        flex-wrap: nowrap;
    }


.marcador {
    width: 1.5rem;
    height: 1.5rem;
    border: 2px solid white;
    border-radius: 4px;
    cursor: pointer;
}

.marcador.checked {
    background-color: var(--color-primary);
}

.controles-ejercicio {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 2rem;
}

.barra-tiempo {
    text-align: center;
    font-size: 1.2rem;
    color: var(--color-light);
    margin-top: 1rem;
}

    .mini-operacion {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        font-family: monospace;
    }

    .linea1,
    .linea2 {
        width: 100%;
        text-align: right;
    }

    .linea-operacion {
        width: 100%;
        border: none;
        border-top: 2px solid white;
        margin-top: 0.3rem;
    }

    .top-bar {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.7rem;
        background-color: #1b1e3c;
        box-shadow: 0 0 20px rgba(0,0,0,0.3);
        border-radius: 25px;
        margin-top: -2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .form-fin {
        margin: 0;
    }

    .btn-finalizar {
        background-color: #df312c;
        color: white;
        padding: 0.6rem 1rem;
        border: none;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 0 10px rgba(255, 0, 0, 0.5);
    }

        .btn-finalizar:hover {
            background-color: #b22222;
            transform: scale(1.05);
        }

    .info-tiempo {
        font-size: 1rem;
        color: #d1d1f0;
        font-weight: 500;
    }

    .contador {
        color: #ffffff;
        font-weight: bold;
        font-size: 1.6rem;
        animation: pulse 1s infinite ease-in-out;
    }

    .modo-libre {
        color: #ffffff;
    }

    .separator {
        display: inline-block;
    }


    .input-respuesta {
        padding: 0.6rem 0.1rem;
        font-size: 2rem;
        border-radius: 10px;
        border: none;
        width: 100%;
        text-align: right;
        background-color: #ffffff;
        color: #000000;
        box-shadow: 0 0 10px rgba(76, 76, 255, 0.2);
    }

    .respuesta-mini {
        margin-top: 0;
        font-size: 1.1rem;
        padding: 0.3rem;
        text-align: center;
        border-radius: 6px;
        border: none;
        background-color: #444a77;
        color: white;
        width: 100%;
        pointer-events: none;
    }

    .horizontal-contenedor {
        display: flex;
        gap: 0.4rem;
        align-items: flex-start;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

    .digito-con-marcador {
        display: flex;
        flex-direction: column;
        align-items: center;
        font-size: 2.5rem;
        font-weight: bold;
        color: white;
        font-family: monospace;
    }

        .digito-con-marcador .marcador {
            margin-bottom: 0.3rem;
        }

    .digito.iluminado {
        background-color: rgba(255, 255, 255, 0.15);
    }




    @@media (max-width: 768px) {

    .grid-ejercicios {
        grid-template-columns: 1fr 1fr;
    }
    
    }
</style>

<script>
    const ejercicios = @Html.Raw(JsonSerializer.Serialize(Model));
    let actual = 0;
    const total = ejercicios.length;
    const direccionRespuesta = "@Model[0].DireccionRespuesta";
    let respuestasUsuario = Array(ejercicios.length).fill("");
    window.formularioEnviado = false;
    let timer;


    function renderEjercicio() {
        const ej = ejercicios[actual];
        const contenedor = document.getElementById("contenidoEjercicio");
        const miniInput = document.getElementById(`respuestaMini_${actual}`);

        // Iluminar ejercicio actual
        for (let i = 0; i < total; i++) {
            const mini = document.getElementById(`ejMini_${i}`);
            mini.classList.toggle("activo", i === actual);
        }

        // Limpiar marcadores
        const marcadores = document.getElementById("marcadores");
        marcadores.innerHTML = "";

        if (ej.FormatoPregunta === "Vertical") {
            renderMarcadoresVertical(ej.Multiplicando.length);

            const maxLen = Math.max(ej.Multiplicando.length, ej.Multiplicador.length);

            // Rellenar con ceros al inicio para igualar longitud
            const multiplicandoPadded = ej.Multiplicando.padStart(maxLen, ' ');
            const multiplicadorPadded = ej.Multiplicador.padStart(maxLen, ' ');

            // Generar HTML con misma data-col de derecha a izquierda
            const multiplicandoHTML = multiplicandoPadded.split('').map((d, i) =>
                `<span class="digito" data-col="v-${i}">${d}</span>`).join('');

            const multiplicadorHTML = multiplicadorPadded.split('').map((d, i) =>
                `<span class="digito" data-col="v-${i}">${d}</span>`).join('');



            contenedor.innerHTML = `
                <div style="display: flex; flex-direction: column; align-items: flex-end; font-size: 2.5rem;">
                    <div>
                        ${multiplicandoHTML}
                    </div>
                    <div>
                        × ${multiplicadorHTML}
                    </div>
                    <hr style="width: 100%; border: none; border-top: 2px solid white; margin: 0.5rem 0;" />
                    <input type="text" id="respuestaActual" class="input-respuesta" oninput="actualizarRespuesta()" autocomplete="off" />
                </div>
            `;
        }
        else {
            const multiplicandoLen = ej.Multiplicando.length;
            const multiplicadorLen = ej.Multiplicador.length;

            const marcadoresHTML =
                Array.from({ length: multiplicandoLen }, (_, i) => `<div class="marcador" data-col="v-${i}"></div>`).join('') +
                `<div class="separator" style="width: 2rem;"></div>` +
                Array.from({ length: multiplicadorLen }, (_, i) => `<div class="marcador" data-col="v-${multiplicandoLen + i}"></div>`).join('');

            const digitosMultiplicando = ej.Multiplicando.split('').map((d, i) =>
                `<div class="digito" data-col="v-${i}">${d}</div>`).join('');

            const digitosMultiplicador = ej.Multiplicador.split('').map((d, i) =>
                `<div class="digito" data-col="v-${multiplicandoLen + i}">${d}</div>`).join('');

            const contenidoHTML = `
                <div style="display: flex; flex-direction: column;">
                    <div style="display: flex; gap: 0.25rem; margin-bottom: 0;" id="marcadoresHorizontales">
                        ${marcadoresHTML}
                    </div>
                    <div style="display: flex; gap: 0.12rem; font-size: 2.5rem;">
                        ${digitosMultiplicando}
                        <span>×</span>
                        ${digitosMultiplicador}
                        <span>=</span>
                        <input type="text" id="respuestaActual" class="input-respuesta" oninput="actualizarRespuesta()" autocomplete="off" />
                    </div>
                </div>
            `;

            contenedor.innerHTML = contenidoHTML;


        // // Asignar eventos a cada marcador
        // const marcadoresContenedor = document.getElementById("marcadoresHorizontales");
        // Array.from(marcadoresContenedor.children).forEach(m => {
        //     m.onclick = () => m.classList.toggle("checked");
        // });

            // Asignar evento a todos los marcadores para iluminar columnas
            Array.from(document.querySelectorAll('.marcador')).forEach(m => {
                m.onclick = () => {
                    m.classList.toggle("checked");
                    const col = m.dataset.col;
                    const digitos = document.querySelectorAll(`.digito[data-col='${col}']`);
                    digitos.forEach(d => d.classList.toggle("iluminado"));
                };
            });

        }


            // Restaurar respuesta y enfocar input
            const inputActual = document.getElementById("respuestaActual");
                if (inputActual && miniInput) {
                    let valorGuardado = respuestasUsuario[actual] || "";


                    if (direccionRespuesta === "DerechaAIzquierda") {
                        // Mostrar invertido al cargar
                        inputActual.value = valorGuardado.split('').reverse().join('');
                    } else {
                        inputActual.value = valorGuardado;
                    }

                        // Mostrar visualmente invertido en mini input si es necesario
                    if (direccionRespuesta === "DerechaAIzquierda") {
                        miniInput.value = valorGuardado.split('').reverse().join('');
                    } else {
                        miniInput.value = valorGuardado;
                    }


                        if (direccionRespuesta === "DerechaAIzquierda") {
                            document.getElementById("respuestaActual").style.direction = "rtl";
                        } else {
                            document.getElementById("respuestaActual").style.direction = "ltr";
                        }


                        setTimeout(() => {
                        inputActual.focus();
                        inputActual.select();

                        inputActual.addEventListener("keydown", function (e) {
                            if (e.key === "Enter") {
                                e.preventDefault();
                                ejercicioSiguiente();
                                return;
                            }

                            // Solo aplica si la dirección es DerechaAIzquierda
                            if (direccionRespuesta !== "DerechaAIzquierda") return;

                            // Solo permitir dígitos y backspace/delete
                            if (!/^\d$/.test(e.key) && e.key !== "Backspace" && e.key !== "Delete") {
                                return;
                            }

                            e.preventDefault(); // Prevenir escritura automática

                            const valorActual = respuestasUsuario[actual] || "";

                            if (e.key === "Backspace") {
                                respuestasUsuario[actual] = valorActual.slice(0, -1);
                            } else if (e.key === "Delete") {
                                respuestasUsuario[actual] = "";
                            } else {
                                respuestasUsuario[actual] = valorActual + e.key;
                            }

                            // Mostrar el valor invertido en el input
                            const nuevoValorVisual = respuestasUsuario[actual].split('').reverse().join('');
                            inputActual.value = nuevoValorVisual;

                            // Actualizar mini input lógico
                                // Mostrar valor invertido también en mini input
                            miniInput.value = nuevoValorVisual;
    
                        });
                    }, 50);



                }


    }


    function renderMarcadoresVertical(cantidad) {
        const marcadores = document.getElementById("marcadores");
        marcadores.innerHTML = "";
        marcadores.style.flexDirection = "row";
        marcadores.style.alignItems = "center";

        // for (let i = 0; i < cantidad; i++) {
        //     const m = document.createElement("div");
        //     m.className = "marcador";
        //     m.onclick = () => m.classList.toggle("checked");
        //     marcadores.appendChild(m);
        // }

        for (let i = 0; i < cantidad; i++) {
            const m = document.createElement("div");
            m.className = "marcador";
            m.dataset.col = `v-${i}`;
            m.onclick = () => {
                m.classList.toggle("checked");
                const digitos = document.querySelectorAll(`.digito[data-col='v-${i}']`);
                digitos.forEach(d => d.classList.toggle("iluminado"));
            };
            marcadores.appendChild(m);
        }

    }


    function seleccionarEjercicio(index) {
        actual = index;
        renderEjercicio();
    }

        function actualizarRespuesta() {
        const input = document.getElementById("respuestaActual");
        let valorMostrado = input.value;

        // Convertir lo que ve a valor lógico
        let valorCrudo = direccionRespuesta === "DerechaAIzquierda"
            ? valorMostrado.split('').reverse().join('').replace(/\D/g, '')
            : valorMostrado.replace(/\D/g, '');

        // Guardar la respuesta lógica
        respuestasUsuario[actual] = valorCrudo;

        // Mostrar invertido si es necesario
        const valorVisual = direccionRespuesta === "DerechaAIzquierda"
            ? valorCrudo.split('').reverse().join('')
            : valorCrudo;

        input.value = valorVisual;

        // Mini input solo se usa para mostrar, así que va con visual
        const miniInput = document.getElementById(`respuestaMini_${actual}`);
        miniInput.value = valorVisual;
    }




    renderEjercicio();

    // Cronómetro si se activa
    let tiempo = @tiempoLimiteSeg;
    const cronometro = document.getElementById("cronometro");

    function actualizarCronometro() {
        if (tiempo <= 0) {
            tiempo = 0; // Asegura que no vaya a negativos
            clearInterval(timer);

            // Solo si aún no se envió
            if (!window.formularioEnviado) {
                window.formularioEnviado = true;
                copiarRespuestasAlFormulario();
                document.getElementById("FormFinalizar").submit();
            }
            return;
        }

        const min = Math.floor(tiempo / 60);
        const seg = Math.floor(tiempo % 60).toString().padStart(2, '0');
        cronometro.textContent = `${min}:${seg}`;
        tiempo--;
    }




    if (cronometro) {
        actualizarCronometro();
        timer = setInterval(actualizarCronometro, 1000);
    }

    function ejercicioAnterior() {
        if (actual > 0) {
            seleccionarEjercicio(actual - 1);
        }
    }

    function ejercicioSiguiente() {
        if (actual < total - 1) {
            seleccionarEjercicio(actual + 1);
        }
    }

    document.addEventListener("keydown", function (e) {
        const esInputActivo = document.activeElement.tagName === "INPUT";

        if (!esInputActivo || document.activeElement.id === "respuestaActual") {
            switch (e.key) {
                case "ArrowLeft":
                    e.preventDefault();
                    ejercicioAnterior();
                    break;
                case "ArrowRight":
                    e.preventDefault();
                    ejercicioSiguiente();
                    break;
            }
        }
    });

    function copiarRespuestasAlFormulario() {
        respuestasUsuario.forEach((resp, i) => {
            const input = document.getElementById(`hiddenRespuesta_${i}`);
            if (input) {
                input.value = resp;
                console.log(`Respuesta ${i}:`, resp);
            }
        });

        return true;
    }

    document.getElementById("FormFinalizar").addEventListener("submit", function (e) {
        copiarRespuestasAlFormulario();
    });




</script>
