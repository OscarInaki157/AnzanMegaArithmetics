            order: 1;
        }

        .tecla.enviar {
            order: 2;
        }

        .tecla {
            font-size: 2.5rem;
            padding: 1rem;
        }

    .grid-ejercicios {
        grid-template-columns: 1fr 1fr;
    }

    .alinear{
        flex-direction:column;
    }

        .ejercicio-mini {
            letter-spacing: 0.1rem;
        }
    
    }
</style>

<script>
    const ejercicios = @Html.Raw(JsonSerializer.Serialize(Model));
    let actual = 0;
    const total = ejercicios.length;
    const direccionRespuesta = "@Model[0].DireccionRespuesta";
    let respuestasUsuario = Array(ejercicios.length).fill("");
    window.formularioEnviado = false;
    let timer;

    let tiempoInicio = Date.now();
    let tiempoLimiteMs = @tiempoLimiteSeg * 1000;


    function renderEjercicio() {
        const ej = ejercicios[actual];
        const contenedor = document.getElementById("contenidoEjercicio");
        const miniInput = document.getElementById(`respuestaMini_${actual}`);

        // Iluminar ejercicio actual
        for (let i = 0; i < total; i++) {
            const mini = document.getElementById(`ejMini_${i}`);
            mini.classList.toggle("activo", i === actual);
        }

        // Limpiar marcadores
        const marcadores = document.getElementById("marcadores");
        marcadores.innerHTML = "";

        if (ej.FormatoPregunta === "Vertical") {
            renderMarcadoresVertical(ej.Multiplicando.length);

            const maxLen = Math.max(ej.Multiplicando.length, ej.Multiplicador.length);

            // Rellenar con ceros al inicio para igualar longitud
            const multiplicandoPadded = ej.Multiplicando.padStart(maxLen, ' ');
            const multiplicadorPadded = ej.Multiplicador.padStart(maxLen, ' ');

            // Generar HTML con misma data-col de derecha a izquierda
            const multiplicandoHTML = multiplicandoPadded.split('').map((d, i) =>
                `<span class="digito" data-col="v-${i}">${d}</span>`).join('');

            const multiplicadorHTML = multiplicadorPadded.split('').map((d, i) =>
                `<span class="digito" data-col="v-${i}">${d}</span>`).join('');



            contenedor.innerHTML = `
                <div style="display: flex; flex-direction: column; align-items: flex-end; font-size: 4.5rem;">
                    <div>
                        ${multiplicandoHTML}
                    </div>
                    <div>
                        × ${multiplicadorHTML}
                    </div>
                    <hr style="width: 100%; border: none; border-top: 2px solid white; margin: 0.5rem 0;" />
                    <input type="text" id="respuestaActual" class="input-respuesta" oninput="actualizarRespuesta()" autocomplete="off" />
                </div>
            `;
        }
        else {
            const multiplicandoLen = ej.Multiplicando.length;
            const multiplicadorLen = ej.Multiplicador.length;

            const marcadoresHTML =
                Array.from({ length: multiplicandoLen }, (_, i) => `<div class="marcador" data-col="v-${i}"></div>`).join('') +
                `<div class="separator" style="width: 2rem;"></div>` +
                Array.from({ length: multiplicadorLen }, (_, i) => `<div class="marcador" data-col="v-${multiplicandoLen + i}"></div>`).join('');

            const digitosMultiplicando = ej.Multiplicando.split('').map((d, i) =>
                `<div class="digito" data-col="v-${i}">${d}</div>`).join('');

            const digitosMultiplicador = ej.Multiplicador.split('').map((d, i) =>
                `<div class="digito" data-col="v-${multiplicandoLen + i}">${d}</div>`).join('');

            const contenidoHTML = `
                <div style="display: flex; flex-direction: column;">
                    <div style="display: flex; gap: 0.25rem; margin-bottom: 0;" id="marcadoresHorizontales">
                        ${marcadoresHTML}
                    </div>
                    <div style="display: flex; gap: 0.12rem; font-size: 2.5rem;">
                        ${digitosMultiplicando}
                        <span>×</span>
                        ${digitosMultiplicador}
                        <span>=</span>
                        <input type="text" id="respuestaActual" class="input-respuesta" oninput="actualizarRespuesta()" autocomplete="off" />
                    </div>
                </div>
            `;

            contenedor.innerHTML = contenidoHTML;


        // // Asignar eventos a cada marcador
        // const marcadoresContenedor = document.getElementById("marcadoresHorizontales");
        // Array.from(marcadoresContenedor.children).forEach(m => {
        //     m.onclick = () => m.classList.toggle("checked");
        // });

            // Asignar evento a todos los marcadores para iluminar columnas
            Array.from(document.querySelectorAll('.marcador')).forEach(m => {
                m.onclick = (e) => {
                    e.preventDefault();
                    m.classList.toggle("checked");
                    const col = m.dataset.col;
                    const digitos = document.querySelectorAll(`.digito[data-col='${col}']`);
                    digitos.forEach(d => d.classList.toggle("iluminado"));
                };
            });

        }


            // Restaurar respuesta y enfocar input
            const inputActual = document.getElementById("respuestaActual");
                if (inputActual && miniInput) {
                    let valorGuardado = respuestasUsuario[actual] || "";


                    inputActual.value = valorGuardado;
                    miniInput.value = valorGuardado;


                       if (direccionRespuesta === "DerechaAIzquierda") {
                            inputActual.style.direction = "rtl";
                        } else {
                            inputActual.style.direction = "ltr";
                        }


                        setTimeout(() => {
                        inputActual.focus();
                        inputActual.select();

                        inputActual.addEventListener("keydown", function (e) {
                            if (e.key === "Enter") {
                                e.preventDefault();
                                ejercicioSiguiente();
                                return;
                            }

                            // Solo aplica si la dirección es DerechaAIzquierda
                            if (direccionRespuesta !== "DerechaAIzquierda") return;

                            // Solo permitir dígitos y backspace/delete
                            if (!/^\d$/.test(e.key) && e.key !== "Backspace" && e.key !== "Delete") {
                                return;
                            }

                            e.preventDefault(); // Prevenir escritura automática

                            const valorActual = respuestasUsuario[actual] || "";

                            if (e.key === "Backspace") {
                                respuestasUsuario[actual] = valorActual.slice(0, -1);
                            } else if (e.key === "Delete") {
                                respuestasUsuario[actual] = "";
                            } else {
                                respuestasUsuario[actual] = valorActual + e.key;
                            }

                            // Mostrar el valor invertido en el input
                            const nuevoValorVisual = respuestasUsuario[actual].split('').reverse().join('');
                            inputActual.value = nuevoValorVisual;

                            // Actualizar mini input lógico
                                // Mostrar valor invertido también en mini input
                            miniInput.value = nuevoValorVisual;
    
                        });
                    }, 50);



                }


    }


    function renderMarcadoresVertical(cantidad) {
        const marcadores = document.getElementById("marcadores");
        marcadores.innerHTML = "";
        marcadores.style.flexDirection = "row";
        marcadores.style.alignItems = "center";

        // for (let i = 0; i < cantidad; i++) {
        //     const m = document.createElement("div");
        //     m.className = "marcador";
        //     m.onclick = () => m.classList.toggle("checked");
        //     marcadores.appendChild(m);
        // }

        for (let i = 0; i < cantidad; i++) {
            const m = document.createElement("div");
            m.className = "marcador";
            m.dataset.col = `v-${i}`;

            m.onclick = (e) => {
                e.preventDefault();
                m.classList.toggle("checked");
                const digitos = document.querySelectorAll(`.digito[data-col='v-${i}']`);
                digitos.forEach(d => d.classList.toggle("iluminado"));
            };
            marcadores.appendChild(m);
        }

    }


    function seleccionarEjercicio(index) {
        actual = index;
        renderEjercicio();
    }

    function actualizarRespuesta() {
            const input = document.getElementById("respuestaActual");
            const miniInput = document.getElementById(`respuestaMini_${actual}`);

            // Lo que el usuario VE en el input principal (ej: 54321 visual)
            let valorVisual = input.value;

            // Lo replicamos en el mini input visualmente
            if (miniInput) {
                miniInput.value = valorVisual;
            }

            if (direccionRespuesta === "DerechaAIzquierda") {
                respuestasUsuario[actual] = valorVisual.split('').reverse().join('');
            } else {
                respuestasUsuario[actual] = valorVisual;
            }
        }

    renderEjercicio();

    // Cronómetro si se activa
    let tiempoRestante = @tiempoLimiteSeg;
    const cronometro = document.getElementById("cronometro");

    function actualizarCronometro() {
        if (tiempoRestante <= 0) {
            tiempoRestante = 0;
            clearInterval(timer);

            // Solo si aún no se envió
            if (!window.formularioEnviado) {
                window.formularioEnviado = true;

                let tiempoUtilizadoMs = tiempoLimiteMs;
                agregarTiempoRealAlFormulario(tiempoUtilizadoMs);

                copiarRespuestasAlFormulario();
                document.getElementById("FormFinalizar").submit();
            }
            return;
        }

        if(cronometro){
            const min = Math.floor(tiempoRestante / 60);
            const seg = Math.floor(tiempoRestante % 60).toString().padStart(2, '0');
            cronometro.textContent = `${min}:${seg}`;
        }

        tiempoRestante--;
    }

        function agregarTiempoRealAlFormulario(tiempoMs) {
        let inputTiempo = document.getElementById("hiddenTiempoReal");
        if (!inputTiempo) {
            inputTiempo = document.createElement('input');
            inputTiempo.type = 'hidden';
            inputTiempo.name = 'TiempoRealMs';
            inputTiempo.id = 'hiddenTiempoReal';
            document.getElementById("FormFinalizar").appendChild(inputTiempo);
        }
        inputTiempo.value = tiempoMs;
    }

        // Cuando el usuario presiona Finalizar manualmente
    document.getElementById("FormFinalizar").addEventListener("submit", function (e) {
        // Calcular tiempo real utilizado
        let tiempoTranscurridoMs = Date.now() - tiempoInicio;

        // Si se pasó del tiempo límite, usar el tiempo límite
        if (tiempoTranscurridoMs > tiempoLimiteMs) {
            tiempoTranscurridoMs = tiempoLimiteMs;
        }

        agregarTiempoRealAlFormulario(tiempoTranscurridoMs);
        copiarRespuestasAlFormulario();
    });

    
    actualizarCronometro();
    timer = setInterval(actualizarCronometro, 1000);
    

    function ejercicioAnterior() {
        if (actual > 0) {
            seleccionarEjercicio(actual - 1);
        }
    }

    function ejercicioSiguiente() {
        if (actual < total - 1) {
            seleccionarEjercicio(actual + 1);
        }
        else{
            copiarRespuestasAlFormulario();
            document.getElementById("FormFinalizar").submit();
        }
    }

    document.addEventListener("keydown", function (e) {
        const esInputActivo = document.activeElement.tagName === "INPUT";

        if (!esInputActivo || document.activeElement.id === "respuestaActual") {
            switch (e.key) {
                case "ArrowLeft":
                    e.preventDefault();
                    ejercicioAnterior();
                    break;
                case "ArrowRight":
                    e.preventDefault();
                    ejercicioSiguiente();
                    break;
            }
        }
    });

    function copiarRespuestasAlFormulario() {
        respuestasUsuario.forEach((_, i) => {
            const inputHidden = document.getElementById(`hiddenRespuesta_${i}`);
            const miniInput = document.getElementById(`respuestaMini_${i}`);

            if (inputHidden && miniInput) {
                // Enviamos el valor visual (ej: 321) en lugar del lógico (123)
                inputHidden.value = miniInput.value;
                console.log(`Respuesta enviada ${i}:`, miniInput.value);
            }
        });
        return true;
    }

    history.pushState(null, null, location.href);
    window.onpopstate = function () {
        history.pushState(null, null, location.href);
    };

    window.addEventListener('keydown', function (e) {
        // F5 o Ctrl+R
        if ((e.key === 'F5') || (e.ctrlKey && e.key === 'r')) {
            e.preventDefault();
        }
    });

    // --- LÓGICA DEL TECLADO VIRTUAL ---
    document.querySelectorAll('.tecla').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();

            const inputActual = document.getElementById("respuestaActual");
            if (!inputActual) return;

            const teclaValor = btn.textContent.trim();
            let valorActual = respuestasUsuario[actual] || "";

            // Manejo de botones especiales
            if (btn.classList.contains('borrar')) {
                respuestasUsuario[actual] = valorActual.slice(0, -1);
            }
            else if (btn.classList.contains('enviar')) {
                ejercicioSiguiente(); // Llama a la misma función del botón "Siguiente"

                // Efecto visual rápido
                btn.classList.add('presionada');
                setTimeout(() => btn.classList.remove('presionada'), 100);
                return; // Salimos de la función para no intentar escribir el check (✅)
            }
            else if (!isNaN(teclaValor)) {
                // Es un número normal
                respuestasUsuario[actual] = valorActual + teclaValor;
            }

            // Aplicar la lógica de visualización (Normal o de Derecha a Izquierda)
            let nuevoValorVisual = respuestasUsuario[actual];
            if (direccionRespuesta === "DerechaAIzquierda") {
                nuevoValorVisual = respuestasUsuario[actual].split('').reverse().join('');
            }

            // Actualizar el input y llamar a tu función existente
            inputActual.value = nuevoValorVisual;
            actualizarRespuesta();

            // Efecto visual del botón presionado
            btn.classList.add('presionada');
            setTimeout(() => btn.classList.remove('presionada'), 100);

            // Evitar que en móvil se abra el teclado nativo, pero mantener foco en PC
            const esTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
            if (!esTouch) {
                inputActual.focus();
            }
        });
    });

</script>
