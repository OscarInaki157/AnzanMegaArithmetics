@section Scripts {
    <script>
        let tiempoInicio = Date.now();
        const velocidad = parseFloat("@velocidad".replace(',', '.'));
        const form = document.getElementById("formRespuesta");
        const inputRespuesta = document.getElementById("inputRespuesta");
        const tiempoRespuestaInput = document.getElementById("tiempoRespuesta");
        const direccionRespuesta = "@direccion";

        // --- LÓGICA DE TABS ---
                function mostrarTab(tabId) {
                    // Guardamos la selección para el próximo ejercicio
                    sessionStorage.setItem("tabSeleccionadoDivision", tabId);

                    // Remover clase active de todos los botones y contenidos
                    document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
                    document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));

                    // Activar el seleccionado (usando querySelector para encontrar el botón correcto)
                    document.querySelector(`.tab-btn[onclick*="${tabId}"]`).classList.add('active');
                    document.getElementById('tab-' + tabId).classList.add('active');

                    // Evitar teclado nativo en móvil si usa el teclado virtual
                    const esTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
                    if (tabId === 'teclado' && esTouch) {
                        inputRespuesta.setAttribute('readonly', 'readonly');
                    } else {
                        inputRespuesta.removeAttribute('readonly');
                    }

                    enfocarSinTeclado(inputRespuesta);
                }

        function enfocarSinTeclado(el) {
            if (!el) return;
            const modoOriginal = el.inputMode;
            el.inputMode = "none"; // Desactiva temporalmente el teclado
            el.focus();

            setTimeout(() => {
                el.inputMode = modoOriginal; // Restaura el modo original (decimal)
            }, 100);
        }

        window.addEventListener('load', () => {
               tiempoInicio = Date.now();

               // Cargar la última pestaña seleccionada (o 'soroban' por defecto)
               const tabGuardado = sessionStorage.getItem("tabSeleccionadoDivision") || "soroban";
               mostrarTab(tabGuardado);

               // Enfocar input
               enfocarSinTeclado(inputRespuesta);
           });

          // --- LÓGICA TECLADO VIRTUAL ---
        document.querySelectorAll('.tecla').forEach(btn => {
            btn.addEventListener('click', () => {
                if (btn.classList.contains('borrar')) {
                    inputRespuesta.value = inputRespuesta.value.slice(0, -1);
                } else if (btn.classList.contains('enter')) {
                    form.dispatchEvent(new Event('submit'));
                } else {
                    inputRespuesta.value += btn.textContent.trim();
                }

                btn.classList.add('presionada');
                setTimeout(() => btn.classList.remove('presionada'), 100);
                enfocarInput();
            });
        });

        form.addEventListener("submit", function(e) {
            e.preventDefault();

            // Calculamos tiempo
            const tiempoTotalSegundos = (Date.now() - tiempoInicio) / 1000;
            tiempoRespuestaInput.value = tiempoTotalSegundos.toFixed(2);

            // Lógica de respuesta oculta
            const valorVisual = inputRespuesta.value.trim();
            const hiddenRespuesta = document.getElementById("hiddenRespuestaUsuario");

            // Si está vacío enviamos -1, si no, enviamos lo que escribió
            hiddenRespuesta.value = (valorVisual === "") ? "-1" : valorVisual;

            // NO tocamos inputRespuesta.value, así se queda limpio o con lo que puso el usuario
            this.submit();
        });

        if (velocidad > 0) {
            let tiempo = velocidad;
            const contador = document.getElementById("contador");
            const intervalo = setInterval(() => {
                tiempo -= 0.1;
                if (tiempo <= 0) {
                    clearInterval(intervalo);
                    form.dispatchEvent(new Event('submit'));
                } else if (contador) {
                    contador.textContent = tiempo.toFixed(1);
                }
            }, 100);
        }

        function finalizarConTiempo() {
            const tiempoTotal = (Date.now() - tiempoInicio) / 1000;
            const resp = inputRespuesta.value.trim() || "-1";

            const f = document.createElement('form');
            f.method = 'POST';
            f.action = '@Url.Action("FinalizarDivision", "Division")';

            f.innerHTML = `
                <input type="hidden" name="respuestaUsuario" value="${resp}">
                <input type="hidden" name="tiempoRespuesta" value="${tiempoTotal}">
                @Html.AntiForgeryToken()
            `;
            document.body.appendChild(f);
            f.submit();
        }

        inputRespuesta.addEventListener("keypress", (e) => {
            if (e.key === "Enter") {
                e.preventDefault();
                form.dispatchEvent(new Event('submit'));
            }
        });

        if (direccionRespuesta === "DerechaAIzquierda") {
            inputRespuesta.addEventListener("beforeinput", function(e) {
                if (e.inputType === "insertText" && /^\d$/.test(e.data)) {
                    e.preventDefault();
                    const actual = this.value;
                    this.value = e.data + actual;
                }
            });
        }

        document.querySelectorAll("#sorobanSR .soroban-column").forEach(col => {
            const superior = col.querySelector(".bead.superior");
            const inferiores = col.querySelectorAll(".bead.inferior");

            superior.addEventListener("click", () => {
                superior.classList.toggle("activa");
                // CAMBIO AQUÍ:
                enfocarSinTeclado(inputRespuesta);
            });

            inferiores.forEach((bead, i) => {
                bead.addEventListener("click", () => {
                    const activar = !bead.classList.contains("activa");
                    inferiores.forEach((b, j) => {
                        if ((activar && j <= i) || (!activar && j >= i)) {
                            b.classList.toggle("activa", activar);
                        }
                    });
                    // CAMBIO AQUÍ:
                    enfocarSinTeclado(inputRespuesta);
                });
            });
        });
    </script>
}