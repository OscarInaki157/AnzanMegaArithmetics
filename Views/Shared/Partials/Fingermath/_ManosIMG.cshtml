@model int
@{
    string nombreSkin = Model switch
    {
        5 => "Manos1",
        _ => "Manos1"
    };
    string rutaBase = $"/Content/Images/Fingermath/{nombreSkin}/";
}

<div class="manos-container">
    <div class="manos-wrapper">

        <div class="palmas-wrapper">
            <img src="@Url.Content(rutaBase + "Pizq.png")" class="palma izq" />
            <img src="@Url.Content(rutaBase + "Pder.png")" class="palma der" />
        </div>

        <div class="puntos-wrapper">
            @for (int i = 1; i <= 10; i++)
            {
                int valorDedo = (i <= 4) ? 10 : (i == 5 ? 50 : (i == 6 ? 5 : 1));

                <div class="punto dedo dedo@(i)" data-valor="@valorDedo">

                    <div class="dedo-container">

                        <img src="@Url.Content(rutaBase + i + ".png")"
                             class="finger-img normal img-dedo@(i)" />

                        <img src="@Url.Content(rutaBase + i + "A.png")"
                             class="finger-img activa img-dedo@(i)" />
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>

    /* Cuando el dedo está iluminado, oculta la imagen normal */
    .punto.iluminado .finger-img.normal {
        opacity: 0;
    }

    /* Cuando el dedo está iluminado, muestra la imagen 'A' */
    .punto.iluminado .finger-img.activa {
        opacity: 1;
    }

    .manos-wrapper {
        position: relative;
        width: 43rem;
        height: 35rem;
        margin: 0 auto;
    }

    .palmas-wrapper {
