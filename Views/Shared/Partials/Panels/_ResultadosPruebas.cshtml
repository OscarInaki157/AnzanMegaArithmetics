@model List<AnzanMegaArithmetics.Models.HistorialPruebaModel>

<div class="smart-list">
    @if (Model != null && Model.Any())
    {
        <div style="color: #a0a0c0; margin-bottom: 1rem; font-size: 0.85rem;">
            <i class="fas fa-check-circle" style="color: #00ff88;"></i> Se encontraron @Model.Count registros (Limitado a 100).
        </div>

        @foreach (var prueba in Model)
        {
            string colorEfectividad = "#ff4757"; // Rojo por defecto
            if (prueba.Efectividad >= 90) { colorEfectividad = "#00ff88"; } // Verde
            else if (prueba.Efectividad >= 70) { colorEfectividad = "#ff9f43"; } // Naranja

            <div class="student-row" style="grid-template-columns: 0.5fr 2fr 1.5fr 1fr 1fr 1fr 1fr; align-items: center;">

                <div style="text-align: right;">
                    <button class="btn-mini-sec" style="background: linear-gradient(135deg, #636e72, #2d3436); box-shadow: none;" onclick="verConfiguracionPrueba(@prueba.Id_Prueba)" title="Ver Parámetros">
                        <i class="fas fa-cogs"></i>
                    </button>
                </div>

                <div style="font-size: 0.8rem; color: #a0a0c0; text-align: center;">
                    <div style="color: white;">@prueba.Fecha.ToString("dd/MMM")</div>
                    <div>@prueba.Fecha.ToString("HH:mm")</div>
                </div>

                <div class="name-info">
                    <strong>@prueba.NombreAlumno</strong>
                    <span>@prueba.GamerTag</span>
                </div>

                <div>
                    <span style="font-size: 0.85rem; color: white;">
                        <i class="fas fa-gamepad" style="color: var(--color-primary);"></i> @prueba.TipoPrueba
                    </span>
                </div>

                <div style="text-align: center;">
                    <strong style="color: white;">@prueba.Aciertos / @prueba.TotalPreguntas</strong>
                    <div style="font-size: 0.75rem; color: #a0a0c0;">Aciertos</div>
                </div>

                <div style="text-align: center;">
                    <strong style="color: @colorEfectividad;">@prueba.Efectividad%</strong>
                    <div style="font-size: 0.75rem; color: #a0a0c0;">+@prueba.XP XP</div>
                </div>

                <div style="text-align: right; color: white; font-family: monospace; font-size: 1.1rem;">
                    <i class="fas fa-stopwatch" style="color: #4c4cff;"></i>
                    @prueba.Tiempo.ToString(@"mm\:ss")
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state-radar" style="border-color: rgba(255, 71, 87, 0.3);">
            <i class="fas fa-search-minus radar-icon" style="color: #ff4757; animation: none;"></i>
            <h4>Sin resultados</h4>
            <p>El filtro no encontró ninguna prueba con estos parámetros en la base de datos.</p>
        </div>
    }
</div>

