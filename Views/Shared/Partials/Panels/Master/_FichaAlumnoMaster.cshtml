@model AnzanMegaArithmetics.Models.UsuarioBDModel

<style>
    .player-card {
        background: var(--color-card-bg, #010f36);
        color: white;
        border-radius: 1rem;
        padding: 1.5rem;
        border: 1px solid rgba(76, 76, 255, 0.3);
        position: relative;
        overflow: hidden;
    }

        /* Decoración de fondo gamificada */
        .player-card::before {
            content: '';
            position: absolute;
            top: -50px;
            right: -50px;
            width: 150px;
            height: 150px;
            background: radial-gradient(circle, rgba(76, 76, 255, 0.2) 0%, transparent 70%);
            border-radius: 50%;
        }

    .card-header-profile {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
    }

    .avatar-placeholder {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #4c4cff, #2a2a72);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        border: 3px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 0 15px rgba(76, 76, 255, 0.5);
    }

    .profile-title h3 {
        margin: 0;
        font-size: 1.5rem;
        color: white;
    }

    .profile-title p {
        margin: 0;
        color: #a0a0c0;
        font-size: 1rem;
        font-family: monospace;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        gap: 1rem;
    }

    .stat-box {
        background: rgba(255, 255, 255, 0.03);
        padding: 1rem;
        border-radius: 0.5rem;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

        .stat-box label {
            display: block;
            font-size: 0.75rem;
            color: var(--color-primary);
            text-transform: uppercase;
            margin-bottom: 0.3rem;
        }

        .stat-box .stat-value {
            font-size: 1rem;
            color: white;
            word-break: break-all;
        }

    .badge-class {
        background: rgba(76, 76, 255, 0.2);
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
        font-size: 0.8rem;
        display: inline-block;
        margin: 2px;
        border: 1px solid rgba(76, 76, 255, 0.3);
    }

    .status-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin-right: 5px;
    }

    .status-on {
        background-color: #00ff88;
        box-shadow: 0 0 8px #00ff88;
    }

    .status-off {
        background-color: #ff4757;
    }

    @@media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="player-card">
    <div class="card-header-profile">
        <div class="avatar-placeholder">
            <i class="fas fa-user-astronaut"></i>
        </div>
        <div class="profile-title">
            <h3>@Model.Nombre</h3>
            <p>@Model.Gamer_Tag | ID: #@Model.Id_Usuario.ToString("D3")</p>
            <div style="margin-top: 0.5rem;">
                <span class="status-dot @(Model.Activo ? "status-on" : "status-off")"></span>
                <span style="font-size: 0.85rem; color: #a0a0c0;">@(Model.Activo ? "Cuenta Activa" : "Cuenta Inactiva")</span>
            </div>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-box">
            <label><i class="fas fa-envelope"></i> Correo</label>
            <div class="stat-value">@Model.Correo</div>
        </div>
        <div class="stat-box">
            <label><i class="fas fa-key"></i> Contraseña</label>
            <div class="stat-value" style="font-family: monospace; color: #ff9f43;">@Model.Pass</div>
        </div>

        <div class="stat-box">
            <label><i class="fas fa-medal"></i> Rango y XP</label>
            <div class="stat-value"><strong>@Model.Rango_Actual</strong> (@Model.Exp XP)</div>
        </div>
        <div class="stat-box">
            <label><i class="fas fa-fire"></i> Racha Actual</label>
            <div class="stat-value">@Model.Racha días</div>
        </div>

        <div class="stat-box">
            <label><i class="fas fa-clock"></i> Última Conexión</label>
            <div class="stat-value" style="font-size: 0.9rem;">
                @if (Model.Ultima_Cnx != DateTime.MinValue)
                {
                    @Model.Ultima_Cnx.ToString("dd/MM/yyyy - hh:mm tt")
                }
                else
                {
                    <span style="color: #ff4757;">Nunca conectado</span>
                }
            </div>
        </div>

        <div class="stat-box">
            <label><i class="fas fa-id-card"></i> Licencia</label>
            <div class="stat-value">@Model.Licencia</div>
            @if (Model.Fecha_Vencimiento_Licencia.HasValue)
            {
                <div style="font-size: 0.75rem; color: #a0a0c0; margin-top: 0.2rem;">
                    Vence: @Model.Fecha_Vencimiento_Licencia.Value.ToString("dd/MM/yyyy")
                </div>
            }
        </div>

        <div class="stat-box">
            <label><i class="fas fa-chalkboard-teacher"></i> Clases Asignadas</label>
            <div class="stat-value">
                @if (Model.Clases.Any())
                {
                    foreach (var c in Model.Clases)
                    {
                        <span class="badge-class">@c</span>
                    }
                }
                else
                {
                    <span style="color: #a0a0c0;">Sin clases</span>
                }
            </div>
        </div>

        <div class="stat-box" style="grid-column: 1 / -1;">
            <label><i class="fas fa-id-card"></i> Estado de la Licencia</label>
            <div class="stat-value" style="display: flex; gap: 2rem; align-items: center; flex-wrap: wrap;">
                <div>
                    <strong>@Model.Licencia</strong>
                </div>

                @if (Model.Fecha_Asignacion_Licencia.HasValue)
                {
                    <div style="font-size: 0.85rem; color: #00ff88;">
                        <i class="fas fa-calendar-check"></i> Asignada: @Model.Fecha_Asignacion_Licencia.Value.ToString("dd/MM/yyyy")
                    </div>
                }

                @if (Model.Fecha_Vencimiento_Licencia.HasValue)
                {
                    <div style="font-size: 0.85rem; color: #ff9f43;">
                        <i class="fas fa-calendar-times"></i> Vence: @Model.Fecha_Vencimiento_Licencia.Value.ToString("dd/MM/yyyy")
                    </div>
                }
            </div>
        </div>

    </div>
</div>