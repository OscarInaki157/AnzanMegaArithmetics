@model AnzanMegaArithmetics.Models.MasterModels.ListadoAlumnosInstitucionViewModel

<div class="header-gestion">
    <div class="search-container">
        <i class="fas fa-search"></i>
        <input type="text" id="txtBuscarAlumnoMaster" placeholder="Buscar por nombre o GamerTag..."
               onkeyup="filtrarAlumnosMasterLocal()" />
    </div>

    <div style="display:flex; align-items:center; gap:1rem; flex-wrap:wrap;">
        <div class="selector-clase">
            <label><i class="fas fa-filter"></i> Clase:</label>
            <select id="ddlClaseMaster" onchange="filtrarPorClaseMaster(this.value, @Model.Id_Institucion)">
                @foreach (var clase in Model.ClasesDisponibles)
                {
                    if (clase == Model.ClaseActual)
                    {
                        <option value="@clase" selected>@clase</option>
                    }
                    else
                    {
                        <option value="@clase">@clase</option>
                    }
                }
            </select>
        </div>

        <button onclick="abrirCrearAlumnoMaster(@Model.Id_Institucion)"
                style="background:var(--color-primary); color:white; border:none; padding:0.7rem 1.5rem;
                       border-radius:2rem; font-weight:bold; cursor:pointer; display:flex;
                       align-items:center; gap:0.5rem; box-shadow:0 4px 10px rgba(76,76,255,0.3);">
            <i class="fas fa-user-plus"></i> Nuevo Alumno
        </button>
    </div>
</div>

<div class="stats-summary">
    <div class="stat-item">
        <i class="fas fa-users icon-total"></i>
        <div class="stat-info">
            <span class="label">Total Alumnos</span>
            <span class="value">@(Model.ListaAlumnos?.Count ?? 0)</span>
        </div>
    </div>
    <div class="stat-divider"></div>
    <div style="color:#a0a0c0; display:flex; align-items:center; gap:0.5rem;">
        <i class="fas fa-filter"></i> Clase: <strong style="color:white;">@Model.ClaseActual</strong>
    </div>
</div>

<div class="smart-list" id="listaAlumnosMaster">
    @if (Model.ListaAlumnos != null && Model.ListaAlumnos.Any())
    {
        @foreach (var alumno in Model.ListaAlumnos)
        {
            string rangoClase = "bronze";
            string rango = alumno.Rango_Actual ?? "Bronce I";
            if (rango.Contains("Materia Oscura", StringComparison.OrdinalIgnoreCase)) rangoClase = "dark-matter";
            else if (rango.Contains("Heroico", StringComparison.OrdinalIgnoreCase)) rangoClase = "heroic";
            else if (rango.Contains("Diamante", StringComparison.OrdinalIgnoreCase)) rangoClase = "diamond";
            else if (rango.Contains("Oro", StringComparison.OrdinalIgnoreCase)) rangoClase = "gold";
            else if (rango.Contains("Plata", StringComparison.OrdinalIgnoreCase)) rangoClase = "silver";

            <div class="alumno-row" data-search="@alumno.Nombre.ToLower() @alumno.Gamer_Tag.ToLower()"
                 style="@(!alumno.Activo ? "opacity:0.5;" : "")">

                <div class="id-tag">#@alumno.Id_Usuario.ToString("D3")</div>

                <div class="name-info">
                    <strong>@alumno.Nombre</strong>
                    <span>@alumno.Gamer_Tag
                        @if (!alumno.Activo)
                        {
                            <span style="color:#ff4757; margin-left:0.5rem;">
                                <i class="fas fa-ban"></i> Inactivo
                            </span>
                        }
                    </span>
                </div>

                <div>
                    <span class="rango-badge @rangoClase">
                        <i class="fas fa-medal"></i> @alumno.Rango_Actual
                    </span>
                </div>

                <div class="racha">
                    <i class="fas fa-fire" style="color:#ff9f43;"></i> @alumno.Racha
                </div>

                <div class="action-buttons">
                    <button onclick="confirmarEliminarUsuario(@alumno.Id_Usuario, '@alumno.Nombre')" title="Eliminar"
                            style="border:none; width:2.5rem; height:2.5rem; border-radius:0.5rem; cursor:pointer;
                       background:rgba(255,71,87,0.2); color:#ff4757; font-size:1rem;
                       display:inline-flex; align-items:center; justify-content:center; transition:0.3s;">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                    <button class="btn-mini-sec" onclick="abrirFichaAlumnoMaster(@alumno.Id_Usuario)" title="Ver Perfil">
                        <i class="fas fa-address-card"></i>
                    </button>
                    <button class="btn-mini" onclick="abrirEditarAlumnoMaster(@alumno.Id_Usuario)" title="Editar">
                        <i class="fas fa-user-edit"></i>
                    </button>
                    <button onclick="toggleActivoAlumno(@alumno.Id_Usuario, this)"
                            title="@(alumno.Activo ? "Desactivar" : "Activar")"
                            style="border:none; width:2.5rem; height:2.5rem; border-radius:0.5rem; cursor:pointer;
                                   background:@(alumno.Activo ? "rgba(255,71,87,0.2)" : "rgba(0,255,136,0.2)");
                                   color:@(alumno.Activo ? "#ff4757" : "#00ff88");
                                   font-size:1rem; display:inline-flex; align-items:center; justify-content:center;
                                   transition:0.3s;">
                        <i class="fas @(alumno.Activo ? "fa-ban" : "fa-check-circle")"></i>
                    </button>
                </div>
            </div>
        }
    }
    else
    {
        <div style="text-align:center; padding:3rem; color:#a0a0c0; border:1px dashed rgba(255,255,255,0.1); border-radius:1rem;">
            <i class="fas fa-users fa-3x" style="margin-bottom:1rem; opacity:0.5;"></i>
            <p>No hay alumnos en esta institución.</p>
            <button onclick="abrirCrearAlumnoMaster(@Model.Id_Institucion)"
                    style="margin-top:1rem; background:var(--color-primary); color:white; border:none;
                           padding:0.6rem 1.5rem; border-radius:2rem; cursor:pointer; font-weight:bold;">
                <i class="fas fa-user-plus"></i> Crear primer alumno
            </button>
        </div>
    }
</div>

<style>
    .selector-clase { display:flex; align-items:center; gap:0.5rem; color:#a0a0c0; }
    .selector-clase select {
        background:rgba(0,0,0,0.3); border:1px solid rgba(76,76,255,0.3);
        color:white; padding:0.5rem 1rem; border-radius:2rem; outline:none; cursor:pointer;
    }
    .selector-clase select option { background:#010f36; }
    .alumno-row {
        background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.05);
        border-radius:0.6rem; display:grid;
        grid-template-columns: 0.8fr 3fr 2fr 1fr 2fr;
        align-items:center; padding:0.7rem 1rem; transition:0.2s;
    }
    .alumno-row:hover { background:rgba(76,76,255,0.1); transform:translateX(5px); border-color:rgba(76,76,255,0.3); }
    .header-gestion { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1.5rem; }
    .search-container { position:relative; flex:1; max-width:400px; }
    .search-container input {
        width:100%; background:rgba(0,0,0,0.3); border:1px solid rgba(76,76,255,0.3);
        padding:0.6rem 1rem 0.6rem 2.5rem; border-radius:2rem; color:white; outline:none;
        transition:0.3s; font-size:1rem; box-sizing:border-box;
    }
    .search-container input:focus { border-color:var(--color-primary); }
    .search-container i { position:absolute; left:1rem; top:50%; transform:translateY(-50%); color:var(--color-primary); }
    .stats-summary { display:flex; gap:1.5rem; margin-bottom:1.5rem; padding:0.8rem 1.2rem; background:rgba(255,255,255,0.03); border-radius:0.8rem; border:1px solid rgba(255,255,255,0.05); align-items:center; }
    .stat-item { display:flex; align-items:center; gap:0.8rem; }
    .stat-item i { font-size:1.2rem; width:30px; height:30px; display:flex; align-items:center; justify-content:center; border-radius:50%; }
    .stat-info { display:flex; flex-direction:column; }
    .stat-info .label { font-size:0.85rem; color:#a0a0c0; text-transform:uppercase; font-weight:600; }
    .stat-info .value { font-size:1.5rem; font-weight:bold; color:white; line-height:1; }
    .icon-total { background:rgba(76,76,255,0.2); color:#4c4cff; }
    .stat-divider { width:1px; height:25px; background:rgba(255,255,255,0.1); }
    .smart-list { display:flex; flex-direction:column; gap:0.6rem; }
    .id-tag { font-size:1rem; color:var(--color-primary); font-family:monospace; font-weight:bold; }
    .name-info strong { display:block; color:white; font-size:1.1rem; }
    .name-info span { font-size:0.85rem; color:#a0a0c0; display:flex; align-items:center; gap:0.3rem; }
    .racha { display:flex; align-items:center; justify-content:center; gap:0.3rem; color:white; font-weight:600; }
    .action-buttons { display:flex; justify-content:flex-end; gap:0.5rem; }
    .btn-mini, .btn-mini-sec { border:none; width:2.5rem; height:2.5rem; border-radius:0.5rem; display:inline-flex; align-items:center; justify-content:center; cursor:pointer; transition:0.3s; color:white; font-size:1rem; }
    .btn-mini { background:linear-gradient(135deg,#ffa500,#ff8c00); box-shadow:0 4px 10px rgba(255,165,0,0.2); }
    .btn-mini-sec { background:linear-gradient(135deg,#4c4cff,#2a2a72); box-shadow:0 4px 10px rgba(76,76,255,0.2); }
    .btn-mini:hover, .btn-mini-sec:hover { filter:brightness(1.1); transform:translateY(-2px); }
    .rango-badge { padding:0.3rem 0.8rem; border-radius:1rem; font-size:0.8rem; font-weight:600; text-align:center; display:inline-block; border:1px solid rgba(255,255,255,0.1); }
    .rango-badge.dark-matter { background:linear-gradient(135deg,#2d1b69,#1a1033); color:#00e6ff; }
    .rango-badge.heroic { background:linear-gradient(135deg,#ff6b6b,#ee5a24); color:white; }
    .rango-badge.diamond { background:linear-gradient(135deg,#b9f2ff,#4cc9f0); color:#0066cc; }
    .rango-badge.gold { background:linear-gradient(135deg,#ffd700,#ffa500); color:#8b6508; }
    .rango-badge.silver { background:linear-gradient(135deg,#c0c0c0,#a0a0a0); color:#333; }
    .rango-badge.bronze { background:linear-gradient(135deg,#cd7f32,#a56c2c); color:#fff; }
    @@media (max-width:768px) {
        .alumno-row { grid-template-columns:1fr; text-align:center; gap:0.5rem; }
        .action-buttons { justify-content:center; }
        .header-gestion { flex-direction:column; }
        .search-container { max-width:100%; }
    }
</style>