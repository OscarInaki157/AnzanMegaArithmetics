@model AnzanMegaArithmetics.Models.MasterModels.GestionLicenciasIndividualViewModel

@{
    string ColorDias(int dias, bool vencida)
    {
        if (vencida) return "#ff4757";
        if (dias <= 30) return "#ff4757";
        if (dias <= 90) return "#ffa500";
        return "#00ff88";
    }
    string BgDias(int dias, bool vencida)
    {
        if (vencida) return "rgba(255,71,87,0.1)";
        if (dias <= 30) return "rgba(255,71,87,0.1)";
        if (dias <= 90) return "rgba(255,165,0,0.1)";
        return "rgba(0,255,136,0.07)";
    }
}


<div style="display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; margin-bottom:1.5rem;">
    <div style="background:rgba(76,76,255,0.1); border:1px solid rgba(76,76,255,0.3);
                border-radius:0.8rem; padding:1rem; text-align:center;">
        <div style="font-size:1.8rem; font-weight:700; color:white;">@Model.TotalLicencias</div>
        <div style="color:#a0a0c0; font-size:0.85rem;">Total</div>
    </div>
    <div style="background:rgba(0,255,136,0.07); border:1px solid rgba(0,255,136,0.2);
                border-radius:0.8rem; padding:1rem; text-align:center;">
        <div style="font-size:1.8rem; font-weight:700; color:#00ff88;">@Model.LicenciasLibres</div>
        <div style="color:#a0a0c0; font-size:0.85rem;">Libres</div>
    </div>
    <div style="background:rgba(255,165,0,0.08); border:1px solid rgba(255,165,0,0.3);
                border-radius:0.8rem; padding:1rem; text-align:center;">
        <div style="font-size:1.8rem; font-weight:700; color:#ffa500;">@Model.LicenciasAsignadas</div>
        <div style="color:#a0a0c0; font-size:0.85rem;">Asignadas</div>
    </div>
    <div style="background:rgba(255,71,87,0.08); border:1px solid rgba(255,71,87,0.3);
                border-radius:0.8rem; padding:1rem; text-align:center;">
        <div style="font-size:1.8rem; font-weight:700; color:#ff4757;">@Model.LicenciasVencidas</div>
        <div style="color:#a0a0c0; font-size:0.85rem;">Vencidas</div>
    </div>
</div>


<div style="display:flex; gap:0.8rem; margin-bottom:1.5rem; flex-wrap:wrap;">
    <button onclick="abrirCrearLicencia(@Model.Id_Institucion)"
            style="background:var(--color-primary); color:white; border:none; padding:0.7rem 1.2rem;
                   border-radius:0.5rem; cursor:pointer; font-weight:600;
                   display:inline-flex; align-items:center; gap:0.5rem;">
        <i class="fas fa-plus"></i> Nueva Licencia
    </button>
</div>

<div id="msgTabLicencias" style="display:none; border-radius:0.5rem; padding:0.7rem 1rem;
     margin-bottom:1rem; font-size:0.9rem;"></div>

@if (!Model.Licencias.Any())
{
    <div style="text-align:center; padding:3rem; color:#a0a0c0;">
        <i class="fas fa-key" style="font-size:3rem; margin-bottom:1rem; display:block; color:rgba(76,76,255,0.4);"></i>
        No hay licencias registradas para esta institución.
    </div>
}
else
{
    <div style="display:flex; flex-direction:column; gap:0.6rem;">
        @foreach (var lic in Model.Licencias)
        {
            string colorDias = ColorDias(lic.DiasRestantes, lic.Vencida);
            string bgDias    = BgDias(lic.DiasRestantes, lic.Vencida);

            <div style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06);
                        border-radius:0.8rem; padding:1rem 1.2rem;
                        display:grid; grid-template-columns:auto 1fr auto auto auto; gap:1rem;
                        align-items:center; transition:0.2s;"
                 onmouseover="this.style.background='rgba(76,76,255,0.07)'"
                 onmouseout="this.style.background='rgba(255,255,255,0.03)'">

              
                <div style="text-align:center; min-width:3rem;">
                    @if (lic.Vencida)
                    {
                        <span title="Vencida" style="font-size:1.4rem;">⛔</span>
                    }
                    else if (lic.Libre)
                    {
                        <span title="Libre" style="font-size:1.4rem;">🟢</span>
                    }
                    else
                    {
                        <span title="Asignada" style="font-size:1.4rem;">🔶</span>
                    }
                </div>

               
                <div>
                    <div style="color:white; font-weight:600; font-size:0.95rem;">
                        @lic.TipoLicencia
                        <span style="color:#a0a0c0; font-weight:400; font-size:0.8rem; margin-left:0.5rem;">
                            #@lic.Id
                        </span>
                    </div>
                    <div style="color:#a0a0c0; font-size:0.82rem; margin-top:0.2rem;">
                        Compra: @lic.Fecha_Compra.ToString("dd/MMM/yyyy")
                        &nbsp;·&nbsp;
                        Vence: @lic.Fecha_Vencimiento.ToString("dd/MMM/yyyy")
                    </div>
                    @if (!lic.Libre)
                    {
                        <div style="color:#8c8cff; font-size:0.82rem; margin-top:0.2rem;">
                            <i class="fas fa-user"></i> @lic.NombreUsuario
                            <span style="color:#a0a0c0;">(@lic.CorreoUsuario)</span>
                        </div>
                    }
                </div>

           
                <div style="background:@bgDias; border:1px solid @colorDias;
                            border-radius:0.5rem; padding:0.4rem 0.8rem;
                            color:@colorDias; font-weight:700; font-size:0.85rem;
                            text-align:center; white-space:nowrap;">
                    @if (lic.Vencida)
                    {
                        <span>Vencida</span>
                    }
                    else
                    {
                        <span>@lic.DiasRestantes días</span>
                    }
                </div>

              
                <button onclick="renovarLicencia(@lic.Id)"
                        title="Renovar licencia"
                        style="background:rgba(0,200,150,0.15); color:#00c896; border:1px solid rgba(0,200,150,0.3);
                               width:2.5rem; height:2.5rem; border-radius:0.5rem; cursor:pointer;
                               display:flex; align-items:center; justify-content:center; transition:0.2s;"
                        onmouseover="this.style.background='rgba(0,200,150,0.3)'"
                        onmouseout="this.style.background='rgba(0,200,150,0.15)'">
                    <i class="fas fa-sync-alt"></i>
                </button>

           
                <div style="display:flex; gap:0.4rem;">
                    @if (!lic.Libre)
                    {
                        <button onclick="desasignarLicencia(@lic.Id)"
                                title="Desasignar usuario"
                                style="background:rgba(255,165,0,0.15); color:#ffa500; border:1px solid rgba(255,165,0,0.3);
                                       width:2.5rem; height:2.5rem; border-radius:0.5rem; cursor:pointer;
                                       display:flex; align-items:center; justify-content:center; transition:0.2s;"
                                onmouseover="this.style.background='rgba(255,165,0,0.3)'"
                                onmouseout="this.style.background='rgba(255,165,0,0.15)'">
                            <i class="fas fa-user-slash"></i>
                        </button>
                    }
                    @if (lic.Libre)
                    {
                        <button onclick="eliminarLicencia(@lic.Id)"
                                title="Eliminar licencia"
                                style="background:rgba(255,71,87,0.15); color:#ff4757; border:1px solid rgba(255,71,87,0.3);
                                       width:2.5rem; height:2.5rem; border-radius:0.5rem; cursor:pointer;
                                       display:flex; align-items:center; justify-content:center; transition:0.2s;"
                                onmouseover="this.style.background='rgba(255,71,87,0.3)'"
                                onmouseout="this.style.background='rgba(255,71,87,0.15)'">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    }
                </div>
            </div>
        }
    </div>
}