@model AnzanMegaArithmetics.Models.MasterModels.MoverUsuarioModel

<div class="formulario-flash">
    <div class="form-header">
        <h2>
            <i class="fas fa-exchange-alt" style="color:#00c896; margin-right:0.5rem;"></i>
            Mover Usuario
        </h2>
    </div>

    <div style="background:rgba(0,200,150,0.08); border:1px solid rgba(0,200,150,0.3);
                border-radius:0.8rem; padding:1rem; margin-bottom:1.5rem;">
        <p style="color:white; margin:0 0 0.3rem; font-weight:600;">
            <i class="fas fa-user" style="color:#00c896;"></i> @Model.NombreUsuario
            <span style="color:#a0a0c0; font-weight:400; font-size:0.9rem; margin-left:0.5rem;">(@Model.RolUsuario)</span>
        </p>
        <p style="color:#a0a0c0; margin:0; font-size:0.9rem;">
            <i class="fas fa-building"></i> Institución actual: <strong style="color:white;">@Model.NombreInstitucionOrigen</strong>
        </p>
    </div>

    <form onsubmit="enviarMoverUsuario(event)">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id_Usuario" value="@Model.Id_Usuario" />
        <input type="hidden" name="Id_Institucion_Origen" value="@Model.Id_Institucion_Origen" />

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
            <div>
                <label class="lbl-form">
                    <i class="fas fa-building"></i> Institución destino
                </label>
                <select name="Id_Institucion_Destino" id="ddlInstitucionDestino"
                        class="input-game" required
                        onchange="cargarClasesYLicenciasDestino(this.value)">
                    <option value="">— Selecciona institución —</option>
                    @foreach (var inst in Model.InstitucionesDisponibles)
                    {
                        <option value="@inst.Id_Institucion"
                                style="@(inst.LicenciasDisponibles == 0 ? "color:#ff4757;" : "")">
                            @inst.Nombre — @inst.LicenciasDisponibles lic. disponibles
                        </option>
                    }
                </select>
            </div>

            <div>
                <label class="lbl-form">
                    <i class="fas fa-chalkboard"></i> Clase destino
                </label>
                <select name="Id_Clase_Destino" id="ddlClaseDestino" class="input-game" required>
                    <option value="">— Primero selecciona institución —</option>
                </select>
            </div>

            <div style="grid-column:1/-1; display:none;" id="divLicenciaDestino">
                <label class="lbl-form">
                    <i class="fas fa-id-card" style="color:#00c896;"></i>
                    Licencia a asignar en destino
                </label>
                <select name="Id_Licencia_Individual" id="ddlLicenciaDestino"
                        class="input-game" required>
                    <option value="0">— Selecciona institución primero —</option>
                </select>
                <div id="msgSinLicencias" style="display:none; margin-top:0.5rem; color:#ff4757;
                     background:rgba(255,71,87,0.1); border:1px solid rgba(255,71,87,0.3);
                     border-radius:0.5rem; padding:0.5rem 1rem; font-size:0.85rem;">
                    <i class="fas fa-exclamation-triangle"></i>
                    Esta institución no tiene licencias disponibles.
                </div>
            </div>
        </div>

        <div id="msgErrorMoverUsuario" style="display:none; color:#ff4757; background:rgba(255,71,87,0.1);
             border:1px solid rgba(255,71,87,0.3); border-radius:0.5rem; padding:0.7rem 1rem;
             margin-top:1rem; font-size:0.9rem;"></div>

        <div style="display:flex; gap:0.8rem; justify-content:flex-end; margin-top:1.5rem;">
            <button type="button" onclick="cerrarModalSede()"
                    style="background:rgba(255,255,255,0.05); color:white; border:1px solid rgba(255,255,255,0.1);
                           padding:0.7rem 1.5rem; border-radius:0.5rem; cursor:pointer; font-weight:600;">
                Cancelar
            </button>
            <button type="submit" id="btnMoverUsuario"
                    style="background:linear-gradient(135deg,#00c896,#00a876); color:white; border:none;
                           padding:0.7rem 1.5rem; border-radius:0.5rem; cursor:pointer; font-weight:600;
                           display:inline-flex; align-items:center; gap:0.5rem;">
                <i class="fas fa-exchange-alt"></i> Mover Usuario
            </button>
        </div>
    </form>
</div>

<style>
    .lbl-form {
        display: block;
        color: #a0a0c0;
        font-size: 0.8rem;
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 0.4rem;
    }

    .input-game {
        width: 100%;
        background: rgba(0,0,0,0.3);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 0.5rem;
        padding: 0.6rem 0.8rem;
        color: white;
        outline: none;
        transition: 0.3s;
        box-sizing: border-box;
        font-size: 0.95rem;
    }

        .input-game:focus {
            border-color: #00c896;
        }

        .input-game option {
            background: #010f36;
        }

    .formulario-flash {
        background: #010f36;
        border-radius: 1rem;
        padding: 1.5rem;
    }

    .form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

        .form-header h2 {
            margin: 0;
            font-size: 1.5rem;
            color: white;
            font-weight: 600;
        }
</style>