@model AnzanMegaArithmetics.Models.MasterModels.ListadoProfesoresInstitucionViewModel

<div class="header-gestion">
    <div class="search-container">
        <i class="fas fa-search"></i>
        <input type="text" id="txtBuscarProfe" placeholder="Buscar por nombre o GamerTag..."
               onkeyup="filtrarProfesLocal()" />
    </div>
    <button onclick="abrirCrearProfesorMaster(@Model.Id_Institucion)"
            style="background:var(--color-primary); color:white; border:none; padding:0.7rem 1.5rem;
                   border-radius:2rem; font-weight:bold; cursor:pointer; display:flex;
                   align-items:center; gap:0.5rem; box-shadow:0 4px 10px rgba(76,76,255,0.3);">
        <i class="fas fa-user-plus"></i> Nuevo Profesor
    </button>
</div>

<div class="stats-summary">
    <div class="stat-item">
        <i class="fas fa-user-tie icon-total"></i>
        <div class="stat-info">
            <span class="label">Total Profesores</span>
            <span class="value">@(Model.ListaProfesores?.Count ?? 0)</span>
        </div>
    </div>
</div>

<div class="smart-list" id="listaProfesores">
    @if (Model.ListaProfesores != null && Model.ListaProfesores.Any())
    {
        @foreach (var profe in Model.ListaProfesores)
        {
            <div class="profe-row" data-search="@profe.Nombre.ToLower() @profe.Gamer_Tag.ToLower()"
                 style="@(!profe.Activo ? "opacity:0.5;" : "")">

                <div class="id-tag">#@profe.Id_Usuario.ToString("D3")</div>

                <div class="name-info">
                    <strong>@profe.Nombre</strong>
                    <span>
                        @profe.Gamer_Tag
                        @if (!profe.Activo)
                        {
                            <span style="color:#ff4757; margin-left:0.5rem;">
                                <i class="fas fa-ban"></i> Inactivo
                            </span>
                        }
                    </span>
                </div>

                <div style="display:flex; flex-wrap:wrap; gap:0.3rem;">
                    @if (profe.Clases.Any())
                    {
                        @foreach (var clase in profe.Clases)
                        {
                            <span style="background:rgba(76,76,255,0.15); color:#8c8cff;
                                                         border:1px solid rgba(76,76,255,0.3); border-radius:1rem;
                                                         padding:0.2rem 0.6rem; font-size:0.78rem; font-weight:600;">
                                <i class="fas fa-chalkboard"></i> @clase
                            </span>
                        }
                    }
                    else
                    {
                        <span style="color:#a0a0c0; font-size:0.85rem;">Sin clases</span>
                    }
                </div>

                <div class="action-buttons">
                    <button class="btn-mini-sec" onclick="abrirFichaProfesorMaster(@profe.Id_Usuario)" title="Ver Perfil">
                        <i class="fas fa-address-card"></i>
                    </button>
                    <button class="btn-mini" onclick="abrirEditarProfesorMaster(@profe.Id_Usuario)" title="Editar">
                        <i class="fas fa-user-edit"></i>
                    </button>
                    <button onclick="toggleActivoProfesor(@profe.Id_Usuario, this)"
                            title="@(profe.Activo ? "Desactivar" : "Activar")"
                            style="border:none; width:2.5rem; height:2.5rem; border-radius:0.5rem; cursor:pointer;
                                           background:@(profe.Activo ? "rgba(255,71,87,0.2)" : "rgba(0,255,136,0.2)");
                                           color:@(profe.Activo ? "#ff4757" : "#00ff88");
                                           font-size:1rem; display:inline-flex; align-items:center; justify-content:center;">
                        <i class="fas @(profe.Activo ? "fa-ban" : "fa-check-circle")"></i>
                    </button>
                </div>
            </div>
        }
    }
    else
    {
        <div style="text-align:center; padding:3rem; color:#a0a0c0;
                        border:1px dashed rgba(255,255,255,0.1); border-radius:1rem;">
            <i class="fas fa-user-tie fa-3x" style="margin-bottom:1rem; opacity:0.5;"></i>
            <p>No hay profesores en esta institución.</p>
            <button onclick="abrirCrearProfesorMaster(@Model.Id_Institucion)"
                    style="margin-top:1rem; background:var(--color-primary); color:white; border:none;
                               padding:0.6rem 1.5rem; border-radius:2rem; cursor:pointer; font-weight:bold;">
                <i class="fas fa-user-plus"></i> Agregar primer profesor
            </button>
        </div>
    }
</div>

<style>
    .profe-row {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 0.6rem;
        display: grid;
        grid-template-columns: 0.8fr 2.5fr 3fr 2fr;
        align-items: center;
        padding: 0.7rem 1rem;
        transition: 0.2s;
    }

        .profe-row:hover {
            background: rgba(76,76,255,0.1);
            transform: translateX(5px);
            border-color: rgba(76,76,255,0.3);
        }

    .header-gestion {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .search-container {
        position: relative;
        flex: 1;
        max-width: 400px;
    }

        .search-container input {
            width: 100%;
            background: rgba(0,0,0,0.3);
            border: 1px solid rgba(76,76,255,0.3);
            padding: 0.6rem 1rem 0.6rem 2.5rem;
            border-radius: 2rem;
            color: white;
            outline: none;
            transition: 0.3s;
            font-size: 1rem;
            box-sizing: border-box;
        }

            .search-container input:focus {
                border-color: var(--color-primary);
            }

        .search-container i {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--color-primary);
        }

    .stats-summary {
        display: flex;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
        padding: 0.8rem 1.2rem;
        background: rgba(255,255,255,0.03);
        border-radius: 0.8rem;
        border: 1px solid rgba(255,255,255,0.05);
        align-items: center;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

        .stat-item i {
            font-size: 1.2rem;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

    .stat-info {
        display: flex;
        flex-direction: column;
    }

        .stat-info .label {
            font-size: 0.85rem;
            color: #a0a0c0;
            text-transform: uppercase;
            font-weight: 600;
        }

        .stat-info .value {
            font-size: 1.5rem;
            font-weight: bold;
            color: white;
            line-height: 1;
        }

    .icon-total {
        background: rgba(76,76,255,0.2);
        color: #4c4cff;
    }

    .smart-list {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .id-tag {
        font-size: 1rem;
        color: var(--color-primary);
        font-family: monospace;
        font-weight: bold;
    }

    .name-info strong {
        display: block;
        color: white;
        font-size: 1.1rem;
    }

    .name-info span {
        font-size: 0.85rem;
        color: #a0a0c0;
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    .action-buttons {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
    }

    .btn-mini, .btn-mini-sec {
        border: none;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.5rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.3s;
        color: white;
        font-size: 1rem;
    }

    .btn-mini {
        background: linear-gradient(135deg,#ffa500,#ff8c00);
    }

    .btn-mini-sec {
        background: linear-gradient(135deg,#4c4cff,#2a2a72);
    }

        .btn-mini:hover, .btn-mini-sec:hover {
            filter: brightness(1.1);
            transform: translateY(-2px);
        }

    @@media (max-width:768px) {
        .profe-row {
            grid-template-columns: 1fr;
            text-align: center;
            gap: 0.5rem;
        }

        .action-buttons {
            justify-content: center;
        }
    }
</style>
