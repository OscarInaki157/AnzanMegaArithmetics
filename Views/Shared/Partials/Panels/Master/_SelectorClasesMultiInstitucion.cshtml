@{
    var clases = (List<AnzanMegaArithmetics.Models.MasterModels.ClaseSedeModel>)ViewData["Clases"];
    var idsActuales = (ViewData["IdsActuales"] as List<int>) ?? new List<int>();
    string nombreInput = (string)ViewData["NombreInput"];

    var porInstitucion = clases
        .GroupBy(c => new { c.Id_Institucion, c.NombreInstitucion })
        .OrderBy(g => g.Key.NombreInstitucion)
        .ToList();

    string uid = Guid.NewGuid().ToString("N").Substring(0, 8);
}

<style>
    @foreach (var g in porInstitucion)
    {
        <text>
        #radio-@(uid)-@g.Key.Id_Institucion:checked ~ .clases-wrapper-@uid .grupo-@(uid)-@g.Key.Id_Institucion {
            display: flex !important;
        }
        </text>
    }
</style>

<div style="grid-column:1/-1;">
    <label class="lbl-form">
        <i class="fas fa-chalkboard"></i> Clases asignadas
    </label>

    @foreach (var g in porInstitucion)
    {
        <input type="radio" name="instRadio-@uid" id="radio-@(uid)-@g.Key.Id_Institucion"
               value="@g.Key.Id_Institucion" style="display:none;" />
    }


    <div style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-bottom:0.6rem;">
        @foreach (var g in porInstitucion)
        {
            <label for="radio-@(uid)-@g.Key.Id_Institucion"
                   style="cursor:pointer; background:rgba(76,76,255,0.08);
                          border:1px solid rgba(76,76,255,0.2); border-radius:0.5rem;
                          padding:0.4rem 0.9rem; color:#a0a0c0; font-size:0.85rem;
                          transition:0.15s; user-select:none;">
                🏫 @g.Key.NombreInstitucion
            </label>
        }
    </div>

    <div class="clases-wrapper-@uid">
        @foreach (var g in porInstitucion)
        {
            <div class="grupo-@(uid)-@g.Key.Id_Institucion"
                 style="display:none; flex-wrap:wrap; gap:0.5rem; margin-bottom:0.5rem;">
                @foreach (var c in g)
                {
                    bool estaChecked = idsActuales.Contains(c.Id_Clase);
                    <label style="display:flex; align-items:center; gap:0.4rem; cursor:pointer;
                                  background:@(estaChecked ? "rgba(76,76,255,0.25)" : "rgba(76,76,255,0.08)");
                                  border:1px solid @(estaChecked ? "rgba(76,76,255,0.5)" : "rgba(76,76,255,0.2)");
                                  border-radius:0.5rem; padding:0.35rem 0.7rem;">
                        <input type="checkbox" name="@nombreInput" value="@c.Id_Clase"
                               @(estaChecked ? "checked" : "")
                               style="accent-color:var(--color-primary);" />
                        <span style="color:white; font-size:0.88rem;">@c.Nombre</span>
                    </label>
                }
            </div>
        }
    </div>


    <div style="margin-top:0.5rem; font-size:0.8rem; color:#a0a0c0;">
        @{
            var seleccionadasRender = clases.Where(c => idsActuales.Contains(c.Id_Clase)).ToList();
        }
        @if (seleccionadasRender.Any())
        {
            <span style="color:#00ff88;"><i class="fas fa-check-circle"></i> Seleccionadas: </span>
            @string.Join(", ", seleccionadasRender.Select(c => c.NombreInstitucion + "/" + c.Nombre))
        }
        else
        {
            <span>Sin clases seleccionadas</span>
        }
    </div>
</div>