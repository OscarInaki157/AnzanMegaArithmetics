@model AnzanMegaArithmetics.Models.MasterModels.EditarInstitucionModel

<div class="player-card edit-theme">
    <div class="card-header-profile">
        <div class="avatar-placeholder avatar-edit">
            <i class="fas fa-edit"></i>
        </div>
        <div class="profile-title">
            <h3>Editar Institución</h3>
            <p>ID: #@Model.Id_Institucion.ToString("D3")</p>
        </div>
    </div>

    <div id="msgErrorEdicion" class="msg-error" style="display:none;"></div>

    <form id="formEditarInst" onsubmit="enviarEdicionInstitucion(event)">
        <input type="hidden" name="Id_Institucion" value="@Model.Id_Institucion" />
        <input type="hidden" name="NombreActual" value="@Model.NombreActual" />

        <div class="stats-grid" style="grid-template-columns: 1fr;">
            <div class="stat-box edit-box">
                <label>Nombre de la Institución</label>
                <input type="text" name="NuevoNombre" id="inputNuevoNombre" value="@Model.NuevoNombre"
                       class="input-game input-edit"
                       required maxlength="150" minlength="3" autocomplete="off" />
                <small style="display: block; text-align: center; color: #a0a0c0; margin-top: 0.5rem; font-size: 0.8rem;">
                    Mínimo 3 caracteres. No puede duplicar nombres existentes.
                </small>
            </div>
        </div>

        <div class="action-footer">
            <button type="button" class="btn-mini-sec" onclick="cerrarModalMaster()">
                Cancelar
            </button>
            <button type="submit" id="btnGuardarEdicion" class="btn-mini btn-edit">
                <i class="fas fa-save"></i> Guardar Cambios
            </button>
        </div>
    </form>
</div>

<style>
    /* Tema General de la Card (Naranja) */
    .player-card.edit-theme {
        background: var(--color-card-bg, #010f36);
        color: white;
        border-radius: 1rem;
        padding: 1.5rem;
        border: 1px solid #ffa500;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    }

        .player-card.edit-theme::before {
            content: '';
            position: absolute;
            top: -50px;
            right: -50px;
            width: 150px;
            height: 150px;
            background: radial-gradient(circle, rgba(255, 165, 0, 0.15) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

    /* Cabecera */
    .card-header-profile {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
    }

    .avatar-edit {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        background: linear-gradient(135deg, #ffa500, #ff8c00);
        border: 2px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 0 15px rgba(255, 165, 0, 0.4);
    }

    .profile-title h3 {
        margin: 0;
        font-size: 1.3rem;
        color: white;
    }

    .profile-title p {
        margin: 0;
        color: #a0a0c0;
        font-size: 0.85rem;
    }

    /* Caja de Input (Destacada en Naranja) */
    .edit-box {
        background: rgba(255, 165, 0, 0.05) !important;
        border: 1px solid rgba(255, 165, 0, 0.3) !important;
        padding: 1.5rem;
        border-radius: 0.8rem;
    }

        .edit-box label {
            color: #ffa500 !important;
            display: block;
            text-align: center;
            font-size: 0.9rem;
            text-transform: uppercase;
            font-weight: bold;
            letter-spacing: 1px;
            margin-bottom: 0.8rem;
        }

    /* Input Style */
    .input-edit {
        width: 100%;
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.5rem;
        padding: 0.8rem;
        color: white;
        outline: none;
        transition: 0.3s;
        font-size: 1.3rem !important;
        text-align: center;
        font-weight: bold;
        box-sizing: border-box;
    }

        .input-edit:focus {
            border-color: #ffa500;
            background: rgba(255, 165, 0, 0.05);
            box-shadow: 0 0 12px rgba(255, 165, 0, 0.3);
        }

    /* Mensaje de Error */
    .msg-error {
        color: #ff4757;
        background: rgba(255, 71, 87, 0.1);
        padding: 10px;
        border-radius: 5px;
        margin-bottom: 15px;
        border: 1px solid #ff4757;
        font-size: 0.9rem;
        text-align: center;
        animation: fadeIn 0.3s ease;
    }

    /* Botones */
    .action-footer {
        margin-top: 1.5rem;
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
    }

    .btn-edit {
        background: linear-gradient(135deg, #ffa500, #ff8c00) !important;
        color: white;
        border: none;
        padding: 0.7rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: 0 4px 10px rgba(255, 165, 0, 0.3);
    }

        .btn-edit:hover {
            transform: translateY(-2px);
            filter: brightness(1.1);
            box-shadow: 0 6px 15px rgba(255, 165, 0, 0.5);
        }

        .btn-edit:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
        }

    .btn-mini-sec {
        background: rgba(255, 255, 255, 0.05);
        color: #a0a0c0;
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 0.7rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
    }

        .btn-mini-sec:hover {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            border-color: rgba(255, 255, 255, 0.2);
        }
</style>
