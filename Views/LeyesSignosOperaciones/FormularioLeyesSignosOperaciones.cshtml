@model AnzanMegaArithmetics.Models.MatematicasModels.LeyesSignosOperaciones.ConfLeyesSignosOperacionesViewModel
@using AnzanMegaArithmetics.Models.MatematicasModels.LeyesSignosOperaciones
@{
    ViewData["Title"] = "Leyes de los signos — Configuración";
    Layout = "~/Views/Shared/MatematicasV/_LayoutDashboardMates.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="/Content/css/Matematicas/formulario-leyes-signos-operaciones.css" />
    <link rel="stylesheet" href="/Content/css/Matematicas/formulario-negativos-positivos.css" />
}

<header class="dash-topbar">
    <a class="btn-regresar" href="@Url.Action("DashboardMatematicas", "DashboardMatematicas")">
        <span class="btn-regresar__icon">←</span> Volver al mapa
    </a>
    <div class="dash-topbar__greeting">Configura tu práctica de <strong>Leyes de los signos</strong></div>
</header>

<div class="dash-content">
    <div class="config-card">

        <div class="config-card__header">
            <span class="config-card__icon">×÷</span>
            <div>
                <h1 class="config-card__title">Leyes de los signos</h1>
                <p class="config-card__sub">Configura los parámetros de la sesión</p>
            </div>
        </div>

        <form id="formLeyes" method="post"
              asp-controller="LeyesSignosOperaciones" asp-action="Iniciar" novalidate>

            <div class="leyes-form-grid">

                @* ── Columna 1 ── *@
                <div class="leyes-col">

                    <div class="config-group">
                        <label class="form-label">Cantidad de ejercicios</label>
                        <div class="stepper">
                            <button type="button" class="stepper__btn" data-target="CantidadEjercicios" data-dir="-1">−</button>
                            <input class="stepper__val" asp-for="CantidadEjercicios" type="number" min="1" max="100" />
                            <button type="button" class="stepper__btn" data-target="CantidadEjercicios" data-dir="1">+</button>
                        </div>
                    </div>

                    <div class="config-group" id="grupoCantOperandos">
                        <label class="form-label">Cantidad de operandos</label>
                        <div class="stepper">
                            <button type="button" class="stepper__btn" data-target="CantidadOperandos" data-dir="-1">−</button>
                            <input class="stepper__val" asp-for="CantidadOperandos" type="number" min="2" max="10" />
                            <button type="button" class="stepper__btn" data-target="CantidadOperandos" data-dir="1">+</button>
                        </div>
                        <p class="config-hint" id="hintOperandos">
                            Con 3 → <strong>−4x + 8x − 2x =</strong>
                        </p>
                        <p class="config-hint" id="hintRaizExp" style="display:none;">
                            Raíz y Exponente siempre usan <strong>1 operando</strong>.
                        </p>
                    </div>

                    <div class="config-group" id="grupoDigitos">
                        <label class="form-label">Dígitos por número</label>
                        <div class="digits-range">
                            <div class="digits-range__item">
                                <span class="digits-range__label">Mín.</span>
                                <div class="stepper stepper--sm">
                                    <button type="button" class="stepper__btn" data-target="MinDigitos" data-dir="-1">−</button>
                                    <input class="stepper__val" asp-for="MinDigitos" type="number" min="1" max="3" />
                                    <button type="button" class="stepper__btn" data-target="MinDigitos" data-dir="1">+</button>
                                </div>
                            </div>
                            <span class="digits-range__sep">→</span>
                            <div class="digits-range__item">
                                <span class="digits-range__label">Máx.</span>
                                <div class="stepper stepper--sm">
                                    <button type="button" class="stepper__btn" data-target="MaxDigitos" data-dir="-1">−</button>
                                    <input class="stepper__val" asp-for="MaxDigitos" type="number" min="1" max="3" />
                                    <button type="button" class="stepper__btn" data-target="MaxDigitos" data-dir="1">+</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="config-group">
                        <label class="form-label">Velocidad por ejercicio</label>
                        <div class="speed-pills" id="speedPills">
                            @foreach (var v in new[] { "0", "5", "10", "15", "20", "30", "45", "60" })
                            {
                                <button type="button"
                                        class="speed-pill @(Model.VelocidadEjercicio == v ? "speed-pill--active" : "")"
                                        data-val="@v">
                                    @(v == "0" ? "Libre" : v + "s")
                                </button>
                            }
                        </div>
                        <input type="hidden" name="VelocidadEjercicio" id="hdVelocidad" value="@Model.VelocidadEjercicio" />
                    </div>

                    @* ── Operaciones permitidas (punto 9) ── *@
                    <div class="config-group">
                        <label class="form-label">Operaciones permitidas</label>
                        <div class="op-checks">
                            <label class="op-check op-check--sr" id="lblSumaResta">
                                <span class="op-check__box">±</span>
                                <span class="op-check__lbl">Suma y Resta</span>
                            </label>
                            <label class="op-check op-check--mult" id="lblMult">
                                <span class="op-check__box">×</span>
                                <span class="op-check__lbl">Multiplicación</span>
                            </label>
                            <label class="op-check op-check--div" id="lblDiv">
                                <span class="op-check__box">÷</span>
                                <span class="op-check__lbl">División</span>
                            </label>
                        </div>
                        @* Hiddens que el JS actualiza al hacer click *@
                        <input type="hidden" name="OpSumaResta" id="hdOpSR" value="@(Model.OpSumaResta ? "true" : "false")" />
                        <input type="hidden" name="OpMultiplicacion" id="hdOpMult" value="@(Model.OpMultiplicacion ? "true" : "false")" />
                        <input type="hidden" name="OpDivision" id="hdOpDiv" value="@(Model.OpDivision ? "true" : "false")" />
                        <p class="config-hint">Selecciona las operaciones que pueden aparecer.</p>
                    </div>

                </div>

                @* ── Columna 2: Tipos (checkboxes múltiples — punto 10) ── *@
                <div class="leyes-col">
                    <div class="config-group">
                        <label class="form-label">Tipo de ejercicio</label>
                        <p class="config-hint" style="margin-bottom:0.5rem;">
                            Selecciona uno o varios. Con varios se mezclan aleatoriamente.
                        </p>
                        <div class="tipo-cards" id="tipoCards">

                            @{
                                var tiposUI = new[]
                                {
                                                        ((int)TipoEjercicioLeyes.PuroSigno,  "±",   "#f3e8ff", "#7c3aed", "Puro signo",      "(+) × (−) = ?"),
                                                        ((int)TipoEjercicioLeyes.Literales,  "ax",  "#eeefff", "#4338ca", "Literales",       "3x − 5x = ?"),
                                                        ((int)TipoEjercicioLeyes.Reales,     "1.5", "#f0fdf4", "#15803d", "Reales",          "(−1.5) × (+2) = ?"),
                                                        ((int)TipoEjercicioLeyes.Parentesis, "()",  "#fff7ed", "#c2410c", "Paréntesis",      "(2+3) × (−4) = ?"),
                                                        ((int)TipoEjercicioLeyes.Corchetes,  "{[]}", "#fef3c7","#92400e", "Corchetes",       "{[(2+3)×4]−5} = ?"),
                                                        ((int)TipoEjercicioLeyes.Exponente,  "x²",  "#fef9c3", "#b45309", "Exponente",       "(−2)³ = ?"),
                                                        ((int)TipoEjercicioLeyes.Raiz,       "√",   "#ecfdf5", "#065f46", "Raíz cuadrada",   "√(16) = ?"),
                                                        };
                            }

                            @foreach (var (val, icono, bg, color, nombre, desc) in tiposUI)
                            {
                                bool seleccionado = Model.TiposSeleccionados != null
                                && Model.TiposSeleccionados.Contains(val);
                                <label class="tipo-card @(seleccionado ? "tipo-card--active" : "")">
                                    <input type="checkbox" name="TiposSeleccionados" value="@val"
                                           @(seleccionado ? "checked" : "") />
                                    <div class="tipo-card__icon" style="background:@bg;color:@color;">@icono</div>
                                    <div class="tipo-card__info">
                                        <span class="tipo-card__nombre">@nombre</span>
                                        <span class="tipo-card__desc">@desc</span>
                                    </div>
                                </label>
                            }

                        </div>
                        <p class="config-hint" id="hintMultiTipo" style="display:none; color:#be185d; margin-top:0.4rem;">
                            🎲 Varios tipos seleccionados → se mezclan aleatoriamente
                        </p>
                    </div>
                </div>

            </div>

            <div class="config-card__footer">
                <button type="submit" class="btn btn--primary config-card__submit">
                    Iniciar práctica ×÷
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script src="/Content/js/Matematicas/formulario-leyes-signos-operaciones.js"></script>
}
