@model AnzanMegaArithmetics.Models.MatematicasModels.LeyesSignosOperaciones.ConfLeyesSignosOperacionesViewModel
@using AnzanMegaArithmetics.Models.MatematicasModels.LeyesSignosOperaciones
@{
    ViewData["Title"] = "Leyes de los signos — Configuración";
    Layout = "~/Views/Shared/MatematicasV/_LayoutDashboardMates.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="/Content/css/Matematicas/formulario-leyes-signos-operaciones.css" />
    <link rel="stylesheet" href="/Content/css/Matematicas/formulario-negativos-positivos.css" />
}

<header class="dash-topbar">
    <a class="btn-regresar" href="@Url.Action("DashboardMatematicas", "DashboardMatematicas")">
        <span class="btn-regresar__icon">←</span> Volver al mapa
    </a>
    <div class="dash-topbar__greeting">
        Configura tu práctica de <strong>Leyes de los signos</strong>
    </div>
</header>

<div class="dash-content">
    <div class="config-card">

        <div class="config-card__header">
            <span class="config-card__icon">×÷</span>
            <div>
                <h1 class="config-card__title">Leyes de los signos</h1>
                <p class="config-card__sub">Configura los parámetros de la sesión</p>
            </div>
        </div>

        <form id="formLeyes" method="post"
              asp-controller="LeyesSignosOperaciones" asp-action="Iniciar" novalidate>

            <div class="leyes-form-grid">

                @* ── Columna 1 ── *@
                <div class="leyes-col">

                    <div class="config-group">
                        <label class="form-label" asp-for="CantidadEjercicios">Cantidad de ejercicios</label>
                        <div class="stepper">
                            <button type="button" class="stepper__btn" data-target="CantidadEjercicios" data-dir="-1">−</button>
                            <input class="stepper__val form-input" asp-for="CantidadEjercicios" type="number" min="1" max="100" />
                            <button type="button" class="stepper__btn" data-target="CantidadEjercicios" data-dir="1">+</button>
                        </div>
                    </div>

                    <div class="config-group" id="grupoCantOperandos">
                        <label class="form-label" asp-for="CantidadOperandos">Cantidad de operandos</label>
                        <div class="stepper">
                            <button type="button" class="stepper__btn" data-target="CantidadOperandos" data-dir="-1">−</button>
                            <input class="stepper__val form-input" asp-for="CantidadOperandos" type="number" min="2" max="10" />
                            <button type="button" class="stepper__btn" data-target="CantidadOperandos" data-dir="1">+</button>
                        </div>
                        <p class="config-hint" id="hintOperandos">
                            Mínimo 2, máximo 10. Ej: con 3 → <strong>(+3x) − (−5x) + (+2x)</strong>
                        </p>
                        <p class="config-hint" id="hintRaiz" style="display:none;">
                            La raíz cuadrada siempre usa <strong>1 operando</strong>.
                        </p>
                        <p class="config-hint" id="hintExponente" style="display:none;">
                            El exponente siempre usa <strong>1 operando</strong> (la base).
                        </p>
                    </div>

                    <div class="config-group" id="grupoDigitos">
                        <label class="form-label">Dígitos por número</label>
                        <div class="digits-range">
                            <div class="digits-range__item">
                                <span class="digits-range__label">Mín.</span>
                                <div class="stepper stepper--sm">
                                    <button type="button" class="stepper__btn" data-target="MinDigitos" data-dir="-1">−</button>
                                    <input class="stepper__val form-input" asp-for="MinDigitos" type="number" min="1" max="3" />
                                    <button type="button" class="stepper__btn" data-target="MinDigitos" data-dir="1">+</button>
                                </div>
                            </div>
                            <span class="digits-range__sep">→</span>
                            <div class="digits-range__item">
                                <span class="digits-range__label">Máx.</span>
                                <div class="stepper stepper--sm">
                                    <button type="button" class="stepper__btn" data-target="MaxDigitos" data-dir="-1">−</button>
                                    <input class="stepper__val form-input" asp-for="MaxDigitos" type="number" min="1" max="3" />
                                    <button type="button" class="stepper__btn" data-target="MaxDigitos" data-dir="1">+</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="config-group">
                        <label class="form-label">Velocidad por ejercicio</label>
                        <div class="speed-pills" id="speedPills">
                            @foreach (var v in new[] { "0", "5", "10", "15", "20", "30", "45", "60" })
                            {
                                var label = v == "0" ? "Libre" : v + "s";
                                <button type="button"
                                        class="speed-pill @(Model.VelocidadEjercicio == v ? "speed-pill--active" : "")"
                                        data-val="@v">
                                    @label
                                </button>
                            }
                        </div>
                        <input type="hidden" name="VelocidadEjercicio" id="hdVelocidad" value="@Model.VelocidadEjercicio" />
                    </div>

                </div>

                @* ── Columna 2: Tipo de ejercicio ── *@
                <div class="leyes-col">
                    <div class="config-group">
                        <label class="form-label">Tipo de ejercicio</label>
                        <div class="tipo-cards" id="tipoCards">

                            <label class="tipo-card @(Model.TipoEjercicio == TipoEjercicioLeyes.PuroSigno ? "tipo-card--active" : "")">
                                <input type="radio" asp-for="TipoEjercicio" value="@((int)TipoEjercicioLeyes.PuroSigno)" />
                                <div class="tipo-card__icon" style="background:#f3e8ff;color:#7c3aed;">±</div>
                                <div class="tipo-card__info">
                                    <span class="tipo-card__nombre">Puro signo</span>
                                    <span class="tipo-card__desc">(+) × (−) = ?</span>
                                </div>
                            </label>

                            <label class="tipo-card @(Model.TipoEjercicio == TipoEjercicioLeyes.Literales ? "tipo-card--active" : "")">
                                <input type="radio" asp-for="TipoEjercicio" value="@((int)TipoEjercicioLeyes.Literales)" />
                                <div class="tipo-card__icon" style="background:#eeefff;color:#4338ca;">ax</div>
                                <div class="tipo-card__info">
                                    <span class="tipo-card__nombre">Literales</span>
                                    <span class="tipo-card__desc">3x − 5x + 2x = ?</span>
                                </div>
                            </label>

                            <label class="tipo-card @(Model.TipoEjercicio == TipoEjercicioLeyes.Reales ? "tipo-card--active" : "")">
                                <input type="radio" asp-for="TipoEjercicio" value="@((int)TipoEjercicioLeyes.Reales)" />
                                <div class="tipo-card__icon" style="background:#f0fdf4;color:#15803d;">1.5</div>
                                <div class="tipo-card__info">
                                    <span class="tipo-card__nombre">Reales</span>
                                    <span class="tipo-card__desc">(−1.5) × (+2.0) = ?</span>
                                </div>
                            </label>

                            <label class="tipo-card @(Model.TipoEjercicio == TipoEjercicioLeyes.Parentesis ? "tipo-card--active" : "")">
                                <input type="radio" asp-for="TipoEjercicio" value="@((int)TipoEjercicioLeyes.Parentesis)" />
                                <div class="tipo-card__icon" style="background:#fff7ed;color:#c2410c;">()</div>
                                <div class="tipo-card__info">
                                    <span class="tipo-card__nombre">Paréntesis</span>
                                    <span class="tipo-card__desc">(2+3) × (−4) = ?</span>
                                </div>
                            </label>

                            <label class="tipo-card @(Model.TipoEjercicio == TipoEjercicioLeyes.Corchetes ? "tipo-card--active" : "")">
                                <input type="radio" asp-for="TipoEjercicio" value="@((int)TipoEjercicioLeyes.Corchetes)" />
                                <div class="tipo-card__icon" style="background:#fef3c7;color:#92400e;">{[]}</div>
                                <div class="tipo-card__info">
                                    <span class="tipo-card__nombre">Corchetes</span>
                                    <span class="tipo-card__desc">{[(2+3)×4]−5} = ?</span>
                                </div>
                            </label>

                            <label class="tipo-card @(Model.TipoEjercicio == TipoEjercicioLeyes.Exponente ? "tipo-card--active" : "")">
                                <input type="radio" asp-for="TipoEjercicio" value="@((int)TipoEjercicioLeyes.Exponente)" />
                                <div class="tipo-card__icon" style="background:#fef9c3;color:#b45309;">x²</div>
                                <div class="tipo-card__info">
                                    <span class="tipo-card__nombre">Exponente</span>
                                    <span class="tipo-card__desc">(−2)³ = ?</span>
                                </div>
                            </label>

                            <label class="tipo-card @(Model.TipoEjercicio == TipoEjercicioLeyes.Raiz ? "tipo-card--active" : "")">
                                <input type="radio" asp-for="TipoEjercicio" value="@((int)TipoEjercicioLeyes.Raiz)" />
                                <div class="tipo-card__icon" style="background:#ecfdf5;color:#065f46;">√</div>
                                <div class="tipo-card__info">
                                    <span class="tipo-card__nombre">Raíz cuadrada</span>
                                    <span class="tipo-card__desc">√(16) = ?</span>
                                </div>
                            </label>

                            <label class="tipo-card tipo-card--aleatorio @(Model.TipoEjercicio == TipoEjercicioLeyes.Aleatorio ? "tipo-card--active" : "")">
                                <input type="radio" asp-for="TipoEjercicio" value="@((int)TipoEjercicioLeyes.Aleatorio)" />
                                <div class="tipo-card__icon" style="background:#fce7f3;color:#be185d;">🎲</div>
                                <div class="tipo-card__info">
                                    <span class="tipo-card__nombre">Aleatorio</span>
                                    <span class="tipo-card__desc">Mezcla de todos los modos</span>
                                </div>
                            </label>

                        </div>
                    </div>
                </div>

            </div>

            <div class="config-card__footer">
                <button type="submit" class="btn btn--primary config-card__submit">
                    Iniciar práctica ×÷
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script src="/Content/js/Matematicas/formulario-leyes-signos-operaciones.js"></script>
}
