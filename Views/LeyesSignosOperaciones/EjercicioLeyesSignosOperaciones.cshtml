@model AnzanMegaArithmetics.Models.MatematicasModels.LeyesSignosOperaciones.EjercicioLeyesSignosOperacionesViewModel
@using AnzanMegaArithmetics.Models.MatematicasModels.LeyesSignosOperaciones
@using System.Text.Json
@{
    ViewData["Title"] = Model.EsTutorial ? "Tutorial — Leyes de los signos" : "Leyes de los signos";
    Layout = "~/Views/Shared/MatematicasV/_LayoutDashboardMates.cshtml";

    int porcentaje = Model.CantidadEjercicios > 0
        ? (int)((float)Model.EjerciciosRealizados / Model.CantidadEjercicios * 100) : 0;

    var tipo = Model.TipoEjercicioActual;

    var colorBanner = tipo switch
    {
        TipoEjercicioLeyes.PuroSigno => "#7c3aed",
        TipoEjercicioLeyes.Literales => "#4338ca",
        TipoEjercicioLeyes.Reales => "#15803d",
        TipoEjercicioLeyes.Parentesis => "#c2410c",
        TipoEjercicioLeyes.Corchetes => "#92400e",
        TipoEjercicioLeyes.Exponente => "#b45309",
        TipoEjercicioLeyes.Raiz => "#065f46",
        _ => "#4338ca"
    };
    var nombreTipo = tipo switch
    {
        TipoEjercicioLeyes.PuroSigno => "Puro signo",
        TipoEjercicioLeyes.Literales => "Literales",
        TipoEjercicioLeyes.Reales => "Reales",
        TipoEjercicioLeyes.Parentesis => "Paréntesis",
        TipoEjercicioLeyes.Corchetes => "Corchetes",
        TipoEjercicioLeyes.Exponente => "Exponente",
        TipoEjercicioLeyes.Raiz => "Raíz √",
        _ => "Leyes"
    };

    // Deserializar listas
    var signos = !string.IsNullOrEmpty(Model.SignosJson) && Model.SignosJson != "[]"
        ? JsonSerializer.Deserialize<List<bool>>(Model.SignosJson)! : new List<bool>();
    var valores = !string.IsNullOrEmpty(Model.ValoresJson) && Model.ValoresJson != "[]"
        ? JsonSerializer.Deserialize<List<double>>(Model.ValoresJson)! : new List<double>();
    var coefs = !string.IsNullOrEmpty(Model.CoefsJson) && Model.CoefsJson != "[]"
        ? JsonSerializer.Deserialize<List<int>>(Model.CoefsJson)! : new List<int>();
    var operaciones = !string.IsNullOrEmpty(Model.OperacionesJson) && Model.OperacionesJson != "[]"
        ? JsonSerializer.Deserialize<List<int>>(Model.OperacionesJson)! : new List<int>();

    // Helpers para renderizado limpio
    string OpStr(int op) => op switch { 0 => "+", 1 => "−", 2 => "×", 3 => "÷", 4 => "^", _ => "?" };

    // Término literal limpio: sin paréntesis, sin + innecesario
    // Punto 1 y 2: -4x, 8x, -7x (nunca +4x)
    string TermLit(int i)
    {
        int c = i < coefs.Count ? coefs[i] : 0;
        bool s = i < signos.Count && signos[i];
        int val = s ? c : -c;
        return val == 0 ? $"0{Model.Variable}"
             : val > 0 ? $"{val}{Model.Variable}"
             : $"−{Math.Abs(val)}{Model.Variable}";
    }

    // Operador entre términos literales (puntos 1-2):
    // Si el siguiente término es negativo → ya lleva el −, usamos +
    // (+8x)-(-7x) → 8x+(-7x)... pero regla: si se resta un negativo → +abs
    // Lógica: la operación es Suma/Resta entre términos con signo
    // Resultado: lo que el alumno ve algebraicamente correcto
    string OpLit(int opIdx, int termIdx)
    {
        int op = opIdx < operaciones.Count ? operaciones[opIdx] : 0;
        bool sNext = termIdx < signos.Count && signos[termIdx];
        int cNext = termIdx < coefs.Count ? coefs[termIdx] : 0;
        // op=Suma: (+c) → +c, (-c) → -c (el signo del término absorbe el +)
        // op=Resta: (+c) → -c, (-c) → +c (se invierte el signo)
        int valEfectivo = op == 0
            ? (sNext ? cNext : -cNext)
            : (sNext ? -cNext : cNext);

        if (valEfectivo > 0) return $"+{valEfectivo}{Model.Variable}";
        if (valEfectivo < 0) return $"−{Math.Abs(valEfectivo)}{Model.Variable}";
        return $"+0{Model.Variable}";
    }

    // Número dentro de paréntesis limpio (punto 3):
    // Primer número de la operación: sin + si es positivo
    // Si es negativo → −n, si es positivo → n (sin signo)
    string NumParens(bool signo, int val, bool esPrimero)
    {
        if (signo) return val.ToString();   // positivo: sin signo
        return $"−{val}";                    // negativo: con −
    }

    // Operador limpio entre elementos dentro de un paréntesis (punto 3)
    // (+2-+3) → (2-3), (+2++3) → (2+3), (+2-(-3)) → (2+3)
    string OpDentroParens(int op, bool signoSig, int valSig)
    {
        // op=Suma+sig_pos → +n, op=Suma+sig_neg → −n, op=Resta+sig_pos → −n, op=Resta+sig_neg → +n
        int efectivo = op == 0
            ? (signoSig ? valSig : -valSig)
            : (signoSig ? -valSig : valSig);
        if (efectivo >= 0) return $"+{efectivo}";
        return $"−{Math.Abs(efectivo)}";
    }

    // Para paréntesis/corchetes
    JsonElement estructura = default;
    bool tieneEstructura = false;
    if ((tipo == TipoEjercicioLeyes.Parentesis || tipo == TipoEjercicioLeyes.Corchetes)
        && !string.IsNullOrEmpty(Model.EstructuraJson) && Model.EstructuraJson.StartsWith("{"))
    {
        estructura = JsonSerializer.Deserialize<JsonElement>(Model.EstructuraJson);
        tieneEstructura = true;
    }
}

@section Styles {
    <link rel="stylesheet" href="/Content/css/Matematicas/ejercicio-leyes-signos-operaciones.css" />
    @if (Model.EsTutorial)
    {
        <link rel="stylesheet" href="/Content/css/Matematicas/tutorial-leyes-signos-operaciones.css" />
    }
}

@* ── Forms ── *@
<form id="formAvanzar" method="post" asp-controller="LeyesSignosOperaciones" asp-action="Avanzar">
    <input type="hidden" asp-for="CantidadEjercicios" />
    <input type="hidden" asp-for="CantidadOperandos" />
    <input type="hidden" asp-for="MinDigitos" />
    <input type="hidden" asp-for="MaxDigitos" />
    <input type="hidden" asp-for="TiposSeleccionadosJson" />
    <input type="hidden" asp-for="OpSumaResta" />
    <input type="hidden" asp-for="OpMultiplicacion" />
    <input type="hidden" asp-for="OpDivision" />
    <input type="hidden" asp-for="TipoEjercicioActual" />
    <input type="hidden" asp-for="VelocidadEjercicio" />
    <input type="hidden" asp-for="EjerciciosRealizados" />
    <input type="hidden" asp-for="ResultadosJson" />
    <input type="hidden" asp-for="SignosJson" />
    <input type="hidden" asp-for="ValoresJson" />
    <input type="hidden" asp-for="OperacionesJson" />
    <input type="hidden" asp-for="CoefsJson" />
    <input type="hidden" asp-for="Variable" />
    <input type="hidden" asp-for="SignoA" />
    <input type="hidden" asp-for="ValorA" />
    <input type="hidden" asp-for="Exponente" />
    <input type="hidden" asp-for="ExpConParentesis" />
    <input type="hidden" asp-for="ValorRaiz" />
    <input type="hidden" asp-for="EstructuraJson" />
    <input type="hidden" asp-for="RespuestaCorrecta" />
    <input type="hidden" asp-for="CoefRespuesta" />
    <input type="hidden" asp-for="EsTutorial" />
    <input type="hidden" asp-for="PasoTutorial" />
    <input type="hidden" name="RespuestaUsuario" id="hdRespuesta" value="" />
    <input type="hidden" name="TiempoRespuesta" id="hdTiempo" value="0" />
</form>

<form id="formFinalizar" method="post" asp-controller="LeyesSignosOperaciones" asp-action="Finalizar">
    <input type="hidden" asp-for="CantidadEjercicios" />
    <input type="hidden" asp-for="CantidadOperandos" />
    <input type="hidden" asp-for="MinDigitos" />
    <input type="hidden" asp-for="MaxDigitos" />
    <input type="hidden" asp-for="TiposSeleccionadosJson" />
    <input type="hidden" asp-for="OpSumaResta" />
    <input type="hidden" asp-for="OpMultiplicacion" />
    <input type="hidden" asp-for="OpDivision" />
    <input type="hidden" asp-for="TipoEjercicioActual" />
    <input type="hidden" asp-for="VelocidadEjercicio" />
    <input type="hidden" asp-for="EjerciciosRealizados" />
    <input type="hidden" asp-for="ResultadosJson" />
    <input type="hidden" asp-for="EsTutorial" />
</form>

<div class="ejercicio-layout"
     data-tipo="@((int)tipo)"
     data-respuesta-correcta="@Model.RespuestaCorrecta.ToString(System.Globalization.CultureInfo.InvariantCulture)"
     data-coef-respuesta="@Model.CoefRespuesta"
     data-es-puro-signo="@Model.EsPuroSigno.ToString().ToLower()"
     data-es-literal="@Model.EsLiteral.ToString().ToLower()"
     data-usa-decimales="@Model.UsaDecimales.ToString().ToLower()"
     data-es-raiz="@Model.EsRaiz.ToString().ToLower()"
     data-velocidad="@Model.VelocidadEjercicio"
     data-es-tutorial="@Model.EsTutorial.ToString().ToLower()"
     id="ejercicioLayout">

    <aside class="progreso-lateral" id="progresoLateral">
        <div class="progreso-lateral__track">
            <div class="progreso-lateral__fill" style="height:@porcentaje%"></div>
        </div>
        <span class="progreso-lateral__label">@Model.EjerciciosRealizados/@Model.CantidadEjercicios</span>
    </aside>

    <main class="ejercicio-centro">

        <div class="ejercicio-topbar" id="ejercicioTopbar">
            <div class="ejercicio-timer" id="timerWrap">
                @if (Model.VelocidadEjercicio != "0")
                {
                    <span>⏱</span>
                    <span class="ejercicio-timer__num" id="timerNum">@Model.VelocidadEjercicio</span>
                    <span class="ejercicio-timer__seg">s</span>
                }
                else
                {
                    <span class="ejercicio-timer__libre">♾️ Libre</span>
                }
            </div>
            <span class="tipo-badge" style="background:@colorBanner;">@nombreTipo</span>
            <button type="button" class="btn-terminar" id="btnTerminar">
                @(Model.EsTutorial ? "Salir" : "Terminar")
            </button>
        </div>

        <div class="operacion-wrap" id="operacionWrap">
            <span class="operacion-label">Resuelve:</span>

            @* ═══ PURO SIGNO ═══ *@
            @if (tipo == TipoEjercicioLeyes.PuroSigno)
            {
                <div class="puro-signo-display multi" id="ejercicioDisplay">
                    @for (int i = 0; i < signos.Count; i++)
                    {
                        <div class="signo-grande signo-grande--@(signos[i] ? "pos" : "neg")">
                            @(signos[i] ? "+" : "−")
                        </div>
                        @if (i < operaciones.Count)
                        {
                            <div class="op-signo-center">@OpStr(operaciones[i])</div>
                        }
                    }
                    <div class="op-signo-center">=</div>
                    <div class="signo-grande signo-grande--incognita" id="resultadoDisplay">?</div>
                </div>
            }

            @* ═══ LITERALES — sin paréntesis, sin + innecesario ═══ *@
            else if (tipo == TipoEjercicioLeyes.Literales)
            {
                <div class="operacion-display lit-display" id="ejercicioDisplay">
                    @* Primer término: sin + si es positivo *@
                    <span class="op-lit">@TermLit(0)</span>
                    @* Siguientes términos con operador algebraico correcto *@
                    @for (int i = 0; i < operaciones.Count; i++)
                    {
                        <span class="op-lit">@OpLit(i, i + 1)</span>
                    }
                    <span class="op-signo">=</span>
                    <span class="op-resultado lejos" id="resultadoDisplay">?</span>
                    <span class="op-var-resp" id="varRespuesta">@Model.Variable</span>
                </div>
            }

            @* ═══ REALES ═══ *@
            else if (tipo == TipoEjercicioLeyes.Reales)
            {
                <div class="operacion-display" id="ejercicioDisplay">
                    @for (int i = 0; i < signos.Count; i++)
                    {
                        string vStr = i < valores.Count
                        ? (valores[i] % 1 == 0
                        ? ((int)valores[i]).ToString()
                        : valores[i].ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))
                        : "?";
                        bool s = signos[i];
                        @* Punto 2: primer positivo sin signo *@
                        if (i == 0)
                        {
                            if (!s)
                            {
                                <span class="op-signo-inline">−</span>
                            }
                            <span class="op-num">@vStr</span>
                        }
                        else
                        {
                            <span class="op-signo">@OpStr(operaciones[i - 1])</span>
                            <span class="op-parentesis">(</span>
                            if (!s)
                            {

                                <span class="op-signo-inline">−</span>
                            }
                            <span class="op-num">@vStr</span>
                            <span class="op-parentesis">)</span>
                        }
                    }
                    <span class="op-signo">=</span>
                    <span class="op-resultado lejos" id="resultadoDisplay">?</span>
                </div>
            }

            @* ═══ EXPONENTE — con o sin paréntesis, sin + ═══ *@
            else if (tipo == TipoEjercicioLeyes.Exponente)
            {
                <div class="operacion-display" id="ejercicioDisplay">
                    @if (Model.ExpConParentesis)
                    {
                        @* Con paréntesis: (−2)³ o (2)³ *@
                        <span class="op-parentesis">(</span>
                        @if (!Model.SignoA)
                        {
                            <span class="op-signo-inline">−</span>
                        }
                        <span class="op-num">@((int)Model.ValorA)</span>
                        <span class="op-parentesis">)</span>
                    }
                    else
                    {
                        @* Sin paréntesis: −2³ o 2³ *@
                        @if (!Model.SignoA)
                        {
                            <span class="op-signo-inline">−</span>
                        }
                        <span class="op-num">@((int)Model.ValorA)</span>
                    }
                    <sup class="op-exponente">@Model.Exponente</sup>
                    <span class="op-signo">=</span>
                    <span class="op-resultado lejos" id="resultadoDisplay">?</span>
                </div>
            }

            @* ═══ RAÍZ ═══ *@
            else if (tipo == TipoEjercicioLeyes.Raiz)
            {
                <div class="operacion-display raiz-display" id="ejercicioDisplay">
                    <span class="op-raiz-simbolo">√</span>
                    <span class="op-raiz-contenido">
                        <span class="op-raiz-linea"></span>
                        <span class="op-num">@((int)Model.ValorRaiz)</span>
                    </span>
                    <span class="op-signo">=</span>
                    <span class="op-resultado lejos" id="resultadoDisplay">?</span>
                </div>
            }

            @* ═══ PARÉNTESIS — limpio ═══ *@
            else if (tipo == TipoEjercicioLeyes.Parentesis && tieneEstructura)
            {
                // Valores YA tienen signo incluido (int con signo)
                int vIA2 = estructura.GetProperty("vIA").GetInt32();
                int vIB2 = estructura.GetProperty("vIB").GetInt32();
                int opI2 = estructura.GetProperty("opI").GetInt32();
                var vExts2 = estructura.GetProperty("vExts");
                var opExts2 = estructura.GetProperty("opExts");

                // Mostrar dentro del paréntesis limpio
                string aStr2 = vIA2 < 0 ? $"−{Math.Abs(vIA2)}" : vIA2.ToString();
                // Operador + vIB limpio
                string bStr2;
                if (opI2 == 0) bStr2 = vIB2 >= 0 ? $"+{vIB2}" : $"−{Math.Abs(vIB2)}";
                else if (opI2 == 1) bStr2 = vIB2 >= 0 ? $"−{vIB2}" : $"+{Math.Abs(vIB2)}";
                else bStr2 = $"{(opI2 == 2 ? "×" : "÷")}{(vIB2 < 0 ? $"(−{Math.Abs(vIB2)})" : vIB2.ToString())}";

                <div class="operacion-parentesis" id="ejercicioDisplay">
                    <div class="parentesis-hint">👇 Resuelve primero lo que está dentro del paréntesis</div>
                    <div class="parentesis-expr">
                        <span class="op-parentesis op-parentesis--resalto">(</span>
                        <span class="op-num resalto">@aStr2@bStr2</span>
                        <span class="op-parentesis op-parentesis--resalto">)</span>

                        @for (int i = 0; i < vExts2.GetArrayLength(); i++)
                        {
                            int vv2 = vExts2[i].GetInt32();
                            int opv2 = opExts2[i].GetInt32();
                            string opvStr = opv2 == 0 ? "+" : opv2 == 1 ? "−" : opv2 == 2 ? "×" : "÷";
                            string numStr2 = vv2 < 0 ? $"(−{Math.Abs(vv2)})" : vv2.ToString();
                            <span class="op-signo">@opvStr</span>
                            <span class="op-num">@numStr2</span>
                        }
                        <span class="op-signo">=</span>
                        <span class="op-resultado lejos" id="resultadoDisplay">?</span>
                    </div>
                </div>
            }

            @* ═══ CORCHETES — limpio ═══ *@
            else if (tipo == TipoEjercicioLeyes.Corchetes && tieneEstructura)
            {
                // Valores YA tienen signo incluido
                int cvA = estructura.GetProperty("vA").GetInt32();
                int cvB = estructura.GetProperty("vB").GetInt32();
                int cop1 = estructura.GetProperty("op1").GetInt32();
                int cvC = estructura.GetProperty("vC").GetInt32();
                int cop2 = estructura.GetProperty("op2").GetInt32();
                bool cTieneExt = estructura.GetProperty("tieneExterno").GetBoolean();

                string caStr = cvA < 0 ? $"−{Math.Abs(cvA)}" : cvA.ToString();
                string cbStr;
                if (cop1 == 0) cbStr = cvB >= 0 ? $"+{cvB}" : $"−{Math.Abs(cvB)}";
                else if (cop1 == 1) cbStr = cvB >= 0 ? $"−{cvB}" : $"+{Math.Abs(cvB)}";
                else cbStr = $"{(cop1 == 2 ? "×" : "÷")}{(cvB < 0 ? $"(−{Math.Abs(cvB)})" : cvB.ToString())}";

                string ccStr;
                if (cop2 == 0) ccStr = cvC >= 0 ? $"+{cvC}" : $"−{Math.Abs(cvC)}";
                else if (cop2 == 1) ccStr = cvC >= 0 ? $"−{cvC}" : $"+{Math.Abs(cvC)}";
                else ccStr = $"{(cop2 == 2 ? "×" : "÷")}{(cvC < 0 ? $"(−{Math.Abs(cvC)})" : cvC.ToString())}";

                <div class="operacion-parentesis operacion-corchetes" id="ejercicioDisplay">
                    <div class="parentesis-hint corchetes-hint">
                        🔢 Primero ( ), luego [ ], luego { }
                    </div>
                    <div class="parentesis-expr">
                        @if (cTieneExt)
                        {
                            int cvD = estructura.GetProperty("vD").GetInt32();
                            int cop3 = estructura.GetProperty("op3").GetInt32();
                            string cdStr;
                            if (cop3 == 0) cdStr = cvD >= 0 ? $"+{cvD}" : $"−{Math.Abs(cvD)}";
                            else if (cop3 == 1) cdStr = cvD >= 0 ? $"−{cvD}" : $"+{Math.Abs(cvD)}";
                            else cdStr = $"{(cop3 == 2 ? "×" : "÷")}{(cvD < 0 ? $"(−{Math.Abs(cvD)})" : cvD.ToString())}";

                            <span class="op-corchete op-corchete--llave">{</span>
                            <span class="op-corchete">[</span>
                            <span class="op-parentesis op-parentesis--resalto">(</span>
                            <span class="op-num resalto">@caStr@cbStr</span>
                            <span class="op-parentesis op-parentesis--resalto">)</span>
                            <span class="op-num">@ccStr</span>
                            <span class="op-corchete">]</span>
                            <span class="op-num">@cdStr</span>
                            <span class="op-corchete op-corchete--llave">}</span>
                        }
                        else
                        {
                            <span class="op-corchete">[</span>
                            <span class="op-parentesis op-parentesis--resalto">(</span>
                            <span class="op-num resalto">@caStr@cbStr</span>
                            <span class="op-parentesis op-parentesis--resalto">)</span>
                            <span class="op-num">@ccStr</span>
                            <span class="op-corchete">]</span>
                        }
                        <span class="op-signo">=</span>
                        <span class="op-resultado lejos" id="resultadoDisplay">?</span>
                    </div>
                </div>
            }
        </div>

        @* ── REGLA ACTIVA ── *@
        <div class="regla-hint" id="reglaHint">
            @if (tipo == TipoEjercicioLeyes.Literales)
            {
                <span>📌 Suma/resta los coeficientes, conserva la variable <strong>@Model.Variable</strong></span>
            }
            else if (tipo == TipoEjercicioLeyes.Exponente)
            {
                <span>
                    📌 Base @(Model.SignoA ? "positiva" : "negativa"), exp. @Model.Exponente →
                    <strong>@(Model.Exponente % 2 == 0 ? "resultado positivo" : "conserva el signo")</strong>
                </span>
            }
            else if (tipo == TipoEjercicioLeyes.Parentesis)
            {
                <span>📌 Primero resuelve el <strong>paréntesis</strong>, luego la operación exterior</span>
            }
            else if (tipo == TipoEjercicioLeyes.Corchetes)
            {
                <span>📌 Orden: <strong>( ) → [ ] → { }</strong> de adentro hacia afuera</span>
            }
            else if (tipo == TipoEjercicioLeyes.Raiz)
            {
                <span>📌 La raíz cuadrada siempre da un resultado <strong>positivo</strong></span>
            }
        </div>

        @* ── ZONA DE RESPUESTA ── *@
        @if (tipo == TipoEjercicioLeyes.PuroSigno)
        {
            <div class="signo-btns-wrap" id="signoBtnsWrap">
                <button type="button" class="signo-btn signo-btn--pos" id="btnSignoPos" data-val="+">
                    <span class="signo-btn__icon">+</span>
                    <span class="signo-btn__label">Positivo</span>
                </button>
                <button type="button" class="signo-btn signo-btn--neg" id="btnSignoNeg" data-val="-">
                    <span class="signo-btn__icon">−</span>
                    <span class="signo-btn__label">Negativo</span>
                </button>
            </div>
            <div class="respuesta-wrap">
                <button type="button" class="btn-confirmar btn-confirmar--full" id="btnConfirmar" disabled>Enviar ✓</button>
            </div>
        }
        else
        {
            <div class="teclado-wrap" id="tecladoWrap">
                <div class="teclado-display" id="tecladoDisplay">
                    <span class="teclado-display__val" id="tecladoVal">—</span>
                    @if (tipo == TipoEjercicioLeyes.Literales)
                    {
                        <span class="teclado-var-suffix">@Model.Variable</span>
                    }
                </div>
                <div class="teclado-grid">
                    @foreach (var digit in new[] { "7", "8", "9", "4", "5", "6", "1", "2", "3" })
                    {
                        <button type="button" class="teclado-btn" data-digit="@digit">@digit</button>
                    }
                    <button type="button" class="teclado-btn teclado-btn--neg" id="btnNeg">±</button>
                    <button type="button" class="teclado-btn" data-digit="0">0</button>
                    @if (tipo == TipoEjercicioLeyes.Reales)
                    {
                        <button type="button" class="teclado-btn teclado-btn--dec" id="btnDec">.</button>
                    }
                    else
                    {
                        <button type="button" class="teclado-btn teclado-btn--del" id="btnDel">⌫</button>
                    }
                </div>
                @if (tipo == TipoEjercicioLeyes.Reales)
                {
                    <button type="button" class="teclado-btn teclado-btn--del teclado-btn--del-wide" id="btnDel">⌫ Borrar</button>
                }
            </div>
            <div class="respuesta-wrap">
                <button type="button" class="btn-confirmar btn-confirmar--full" id="btnConfirmar" disabled>Enviar ✓</button>
            </div>
        }

    </main>
</div>

@if (Model.EsTutorial)
{
    <div class="tutorial-overlay" id="tutorialOverlay">
        <div class="tutorial-spotlight" id="tutorialSpotlight"></div>
        <div class="tutorial-card" id="tutorialCard">
            <div class="tutorial-card__header">
                <span class="tutorial-card__paso" id="tutorialPaso">Paso 1</span>
                <span class="tutorial-card__emoji" id="tutorialEmoji">🧑‍🚀</span>
            </div>
            <h3 class="tutorial-card__titulo" id="tutorialTitulo"></h3>
            <p class="tutorial-card__desc" id="tutorialDesc"></p>
            <div class="tutorial-card__footer">
                <button class="tutorial-btn tutorial-btn--skip" id="btnSkipTutorial">Saltar</button>
                <button class="tutorial-btn tutorial-btn--next" id="btnNextTutorial">Entendido →</button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="/Content/js/Matematicas/ejercicio-leyes-signos-operaciones.js"></script>
    @if (Model.EsTutorial)
    {
        <script src="/Content/js/Matematicas/tutorial-leyes-signos-operaciones.js"></script>
    }
}
