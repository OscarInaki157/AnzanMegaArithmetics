@model AnzanMegaArithmetics.Models.ConfDadosModel
@{
    ViewBag.Title = "Matemáticas con Dados";
    Layout = "_LayoutDados";
}

<div class="top-bar-config">
    <form method="get" asp-controller="Dados" asp-action="LimpiarYDashboard">
        <button type="submit" class="btn-dashboard">
            <i class="fas fa-home"></i> Regresar al dashboard
        </button>
    </form>
    <h2 style="color:white">Matemáticas con dados</h2>
</div>

<div class="tabs">
    <div class="tab-buttons">
        <button type="button" class="tab-btn active" onclick="mostrarTab('tab1', this)">Tradicional</button>
        <button type="button" class="tab-btn" onclick="mostrarTab('tab4', this)">Dictado</button>
        <button type="button" class="tab-btn" onclick="mostrarTab('tab2', this)">Suma</button>
        <button type="button" class="tab-btn" onclick="mostrarTab('tab3', this)">Multi-Suma</button>
    </div>

    <form method="post" asp-action="ConcentracionDados" class="formulario-flash tab-content active" id="tab1">
        <input type="hidden" name="ModoJuego" value="Aritmetica" />
        <div class="form-grid">
            <div class="form-column">
                <div>
                    <label>Cantidad de ejercicios:</label>
                    <input asp-for="CantidadEjercicios" type="number" min="1" required />
                </div>
                <div>
                    <label>Modo de operación:</label>
                    <select asp-for="UsaJerarquia" required>
                        <option value="false">Sin Jerarquía</option>
                        <option value="true">Con Jerarquía</option>
                    </select>
                </div>
            </div>
            <div class="form-column">
                <div>
                    <label>Minutos para contestar (0 = Sin límite):</label>
                    <input asp-for="TiempoTotal" type="number" min="0" max="40" required />
                </div>
                <div>
                    <label asp-for="TiempoMeditacion">Tiempo de concentración:</label>
                    <select asp-for="TiempoMeditacion" required>
                        @foreach (var val in new[] { 0, 3, 5, 8, 10 })
                        {
                            <option value="@val">@val @(val == 0 ? "(sin concentración)" : "")</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <button type="submit" class="btn btn-primary" style="margin-top:1rem">⚡ Iniciar ejercicios</button>
    </form>

    <form method="post" asp-action="ConcentracionDictado" class="formulario-flash tab-content" id="tab4">
        <input type="hidden" name="ModoJuego" value="Dictado" />
        <div class="form-grid">
            <div class="form-column">
                <div>
                    <label>Cantidad de ejercicios:</label>
                    <input asp-for="CantidadEjercicios" type="number" min="1" required />
                </div>
                <div style="margin-top: 1rem; color: #aaa; font-style: italic;">
                    <p><i class="fas fa-info-circle"></i> Este modo es para practicar con un instructor, no otorga experiencia ni queda registrada su actividad.</p>
                </div>
            </div>
            <div class="form-column">
                <div>
                    <label>Tiempo de concentración:</label>
                    <select asp-for="TiempoMeditacion" required>
                        @foreach (var val in new[] { 0, 3, 5, 8, 10 })
                        {
                            <option value="@val">@val @(val == 0 ? "(sin concentración)" : "")</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <button type="submit" class="btn btn-primary" style="margin-top:1rem;">
            <i class="fas fa-chalkboard-teacher"></i> Iniciar Modo Dictado
        </button>
    </form>

    <form method="post" asp-action="ConcentracionSuma" class="formulario-flash tab-content" id="tab2">
        <input type="hidden" name="ModoJuego" value="SumaFlash" />
        <div class="form-grid">
            <div class="form-column">
                <div>
                    <label>Cantidad de ejercicios:</label>
                    <input asp-for="CantidadEjercicios" type="number" min="1" required />
                </div>
                <div>
                    <label asp-for="NumeroDados">Cantidad de dados a sumar:</label>
                    <select asp-for="NumeroDados" required>
                        @for (int i = 5; i <= 15; i++)
                        {
                            <option value="@i">@i dados</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-column">
                <div>
                    <label>Minutos para contestar (0 = Sin límite):</label>
                    <input asp-for="TiempoTotal" type="number" min="0" max="40" required />
                </div>
                <div>
                    <label asp-for="TiempoMeditacion">Tiempo de concentración:</label>
                    <select asp-for="TiempoMeditacion" required>
                        @foreach (var val in new[] { 0, 3, 5, 8, 10 })
                        {
                            <option value="@val">@val @(val == 0 ? "(sin concentración)" : "")</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <button type="submit" class="btn btn-primary" style="margin-top:1rem;">🚀 Iniciar ejercicios</button>
    </form>

    <form method="post" asp-action="ConcentracionMulti" class="formulario-flash tab-content" id="tab3">
        <input type="hidden" name="ModoJuego" value="MultiSuma" />
        <div class="form-grid">
            <div class="form-column">
                <div>
                    <label>Cantidad de ejercicios:</label>
                    <input asp-for="CantidadEjercicios" type="number" min="1" required />
                </div>
                <div>
                    <label asp-for="NumeroDados">Cantidad de dados a sumar:</label>
                    <select asp-for="NumeroDados" required>
                        @for (int i = 5; i <= 15; i++)
                        {
                            <option value="@i">@i dados</option>
                        }
                    </select>
                </div>
                <div>
                    <label>Rango del dado multiplicador:</label>
                    <select asp-for="RangoDados" class="form-control" id="selectRangoMulti" onchange="toggleMultiLibre()">
                        <option value="2-11">Nivel Básico (2 - 11)</option>
                        <option value="9-16">Nivel Medio (9 - 16)</option>
                        <option value="15-24">Nivel Pro (15 - 24)</option>
                        <option value="Libre">Libre (Manual)</option>
                    </select>
                </div>
                <div id="containerMultiLibre" style="display:none; margin-top: 1rem;">
                    <label>Multiplicador personalizado (1 - 100):</label>
                    <input asp-for="MultiplicadorLibre" type="number" min="1" value="7" max="100" />
                </div>
            </div>
            <div class="form-column">
                <div>
                    <label>Minutos para contestar (0 = Sin límite):</label>
                    <input asp-for="TiempoTotal" type="number" min="0" max="40" required />
                </div>
                <div>
                    <label asp-for="TiempoMeditacion">Tiempo de concentración:</label>
                    <select asp-for="TiempoMeditacion" required>
                        @foreach (var val in new[] { 0, 3, 5, 8, 10 })
                        {
                            <option value="@val">@val @(val == 0 ? "(sin concentración)" : "")</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <button type="submit" class="btn btn-primary" style="margin-top:1rem;">🧠 Iniciar ejercicios</button>
    </form>
</div>

<style>

    body {
        background-color: var(--color-bg);
        color: var(--color-tex);
    }

    h2 {
        text-align: center;
        color: var(--color-light);
        font-weight: 600;
        font-size: clamp(1.4rem, 2vw, 1.7rem);
    }

    form#formConfigSR input[type="range"] {
        background-color: #292c4f;
    }


    .formulario-flash {
        max-width: 100%;
        padding: 1.3rem;
        border-radius: 0 1rem 1rem 1rem;
        background-color: var(--bg-color);
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.4);
        animation: fadeIn 0.4s ease;
    }

    .top-bar-config {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        max-width: 85%;
        margin: -1rem auto 1rem auto;
        padding: 0 1rem;
    }

        .top-bar-config h2 {
            margin: 0;
            font-size: clamp(1.4rem, 2vw, 1.7rem);
            font-weight: 600;
            color: var(--color-light);
        }

    .form-grid {
        display: flex;
        flex-wrap: wrap;
    }

    .form-column {
        flex: 1 1 49%;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .formulario-flash label {
        display: block;
        margin-bottom: 0.4rem;
        font-weight: 600;
        font-size: 1rem;
    }

    .formulario-flash select,
    .formulario-flash input[type="number"] {
        width: 60%;
        padding: 0.5rem 0.6rem;
        border: none;
        border-radius: 0.5rem;
        background-color: #292c4f;
        color: white;
        font-size: 1rem;
    }

    .formulario-flash input[type="radio"] {
        accent-color: var(--color-primary);
        transform: scale(1.1);
    }

    .btn.btn-primary {
        color: white;
        padding: 1.2rem 1rem;
        font-size: 1.1rem;
        font-weight: bold;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: transform 0.2s ease, background-color 0.3s ease, box-shadow 0.3s ease;
        width: 100%;
        background: #28a745;
        box-shadow: 0 4px 12px rgba(76, 175, 80, 0.4);
    }

        .btn.btn-primary:hover {
            background: #2ecc71;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(46, 204, 113, 0.5);
        }

    .btn-dashboard {
        background-color: var(--color-primary);
        color: white;
        padding: 0.7rem 1.5rem;
        border: none;
        border-radius: 0.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(76, 76, 255, 0.3);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
    }


        .btn-dashboard i {
            font-size: 1.1rem;
        }

    .dashboard-button-wrapper {
        display: flex;
        justify-content: center;
        margin-bottom: 2rem;
    }

    .btn-dashboard:hover {
        background-color: var(--color-primary-dark);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(76, 76, 255, 0.5);
    }

    .tag-input {
        border: 1px solid #555;
        border-radius: 0.5rem;
        padding: 0.6rem 0.8rem;
        background-color: #292c4f;
        position: relative;
        cursor: pointer;
        min-height: 48px;
        width: 60%;
    }

    .tags-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tag {
        background-color: var(--color-primary);
        color: white;
        padding: 5px 12px;
        border-radius: 999px;
        display: flex;
        align-items: center;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.2s ease;
        cursor: pointer;
    }

        .tag:hover {
            background-color: var(--color-primary-dark);
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(76, 76, 255, 0.5);
            transition: all 0.2s ease;
        }


        .tag .remove {
            margin-left: 8px;
            font-weight: bold;
            cursor: pointer;
        }

    .dropdown-toggle {
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 1.4rem;
        color: #ccc;
        user-select: none;
    }

    .dropdown-options {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background-color: #1b1e3c;
        border: 1px solid #555;
        border-radius: 0.5rem;
        margin-top: 6px;
        z-index: 10;
        display: none;
        max-height: 180px;
        overflow-y: auto;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.5);
    }

    .option {
        padding: 10px 15px;
        font-size: 0.95rem;
        color: var(--color-light);
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .option:hover {
            background-color: var(--color-primary-dark);
        }

        .option.special {
            font-weight: bold;
            background-color: #292c4f;
            color: var(--color-primary);
        }

            .option.special:hover {
                background-color: #3737e8;
                color: white;
            }

    .input-error {
        border: 2px solid var(--color-danger) !important;
    }

    .elslider {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 60%;
    }


    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .toggle-container {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 1rem;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 3rem;
        height: 2rem;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
            position: absolute;
            left: 0;
            top: 0;
        }

            .switch input[type="checkbox"] {
                z-index: 1;
                width: 100%;
                height: 100%;
            }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #555;
        transition: .4s;
        border-radius: 34px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 1.5rem;
            width: 1.5rem;
            left: 4px;
            bottom: 4px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: var(--color-primary);
    }

        input:checked + .slider:before {
            transform: translateX(1rem);
        }

    .estado-texto {
        font-weight: bold;
        font-size: 1rem;
        color: var(--color-light);
    }

    .tabs {
        width: 85%;
        margin-top: 2rem;
        justify-self: center;
    }

    /* --- Estilos con Tonalidad Dashboard --- */
    .tab-buttons {
        display: flex;
        gap: 0.6rem;
        margin-bottom: 0; /* Pegado al contenido para mejor flujo */
        border-bottom: 2px solid rgba(76, 76, 255, 0.1);
    }

    .tab-btn {
        background: rgba(41, 44, 79, 0.6); /* El fondo oscuro que ya usas, pero traslúcido */
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 0.7rem 1.3rem;
        font-size: 0.95rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.6);
        cursor: pointer;
        border-radius: 8px 8px 0 0;
        transition: all 0.3s ease;
        margin-bottom: -2px; /* Para que el borde activo monte sobre la línea base */
    }

        .tab-btn:hover {
            background: rgba(76, 76, 255, 0.15); /* Azul muy tenue */
            color: white;
        }

        .tab-btn.active {
            /* Usamos el color de tu botón dashboard */
            background-color: var(--color-primary);
            color: white;
            border-color: var(--color-primary);
            /* Glow sutil con el mismo tono azul */
            box-shadow: 0 4px 12px rgba(76, 76, 255, 0.4);
            /* Un degradado lineal para que no sea un color plano y aburrido */
            background-image: linear-gradient(180deg, rgba(255,255,255,0.1) 0%, rgba(0,0,0,0) 100%);
            transform: none; /* Mantenerlo estable */
            z-index: 2;
        }


    .tab-content {
        display: none;
    }

        .tab-content.active {
            display: block;
        }



    @@media (max-width: 768px) {
        .form-grid {
            flex-direction: column;
        }

        .btn-dashboard {
            width: 100%;
            margin-bottom: 1rem;
        }

        .btn.btn-primary {
            font-size: 1rem;
        }

        .top-bar-config {
            flex-direction: column-reverse;
            align-items: center;
            text-align: center;
        }

            .top-bar-config h2 {
                width: 100%;
            }

            .top-bar-config .btn-dashboard {
                width: auto;
                margin: 0 auto;
            }

        .formulario-flash select,
        .formulario-flash input[type="number"] {
            width: 100%;
        }

        .elslider {
            width: 100%;
        }

        .tag-input {
            width: 100%;
        }

        .switch {
            width: 5rem;
        }

        input:checked + .slider:before {
            transform: translateX(1rem);
        }
    }
</style>


<script>
    function regresarAlDashboard() {
        window.location.href = '@Url.Action("LimpiarYDashboard", "Dados")';
    }

       function toggleMultiLibre() {
        const select = document.getElementById('selectRangoMulti');
        const container = document.getElementById('containerMultiLibre');

        // Validamos que ambos elementos existan antes de hacer nada
        if (select && container) {
            if (select.value === 'Libre') {
                container.style.display = 'block';
            } else {
                container.style.display = 'none';
            }
        }
    }


    function mostrarTab(id, btn) {
        document.querySelectorAll(".tab-content").forEach(el => el.classList.remove("active"));
        document.querySelectorAll(".tab-btn").forEach(el => el.classList.remove("active"));

        const targetTab = document.getElementById(id);
        if (targetTab) {
            targetTab.classList.add("active");
            btn.classList.add("active");
            // Guardamos para persistencia en la misma sesión de navegador
            localStorage.setItem("tabDadosActivo", id);
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        toggleMultiLibre();

        // 1. Leemos el valor que viene desde el Controller
        const modoDesdeServidor = "@ViewBag.ModoActivo";

        // 2. Mapeamos el ModoJuego a la ID del tab correspondiente
        const mapeoModos = {
            "Aritmetica": "tab1",
            "SumaFlash": "tab2",
            "MultiSuma": "tab3",
            "Dictado": "tab4"
        };

        // 3. Obtenemos la ID por servidor, si no, por localStorage, o por defecto tab1
        let tabIdDestino = mapeoModos[modoDesdeServidor] || localStorage.getItem("tabDadosActivo") || "tab1";

        // 4. Buscamos el botón exacto que abre esa pestaña
        const botonDestino = document.querySelector(`.tab-btn[onclick*="${tabIdDestino}"]`);

        // 5. Activamos la pestaña
        if (botonDestino) {
            mostrarTab(tabIdDestino, botonDestino);
        }
    });
</script>