@model AnzanMegaArithmetics.Models.ConfDadosModel
@{
    ViewBag.Title = "Matemáticas con Dados";
    Layout = "_LayoutDados";
}

<div id="contenedorConfiguracionFlash">

    <form method="post" action="/Dados/ConcentracionDados" id="formConfigSR" class="formulario-flash">

        <div class="form-header">
            <button type="button" class="btn-dashboard" onclick="regresarAlDashboard()">
                <i class="fas fa-home"></i> Regresar al Dashboard
            </button>
            <h2>Ajustes Matemáticas con Dados</h2>
        </div>

        <div class="form-grid-three-columns">
            <div class="form-column">

                <div>
                    <label asp-for="CantidadEjercicios">Cantidad de ejercicios:</label>
                    <input asp-for="CantidadEjercicios" type="number" min="1" required />
                    <span asp-validation-for="CantidadEjercicios" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="TiempoTotal">Minutos para contestar todos los ejercicios:</label>
                    <input asp-for="TiempoTotal" type="number" min="1" max="40" required />
                    <span asp-validation-for="TiempoTotal" class="validation-error"></span>

                </div>

            </div>

            <div class="form-column">

                <div>
                    <label asp-for="TiempoMeditacion">Tiempo de concentración:</label>
                    <select asp-for="TiempoMeditacion" required>
                        @foreach (var val in new[] { 0, 3, 5, 8, 10 })
                        {
                            <option value="@val">@val @(val == 0 ? "(sin concentración)" : "")</option>
                        }
                    </select>
                </div>


                <div>
                    <button type="submit" class="btn btn-primary">⚡ Iniciar ejercicios</button>
                </div>

            </div>

        </div>
    </form>

</div>

<style>
    body {
        background-color: var(--color-bg);
        color: var(--color-tex);
    }

    .top-bar-config {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        max-width: 85%;
        margin: -1rem auto 1rem auto;
        padding: 0 1rem;
    }

        .top-bar-config h2 {
            margin: 0;
            font-size: clamp(1.4rem, 2vw, 1.7rem);
            font-weight: 600;
        }

    .form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #444;
    }

        .form-header h2 {
            margin: 0;
            font-size: clamp(1.4rem, 2vw, 1.7rem);
            font-weight: 600;
        }

    form#formConfigSR input[type="range"] {
        background-color: #292c4f;
    }

    .formulario-flash {
        max-width: 95%;
        margin: 0 auto;
        padding: 1.3rem;
        border-radius: 1rem;
        background-color: var(--bg-color);
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.4);
        animation: fadeIn 0.4s ease;
        margin-top: -1.5rem;
    }

    .checks {
        flex-direction: row;
        display: flex;
        gap: 2rem;
        padding: 0.5rem;
        align-items: center;
    }

    .form-grid-three-columns {
        display: flex;
        gap: 2rem;
        justify-content: space-between;
    }

    .form-grid {
        display: flex;
        flex-wrap: wrap;
    }

    .form-column {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    form#formConfigSR label {
        display: block;
        margin-bottom: 0.4rem;
        font-weight: 600;
        font-size: 1rem;
    }

    form#formConfigSR select,
    form#formConfigSR input[type="number"] {
        width: 70%;
        padding: 0.5rem 0.6rem;
        border: none;
        border-radius: 0.5rem;
        background-color: #292c4f;
        color: white;
        font-size: 1rem;
    }

    form#formConfigSR input[type="radio"] {
        accent-color: var(--color-primary);
        transform: scale(1.1);
    }

    /* Estilos para los radio buttons de rangos */
    .rango-options {
        margin: 1rem 0;
    }

    .radio-group {
        display: flex;
        flex-direction: row;
        gap: 0.8rem;
        margin-top: 0.5rem;
    }

    .radio-option {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        padding: 0.5rem;
        border-radius: 0.5rem;
        background-color: rgba(41, 44, 79, 0.3);
        transition: all 0.3s ease;
        cursor: pointer;
        border: 2px solid transparent;
    }

        .radio-option:hover {
            background-color: rgba(41, 44, 79, 0.6);
            border-color: rgba(255, 255, 255, 0.2);
        }

        .radio-option.selected {
            background-color: rgba(76, 76, 255, 0.3);
            border-color: var(--color-primary);
            box-shadow: 0 0 10px rgba(76, 76, 255, 0.3);
        }

        .radio-option label {
            margin-bottom: 0;
            cursor: pointer;
            font-weight: 500;
            flex: 1;
        }

        .radio-option input[type="radio"] {
            margin: 0;
        }

    .btn.btn-primary {
        background: #28a745;
        color: white;
        padding: 0.9rem 1.5rem;
        font-size: 1.1rem;
        font-weight: bold;
        border: none;
        border-radius: 0.6rem;
        cursor: pointer;
        transition: all 0.3s ease;
        width: 100%;
        box-shadow: 0 4px 12px rgba(76, 175, 80, 0.4);
        text-shadow: 0 1px 1px rgba(0, 0, 0, 0.2);
        letter-spacing: 0.5px;
    }

        .btn.btn-primary:hover {
            background: #2ecc71;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(46, 204, 113, 0.5);
        }

    .btn-dashboard {
        background-color: var(--color-primary);
        color: white;
        padding: 0.7rem 1.5rem;
        border: none;
        border-radius: 0.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(76, 76, 255, 0.3);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
    }

        .btn-dashboard i {
            font-size: 1.1rem;
        }

    .dashboard-button-wrapper {
        display: flex;
        justify-content: center;
        margin-bottom: 2rem;
    }

    .btn-dashboard:hover {
        background-color: var(--color-primary-dark);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(76, 76, 255, 0.5);
    }

    .tag-input {
        border: 1px solid #555;
        border-radius: 0.5rem;
        padding: 0.6rem 0.8rem;
        background-color: #292c4f;
        position: relative;
        cursor: pointer;
        min-height: 48px;
        width: 70%;
    }

    .tags-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tag {
        background-color: var(--color-primary);
        color: white;
        padding: 5px 12px;
        border-radius: 999px;
        display: flex;
        align-items: center;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.25s ease-in-out;
    }

        .tag:hover {
            background-color: var(--color-primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 0 15px rgba(76, 76, 255, 0.6);
        }

        .tag .remove {
            margin-left: 8px;
            font-weight: bold;
            cursor: pointer;
        }

    .dropdown-toggle {
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 1.4rem;
        color: #ccc;
        user-select: none;
    }

    .dropdown-options {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background-color: #1b1e3c;
        border: 1px solid #555;
        border-radius: 0.5rem;
        margin-top: 6px;
        z-index: 10;
        display: none;
        max-height: 180px;
        overflow-y: auto;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.5);
    }

    .option {
        padding: 10px 15px;
        font-size: 0.95rem;
        color: var(--color-light);
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .option:hover {
            background-color: var(--color-primary-dark);
        }

        .option.special {
            font-weight: bold;
            background-color: #292c4f;
            color: var(--color-primary);
        }

            .option.special:hover {
                background-color: #3737e8;
                color: white;
            }

    .input-error {
        border: 2px solid var(--color-danger) !important;
    }

    .elslider {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 70%;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .form-grid-three-columns {
            flex-direction: column;
        }

        .form-header {
            flex-direction: column;
            gap: 1rem;
            text-align: center;
        }

        .btn-dashboard {
            width: 100%;
            margin-bottom: 1rem;
        }

        .btn.btn-primary {
            font-size: 1rem;
        }

        form#formConfigSR select,
        form#formConfigSR input[type="number"] {
            width: 100%;
        }

        .top-bar-config {
            flex-direction: column;
        }

        .tag-input {
            width: 100%;
        }

        .elslider {
            width: 100%;
        }

        .radio-group {
            gap: 0.5rem;
        }

        .radio-option {
            padding: 0.4rem;
        }

        .radio-group {
            flex-direction: column;
        }
    }
</style>

<script>
    function regresarAlDashboard() {
        window.location.href = '@Url.Action("LimpiarYDashboard", "Dados")';
    }

</script>