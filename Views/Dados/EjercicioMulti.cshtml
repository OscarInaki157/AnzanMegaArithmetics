         <button type="button" id="btnSaltar" class="btn-saltar" onclick="saltarEjercicio()"
             @(ViewBag.SaltosUsados >= 2 ? "disabled" : "")>
             ⏭️ Saltar (@(2 - ViewBag.SaltosUsados))
         </button>
        
    </div>

    <div class="teclado-numerico">
        <div class="fila">
            <button type="button" class="tecla">7</button>
            <button type="button" class="tecla">8</button>
            <button type="button" class="tecla">9</button>
        </div>
        <div class="fila">
            <button type="button" class="tecla">4</button>
            <button type="button" class="tecla">5</button>
            <button type="button" class="tecla">6</button>
        </div>
        <div class="fila">
            <button type="button" class="tecla">1</button>
            <button type="button" class="tecla">2</button>
            <button type="button" class="tecla">3</button>
        </div>
        <div class="fila">
            <button type="button" class="tecla">0</button>
            <button type="button" class="tecla borrar">🗑️</button>
        </div>

    </div>
    
</div>

@section Scripts {
    <script>
        // 1. Variables Globales y DOM
        let tiempoInicio = Date.now();
        let tiempoRestante = @tiempoRestante;
        const totalCorrecto = @Model.Dado_Resultado;
        const input = document.getElementById('inputRespuesta');
        const wrapper = document.getElementById('targetWrapper');
        const displayReloj = document.getElementById('contadorTiempo');

        // 2. Temporizador mm:ss
        function formatearTiempo(seg) {
            if (seg < 0) seg = 0;
            const m = Math.floor(seg / 60);
            const s = seg % 60;
            return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
        }

        displayReloj.textContent = formatearTiempo(tiempoRestante);

        const timer = setInterval(() => {
            tiempoRestante--;
            displayReloj.textContent = formatearTiempo(tiempoRestante);
            if (tiempoRestante <= 0) {
                clearInterval(timer);
                location.href = '/Dados/ResultadosMulti';
            }
        }, 1000);

        // 3. Lógica de Validación Centralizada
        function verificarRespuesta() {
            if (input.readOnly) return;

            const valor = parseInt(input.value);
            if (valor === totalCorrecto) {
                input.readOnly = true;

                // AGREGAR CLASE DE ÉXITO
                input.classList.add('correcto');

                // El resto de tu lógica se mantiene igual
                wrapper.classList.add('revelado');

                const tiempoRespuesta = (Date.now() - tiempoInicio) / 1000;

                setTimeout(() => {
                    enviarDatos(input.value, tiempoRespuesta);
                }, 1100);
            }
        }

        // 4. Teclado Virtual (Clics en pantalla)
        document.querySelectorAll('.tecla').forEach(btn => {
            btn.addEventListener('click', () => {
                if (input.readOnly) return;

                if (btn.classList.contains('borrar')) {
                    input.value = input.value.slice(0, -1);
                } else {
                    const num = btn.textContent.trim();
                    if (!isNaN(num)) {
                        input.value += num;
                    }
                }

                verificarRespuesta();
                input.focus();

                // Animación visual
                btn.classList.add('presionada');
                setTimeout(() => btn.classList.remove('presionada'), 150);
            });
        });

        // 5. Teclado Físico (Eventos de PC)
        document.addEventListener('keydown', e => {
            if (input.readOnly) return;

            const tecla = e.key;

            // Manejo de números
            if (tecla >= '0' && tecla <= '9') {
                e.preventDefault(); // Prevenir duplicados
                input.value += tecla;
                verificarRespuesta();

                const btn = Array.from(document.querySelectorAll('.tecla'))
                                 .find(b => b.textContent.trim() === tecla);
                if (btn) {
                    btn.classList.add('presionada');
                    setTimeout(() => btn.classList.remove('presionada'), 150);
                }
            }

            // Manejo de borrar
            if (tecla === 'Backspace') {
                e.preventDefault();
                input.value = input.value.slice(0, -1);
                verificarRespuesta();

                const btnBorrar = document.querySelector('.tecla.borrar');
                if (btnBorrar) {
                    btnBorrar.classList.add('presionada');
                    setTimeout(() => btnBorrar.classList.remove('presionada'), 150);
                }
            }

            // Manejo de Enter (por si el usuario quiere validar manualmente)
            if (tecla === 'Enter') {
                e.preventDefault();
                verificarRespuesta();
            }
        });

        // 6. Funciones de Envío y Saltar
        function saltarEjercicio() {
            const btn = document.getElementById('btnSaltar');
            btn.disabled = true;
            const tiempoRespuesta = (Date.now() - tiempoInicio) / 1000;
            enviarDatos(null, tiempoRespuesta, true);
        }

        function enviarDatos(resp, tiempo, salto = false) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/Dados/EjercicioMulti';

            const fields = {
                'respuestaUsuario': resp || 0,
                'tiempoRespuesta': tiempo,
                'tiempoRestanteActual': tiempoRestante,
                'esSalto': salto
            };

            for (let key in fields) {
                const inp = document.createElement('input');
                inp.type = 'hidden';
                inp.name = key;
                inp.value = fields[key];
                form.appendChild(inp);
            }

            document.body.appendChild(form);
            form.submit();
        }
    </script>
}