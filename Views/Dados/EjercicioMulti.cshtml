@model AnzanMegaArithmetics.Models.EjercicioDadosModel
@{
    ViewBag.Title = "Multi - Dados";
    Layout = "_LayoutDados";

    var ejercicioActual = ViewBag.EjercicioActual ?? 1;
    var totalEjercicios = ViewBag.TotalEjercicios ?? 1;
    var tiempoRestante = ViewBag.TiempoRestante ?? 0;
    var porcentaje = totalEjercicios > 0 ? (ejercicioActual * 100.0) / totalEjercicios : 0;
}

<style>
    /* Clase para resaltar el éxito de la respuesta */
