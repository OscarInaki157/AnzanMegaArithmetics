@using AnzanMegaArithmetics.Models
@model ResDadosViewModel
@{
    ViewBag.Title = "Resumen de Ejercicios de Dados";
    Layout = "_LayoutDados";

    var total = Model.Ejercicios.Count;
    var correctos = Model.TotalCorrectas;
    var incorrectos = Model.TotalIncorrectas;
    var noRespondidos = Model.TotalSinResponder;
    var porcentaje = Model.PorcentajeAcierto;
    string barraColor = porcentaje >= 79 ? "#28a745" : porcentaje >= 49 ? "#ffc107" : "#dc3545";
    var tiempoTotal = Model.TiempoTotal;
    var tiempoPromedio = Model.TiempoPromedio;

    int totalPuntos = 0;
    foreach (var r in Model.Respuestas)
    {
        if (r.Es_Correcta && r.DadosUtilizados > 0)
        {
            totalPuntos += r.DadosUtilizados;
        }
    }
}

<style>
    body {
        background-color: var(--color-bg);
        color: var(--color-tex);
    }

    h1 {
        text-align: center;
        font-size: 2rem;
        margin-top: 10px;
        margin-bottom: 0.5rem;
    }

    hr {
        border-color: #4c4cff;
        width: 80%;
        margin: 10px auto 30px auto;
    }

    .botones-centrados {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin: 30px 0;
        flex-wrap: wrap;
    }

        .botones-centrados button {
            padding: 12px 20px;
            font-size: 1rem;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s ease;
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.3);
        }

    .btn-primary {
        background-color: #4c4cff;
        color: white;
    }

        .btn-primary:hover {
            background-color: #3737e8;
            transform: translateY(-2px);
        }

    .btn-secondary {
        background-color: #292c4f;
        color: white;
    }

        .btn-secondary:hover {
            background-color: #1b1e3c;
            transform: translateY(-2px);
        }

    .btn-success {
        background-color: #28a745;
        color: white;
    }

        .btn-success:hover {
            background-color: #218838;
            transform: translateY(-2px);
        }

    .resultados {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
    }

    .cont-onl {
        flex: 1 1 50%;
    }

    .resumen-grid-contenedor {
        background-color: #1b1e3c;
        border: 2px solid #4c4cff;
        border-radius: 12px;
        padding: 25px 30px;
        box-shadow: 0 0 20px rgba(76, 76, 255, 0.1);
        margin: 0 auto 30px auto;
        max-width: 1200px;
    }

    .contenedores-resumen {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
    }

    .resultados-con-glow {
        background-color: #1b1e3c;
        border: 2px solid #4c4cff;
        border-radius: 12px;
        padding: 20px 20px;
        box-shadow: 0 0 20px rgba(76, 76, 255, 0.3);
        margin: 0 auto 30px auto;
        max-width: 1200px;
    }

    .card-resumen {
        flex: 1 1 110px;
        max-width: 130px;
        min-width: 90px;
        background-color: #292c4f;
        border-radius: 12px;
        padding: 10px;
        text-align: center;
        box-shadow: 0 0 10px rgba(76, 76, 255, 0.4);
        color: white;
        transition: transform 0.3s ease;
    }

        .card-resumen:hover {
            transform: scale(1.05);
        }

    .card-titulo {
        font-size: 1rem;
        font-weight: 500;
        margin-bottom: 10px;
    }

    .card-icono {
        font-size: 1.5rem;
        margin-bottom: 8px;
    }

    .card-valor {
        font-size: 1.6rem;
        font-weight: bold;
    }

    .card-resumen.total {
        background-color: #00acc1;
    }

    .card-resumen.correctos {
        background-color: #28a745;
    }

    .card-resumen.incorrectos {
        background-color: #dc3545;
    }

    .card-resumen.experiencia {
        background-color: #4c4cff;
    }

    .card-resumen.dados-promedio {
        background-color: #9c27b0;
    }

    .resumen-grid-contenedor p {
        font-size: 1.3rem;
        margin: 10px 0;
    }

    .barra-progreso {
        margin: 0 auto;
        width: 100%;
        max-width: 300px;
        background-color: #292c4f;
        border-radius: 6px;
        height: 22px;
        overflow: hidden;
    }

    .barra-progreso-interna {
        height: 100%;
        transition: width 0.5s ease;
    }

    .container-barrap {
        flex: 1 1 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .grid-acordeones {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        max-width: 1200px;
        margin: 0 auto 50px auto;
        align-items: start;
    }

        .grid-acordeones details {
            background-color: #2a2d56;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }

        .grid-acordeones summary {
            padding: 14px 20px;
            cursor: pointer;
            font-weight: bold;
            background-color: #202349;
            color: white;
            list-style: none;
            position: relative;
            font-size: 1rem;
            border-radius: 10px 10px 0 0;
        }

            .grid-acordeones summary::before {
                content: "▶";
                display: inline-block;
                margin-right: 10px;
                transition: transform 0.3s ease;
            }

        .grid-acordeones details[open] summary::before {
            transform: rotate(90deg);
        }

        .grid-acordeones summary::-webkit-details-marker {
            display: none;
        }

        .grid-acordeones details > div {
            padding: 14px 18px;
            background-color: #1b1e3c;
            color: #d1d1f0;
            font-size: 1rem;
            border-radius: 0 0 10px 10px;
        }

    .correcto summary {
        color: #28a745;
    }

    .incorrecto summary {
        color: #dc3545;
    }

    .no-respondio summary {
        color: #f1c40f;
    }

    .barra-progreso-interna {
        height: 100%;
        width: 0%;
        position: relative;
    }

    .shimmer::after {
        content: "";
        position: absolute;
        top: 0;
        left: -50%;
        height: 100%;
        width: 50%;
        background: linear-gradient(120deg, transparent, rgba(255,255,255,0.6), transparent);
        animation: shimmer 1.5s infinite;
    }

    @@keyframes shimmer {
        0% {
            left: -50%;
        }

        100% {
            left: 100%;
        }
    }

    .parpadeo {
        animation: parpadeo 1s infinite;
    }

    @@keyframes parpadeo {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.3;
        }
    }

    .estrellas-container {
        position: relative;
        height: 0;
        margin-top: 10px;
        overflow: visible;
    }

    .estrella {
        position: absolute;
        font-size: 18px;
        color: #fcd703;
        animation: volar 1s ease-out forwards;
    }

    @@keyframes volar {
        0% {
            transform: translateY(0) scale(1);
            opacity: 1;
        }

        100% {
            transform: translateY(-60px) scale(1.5);
            opacity: 0;
        }
    }

    /* ESTILOS ESPECÍFICOS PARA DADOS */
    .dados-mini {
        display: flex;
        gap: 8px;
        margin: 10px 0;
        flex-wrap: wrap;
        justify-content: center;
    }

    .dado-mini {
        width: 35px;
        height: 35px;
        background: linear-gradient(135deg, #ffffff, #f0f0f0);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        font-weight: bold;
        color: #2d3748;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        border: 2px solid #4c4cff;
    }

    .dado-resultado-mini {
        background: linear-gradient(135deg, #4c4cff, #3737e8);
        color: white;
        border: 2px solid #ffffff;
        margin-left: 5px;
    }

    .expresion-matematica {
        background-color: #292c4f;
        padding: 10px;
        border-radius: 8px;
        margin: 10px 0;
        font-family: 'Courier New', monospace;
        font-size: 1.1rem;
        border-left: 4px solid #4c4cff;
    }

    .respuesta-correcta {
        color: #28a745;
        font-weight: bold;
    }

    .respuesta-incorrecta {
        color: #dc3545;
        font-weight: bold;
    }

    .sin-respuesta {
        color: #f1c40f;
        font-style: italic;
    }

    @@media (max-width: 1200px) {
        .grid-acordeones {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 900px) {
        .grid-acordeones {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .grid-acordeones {
            grid-template-columns: 1fr;
        }

        h1 {
            font-size: 1.7rem;
        }

        .resultados {
            display: flex;
            flex-direction: column-reverse;
        }

        .botones-centrados {
            flex-direction: row;
            align-items: center;
            flex-wrap: inherit;
            gap: 10px;
            margin: 30px 5px;
        }

            .botones-centrados button {
                width: 100%;
                max-width: 300px;
            }

        .resumen-grid-contenedor p {
            font-size: 1rem;
        }

        .card-resumen {
            flex: 1 1 45%;
            max-width: 100%;
        }

        .card-valor {
            font-size: 1.2rem;
        }

        .card-icono {
            font-size: 1rem;
        }

        .contenedores-resumen {
            gap: 5px;
            flex-direction: row;
            display: flex;
            flex-wrap: wrap;
        }

        .container-barrap {
            width: 100%;
            margin-bottom: 30px;
        }

        .cont-onl, .container-barrap {
            flex: 1 1 100%;
            max-width: 100%;
        }
    }
</style>

<h1>🎲 Resumen Matemáticas con dados</h1>
<hr />

<div class="botones-centrados">
    <form method="get" asp-action="FormularioDados" asp-controller="Dados">
        <button type="submit" class="btn-primary">⚙️ Configuración</button>
    </form>

    <form method="get" asp-action="RepetirDados" asp-controller="Dados">
        <button type="submit" class="btn-success">🔁 Repetir</button>
    </form>

    <form method="get" asp-action="LimpiarYDashboard" asp-controller="Dados">
        <button type="submit" class="btn-secondary">🏠 Dashboard</button>
    </form>
</div>

<div class="resultados resultados-con-glow">
    <div class="cont-onl">
        <div class="contenedores-resumen">
            <div class="card-resumen total">
                <div class="card-titulo">TOTAL</div>
                <div class="card-icono">📄</div>
                <div class="card-valor" id="contadorTotal">@total</div>
            </div>
            <div class="card-resumen correctos">
                <div class="card-titulo">CORRECTOS</div>
                <div class="card-icono">✅</div>
                <div class="card-valor" id="contadorCorrectos">@correctos</div>
            </div>
            <div class="card-resumen incorrectos">
                <div class="card-titulo">INCORRECTOS</div>
                <div class="card-icono">❌</div>
                <div class="card-valor" id="contadorIncorrectos">@incorrectos</div>
            </div>
            <div class="card-resumen experiencia">
                <div class="card-titulo">XP</div>
                <div class="card-icono">✨</div>
                <div class="card-valor" id="contadorXP">@porcentaje.ToString("0") XP + @totalPuntos</div>
            </div>
        </div>
    </div>

    <div class="container-barrap">
        <p>🎯 Porcentaje de éxito: <strong>@((int)porcentaje)%</strong></p>

        <div class="barra-progreso" style="width: 100%; max-width: 300px;">
            <div class="barra-progreso-interna shimmer" id="barraProgreso" style="background-color: @barraColor;"></div>
        </div>
        <div id="estrellas" class="estrellas-container"></div>
        <p style="margin:0;">⏱️ Tiempo total: <strong>@tiempoTotal.ToString("0.00")s</strong></p>
        <p style="margin-bottom:0;">⏱️ Tiempo promedio: <strong>@tiempoPromedio.ToString("0.00")s</strong></p>
        <p style="margin-bottom:0;">⭐ Puntos adquiridos: <strong id="contadorPuntosTexto">@totalPuntos</strong></p>
    </div>
</div>

<div class="grid-acordeones">
    @for (int i = 0; i < Model.Ejercicios.Count; i++)
    {
        var ejercicio = Model.Ejercicios[i];
        var respuesta = Model.Respuestas[i];
        var colorClass = string.IsNullOrEmpty(respuesta.Respuesta_Usuario) ? "no-respondio" : respuesta.Es_Correcta ? "correcto" : "incorrecto";
        var estado = string.IsNullOrEmpty(respuesta.Respuesta_Usuario) ? "No respondió" : respuesta.Es_Correcta ? "✅ Correcto" : "❌ Incorrecto";

        // Cálculo de puntos por ejercicio individual
        int puntosEjercicio = (respuesta.Es_Correcta && respuesta.DadosUtilizados > 0) ? respuesta.DadosUtilizados : 0;

        <details class="@colorClass">
            <summary>Ejercicio @(i + 1): @estado</summary>
            <div>
                <div class="dados-mini">
                    @for (int j = 0; j < ejercicio.Dados.Length; j++)
                    {
                        <div class="dado-mini">@ejercicio.Dados[j]</div>
                    }
                    <div class="dado-mini dado-resultado-mini">@ejercicio.Dado_Resultado</div>
                </div>

                <div class="expresion-matematica">
                    <strong>Tu operación:</strong><br />
                    @if (string.IsNullOrEmpty(respuesta.Respuesta_Usuario))
                    {
                        <span class="sin-respuesta">No respondió</span>
                    }
                    else
                    {
                        @respuesta.Respuesta_Usuario
                    }
                </div>

                <p>
                    🎯 <strong>Resultado esperado:</strong><br />
                    <span class="respuesta-correcta">@ejercicio.Dado_Resultado</span>
                </p>

                <p>⏱️ <strong>Tiempo respuesta:</strong><br /> @respuesta.Tiempo_Respuesta.ToString("0.00")s</p>

                @if (!string.IsNullOrEmpty(respuesta.Respuesta_Usuario))
                {
                    <p>🎲 <strong>Dados utilizados:</strong><br /> @respuesta.DadosUtilizados de 5</p>
                }

                @if (!string.IsNullOrEmpty(respuesta.Respuesta_Usuario) && !respuesta.Es_Correcta)
                {
                    <p>
                        📊 <strong>Estado:</strong><br />
                        <span class="respuesta-incorrecta">La operación no da el resultado correcto</span>
                    </p>
                }

                <p style="margin-top: 15px; text-align: center;">
                    @if (string.IsNullOrEmpty(respuesta.Respuesta_Usuario))
                    {
                        <span class="sin-respuesta">Ejercicio no evaluado</span>
                
                        <br />
                        <span class="puntos-destaque" style="color:#aaa;">0 pts</span>
                    }
                    else if (respuesta.Es_Correcta)
                    {
                        <span class="respuesta-correcta">Evaluación Correcta</span>
                
                        <br />
                        <span class="puntos-destaque" style="color:#28a745;">+@puntosEjercicio pts</span>
                    }
                    else
                    {
                        <span class="respuesta-incorrecta">Evaluación Incorrecta</span>
                
                        <br />
                        <span class="puntos-destaque" style="color:#dc3545;">0 pts</span>
                    }
                </p>
            </div>
        </details>
    }
</div>

@section scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const porcentaje = @porcentaje;
            const barra = document.getElementById("barraProgreso");
            const estrellasContainer = document.getElementById("estrellas");

            let progreso = 0;
            const velocidad = 200;
            const incremento = Math.max(1, porcentaje / (1000 / velocidad));

            const animarBarra = setInterval(() => {
                if (progreso >= porcentaje) {
                    clearInterval(animarBarra);
                    barra.classList.add("parpadeo");
                    lanzarEstrellitas();
                    return;
                }
                progreso += incremento;
                barra.style.width = `${Math.min(progreso, porcentaje)}%`;
            }, velocidad);

            function lanzarEstrellitas() {
                for (let i = 0; i < 15; i++) {
                    const estrella = document.createElement("div");
                    estrella.classList.add("estrella");
                    estrella.innerText = "✨";
                    estrella.style.left = `${Math.random() * 80 + 10}%`;
                    estrellasContainer.appendChild(estrella);

                    setTimeout(() => estrella.remove(), 1000);
                }
            }
        });

        // Función de animación con el parámetro 'suffix'
        function animateCount(element, endValue, duration = 2000, suffix = "") {
            const start = 0;
            const startTime = performance.now();

            function update(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const value = Math.floor(progress * endValue);

                // Aplica el formato exacto: numero_animado + sufijo
                element.textContent = value + suffix;

                if (progress < 1) {
                    requestAnimationFrame(update);
                } else {
                    element.textContent = endValue + suffix;
                }
            }

            requestAnimationFrame(update);
        }

        window.addEventListener('DOMContentLoaded', () => {
            // Aquí pasamos exactamente " + [totalPuntos]" como sufijo
            animateCount(document.getElementById('contadorXP'), @((int)porcentaje), 2000, " + @totalPuntos");

            // Animación para el contador de puntos debajo de la barra
            if(document.getElementById('contadorPuntosTexto')) {
                animateCount(document.getElementById('contadorPuntosTexto'), @totalPuntos, 2000, "");
            }
        });
    </script>
}