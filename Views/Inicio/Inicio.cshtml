    .dashboard-section {
        margin-left: -2rem;
        margin-right: -2rem;
        padding: 0 2rem 4rem 2rem;
        display: flex;
        justify-content: center;
        position: relative;
        background: linear-gradient(180deg, rgba(0, 46, 230, 0.7) 0%, #010f36 60%, #010f36 100%);
    }

        .dashboard-section.is-visible .dashboard-wrapper {
