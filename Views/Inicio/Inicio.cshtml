    }

        .ranking-wrapper img {
            max-width: 100%;
            height: auto;
            display: block;
        }

    /* Efecto de desvanecimiento para la imagen del ranking */
    .ranking-fade-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 50%; /* Desvanece la mitad inferior */
        /* Degradado de transparente a el color de fondo oscuro */
        background: linear-gradient(to bottom, rgba(1, 15, 54, 0) 0%, #010f36 90%, #010f36 100%);
        pointer-events: none;
    }

    .ranking-text {
        flex: 1;
        min-width: 300px;
        color: white;
    }

        .ranking-text h2 {
            font-size: 2.2rem;
            margin-bottom: 1.5rem;
            color: white;
            font-weight:600;
        }

        .ranking-text p {
            font-size: 1.1rem;
