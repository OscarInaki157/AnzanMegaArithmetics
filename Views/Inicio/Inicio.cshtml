 }

    .benefits-section {
        /* 1. Rompemos el contenedor para que abarque el 100% de la pantalla */
        margin-left: -2rem;
        margin-right: -2rem;
        /* 2. El fondo blanco sólido */
        background-color: #ffffff;
        /* 3. Ajustamos el padding (añadimos padding horizontal para compensar los márgenes negativos) */
        padding: 2rem;
        text-align: center;
        /* Opcional: Una sutil sombra superior para separar el corte con la sección oscura */
        box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.2);
        position: relative;
        z-index: 10;
    }

        /* Modificación para el título con degradado */
        .gradient-title {
            font-size: 2.2rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            /* Aplicamos el degradado similar al dashboard */
            background: linear-gradient(90deg, #002ee6 0%, #010f36 100%);
            /* Truco para que el degradado esté dentro del texto */
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            color: transparent; /* Fallback */
            margin-top:0;
            display: inline-block; /* Para que el degradado se ajuste al ancho del texto */
        }

        /* Ajuste opcional para el párrafo de abajo para que no quede pegado */
        .benefits-section p {
            color: #4b5563; /* Un gris oscuro para que resalte en el fondo blanco */
            margin-bottom: 3rem;
            font-size: 1.2rem;
            margin-bottom:0;
        }

    .carousel-container {
        position: relative;
        width: 100%;
        max-width: 1200px;
        margin: 0;
        height: 450px;
        overflow: hidden;
        perspective: 1000px; /* Crucial para el efecto 3D */
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .fade-edge {
        position: absolute;
        top: 0;
        width: 15%;
        height: 100%;
        z-index: 10;
        pointer-events: none;
    }

        .fade-edge.left {
            left: 0;
            background: linear-gradient(to right, rgba(255,255,255,1), rgba(255,255,255,0));
        }

        .fade-edge.right {
            right: 0;
            background: linear-gradient(to left, rgba(255,255,255,1), rgba(255,255,255,0));
        }


    .benefits-cards {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        transform-style: preserve-3d;
    }

    .card {
        position: absolute;
        width: 300px;
        padding: 2.5rem 1.5rem;
        border-radius: 2rem;
        color: white;
        text-align: center;
        transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        user-select: none;
    }

.card img {
    height: 60px;
}

        .card.active {
            transform: translate3d(0, 0, 100px) scale(1.1);
            z-index: 5;
            opacity: 1;
        }

        /* Izquierda (Pequeña) */
        .card.prev {
            transform: translate3d(-100%, 0, 0) scale(0.8);
            z-index: 3;
            opacity: 0.6;
        }

        /* Derecha (Pequeña) */
        .card.next {
            transform: translate3d(100%, 0, 0) scale(0.8);
            z-index: 3;
            opacity: 0.6;
        }

        /* Ocultas (Para las que no están en el foco) */
        .card.hidden {
            transform: translate3d(0, 0, -100px) scale(0.5);
            z-index: 1;
            opacity: 0;
        }

.icon-wrapper {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.1);
