    .dashboard-wrapper {
        max-width: 1000px;
        width: 100%;
        position: relative;

        border-bottom: none;
        border-radius: 12px 12px 0 0;
        overflow: hidden;
        box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.3);

        opacity: 0;
        transform: translateY(100px);
        transition: opacity 1s ease-out, transform 1s ease-out;
        will-change: transform, opacity;
    }


        .dashboard-wrapper img {
            width: 100%;
            height: auto;
            display: block; /* Evita espacios fantasma debajo de la imagen */
        }

    /* El efecto que desvanece la imagen en la parte inferior */
    .fade-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 60%; /* La mitad inferior de la imagen se verá afectada */
        /* Un degradado que va de transparente al color exacto de tu fondo */
        background: linear-gradient(to bottom, rgba(1, 15, 54, 0) 0%, #010f36 90%, #010f36 100%);
        pointer-events: none; /* Asegura que la capa no interfiera si la imagen tuviera clics */
    }
    /* Nuevo estilo para el CTA principal en blanco sólido (Inicio.cshtml) */
