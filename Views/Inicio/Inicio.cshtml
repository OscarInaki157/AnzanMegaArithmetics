    }

        .streaks-text h2 {
            font-size: 2.2rem;
            margin-bottom: 1.5rem;
            color: white;
            font-weight:600;
        }

        .streaks-text p {
            font-size: 1.1rem;
            line-height: 1.8;
            color: #d1d1f0;
            text-align: justify;
        }

    .streaks-media {
        flex: 1;
        max-width: 35rem;
        text-align: center;
    }

    .streaks-wrapper {
        position: relative;
        border-radius: 12px;
        overflow: hidden;
        /* Le damos una sombra y borde sutil igual que a la imagen del ranking */
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        /* border: 1px solid rgba(255, 255, 255, 0.1); */
    }

        .streaks-wrapper img {
            width: 100%;
            height: auto;
            display: block;
        }

    /* El efecto de desvanecimiento para el GIF */
    .streaks-fade-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 50%;
        background: linear-gradient(to bottom, rgba(1, 15, 54, 0) 0%, #010f36 90%, #010f36 100%);
        pointer-events: none;
    }
    /* Nueva sección de Ranking */
    .ranking-section {
        padding: 5rem 2rem;
        display: flex;
        justify-content: center;
        background-color: #010f36; /* Volvemos al fondo oscuro */
        overflow:hidden;
    }

        .ranking-section.reveal .ranking-image.left {
            opacity: 0;
            transform: translateX(-100px); /* Viene de la izquierda */
            transition: all 1s ease-out;
            will-change: transform, opacity;
            transition-delay: 0.2s;
        }

        .ranking-section.reveal .ranking-text.right {
            opacity: 0;
            transform: translateX(100px); /* Viene de la derecha */
            transition: all 1s ease-out;
            will-change: transform, opacity;
            transition-delay: 0.2s;
        }

        .ranking-section.is-visible .ranking-image.left,
        .ranking-section.is-visible .ranking-text.right {
            opacity: 1;
