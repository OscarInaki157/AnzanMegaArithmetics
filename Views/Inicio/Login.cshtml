@model AnzanMegaArithmetics.Models.LoginResponseModel;
@{
    ViewBag.Title = "Iniciar Sesión";
    Layout = "_Layout";
}

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 4rem 2rem;
        flex-wrap: wrap;
        background-color: #10132f;
        color: white;
    }

    .login-left {
        flex: 1;
        min-width: 300px;
        text-align: center;
        padding: 2rem;
    }

        .login-left img {
            max-width: 60%;
            height: auto;
            border-radius: 1rem;
            margin-bottom: 1.5rem;
        }

        .login-left .tit {
            font-size: 1.8rem;
            margin-bottom: 1rem;
            color: white;
        }

        .login-left .subtit {
            font-size: 1.2rem;
            color: #d1d1f0;
        }

    .login-right {
        flex: 1;
        min-width: 300px;
        background-color: #1b1e3c;
        padding: 2rem;
        border-radius: 1.5rem;
        box-shadow: 0 0 20px rgba(0,0,0,0.3);
    }

        .login-right form {
            display: flex;
            flex-direction: column;
        }

        .login-right label {
            margin-bottom: 0.5rem;
            color: #d1d1f0;
            font-weight: 600;
        }

        .login-right input {
            padding: 0.8rem;
            margin-bottom: 1.5rem;
            border: none;
            border-radius: 0.6rem;
            background-color: #292c4f;
            color: white;
            font-size: 1rem;
        }

            .login-right input::placeholder {
                color: #a0a0d0;
            }

        .login-right button {
            background-color: #4c4cff;
            color: white;
            padding: 0.9rem;
            font-size: 1.1rem;
            border: none;
            border-radius: 10px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .login-right button:hover {
                background-color: #3737e8;
                transform: translateY(-2px);
                box-shadow: 0 6px 15px rgba(76, 76, 255, 0.3);
            }

        .login-right p {
            margin-top: 1rem;
            font-size: 0.95rem;
            color: #ff6b6b;
            text-align: center;
        }

    @@media (max-width: 768px) {
        .login-container {
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 2rem 1rem;
        }

        .login-left,
        .login-right {
            width: 100%;
            max-width: 400px;
            margin: 0 auto;
        }

            .login-left img {
                max-width: 50%;
                margin: 0 auto 1rem;
            }

        .login-right {
            margin-top: 2rem;
        }
    }

</style>


<div class="login-container">
    <div class="login-left">
        <img src="/Content/Images/iconoMM.png" alt="Anzan 1" />
        <h1 class="tit">Únete a esta experiencia única, practica y aprende con nosotros</h1>
        <h2 class="subtit">¡Inicia sesión en Mentes México!</h2>
    </div>
    <div class="login-right">
        <form action="@Url.Action("ValidarUser", "Inicio")" method="post" id="Logines">
            <label for="username">Nombre o correo:</label>
            <input type="text" name="Usuario" placeholder="Nombre o correo" required>

            <label for="password">Contraseña:</label>
            <input type="password" name="Pass" placeholder="Contraseña" required>

            <button type="submit">Iniciar sesión</button>

            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <p style="color: red;">@ViewBag.ErrorMessage</p>
            }
        </form>
    </div>
</div>

@section Scripts {
    <script>
window.addEventListener('load', function () {
    const form = document.getElementById('Logines');
    if (form) {
       form.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
})
    </script>
}