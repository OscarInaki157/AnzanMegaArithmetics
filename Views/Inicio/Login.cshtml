@model AnzanMegaArithmetics.Models.LoginResponseModel;
@{
    ViewBag.Title = "Iniciar Sesión";
    Layout = "_Layout";
}

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 4rem 2rem;
        flex-wrap: wrap;
        color: white;
    }

    .login-left {
        flex: 1;
        min-width: 300px;
        text-align: center;
        padding: 2rem;
    }

        .login-left img {
            max-width: 50%;
            height: auto;
            border-radius: 1rem;
        }

        .login-left .tit {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            color: white;
        }

        .login-left .subtit {
            font-size: 1.7rem;
            color: #d1d1f0;
        }

    .login-right {
        flex: 1;
        min-width: 300px;
        background-color: #1b1e3c;
        padding: 2rem;
        border-radius: 1.5rem;
        box-shadow: 0 0 20px rgba(0,0,0,0.3);
    }

        .login-right form {
            display: flex;
            flex-direction: column;
        }

        .login-right label {
            margin-bottom: 0.5rem;
            color: #d1d1f0;
            font-weight: 600;
        }

        .login-right input {
            padding: 0.8rem;
            margin-bottom: 0.5rem;
            border: none;
            border-radius: 0.6rem;
            background-color: #292c4f;
            color: white;
            font-size: 1rem;
            width: 100%;
        }

            .login-right input::placeholder {
                color: #a0a0d0;
            }


        .button{
            background-color: #4c4cff;
            color: white;
            padding: 0.9rem;
            font-size: 1.1rem;
            border: none;
            border-radius: 10px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
        
        }

            .login-right button:hover {
                transform: translateY(-2px);
            }

        .login-right p {
            margin-top: 1rem;
            font-size: 0.95rem;
            color: #ff6b6b;
            text-align: center;
        }

    .password-container {
        display: flex;
        flex-direction: column;
        margin-bottom: 1rem; /* Mantiene el espacio original */
    }

    .toggle-password {
        background: none;
        border: none;
        color: #a0a0d0;
        cursor: pointer;
        font-size: 1rem;
        padding: 0.5rem 0;
        text-align: left;
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
    }

        .toggle-password:hover {
            color: white;
            background: none;
        }

    @@media (max-width: 768px) {
        .login-container {
            flex-direction: column;
            align-items: center;
            padding: 2rem 1rem;
        }

        .login-left,
        .login-right {
            width: 100%;
            max-width: 400px;
            margin: 0 auto;
        }

            .login-left img {
                max-width: 50%;
                margin: 0 auto 1rem;
            }

        .login-right {
            margin-top: 2rem;
        }
    }
</style>


<div class="login-container">
    <div class="login-left">
        <img src="/Content/Images/iconoMM.png" alt="Mentes Mexico" />
        <h2 class="subtit">Mentes México ®</h2>
        <h1 class="tit">Únete a esta experiencia única, practica y aprende con nosotros</h1>
    </div>
    <div class="login-right">
        <form action="@Url.Action("ValidarUser", "Inicio")" method="post" id="Logines">
            <label for="username">Nombre o correo:</label>
            <input type="text" name="Usuario" placeholder="Nombre o correo" required>

            <label for="password">Contraseña:</label>
            <div class="password-container">
                <input type="password" name="Pass" id="passwordField" placeholder="Contraseña" required>
                <button type="button" class="toggle-password" id="togglePassword">Mostrar contraseña</button>
            </div>

            <button type="submit" class="button">Iniciar sesión</button>

            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <p style="color: red;">@ViewBag.ErrorMessage</p>
            }
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const togglePassword = document.getElementById('togglePassword');
            const passwordField = document.getElementById('passwordField');

            togglePassword.addEventListener('click', function() {
                const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordField.setAttribute('type', type);
                this.textContent = type === 'password' ? 'Mostrar contraseña' : 'Ocultar contraseña';
            });
        });
    </script>
}