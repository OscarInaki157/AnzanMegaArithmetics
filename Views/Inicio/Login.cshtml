@model AnzanMegaArithmetics.Models.LoginResponseModel;
@{
    ViewBag.Title = "Iniciar Sesión";
    Layout = "_Layout";
}

<style>
    /* Agregamos el degradado y rompemos el contenedor del layout */
    .login-container {
        /* Rompemos el contenedor para ocupar el 100% del ancho y llegar hasta el tope */
        margin-top: -8.5rem; /* Compensa el margin-top del main en el _Layout */
        margin-left: -2rem;
        margin-right: -2rem;
        /* Empujamos el contenido hacia abajo para que el header no lo tape */
        padding: 12rem 2rem 6rem 2rem;
        display: flex;
        justify-content: center;
        align-items: center; /* Centramos verticalmente */
        flex-wrap: wrap;
        color: white;
        /* Aseguramos que ocupe al menos toda la altura de la pantalla visible */
        min-height: 100vh;
        /* EL DEGRADADO: Igual al del inicio, naciendo desde arriba al centro */
        background: linear-gradient(360deg, rgba(0, 46, 230, 0.7) 0%, #010f36 78%, #010f36 100%);
    }

    .login-left {
        flex: 1;
        /* min-width: 300px; */
        text-align: center;
        padding:2rem;
    }

        .login-left img {
            max-width: 40%;
            height: auto;
            border-radius: 1rem;
        }

        .login-left .tit {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            color: white;
            line-height: 1.4;
        }

        .login-left .subtit {
            font-size: 1.7rem;
            color: #d1d1f0;
            margin-bottom: 1rem;
        }

    .login-right {
        flex: 1;
        
        max-width: 50%;
        background-color: rgba(27, 30, 60, 0.6);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 2.5rem;
        border-radius: 1.5rem;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    }

        .login-right form {
            display: flex;
            flex-direction: column;
        }

        .login-right label {
            margin-bottom: 0.5rem;
            color: #d1d1f0;
            font-weight: 600;
        }

        .login-right input {
            padding: 0.8rem 1rem; /* Un poco más de padding horizontal */
            margin-bottom: 0.5rem;
            border: 1px solid rgba(255, 255, 255, 0.1); /* Borde sutil */
            border-radius: 0.6rem;
            background-color: rgba(0, 0, 0, 0.2); /* Fondo de input translúcido */
            color: white;
            font-size: 1rem;
            width: 100%;
            transition: border-color 0.3s ease;
        }

            /* Efecto focus en los inputs */
            .login-right input:focus {
                outline: none;
                border-color: #4c4cff;
                background-color: rgba(0, 0, 0, 0.3);
            }

            .login-right input::placeholder {
                color: #8080a0;
            }


    .button {
        background-color: #4c4cff; /* El azul vibrante de tus botones de navegación */
        color: white;
        padding: 1rem;
        font-size: 1.1rem;
        border: none;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 1rem;
    }

        .button:hover {
            background-color: #3737e8; /* Azul más oscuro al pasar el mouse */
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(76, 76, 255, 0.4); /* Resplandor azul */
        }

    .login-right p {
        margin-top: 1.5rem;
        font-size: 0.95rem;
        text-align: center;
    }

    .password-container {
        display: flex;
        flex-direction: column;
        margin-bottom: 0.5rem;
    }

    .toggle-password {
        background: none;
        border: none;
        color: #a0a0d0;
        cursor: pointer;
        font-size: 0.9rem;
        padding: 0.5rem 0;
        text-align: right; /* Alineamos a la derecha para que se vea más ordenado */
        transition: color 0.3s ease;
    }

        .toggle-password:hover {
            color: white;
        }

    @@media (max-width: 768px) {
        .login-container

    {
        flex-direction: column;
        padding: 8rem 1.5rem 4rem 1.5rem; /* Ajustamos padding para móvil */
    }

    .login-left,
    .login-right {
        width: 100%;
        max-width: 400px;
        margin: 0 auto;
    }

        .login-left img {
            max-width: 50%;
            margin: 0 auto 1rem;
        }

    .login-right {
        margin-top: 2rem;
        padding: 2rem 1.5rem;
    }

    }
</style>



<div class="login-container">
    <div class="login-left">
        <img src="/Content/Images/iconoMM.png" alt="Mentes Mexico" />
        <h2 class="subtit">Mentes México ®</h2>
        <h1 class="tit">Únete a esta experiencia única, practica y aprende con nosotros</h1>
    </div>
    <div class="login-right">
        <form action="@Url.Action("ValidarUser", "Inicio")" method="post" id="Logines">
            <label for="username">Nombre, correo o gamertag:</label>
            <input type="text" name="Usuario" placeholder="Nombre, correo o gamertag" required>

            <label for="password">Contraseña:</label>
            <div class="password-container">
                <input type="password" name="Pass" id="passwordField" placeholder="Contraseña" required>
                <button type="button" class="toggle-password" id="togglePassword">Mostrar contraseña</button>
            </div>

            <button type="submit" class="button">Iniciar sesión</button>

            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <p style="color: red;">@ViewBag.ErrorMessage</p>
            }
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const togglePassword = document.getElementById('togglePassword');
            const passwordField = document.getElementById('passwordField');

            togglePassword.addEventListener('click', function() {
                const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordField.setAttribute('type', type);
                this.textContent = type === 'password' ? 'Mostrar contraseña' : 'Ocultar contraseña';
            });
        });
    </script>
}