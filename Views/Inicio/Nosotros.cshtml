@{
    ViewBag.Title = "Nosotros";
    Layout = "_Layout";
}

<section class="us-hero-section">
    <div class="us-hero-content">
        @* Imagen a la izquierda, carga primero *@
        <div class="us-hero-image us-animate-fadeInUp">
            @* Reemplaza por la ruta de tu imagen *@
            <img src="/Content/Images/Inicio/Nosotros2.png" alt="Ilustración del método Mentes México" />
        </div>

        @* Texto a la derecha, carga con un pequeño delay *@
        <div class="us-hero-text us-animate-fadeInUp delayed-1">
            <h1>Mentes México: Redefiniendo el Potencial Mental</h1>
            <p>
                El cálculo mental es más que rapidez: es estructurar el pensamiento. En Mentes México fusionamos el ábaco japonés, FingerMath y la memorización avanzada para potenciar tu plasticidad cerebral y retención. Nuestro objetivo es impulsar el talento en el país y demostrar que todos podemos ser verdaderos atletas mentales.
            </p>
        </div>
    </div>
</section>

@* --- SECCIÓN MISIÓN, VISIÓN Y VALORES (Fondo Blanco) --- *@
<section class="mission-vision-section reveal" id="mission-vision-section">
    <div class="mvv-container">
        <h2 class="gradient-title" style="text-align: center; width: 100%; margin-bottom: 3rem;">Nuestra Esencia</h2>

        <div class="mvv-cards-wrapper">
            @* TARJETA MISIÓN *@
            <div class="card purple static-card delay-1">
                <div class="icon-wrapper">
                    @* Reemplaza con tus propios GIFs o íconos *@
                    <img src="/Content/Images/Inicio/mision.gif" alt="Ícono Misión" />
                </div>
                <h3>Misión</h3>
                <p>Democratizar el aprendizaje del cálculo mental en México, brindando herramientas interactivas que desarrollen la agilidad cognitiva de nuestros usuarios.</p>
            </div>

            @* TARJETA VISIÓN *@
            <div class="card blue static-card delay-2">
                <div class="icon-wrapper">
                    <img src="/Content/Images/Inicio/vision.gif" alt="Ícono Visión" />
                </div>
                <h3>Visión</h3>
                <p>Ser la plataforma líder en América Latina en entrenamiento mental, transformando la manera en que las personas procesan, calculan y retienen información.</p>
            </div>

            @* TARJETA VALORES *@
            <div class="card navy static-card delay-3">
                <div class="icon-wrapper">
                    <img src="/Content/Images/Inicio/valores.gif" alt="Ícono Valores" />
                </div>
                <h3>Valores</h3>
                <p>Innovación educativa, constancia, accesibilidad tecnológica y un fuerte compromiso con el desarrollo intelectual de nuestra comunidad.</p>
            </div>
        </div>
    </div>
</section>

<style>

    .mission-vision-section {
        background-color: #ffffff;
        padding: 6rem 2rem;
        display: flex;
        justify-content: center;
        margin-left: -2rem; /* Rompe el contenedor global si lo tienes */
        margin-right: -2rem;
    }

    .mvv-container {
        max-width: 1200px;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .mvv-cards-wrapper {
        display: flex;
        flex-direction: row;
        justify-content: center;
        gap: 2.5rem;
        width: 100%;
        flex-wrap: wrap; /* Vital para que se acomoden en móviles */
    }

    /* --- Modificador para Tarjetas Estáticas --- */
    /* Sobrescribe el 'position: absolute' del carrusel para que se formen en fila */
    .card.static-card {
        position: relative;
        flex: 1;
        min-width: 280px;
        max-width: 350px;
        /* Preparamos la animación de entrada (aparecen desde abajo) */
        opacity: 0;
        transform: translateY(40px);
        transition: all 0.6s ease-out;
        will-change: transform, opacity;
    }

        /* Animación Hover: Para que sigan siendo interactivas al pasar el mouse */
        .card.static-card:hover {
            transform: translateY(-10px) !important;
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
        }

    /* --- Animación al hacer scroll (Controlado por JS) --- */
    .mission-vision-section.is-visible .static-card {
        opacity: 1;
        transform: translateY(0);
    }

    /* Delays escalonados (1, 2, 3) */
    .mission-vision-section .delay-1 {
        transition-delay: 0.1s;
    }

    .mission-vision-section .delay-2 {
        transition-delay: 0.3s;
    }

    .mission-vision-section .delay-3 {
        transition-delay: 0.5s;
    }

    .us-hero-section {
        margin-top: -8.5rem; /* Ajuste para Navbar transparente */
        margin-left: -2rem;
        margin-right: -2rem;
        padding: 12rem 2rem 6rem 2rem; /* Más padding abajo para la sección About */
        display: flex;
        justify-content: center;
        /* MISMO DEGRADADO EXACTO QUE EN INICIO */
        background: linear-gradient(360deg, rgba(0, 46, 230, 0.7) 0%, #010f36 78%, #010f36 100%);
        color: white;
    }

    .us-hero-content {
        display: flex;
        flex-direction: row; /* Imagen a la Izquierda, Texto a la Derecha */
        align-items: center;
        justify-content: space-between;
        max-width: 1200px;
        width: 100%;
        gap: 4rem; /* Espacio generoso entre columnas */
    }

    .us-hero-image {
        flex: 1;
        text-align: center;
        min-width: 300px;
    }

        .us-hero-image img {
            max-width: 90%;
            height: auto;
            display: block;
            margin: 0 auto;
        }

    .us-hero-text {
        flex: 1.5; /* El texto recibe un poco más de espacio */
        min-width: 300px;
        text-align: left;
    }

        .us-hero-text h1 {
            font-size: 2.2rem;
            font-weight: 600;
            color: white;
            margin-top: 0;
            margin-bottom: 2rem;
        }

        .us-hero-text p {
            /* MISMO COLOR DE TEXTO OPACO QUE EN INICIO */
            color: #bcbce9;
            font-size: 1.2rem;
            line-height: 1.8;
            text-align: justify;
            margin-bottom: 0;
        }

    /* --- LÓGICA DE ANIMACIÓN ESCALONADA AL CARGAR LA PÁGINA --- */
    .us-animate-fadeInUp {
        opacity: 0;
        transform: translateY(30px);
        animation: fadeInUpUs 1s ease-out forwards;
    }

    .delayed-1 {
        animation-delay: 0.3s; /* Delay para el texto */
    }

    @@keyframes fadeInUpUs {
        to

    {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .devices-section {
        background-color: #ffffff; /* Fondo blanco */
        padding: 5rem 2rem;
        display: flex;
        justify-content: center;
        overflow: hidden; /* Evita scroll horizontal con la animación */
        margin-left: -2rem; /* Rompe el padding si tu layout lo tiene */
        margin-right: -2rem;
        position: relative;
    }

    .devices-container {
        max-width: 1200px;
        width: 100%;
        display: flex;
        flex-wrap: wrap; /* Permite que colapse en móviles */
        align-items: center;
        gap: 3rem;
    }

    .devices-image {
        flex: 1;
        min-width: 300px;
        text-align: center;
    }

        .devices-image img {
            max-width: 100%;
            height: auto;
            display: block;
            margin: 0 auto;
            filter: drop-shadow(0px 18px 25px rgba(0, 0, 0, 0.35));
        }

    .devices-text {
        flex: 1;
        min-width: 300px;
    }

        .devices-text p {
            font-size: 1.15rem;
            color: #4b5563; /* Gris oscuro para que se lea perfecto en blanco */
            line-height: 1.7;
            text-align: justify;
            margin-bottom: 0;
        }

    /* --- ANIMACIÓN CON DELAYS --- */
    .devices-section.reveal .devices-image.left {
        opacity: 0;
        transform: translateX(-100px);
        transition: all 1s ease-out;
        transition-delay: 0.2s; /* Espera un poco al scrollear */
        will-change: transform, opacity;
    }

    .devices-section.reveal .devices-text.right {
        opacity: 0;
        transform: translateX(100px);
        transition: all 1s ease-out;
        transition-delay: 0.5s; /* El texto entra después de la imagen */
        will-change: transform, opacity;
        padding: 1rem;
    }

    .devices-section.is-visible .devices-image.left,
    .devices-section.is-visible .devices-text.right {
        opacity: 1;
        transform: translateX(0);
    }

    #streaks-section .scale-text {
        opacity: 0;
        transform: translateY(40px);
        transition: all 0.8s ease-out;
        will-change: transform, opacity;
        transition-delay: 0.2s;
    }

    /* Estado inicial de la imagen (pequeña y transparente) */
    #streaks-section .scale-image {
        opacity: 0;
        transform: scale(0.7);
        /* El cubic-bezier le da el efecto de rebote al final */
        transition: all 0.9s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        transition-delay: 0.2s; /* Espera un poco a que salga el texto primero */
        will-change: transform, opacity;
    }

    /* Estado final (visible) - Activado por JS */
    #streaks-section.is-visible .scale-text {
        opacity: 1;
        transform: translateY(0);
    }

    #streaks-section.is-visible .scale-image {
        opacity: 1;
        transform: scale(1);
    }

    .split-info-section {
        background-color: #ffffff;
        padding: 3rem 2rem 0 2rem;
        position: relative;
        z-index: 20;
        /* Evita que se vea scroll horizontal si la imagen se mueve mucho */
        overflow: hidden;
        margin-left: -2rem;
        margin-right: -2rem;
    }

    .split-container {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-direction: row;
        gap: 3rem;
        align-items: flex-start;
    }

    .split-column {
        flex: 1;
        min-width: 0;
    }

        .split-column h2.gradient-title {
            font-size: 2.2rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            background: linear-gradient(90deg, #002ee6 0%, #010f36 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .split-column p {
            font-size: 1.15rem;
            color: #4b5563;
            line-height: 1.7;
            margin-bottom: 8rem;
            text-align: justify;
        }

    /* Contenedor con efecto de salida y preparación para Parallax */
    .split-image-wrapper {
        position: relative;
        width: 100%;
        margin-top: -2rem;
        margin-bottom: -8rem;
        border-radius: 15px 15px 0 0;
        overflow: hidden;
        /* box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2); */
        transition: transform 0.1s ease-out; /* Suaviza el movimiento del JS */
        will-change: transform;
    }

    .image-fade-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 45%;
        /* Por defecto: Desvanecido al azul de la sección siguiente (#010f36) */
        background: linear-gradient(to bottom, rgba(255, 255, 255, 0) 0%, #010f36 90%, #010f36 100%);
        pointer-events: none;
    }
    /* --- Sección de Rachas y Gamificación --- */
    .streaks-section {
        padding: 5rem 2rem;
        display: flex;
        justify-content: center;
        background-color: #010f36; /* Mantiene el fondo oscuro */
    }

    .streaks-container {
        max-width: 1200px;
        width: 100%;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 3rem;
    }

    .streaks-text {
        flex: 1;
        min-width: 300px;
        color: white;
    }

        .streaks-text h2 {
            font-size: 2.2rem;
            margin-bottom: 1.5rem;
            color: white;
            font-weight: 600;
        }

        .streaks-text p {
            font-size: 1.1rem;
            line-height: 1.8;
            color: #d1d1f0;
            text-align: justify;
        }

    .streaks-media {
        flex: 1;
        max-width: 35rem;
        text-align: center;
    }

    .streaks-wrapper {
        position: relative;
        border-radius: 12px;
        overflow: hidden;
        /* Le damos una sombra y borde sutil igual que a la imagen del ranking */
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        /* border: 1px solid rgba(255, 255, 255, 0.1); */
    }

        .streaks-wrapper img {
            width: 100%;
            height: auto;
            display: block;
        }

    /* El efecto de desvanecimiento para el GIF */
    .streaks-fade-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 50%;
        background: linear-gradient(to bottom, rgba(1, 15, 54, 0) 0%, #010f36 90%, #010f36 100%);
        pointer-events: none;
    }
    /* Nueva sección de Ranking */
    .ranking-section {
        padding: 5rem 2rem;
        display: flex;
        justify-content: center;
        background-color: #010f36; /* Volvemos al fondo oscuro */
        overflow: hidden;
    }

        .ranking-section.reveal .ranking-image.left {
            opacity: 0;
            transform: translateX(-100px); /* Viene de la izquierda */
            transition: all 1s ease-out;
            will-change: transform, opacity;
            transition-delay: 0.2s;
        }

        .ranking-section.reveal .ranking-text.right {
            opacity: 0;
            transform: translateX(100px); /* Viene de la derecha */
            transition: all 1s ease-out;
            will-change: transform, opacity;
            transition-delay: 0.2s;
        }

        .ranking-section.is-visible .ranking-image.left,
        .ranking-section.is-visible .ranking-text.right {
            opacity: 1;
            transform: translateX(0);
        }

    .ranking-container {
        max-width: 1200px;
        width: 100%;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 3rem; /* Espacio entre imagen y texto */
    }

    .ranking-image {
        flex: 1;
        max-width: 35rem; /* Un poco más grande para ver detalles del ranking */
        text-align: center;
    }

    .ranking-wrapper {
        position: relative;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        /* border: 1px solid rgba(255, 255, 255, 0.1); */
    }

        .ranking-wrapper img {
            max-width: 100%;
            height: auto;
            display: block;
        }

    /* Efecto de desvanecimiento para la imagen del ranking */
    .ranking-fade-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 50%; /* Desvanece la mitad inferior */
        /* Degradado de transparente a el color de fondo oscuro */
        background: linear-gradient(to bottom, rgba(1, 15, 54, 0) 0%, #010f36 90%, #010f36 100%);
        pointer-events: none;
    }

    .ranking-text {
        flex: 1;
        min-width: 300px;
        color: white;
    }

        .ranking-text h2 {
            font-size: 2.2rem;
            margin-bottom: 1.5rem;
            color: white;
            font-weight: 600;
        }

        .ranking-text p {
            font-size: 1.1rem;
            line-height: 1.8;
            color: #d1d1f0;
            text-align: justify;
        }

    .dashboard-section {
        margin-left: -2rem;
        margin-right: -2rem;
        padding: 0 2rem 4rem 2rem;
        display: flex;
        justify-content: center;
        position: relative;
        background: linear-gradient(180deg, rgba(0, 46, 230, 0.7) 0%, #010f36 60%, #010f36 100%);
    }

        .dashboard-section.is-visible .dashboard-wrapper {
            opacity: 1;
            transform: translateY(0);
        }

    .dashboard-wrapper {
        max-width: 1000px;
        width: 100%;
        position: relative;
        border-bottom: none;
        border-radius: 12px 12px 0 0;
        overflow: hidden;
        box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.3);
        opacity: 0;
        transform: translateY(100px);
        transition: opacity 1s ease-out, transform 1s ease-out;
        will-change: transform, opacity;
    }


        .dashboard-wrapper img {
            width: 100%;
            height: auto;
            display: block; /* Evita espacios fantasma debajo de la imagen */
        }

    /* El efecto que desvanece la imagen en la parte inferior */
    .fade-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 60%; /* La mitad inferior de la imagen se verá afectada */
        /* Un degradado que va de transparente al color exacto de tu fondo */
        background: linear-gradient(to bottom, rgba(1, 15, 54, 0) 0%, #010f36 90%, #010f36 100%);
        pointer-events: none; /* Asegura que la capa no interfiera si la imagen tuviera clics */
    }
    /* Nuevo estilo para el CTA principal en blanco sólido (Inicio.cshtml) */
    .btn-cta-white {
        background-color: #ffffff; /* Blanco sólido como en tu referencia */
        color: #010f36; /* Texto súper oscuro para máxima legibilidad */
        text-decoration: none;
        padding: 0.9rem 2rem;
        border-radius: 8px; /* Mantenemos la forma consistente */
        font-size: 1.1rem;
        font-weight: 700; /* Un poco más de peso para que resalte */
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        border: 1px solid transparent;
    }

        /* Efecto al pasar el mouse */
        .btn-cta-white:hover {
            background-color: #f1f5f9; /* Se oscurece ligeramente */
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(255, 255, 255, 0.2); /* Un resplandor blanco sutil */
        }

    .hero-section {
        margin-top: -8.5rem;
        margin-left: -2rem;
        margin-right: -2rem;
        padding: 10rem 2rem 4rem 2rem;
        display: flex;
        justify-content: center;
        background: linear-gradient(360deg, rgba(0, 46, 230, 0.7) 0%, #010f36 78%, #010f36 100%);
    }

    .hero-content {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        max-width: 1200px;
        width: 100%;
        flex-wrap: wrap;
        gap: 1rem;
        opacity: 0;
        animation: fadeInUp 1.2s ease-out forwards;
    }

    .hero-text {
        flex: 1;
        min-width: 280px;
        opacity: 0;
        animation: fadeInUp 1s ease-out forwards;
    }

    .nlogo {
        display: flex;
        margin: 0 auto;
        width: 14rem;
        height: auto;
    }

    .hero-text h1 {
        font-size: 2.9rem;
        color: white;
        margin-bottom: 1.5rem;
        margin-top: 0;
        text-align: justify;
        font-weight: 600;
    }

    .hero-text p {
        color: #bcbce9;
        font-size: 1.2rem;
        margin-bottom: 2rem;
        text-align: justify;
    }

    .cta-button {
        background-color: #4c4cff;
        color: white;
        text-decoration: none;
        padding: 0.9rem 2rem;
        border-radius: 10px;
        font-size: 1.1rem;
        font-weight: 600;
        transition: background-color 0.3s ease;
    }

        .cta-button:hover {
            background-color: #3737e8;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(76, 76, 255, 0.4);
        }


    .hero-image {
        flex: 1;
        text-align: center;
        min-width: 280px;
        opacity: 0;
        animation: fadeInUp 1s ease-out 0.3s forwards;
    }

        .hero-image img {
            max-width: 85%;
            height: auto;
        }

    .benefits-section {
        /* 1. Rompemos el contenedor para que abarque el 100% de la pantalla */
        margin-left: -2rem;
        margin-right: -2rem;
        /* 2. El fondo blanco sólido */
        background-color: #ffffff;
        /* 3. Ajustamos el padding (añadimos padding horizontal para compensar los márgenes negativos) */
        padding: 2rem;
        text-align: center;
        /* Opcional: Una sutil sombra superior para separar el corte con la sección oscura */
        box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.2);
        position: relative;
        z-index: 10;
    }

    /* Modificación para el título con degradado */
    .gradient-title {
        font-size: 2.2rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        /* Aplicamos el degradado similar al dashboard */
        background: linear-gradient(90deg, #002ee6 0%, #010f36 100%);
        /* Truco para que el degradado esté dentro del texto */
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        color: transparent; /* Fallback */
        margin-top: 0;
        display: inline-block; /* Para que el degradado se ajuste al ancho del texto */
    }

    /* Ajuste opcional para el párrafo de abajo para que no quede pegado */
    .benefits-section p {
        color: #4b5563; /* Un gris oscuro para que resalte en el fondo blanco */
        margin-bottom: 3rem;
        font-size: 1.2rem;
        margin-bottom: 0;
    }

    .carousel-container {
        position: relative;
        width: 100%;
        max-width: 1200px;
        margin: 0;
        height: 450px;
        overflow: hidden;
        perspective: 1000px; /* Crucial para el efecto 3D */
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .fade-edge {
        position: absolute;
        top: 0;
        width: 15%;
        height: 100%;
        z-index: 10;
        pointer-events: none;
    }

        .fade-edge.left {
            left: 0;
            background: linear-gradient(to right, rgba(255,255,255,1), rgba(255,255,255,0));
        }

        .fade-edge.right {
            right: 0;
            background: linear-gradient(to left, rgba(255,255,255,1), rgba(255,255,255,0));
        }


    .benefits-cards {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        transform-style: preserve-3d;
    }

    .card {
        position: absolute;
        width: 300px;
        padding: 2.5rem 1.5rem;
        border-radius: 2rem;
        color: white;
        text-align: center;
        transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        user-select: none;
    }

        .card img {
            height: 60px;
        }

        .card.active {
            transform: translate3d(0, 0, 100px) scale(1.1);
            z-index: 5;
            opacity: 1;
        }

        /* Izquierda (Pequeña) */
        .card.prev {
            transform: translate3d(-100%, 0, 0) scale(0.8);
            z-index: 3;
            opacity: 0.6;
        }

        /* Derecha (Pequeña) */
        .card.next {
            transform: translate3d(100%, 0, 0) scale(0.8);
            z-index: 3;
            opacity: 0.6;
        }

        /* Ocultas (Para las que no están en el foco) */
        .card.hidden {
            transform: translate3d(0, 0, -100px) scale(0.5);
            z-index: 1;
            opacity: 0;
        }

    .icon-wrapper {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background-color: rgba(255, 255, 255, 0.1);
        display: flex;
        justify-content: center;
        align-items: center;
