@model AnzanMegaArithmetics.Models.ConfConferencias

@{
    ViewBag.Title = "Panel Soroban";
    Layout = "_LayoutGeneral";
}

<style>

    body {
        background-color: var(--color-bg);
        color: var(--color-tex);
    }

    h2 {
        text-align: center;
        margin-bottom: 1rem;
        color: var(--color-light);
        font-weight: 600;
        font-size: clamp(1.4rem, 2vw, 1.7rem);
    }

    #configuracionEjercicios {
        width: 90%;
        max-width: 60%;
        margin: 0 auto 2rem auto;
        padding: 1.4rem;
        border-radius: 1rem;
        background-color: var(--bg-color);
        box-shadow: 0 0 16px rgba(0, 0, 0, 0.3);
        color: var(--color-light);
        animation: fadeIn 0.4s ease;
        flex-direction: row;
        display: flex;
        gap: 20%;
        justify-content: space-around;
        align-items: center;
    }

        #configuracionEjercicios div {
            margin-bottom: 1rem;
        }

        #configuracionEjercicios label {
            display: block;
            margin-bottom: 0.4rem;
            font-weight: 600;
            font-size: 0.95rem;
        }

        #configuracionEjercicios input[type="number"],
        #configuracionEjercicios select {
            width: 100%;
            padding: 0.5rem 0.6rem;
            border: none;
            border-radius: 0.5rem;
            background-color: #292c4f;
            color: white;
            font-size: 0.95rem;
        }

        #configuracionEjercicios small {
            display: block;
            margin-top: 0.3rem;
            color: #aaa;
            font-size: 0.8rem;
        }

        #configuracionEjercicios button[type="submit"] {
            background-color: var(--color-primary);
            color: white;
            padding: 0.75rem 1rem;
            font-size: 1rem;
            font-weight: bold;
            border: none;
            border-radius: 0.5rem;
            cursor: pointer;
            transition: transform 0.2s ease, background-color 0.3s ease, box-shadow 0.3s ease;
            width: 100%;
            box-shadow: 0 4px 12px rgba(76, 76, 255, 0.3);
        }

            #configuracionEjercicios button[type="submit"]:hover {
                background-color: var(--color-primary-dark);
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(76, 76, 255, 0.5);
            }

    .dashboard-button-wrapper {
        display: flex;
        justify-content: center;
        margin: 1.2rem 0 1.5rem;
        padding: 0 1rem;
        align-items: center;
        gap: 1.5rem;
    }

    .btn-dashboard {
        background-color: var(--color-primary);
        color: white;
        padding: 0.7rem 1.5rem;
        border: none;
        border-radius: 0.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(76, 76, 255, 0.3);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
    }

        .btn-dashboard:hover {
            background-color: var(--color-primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(76, 76, 255, 0.5);
        }

    .main-content {
        margin-top: 3.5rem;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 480px) {
        #configuracionEjercicios {
            padding: 1.2rem;
            flex-direction: column;
            max-width: 90%;
        }

        .dashboard-button-wrapper {
            padding: 0 0.6rem;
            flex-direction: column;
            gap: 0;
        }

        #configuracionEjercicios button,
        .btn-dashboard {
            font-size: 0.9rem;
        }

        h2 {
            font-size: 1.4rem;
        }
    }
</style>

<div class="dashboard-button-wrapper">
    <form method="get" asp-controller="Dashboard" asp-action="Conferencias">
        <button type="submit" class="btn-dashboard">
            <i class="fas fa-home"></i> Regresar al dashboard
        </button>
    </form>
    <h2>Panel de Conferencias Soroban</h2>
</div>

<form id="configuracionEjercicios" method="post" asp-controller="Conferencias" asp-action="SorobanPanel">
    <div>
        <div>
            <label asp-for="Estilo"></label>
            <select asp-for="Estilo">
                <option value="0">Default (morado)</option>
                <option value="1">Verde</option>
                <option value="2">Oro radiante</option>
                <option value="3">Magia profunda</option>
                <option value="4">Cyborg</option>
            </select>
        </div>

        <button type="submit">🚀 Iniciar panel soroban</button>
    </div>
</form>

