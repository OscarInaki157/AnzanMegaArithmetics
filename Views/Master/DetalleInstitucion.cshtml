    async function confirmarEliminarClase(idClase) {
        const btn    = document.getElementById('btnConfirmarEliminarClase');
        const msgErr = document.getElementById('msgErrorEliminarClase');
        const select = document.getElementById('ddlClaseDestino');

        if (select && select.tagName === 'SELECT') {
            const idDestino = parseInt(select.value);
            if (idDestino === 0 || isNaN(idDestino)) {
                msgErr.textContent   = 'Debes seleccionar una clase destino para los usuarios.';
                msgErr.style.display = 'block';
                return;
            }
        }

        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Eliminando...';
        msgErr.style.display = 'none';

        const idDestino = select && select.tagName === 'SELECT' ? parseInt(select.value) : 0;

        try {
            const fd = new FormData();
            fd.append('Id_Clase', idClase);
            fd.append('Id_Clase_Destino', idDestino);

            const res    = await fetch('/Master/EliminarClase', { method: 'POST', body: fd });
            const result = await res.json();
            if (result.exito) {
                cerrarModalSede();
                window.location.reload();
            } else {
                msgErr.textContent   = result.mensaje;
                msgErr.style.display = 'block';
                btn.disabled         = false;
                btn.innerHTML        = '<i class="fas fa-trash-alt"></i> Confirmar Eliminación';
            }
        } catch {
            msgErr.textContent   = 'Error de conexión.';
            msgErr.style.display = 'block';
            btn.disabled         = false;
            btn.innerHTML        = '<i class="fas fa-trash-alt"></i> Confirmar Eliminación';
        }
    }

