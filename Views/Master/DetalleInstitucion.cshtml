            tab.innerHTML = '<div style="color:red;text-align:center;padding:2rem;">Error al cargar configuración.</div>';
        }
    }

    // ── CONFIGURACIÓN DE MÓDULOS ─────────────────────────────
    function toggleGrupo(grupo) {
        const body    = document.getElementById('body-' + grupo);
        const chevron = document.getElementById('chevron-' + grupo);
        body.classList.toggle('collapsed');
        chevron.classList.toggle('open');
    }

    function toggleGrupoCheckboxes(grupo, estado) {
        document.querySelectorAll('.config-item[data-grupo="' + grupo + '"] .config-checkbox').forEach(cb => {
            cb.checked = estado;
            actualizarLabel(cb);
        });
        actualizarBadgeGrupo(grupo);
    }

    function actualizarBadge(checkbox) {
        actualizarLabel(checkbox);
        const grupo = checkbox.closest('.config-item')?.dataset.grupo;
        if (grupo) actualizarBadgeGrupo(grupo);
    }

    function actualizarLabel(checkbox) {
        const label = checkbox.nextElementSibling;
        if (label) {
            label.textContent = checkbox.checked ? 'Activo' : 'Inactivo';
            label.style.color = checkbox.checked ? '#00ff88' : '#ff4757';
        }
    }

    function actualizarBadgeGrupo(grupo) {
        const items   = document.querySelectorAll('.config-item[data-grupo="' + grupo + '"]');
        const activos = Array.from(items).filter(i => i.querySelector('.config-checkbox')?.checked).length;
        const badge   = document.getElementById('badge-' + grupo);
        if (badge) badge.textContent = activos + ' / ' + items.length;
    }

    async function guardarConfiguracion(idInstitucion) {
        const btn = document.getElementById('btnGuardarConfig');
        const msg = document.getElementById('msgConfiguracion');

        const modulosActivos = Array.from(
            document.querySelectorAll('.config-checkbox:checked')
        ).map(cb => cb.dataset.clave);

        btn.disabled  = true;
        btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Guardando...';
        msg.style.display = 'none';

        try {
            const fd = new FormData();
            fd.append('idInstitucion', idInstitucion);
            modulosActivos.forEach(m => fd.append('modulosActivos', m));

            const res    = await fetch('/Master/GuardarConfiguracionModulos', { method: 'POST', body: fd });
            const result = await res.json();

            msg.textContent      = result.mensaje;
            msg.style.display    = 'block';
            msg.style.color      = result.exito ? '#00ff88' : '#ff4757';
            msg.style.background = result.exito ? 'rgba(0,255,136,0.08)' : 'rgba(255,71,87,0.08)';
            msg.style.border     = result.exito ? '1px solid rgba(0,255,136,0.3)' : '1px solid rgba(255,71,87,0.3)';
        } catch {
            msg.textContent   = 'Error de conexión.';
            msg.style.display = 'block';
            msg.style.color   = '#ff4757';
        } finally {
            btn.disabled  = false;
            btn.innerHTML = '<i class="fas fa-save"></i> Guardar cambios';
        }
    }

    // ── TAB LICENCIAS ────────────────────────────────────────
    async function cargarTabLicencias(idInstitucion) {
        const tab = document.getElementById('tab2');
        if (tab.dataset.cargado) return;
        tab.innerHTML = '<div style="text-align:center;padding:3rem;color:white;"><i class="fas fa-spinner fa-spin fa-2x"></i></div>';
        try {
            const res = await fetch(`/Master/ObtenerTabLicencias?idInstitucion=${idInstitucion}`);
            tab.innerHTML = await res.text();
            tab.dataset.cargado = '1';
        } catch {
            tab.innerHTML = '<div style="color:red;text-align:center;padding:2rem;">Error al cargar licencias.</div>';
        }
    }

    function mostrarMsgLicencias(exito, mensaje) {
        const msg = document.getElementById('msgTabLicencias');
        if (!msg) return;
        msg.textContent      = mensaje;
        msg.style.display    = 'block';
        msg.style.color      = exito ? '#00ff88' : '#ff4757';
        msg.style.background = exito ? 'rgba(0,255,136,0.08)' : 'rgba(255,71,87,0.08)';
        msg.style.border     = exito ? '1px solid rgba(0,255,136,0.3)' : '1px solid rgba(255,71,87,0.3)';
        setTimeout(() => msg.style.display = 'none', 4000);
    }

    function recargarTabLicencias() {
        invalidarTodosLosTabs();
        cargarTabLicencias(@Model.Id_Institucion);
    }

    async function desasignarLicencia(idLicencia) {
        if (!confirm('¿Desasignar esta licencia del usuario actual? El usuario quedará sin licencia.')) return;
        const fd = new FormData();
        fd.append('idLicencia', idLicencia);
        try {
            const res    = await fetch('/Master/DesasignarLicenciaManual', { method: 'POST', body: fd });
            const result = await res.json();
            mostrarMsgLicencias(result.exito, result.mensaje);
            if (result.exito) recargarTabLicencias();
        } catch {
            mostrarMsgLicencias(false, 'Error de conexión.');
        }
    }

    async function eliminarLicencia(idLicencia) {
        if (!confirm('¿Eliminar esta licencia permanentemente?')) return;
        const fd = new FormData();
        fd.append('idLicencia', idLicencia);
        try {
            const res    = await fetch('/Master/EliminarLicenciaIndividual', { method: 'POST', body: fd });
            const result = await res.json();
            mostrarMsgLicencias(result.exito, result.mensaje);
            if (result.exito) recargarTabLicencias();
        } catch {
            mostrarMsgLicencias(false, 'Error de conexión.');
        }
    }

    async function renovarLicencia(idLicencia) {
        const modal = document.getElementById('modalSede');
        const body  = document.getElementById('modalSedeBody');
        modal.style.display = 'flex';
        body.innerHTML = `
            <div class="formulario-flash">
                <div class="form-header">
                    <h2><i class="fas fa-sync-alt" style="color:#00c896; margin-right:0.5rem;"></i> Renovar Licencia</h2>
                </div>
                <div style="background:rgba(0,200,150,0.07); border:1px solid rgba(0,200,150,0.2);
                            border-radius:0.5rem; padding:0.8rem 1rem; margin-bottom:1.5rem;
                            color:#a0a0c0; font-size:0.85rem;">
                    <i class="fas fa-info-circle" style="color:#00c896;"></i>
                    Si la licencia está vencida, se renovará desde hoy.
                    Si aún está vigente, se extenderá desde su fecha de vencimiento actual.
                </div>
                <form onsubmit="enviarRenovarLicencia(event)">
                    <input type="hidden" name="Id_Licencia_Individual" value="${idLicencia}" />
                    <div style="margin-bottom:1.5rem;">
                        <label style="display:block; color:#a0a0c0; font-size:0.8rem;
                                      text-transform:uppercase; font-weight:600; margin-bottom:0.4rem;">
                            Meses a renovar
                        </label>
                        <input type="number" name="MesesRenovacion" value="12" min="1" max="120"
                               style="width:100%; background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.1);
                                      border-radius:0.5rem; padding:0.6rem 0.8rem; color:white; outline:none;
                                      transition:0.3s; box-sizing:border-box; font-size:0.95rem;" required />
                    </div>
                    <div id="msgErrorRenovar" style="display:none; color:#ff4757;
                         background:rgba(255,71,87,0.1); border:1px solid rgba(255,71,87,0.3);
                         border-radius:0.5rem; padding:0.7rem 1rem; margin-bottom:1rem; font-size:0.9rem;"></div>
                    <div style="display:flex; gap:0.8rem; justify-content:flex-end;">
                        <button type="button" onclick="cerrarModalSede()"
                                style="background:rgba(255,255,255,0.05); color:white;
                                       border:1px solid rgba(255,255,255,0.1); padding:0.7rem 1.5rem;
                                       border-radius:0.5rem; cursor:pointer; font-weight:600;">
                            Cancelar
                        </button>
                        <button type="submit" id="btnRenovarLicencia"
                                style="background:linear-gradient(135deg,#00c896,#00a876); color:white; border:none;
                                       padding:0.7rem 1.5rem; border-radius:0.5rem; cursor:pointer;
                                       font-weight:600; display:inline-flex; align-items:center; gap:0.5rem;">
                            <i class="fas fa-sync-alt"></i> Renovar
                        </button>
                    </div>
                </form>
            </div>`;
    }

    async function enviarRenovarLicencia(event) {
        event.preventDefault();
        const btn    = document.getElementById('btnRenovarLicencia');
        const msgErr = document.getElementById('msgErrorRenovar');
        const fd     = new FormData(event.target);

        btn.disabled  = true;
        btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Renovando...';

        try {
            const res    = await fetch('/Master/RenovarLicenciaIndividual', { method: 'POST', body: fd });
            const result = await res.json();
            if (result.exito) {
                cerrarModalSede();
                mostrarMsgLicencias(true, result.mensaje);
                recargarTabLicencias();
            } else {
                msgErr.textContent   = result.mensaje;
                msgErr.style.display = 'block';
                btn.disabled         = false;
                btn.innerHTML        = '<i class="fas fa-sync-alt"></i> Renovar';
            }
        } catch {
            msgErr.textContent   = 'Error de conexión.';
            msgErr.style.display = 'block';
            btn.disabled         = false;
            btn.innerHTML        = '<i class="fas fa-sync-alt"></i> Renovar';
        }
    }

    async function abrirCrearLicencia(idInstitucion) {
        const modal = document.getElementById('modalSede');
        const body  = document.getElementById('modalSedeBody');
        modal.style.display = 'flex';
        body.innerHTML = `
            <div class="formulario-flash">
                <div class="form-header">
                    <h2><i class="fas fa-key" style="color:var(--color-primary);margin-right:0.5rem;"></i> Nueva Licencia</h2>
                </div>
                <form onsubmit="enviarCrearLicencia(event)">
                    <input type="hidden" name="Id_Institucion" value="${idInstitucion}" />
                    <div style="display:grid; gap:1rem; margin-bottom:1.5rem;">
                        <div>
                            <label style="display:block; color:#a0a0c0; font-size:0.8rem;
                                   text-transform:uppercase; font-weight:600; margin-bottom:0.4rem;">
                                Meses de vigencia
                            </label>
                            <input type="number" name="MesesVigencia" value="12" min="1" max="120"
                                   style="width:100%; background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.1);
                                          border-radius:0.5rem; padding:0.6rem 0.8rem; color:white; outline:none;
                                          transition:0.3s; box-sizing:border-box; font-size:0.95rem;" required />
                        </div>
                        <div style="background:rgba(76,76,255,0.08); border:1px solid rgba(76,76,255,0.2);
                                    border-radius:0.5rem; padding:0.8rem 1rem; color:#a0a0c0; font-size:0.85rem;">
                            <i class="fas fa-info-circle" style="color:var(--color-primary);"></i>
                            La licencia se creará sin usuario asignado y comenzará a correr desde hoy.
                            Puedes asignarla a un usuario desde el formulario de edición.
                        </div>
                    </div>
                    <div id="msgErrorCrearLicencia" style="display:none; color:#ff4757;
                         background:rgba(255,71,87,0.1); border:1px solid rgba(255,71,87,0.3);
                         border-radius:0.5rem; padding:0.7rem 1rem; margin-bottom:1rem; font-size:0.9rem;"></div>
                    <div style="display:flex; gap:0.8rem; justify-content:flex-end;">
                        <button type="button" onclick="cerrarModalSede()"
                                style="background:rgba(255,255,255,0.05); color:white;
                                       border:1px solid rgba(255,255,255,0.1); padding:0.7rem 1.5rem;
                                       border-radius:0.5rem; cursor:pointer; font-weight:600;">
                            Cancelar
                        </button>
                        <button type="submit" id="btnCrearLicencia"
                                style="background:var(--color-primary); color:white; border:none;
                                       padding:0.7rem 1.5rem; border-radius:0.5rem; cursor:pointer;
                                       font-weight:600; display:inline-flex; align-items:center; gap:0.5rem;">
                            <i class="fas fa-plus"></i> Crear Licencia
                        </button>
                    </div>
                </form>
            </div>`;
    }

    async function enviarCrearLicencia(event) {
        event.preventDefault();
        const btn    = document.getElementById('btnCrearLicencia');
        const msgErr = document.getElementById('msgErrorCrearLicencia');
        const fd     = new FormData(event.target);

        btn.disabled  = true;
        btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Creando...';

        try {
            const res    = await fetch('/Master/CrearLicenciaIndividual', { method: 'POST', body: fd });
            const result = await res.json();
            if (result.exito) {
                cerrarModalSede();
                recargarTabLicencias();
            } else {
                msgErr.textContent   = result.mensaje;
                msgErr.style.display = 'block';
                btn.disabled         = false;
                btn.innerHTML        = '<i class="fas fa-plus"></i> Crear Licencia';
            }
        } catch {
            msgErr.textContent   = 'Error de conexión.';
            msgErr.style.display = 'block';
            btn.disabled         = false;
            btn.innerHTML        = '<i class="fas fa-plus"></i> Crear Licencia';
        }
    }
</script>