@model AnzanMegaArithmetics.Models.MasterModels.PanelMasterViewModel
@{
    ViewBag.Title = "Panel Master";
    Layout = "_LayoutDashLimpio";
}

<style>
    /* =========================================
           1. LAYOUT PRINCIPAL Y BUSCADOR
           ========================================= */

    .master-grid-layout {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 1rem;
        align-items: start;
        width: 100%;
       /*  max-width: 85rem; */
        box-sizing: border-box;
    }

    .omnipotent-search-bar {
        width: 100%;
        max-width: 85rem;
        margin: 0 auto 1rem auto;
        position: relative;
    }

        .omnipotent-search-bar input {
            width: 100%;
            padding: 1rem 1.5rem 1rem 3rem;
            border-radius: 1rem;
            background: var(--color-card-bg);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: white;
            font-size: 1.1rem;
            outline: none;
            box-shadow: 0 0.6rem 1.5rem rgba(0, 0, 0, 0.2);
            transition: 0.3s;
        }

            .omnipotent-search-bar input:focus {
                border-color: var(--color-primary);
                box-shadow: 0 0 15px rgba(76, 76, 255, 0.3);
            }

        .omnipotent-search-bar i.fa-search {
            position: absolute;
            left: 1.2rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--color-primary);
            font-size: 1.2rem;
        }

    .btn-primary-action {
        background-color: var(--color-primary);
        color: white;
        border: none;
        padding: 0.6rem 1.2rem;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
    }

        .btn-primary-action:hover {
            background-color: var(--color-primary-dark);
            transform: translateY(-2px);
        }

    /* =========================================
           2. FONDOS OSCUROS (Izquierda y Derecha)
           ========================================= */
    .formulario-flash {
        width: 100%;
        box-sizing: border-box;
        padding: 1.5rem;
        border-radius: 1rem;
        background-color: var(--color-card-bg, #010f36); /* Aquí forzamos el azul oscuro */
        box-shadow: 0 0.6rem 1.5rem rgba(0, 0, 0, 0.2);
        overflow: hidden;
    }

    .form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 0.06rem solid rgba(255,255,255,0.1);
    }

        .form-header h2 {
            margin: 0;
            font-size: clamp(1.4rem, 2vw, 1.7rem);
            font-weight: 600;
            color:white;
        }

    /* =========================================
           3. MODAL OCULTO POR DEFECTO
           ========================================= */
    .modal-overlay {
        display: none; /* ¡Esto corrige que siempre esté visible! */
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(5px);
        z-index: 9999;
        justify-content: center;
        align-items: center;
        animation: fadeIn 0.3s ease;
    }

    .modal-content-game {
        position: relative;
        width: 100%;
        max-width: 40rem; /* Más estrecho que el de alumnos para formularios */
        padding: 2rem;
        animation: slideUp 0.3s ease;
    }

    .btn-close-modal {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: #ff4757;
        color: white;
        border: none;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        font-size: 1.2rem;
        cursor: pointer;
        box-shadow: 0 0 15px rgba(255, 71, 87, 0.5);
        z-index: 10;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: 0.2s;
    }

        .btn-close-modal:hover {
            transform: scale(1.1);
            background: #ff6b81;
        }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
    }

    to {
        opacity: 1;
    }

    }

    @@keyframes slideUp {
        from

    {
        transform: translateY(1rem);
        opacity: 0;
    }

    to {
        transform: translateY(0);
        opacity: 1;
    }

    }

    @@media (max-width: 1024px) {
        .master-grid-layout

    {
        grid-template-columns: 1fr;
    }

    }
</style>


<div class="master-grid-layout">

    <div class="left-column formulario-flash">
        <partial name="~/Views/Shared/Partials/Panels/Master/_ColumnaIzquierda.cshtml" model="Model.DashboardIzquierdo" />
    </div>

    <div class="right-column">

        <partial name="~/Views/Shared/Partials/Panels/Master/_DirectorioInstituciones.cshtml" model="Model.ListaInstituciones" />

    </div>

</div>

<div id="modalMaster" class="modal-overlay">
    <div class="modal-content-game">
        <button class="btn-close-modal" onclick="cerrarModalMaster()">
            <i class="fas fa-times"></i>
        </button>
        <div id="modalMasterBody">
            <partial name="~/Views/Shared/Partials/Panels/Master/_CrearInstitucion.cshtml" model="new AnzanMegaArithmetics.Models.MasterModels.CrearInstitucionModel { LicenciasIniciales = 1}"/>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    function abrirModalMaster() {
        document.getElementById('modalMaster').style.display = 'flex';
    }

    function cerrarModalMaster() {
        document.getElementById('modalMaster').style.display = 'none';
        document.getElementById('modalMasterBody').innerHTML = '';
    }

    // Cerrar modal al hacer clic afuera
    window.onclick = function(event) {
        const modal = document.getElementById('modalMaster');
        if (event.target === modal) {
            cerrarModalMaster();
        }
    }

        async function abrirModalMaster() {
        const modal = document.getElementById('modalMaster');
        const body = document.getElementById('modalMasterBody');

        modal.style.display = 'flex';
        body.innerHTML = '<div style="text-align:center; padding:2rem; color:white;"><i class="fas fa-spinner fa-spin"></i> Cargando...</div>';

        try {
            const response = await fetch('/Master/ObtenerFormularioInstitucion');
            body.innerHTML = await response.text();
        } catch (e) {
            body.innerHTML = '<div style="color:red;">Error al cargar el formulario.</div>';
        }
    }

    async function enviarNuevaInstitucion(event) {
        event.preventDefault();
        const btn = document.getElementById('btnGuardar');
        const msgError = document.getElementById('msgErrorModal');
        const formData = new FormData(event.target);

        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Guardando...';
        msgError.style.display = 'none';

        try {
            const response = await fetch('/Master/CrearInstitucion', {
                method: 'POST',
                body: formData
            });
            const result = await response.json();

            if (result.exito) {
                // Recargamos la página para que se vean los cambios en las gráficas y la tabla
                window.location.reload();
            } else {
                msgError.textContent = result.mensaje;
                msgError.style.display = 'block';
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-save"></i> Guardar Institución';
            }
        } catch (e) {
            msgError.textContent = "Error de conexión con el servidor.";
            msgError.style.display = 'block';
            btn.disabled = false;
        }
    }

   

    // 1. Modificamos la función que ABRE la modal para agregar el efecto del Foco
    function abrirModalEditarInstitucion(idInstitucion) {
        const modal = document.getElementById('modalMaster');
        const modalBody = document.getElementById('modalMasterBody');

        modal.style.display = 'flex';
        modalBody.innerHTML = '<div class="text-center" style="padding: 3rem; color: white;"><i class="fas fa-sync fa-spin fa-2x"></i><p>Cargando datos de la institución...</p></div>';

        fetch(`/Master/EditarInstitucion?id=${idInstitucion}`)
            .then(response => response.text())
            .then(html => {
                modalBody.innerHTML = html;

                // UX Trick: Ponemos el foco en el input UNA VEZ que el HTML ya se inyectó
                setTimeout(() => {
                    const input = document.getElementById('inputNuevoNombre');
                    if(input) {
                        input.focus();
                        input.select();
                    }
                }, 150);
            })
            .catch(error => {
                modalBody.innerHTML = '<div style="color: #ff4757; text-align: center; padding: 2rem;">Error al cargar.</div>';
            });
    }

    // 2. Agregamos la función global que RECIBE el formulario de la modal
    async function enviarEdicionInstitucion(event) {
        event.preventDefault(); // Evitamos que el formulario recargue la página a lo bruto

        const btn = document.getElementById('btnGuardarEdicion');
        const form = event.target;
        const formData = new FormData(form);
        const divError = document.getElementById('msgErrorEdicion');

        // Estado de carga visual
        btn.innerHTML = '<i class="fas fa-sync-alt fa-spin"></i> Procesando...';
        btn.disabled = true;
        divError.style.display = 'none';

        try {
            const response = await fetch('/Master/GuardarEdicionInstitucion', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (result.exito) {
                // Éxito: Cerramos y recargamos para ver la tabla actualizada
                cerrarModalMaster();
                window.location.reload();
            } else {
                // Error (Duplicado o vacío)
                divError.innerHTML = '<i class="fas fa-exclamation-triangle"></i> ' + result.mensaje;
                divError.style.display = 'block';

                // Restaurar botón
                btn.innerHTML = '<i class="fas fa-save"></i> Guardar Cambios';
                btn.disabled = false;

                // Regresar el foco al input
                document.getElementById('inputNuevoNombre').focus();
            }

        } catch (error) {
            divError.innerHTML = '<i class="fas fa-wifi"></i> Error de conexión con el servidor.';
            divError.style.display = 'block';
            btn.innerHTML = '<i class="fas fa-save"></i> Guardar Cambios';
            btn.disabled = false;
        }
    }

        // ── TOGGLE ACTIVO INSTITUCIÓN ────────────────────────────
    async function toggleActivoInstitucion(idInstitucion, nombre, estaActiva, btn) {
        const accion = estaActiva ? 'desactivar' : 'activar';
        const confirmar = confirm(
            `¿${accion.charAt(0).toUpperCase() + accion.slice(1)} la institución "${nombre}"?\n\n` +
            `Se ${estaActiva ? 'desactivarán' : 'activarán'} también todos sus usuarios.`
        );
        if (!confirmar) return;

        btn.disabled = true;
        const iconEl = btn.querySelector('i');
        const claseOriginal = iconEl.className;
        iconEl.className = 'fas fa-circle-notch fa-spin';

        try {
            const fd = new FormData();
            fd.append('idInstitucion', idInstitucion);
            const res    = await fetch('/Master/ToggleActivoInstitucion', { method: 'POST', body: fd });
            const result = await res.json();

            if (result.exito) {
                window.location.reload();
            } else {
                alert('Error: ' + result.mensaje);
                btn.disabled     = false;
                iconEl.className = claseOriginal;
            }
        } catch {
            alert('Error de conexión.');
            btn.disabled     = false;
            iconEl.className = claseOriginal;
        }
    }

    // ── ELIMINAR INSTITUCIÓN ─────────────────────────────────
    async function confirmarEliminarInstitucion(idInstitucion, nombre) {
        const confirmar = confirm(
            `⚠️ ELIMINAR PERMANENTEMENTE: "${nombre}"\n\n` +
            `Se eliminarán:\n• Todas sus clases\n• Todos sus usuarios\n• Todas sus pruebas\n• Todas sus licencias\n\n` +
            `Esta acción es IRREVERSIBLE. ¿Estás seguro?`
        );
        if (!confirmar) return;

        // Segunda confirmación por ser destructivo
        const confirmar2 = confirm(`¿Confirmas que deseas eliminar "${nombre}" y TODOS sus datos?`);
        if (!confirmar2) return;

        try {
            const fd = new FormData();
            fd.append('idInstitucion', idInstitucion);
            const res    = await fetch('/Master/EliminarInstitucion', { method: 'POST', body: fd });
            const result = await res.json();

            if (result.exito) {
                window.location.reload();
            } else {
                alert('Error: ' + result.mensaje);
            }
        } catch {
            alert('Error de conexión.');
        }
    }
</script>