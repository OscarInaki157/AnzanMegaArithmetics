@model List<AnzanMegaArithmetics.Models.ClaseBDModel>
@{
    ViewBag.Title = "Administrar Clases";
    Layout = "_LayoutAdmin";
}

<div class="admin-container">
    <div class="admin-header">
        <a href="@Url.Action("PanelAdministrador", "Dashboard")" class="back-button">
            <i class="fas fa-arrow-left"></i>
            Regresar
        </a>
    </div>

    <!-- Botón para agregar nueva clase -->
    <div class="action-section">
        <button class="add-class-button" id="btnAddClass">
            <i class="fas fa-plus"></i>
            Agregar Nueva Clase
        </button>
    </div>

    <!-- Tabla de clases -->
    <div class="classes-table-container">
        <div class="table-header">
            <div class="col-id">ID</div>
            <div class="col-name">Nombre de la Clase</div>
            <div class="col-actions">Acciones</div>
        </div>

        <div class="table-body">
            @if (Model != null && Model.Any())
            {
                foreach (var clase in Model)
                {
                    <div class="table-row">
                        <div class="col-id">@clase.Id_Clase.ToString("D3")</div>

                        <div class="col-name">
                            <div class="class-info">
                                <div class="class-name">@clase.Nombre</div>
                            </div>
                        </div>

                        <div class="col-actions">
                            <button class="btn-edit"
                                    data-classid="@clase.Id_Clase"
                                    data-nombre="@clase.Nombre">
                                <i class="fas fa-edit"></i>
                                Modificar
                            </button>
                            <button class="btn-delete" data-classid="@clase.Id_Clase">
                                <i class="fas fa-trash"></i>
                                Eliminar
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="no-results-message">
                    <div class="no-results-content">
                        <i class="fas fa-book"></i>
                        <h3>No hay clases registradas</h3>
                        <p>Comienza agregando una nueva clase</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- MODAL 1: PARA CREAR NUEVA CLASE -->
<div id="createClassModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Crear Nueva Clase</h2>
            <span class="close-create">&times;</span>
        </div>
        <div class="modal-body">
            <form id="createClassForm" method="post" action="@Url.Action("CrearClase", "Admin")">
                <div class="form-group">
                    <label for="createClassName">Nombre de la clase:</label>
                    <input type="text" id="createClassName" name="Nombre" class="form-input" required
                           placeholder="Ejemplo: ESCUELA221099PUE">
                </div>

                <div class="form-actions">
                    <button type="button" class="btn-cancel-create">Cancelar</button>
                    <button type="submit" class="btn-create">
                        <i class="fas fa-plus"></i>
                        Crear Clase
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL 2: PARA EDITAR CLASE EXISTENTE -->
<div id="editClassModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Modificar Clase</h2>
            <span class="close-edit">&times;</span>
        </div>
        <div class="modal-body">
            <form id="editClassForm" method="post" action="@Url.Action("ActualizarClase", "Admin")">
                <input type="hidden" id="editClassId" name="Id_Clase">

                <div class="form-group">
                    <label for="editClassName">Nombre de la clase:</label>
                    <input type="text" id="editClassName" name="Nombre" class="form-input" required
                           placeholder="Ejemplo: ESCUELA221099PUE">
                </div>

                <div class="form-actions">
                    <button type="button" class="btn-cancel-edit">Cancelar</button>
                    <button type="submit" class="btn-update">
                        <i class="fas fa-save"></i>
                        Actualizar Clase
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .btn-create {
        background: linear-gradient(135deg, #00cc66, #00b359);
        color: white;
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

        .btn-create:hover {
            background: linear-gradient(135deg, #00b359, #00994d);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 204, 102, 0.4);
        }

    .btn-cancel-create, .btn-cancel-edit {
        background-color: rgba(255, 255, 255, 0.1);
        color: var(--color-light);
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

        .btn-cancel-create:hover, .btn-cancel-edit:hover {
            background-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

    .close-create, .close-edit {
        color: white;
        font-size: 2rem;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .close-create:hover, .close-edit:hover {
            transform: scale(1.1);
            opacity: 0.8;
        }
    .admin-container {
        padding: 2rem;
        color: var(--color-light);
        max-width: 1000px;
        margin: 0 auto;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

        .admin-header h1 {
            color: var(--color-primary);
            margin: 0;
        }

    .back-button {
        background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
        color: white;
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 2rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        text-decoration: none;
    }

        .back-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(76, 76, 255, 0.4);
        }

    .action-section {
        margin-bottom: 1.5rem;
    }

    .add-class-button {
        background: linear-gradient(135deg, #00cc66, #00b359);
        color: white;
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 2rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

        .add-class-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 204, 102, 0.4);
        }

    .classes-table-container {
        background-color: var(--color-card-bg);
        border-radius: 1rem;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
        overflow-x: auto;
    }

    .table-header {
        display: grid;
        grid-template-columns: 80px 1fr 200px;
        gap: 1rem;
        padding: 1rem;
        background-color: rgba(59, 60, 143, 0.3);
        font-weight: 600;
        font-size: 0.8rem;
        color: var(--color-primary);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .table-body {
        display: flex;
        flex-direction: column;
    }

    .table-row {
        display: grid;
        grid-template-columns: 80px 1fr 200px;
        gap: 1rem;
        padding: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.3s ease;
        align-items: center;
    }

        .table-row:hover {
            background-color: rgba(76, 76, 255, 0.1);
        }

    .col-id {
        font-weight: 600;
        color: var(--color-primary);
        font-size: 0.9rem;
    }

    .class-info {
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .class-name {
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--color-light);
    }

    .col-actions {
        display: flex;
        gap: 0.5rem;
    }

    .btn-edit, .btn-delete {
        border: none;
        padding: 0.5rem 0.8rem;
        border-radius: 0.5rem;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

    .btn-edit {
        background: linear-gradient(135deg, #ffa500, #ff8c00);
        color: white;
    }

        .btn-edit:hover {
            background: linear-gradient(135deg, #ff8c00, #ff7700);
            transform: translateY(-1px);
        }

    .btn-delete {
        background: linear-gradient(135deg, #ff4757, #ff3742);
        color: white;
    }

        .btn-delete:hover {
            background: linear-gradient(135deg, #ff3742, #ff2e2e);
            transform: translateY(-1px);
        }

    .no-results-message {
        grid-column: 1 / -1;
        text-align: center;
        padding: 3rem 2rem;
        color: var(--color-light);
    }

    .no-results-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

        .no-results-content i {
            font-size: 3rem;
            color: var(--color-primary);
            opacity: 0.7;
        }

        .no-results-content h3 {
            font-size: 1.5rem;
            color: var(--color-primary);
            margin: 0;
        }

        .no-results-content p {
            font-size: 1rem;
            opacity: 0.8;
            margin: 0;
        }

    /* Estilos del modal */
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(5px);
    }

    .modal-content {
        background-color: var(--color-card-bg);
        margin: 5% auto;
        padding: 0;
        border-radius: 1rem;
        width: 90%;
        max-width: 500px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        animation: modalSlideIn 0.3s ease-out;
    }

    @@keyframes modalSlideIn {
        from {
            opacity: 0;
            transform: translateY(-50px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .modal-header {
        color: white;
        padding: 1.5rem 2rem;
        border-radius: 1rem 1rem 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .modal-header h2 {
            margin: 0;
            font-size: 1.5rem;
        }

    .close-create, .close-edit {
        color: white;
        font-size: 2rem;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .close-create:hover, .close-edit:hover {
            transform: scale(1.1);
            opacity: 0.8;
        }

    .modal-body {
        padding: 2rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

        .form-group label {
            font-weight: 600;
            color: var(--color-primary);
            font-size: 0.9rem;
        }

    .form-input {
        background-color: var(--color-sidebar);
        color: var(--color-light);
        border: 1px solid rgba(76, 76, 255, 0.3);
        border-radius: 0.5rem;
        padding: 0.8rem 1rem;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        width: 100%;
    }

        .form-input:focus {
            outline: none;
            border-color: var(--color-primary);
            box-shadow: 0 0 0 2px rgba(76, 76, 255, 0.2);
        }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .btn-cancel, .btn-update {
        padding: 0.8rem 1.5rem;
        border: none;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

    .btn-cancel {
        background-color: rgba(255, 255, 255, 0.1);
        color: var(--color-light);
    }

        .btn-cancel:hover {
            background-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

    .btn-update {
        background: linear-gradient(135deg, #00cc66, #00b359);
        color: white;
    }

        .btn-update:hover {
            background: linear-gradient(135deg, #00b359, #00994d);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 204, 102, 0.4);
        }

    @@media (max-width: 768px) {
        .admin-container {
            padding: 1rem;
        }

        .admin-header {
            flex-direction: column;
            gap: 1rem;
            align-items: flex-start;
        }

        .table-header,
        .table-row {
            grid-template-columns: 60px 1fr 150px;
            min-width: 400px;
        }

        .modal-content {
            width: 95%;
            margin: 10% auto;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // ===== MODAL PARA CREAR CLASE =====
        const createModal = document.getElementById('createClassModal');
        const closeCreateBtn = document.querySelector('.close-create');
        const cancelCreateBtn = document.querySelector('.btn-cancel-create');
        const createForm = document.getElementById('createClassForm');
        const addClassBtn = document.getElementById('btnAddClass');

        // Abrir modal para crear
        if (addClassBtn) {
            addClassBtn.addEventListener('click', function() {
                createModal.style.display = 'block';
                document.body.style.overflow = 'hidden';
                // Limpiar formulario
                document.getElementById('createClassName').value = '';
            });
        }

        // Cerrar modal crear
        function closeCreateModal() {
            createModal.style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        if (closeCreateBtn) closeCreateBtn.addEventListener('click', closeCreateModal);
        if (cancelCreateBtn) cancelCreateBtn.addEventListener('click', closeCreateModal);

        // ===== MODAL PARA EDITAR CLASE =====
        const editModal = document.getElementById('editClassModal');
        const closeEditBtn = document.querySelector('.close-edit');
        const cancelEditBtn = document.querySelector('.btn-cancel-edit');
        const editForm = document.getElementById('editClassForm');

        // Abrir modal para editar
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('btn-edit') ||
                e.target.parentElement.classList.contains('btn-edit')) {

                const btn = e.target.classList.contains('btn-edit') ? e.target : e.target.parentElement;

                const classId = btn.getAttribute('data-classid');
                const nombre = btn.getAttribute('data-nombre');

                // Llenar el formulario de edición
                document.getElementById('editClassId').value = classId;
                document.getElementById('editClassName').value = nombre;

                editModal.style.display = 'block';
                document.body.style.overflow = 'hidden';
            }
        });

        // Cerrar modal editar
        function closeEditModal() {
            editModal.style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        if (closeEditBtn) closeEditBtn.addEventListener('click', closeEditModal);
        if (cancelEditBtn) cancelEditBtn.addEventListener('click', closeEditModal);

        // ===== CERRAR MODALES AL HACER CLICK FUERA =====
        window.addEventListener('click', function(e) {
            if (e.target === createModal) closeCreateModal();
            if (e.target === editModal) closeEditModal();
        });

        // ===== CERRAR CON ESC =====
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                if (createModal.style.display === 'block') closeCreateModal();
                if (editModal.style.display === 'block') closeEditModal();
            }
        });

        // ===== VALIDACIÓN DE FORMULARIOS =====
        // Validación para crear
        if (createForm) {
            createForm.addEventListener('submit', function(e) {
                const className = document.getElementById('createClassName').value.trim();

                if (!className) {
                    e.preventDefault();
                    alert('El nombre de la clase es requerido');
                    return false;
                }

                if (className.length < 5) {
                    e.preventDefault();
                    alert('El nombre debe tener al menos 5 caracteres');
                    return false;
                }

                return true;
            });
        }

        // Validación para editar
        if (editForm) {
            editForm.addEventListener('submit', function(e) {
                const className = document.getElementById('editClassName').value.trim();

                if (!className) {
                    e.preventDefault();
                    alert('El nombre de la clase es requerido');
                    return false;
                }

                if (className.length < 5) {
                    e.preventDefault();
                    alert('El nombre debe tener al menos 5 caracteres');
                    return false;
                }

                return true;
            });
        }
    });
</script>