        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        min-width: fit-content;
        text-align:center;
    }

    .table-body {
        display: flex;
        flex-direction: column;
        width: fit-content;
    }

    .table-row {
        display: grid;
        grid-template-columns: 
        minmax(50px, 60px) /* ID */
        minmax(70px, 80px) /* Rol */
        minmax(150px, 1fr) /* Nombre */
        minmax(170px, 1fr) /* Correo */
        minmax(130px, 140px) /* Gamertag */
        minmax(130px, 140px) /* Contraseña */
        minmax(70px, 80px) /* Activo */
        minmax(60px, 70px) /* Racha */
        minmax(80px, 100px) /* Exp */
        minmax(120px, 140px) /* Última Conexión */
        minmax(100px, 120px) /* Licencia */
        minmax(130px, 150px) /* Clases */
        minmax(200px, 200px); /* Acciones */
        gap: 0.8rem;
        padding: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.3s ease;
        align-items: center;
        font-size: 0.85rem;
        min-width: fit-content;
        z-index:100;
        justify-content: center;
        align-items: center;
        text-align:center;
    }

        .table-row:hover {
