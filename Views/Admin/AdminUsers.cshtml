        background-color: var(--color-card-bg);
        border-radius: 1rem;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
        overflow-x: auto;
        min-width: 100%;
    }

    .table-header {
        display: grid;
        grid-template-columns: 
        minmax(50px, 60px) /* ID */
        minmax(70px, 80px) /* Rol */
        minmax(150px, 1fr) /* Nombre */
        minmax(170px, 1fr) /* Correo */
        minmax(130px, 140px) /* Gamertag */
        minmax(130px, 140px) /* Contraseña */
        minmax(70px, 80px) /* Activo */
        minmax(60px, 70px) /* Racha */
        minmax(80px, 100px) /* Exp */
        minmax(120px, 140px) /* Última Conexión */
        minmax(100px, 120px) /* Licencia */
        minmax(130px, 150px) /* Clases */
        minmax(200px, 200px); /* Acciones */
        gap: 0.8rem;
        padding: 1rem;
        background-color: rgba(59, 60, 143, 0.3);
        font-weight: 600;
