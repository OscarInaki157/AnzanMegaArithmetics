function validarFormularioCrear() {
    let esValido = true;
    const mensajesError = [];

    limpiarMensajesErrorCrear();

    // 1. Validar campos requeridos y longitudes
    const nombre = document.getElementById('createNombre').value.trim();
    const correo = document.getElementById('createCorreo').value.trim();
    const gamertag = document.getElementById('createGamerTag').value.trim();
    const pass = document.getElementById('createPassword').value;
    const rol = document.getElementById('createRol').value;
    const licencia = document.getElementById('createLicencia').value;

    // Validar NOMBRE (10-40 caracteres)
    if (!nombre) {
        mostrarErrorCrear('createNombre', 'El nombre completo es requerido');
        esValido = false;
    } else if (nombre.length < 10 || nombre.length > 40) {
        mostrarErrorCrear('createNombre', 'El nombre debe tener entre 10 y 40 caracteres');
        esValido = false;
        mensajesError.push('El nombre debe tener entre 10 y 40 caracteres');
    }

    // Validar CORREO (10-40 caracteres)
    if (!correo) {
        mostrarErrorCrear('createCorreo', 'El correo electrónico es requerido');
        esValido = false;
    } else if (correo.length < 10 || correo.length > 40) {
        mostrarErrorCrear('createCorreo', 'El correo debe tener entre 10 y 40 caracteres');
        esValido = false;
        mensajesError.push('El correo debe tener entre 10 y 40 caracteres');
    } else if (!correo.includes('.')) {
        mostrarErrorCrear('createCorreo', 'El formato del correo no es válido');
        esValido = false;
    }

    // Validar GAMERTAG (7-10 caracteres)
    if (!gamertag) {
        mostrarErrorCrear('createGamerTag', 'El gamertag es requerido');
        esValido = false;
    } else if (gamertag.length < 7 || gamertag.length > 10) {
        mostrarErrorCrear('createGamerTag', 'El gamertag debe tener entre 7 y 10 caracteres');
        esValido = false;
        mensajesError.push('El gamertag debe tener entre 7 y 10 caracteres');
    }

    // Validar CONTRASEÑA (7-10 caracteres) - YA EXISTE
    if (!pass) {
        mostrarErrorCrear('createPassword', 'La contraseña es requerida');
        esValido = false;
    } else if (pass.length < 7 || pass.length > 10) {
        mostrarErrorCrear('createPassword', 'La contraseña debe contener entre 7 a 10 caracteres');
        esValido = false;
        mensajesError.push('La contraseña debe contener entre 7 a 10 caracteres');
    }

    // Resto de validaciones existentes...
    if (!rol) {
        mostrarErrorCrear('createRol', 'El rol es requerido');
        esValido = false;
    }

    if (!licencia) {
        mostrarErrorCrear('createLicencia', 'La licencia es requerida');
        esValido = false;
    }

    // Validar clases
    const clasesSeleccionadas = document.querySelectorAll('.clase-checkbox-create:checked');
    if (clasesSeleccionadas.length === 0) {
        mostrarErrorClasesCrear('Debe seleccionar al menos una clase');
        esValido = false;
        mensajesError.push('Debe seleccionar al menos una clase');
    }

    if (!esValido) {
        mostrarMensajeErrorGeneralCrear('Por favor, corrige los errores en el formulario: ' + mensajesError.join(', '));
    }

    return esValido;
}

// Funciones auxiliares para mostrar errores (versión crear)
function mostrarErrorCrear(campoId, mensaje) {
    const campo = document.getElementById(campoId);
    const grupo = campo.closest('.form-group');
    
    // Remover error anterior
    const errorAnterior = grupo.querySelector('.error-message');
    if (errorAnterior) {
        errorAnterior.remove();
    }
    
    // Agregar estilo de error al campo
    campo.style.borderColor = '#ff4757';
    
    // Crear mensaje de error
    const errorElement = document.createElement('div');
    errorElement.className = 'error-message';
    errorElement.style.color = '#ff4757';
    errorElement.style.fontSize = '0.8rem';
    errorElement.style.marginTop = '0.3rem';
    errorElement.innerHTML = `<i class="fas fa-exclamation-circle"></i> ${mensaje}`;
    
    grupo.appendChild(errorElement);
}

function mostrarErrorClasesCrear(mensaje) {
    const clasesContainer = document.querySelector('.clases-checkbox-container');
    const grupoClases = clasesContainer.closest('.form-group');
    
    // Remover error anterior
    const errorAnterior = grupoClases.querySelector('.error-message');
    if (errorAnterior) {
        errorAnterior.remove();
    }
    
    // Crear mensaje de error
    const errorElement = document.createElement('div');
    errorElement.className = 'error-message';
    errorElement.style.color = '#ff4757';
    errorElement.style.fontSize = '0.8rem';
    errorElement.style.marginTop = '0.5rem';
    errorElement.innerHTML = `<i class="fas fa-exclamation-circle"></i> ${mensaje}`;
    
    grupoClases.appendChild(errorElement);
}

function mostrarMensajeErrorGeneralCrear(mensaje) {
    // Remover mensaje anterior
    const mensajeAnterior = document.querySelector('.alert-error-general-create');
    if (mensajeAnterior) {
        mensajeAnterior.remove();
    }
    
    // Crear mensaje de error general
    const errorGeneral = document.createElement('div');
    errorGeneral.className = 'alert-error-general-create';
    errorGeneral.style.background = 'linear-gradient(135deg, #ff4757, #ff3742)';
    errorGeneral.style.color = 'white';
    errorGeneral.style.padding = '1rem';
    errorGeneral.style.borderRadius = '0.5rem';
    errorGeneral.style.marginBottom = '1rem';
    errorGeneral.style.marginTop = '1rem';
    errorGeneral.innerHTML = `
        <i class="fas fa-exclamation-triangle"></i> 
        <strong>Error:</strong> ${mensaje}
    `;

       // CORRECCIÓN: Buscar form-actions dentro del formulario de crear
        const formActions = createForm.querySelector('.form-actions');
        if (formActions && formActions.parentNode) {
            createForm.insertBefore(errorGeneral, formActions);
        } else {
            // Fallback: insertar al final del formulario
            createForm.appendChild(errorGeneral);
        }
}

