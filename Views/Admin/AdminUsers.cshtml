}


    // === MODAL ELIMINAR USUARIO ===
    const deleteModal = document.getElementById('deleteUserModal');
    const closeDeleteBtn = document.querySelector('.close-delete');
    const cancelDeleteBtn = document.querySelector('.btn-cancel-delete');
    const confirmDeleteBtn = document.getElementById('btnConfirmDelete');
    const deleteButtonText = document.getElementById('delete-button-text');
    const countdownTimer = document.getElementById('countdown-timer');
    const countdownProgress = document.getElementById('countdown-progress');
    const deleteUserForm = document.getElementById('deleteUserForm');
    const deleteUserIdInput = document.getElementById('deleteUserId');
    const deleteUserNombreInput = document.getElementById('deleteUserNombre');
    const deleteUserEmailInput = document.getElementById('deleteUserEmail');

    let countdownInterval;
    let currentUserId;
    let currentUserData = {};
    const COUNTDOWN_TIME = 5; // segundos

    // Event listener para botones de eliminar
    document.addEventListener('click', function(e) {
        if (!e.target) return;

        let btnDelete = null;

        if (e.target.classList && e.target.classList.contains('btn-delete')) {
            btnDelete = e.target;
        } else if (e.target.parentElement &&
                   e.target.parentElement.classList &&
                   e.target.parentElement.classList.contains('btn-delete')) {
            btnDelete = e.target.parentElement;
        }

        if (btnDelete && deleteModal) {
            currentUserId = btnDelete.getAttribute('data-userid');

            // Obtener la fila completa para extraer más datos
            const userRow = btnDelete.closest('.table-row');
            const userName = userRow ? userRow.querySelector('.user-fullname').textContent : '';
            const userEmail = userRow ? userRow.querySelector('.col-email').textContent : '';
            const userGamertag = userRow ? userRow.querySelector('.gamertag-badge').textContent : '';

            // Obtener todos los datos del usuario
            currentUserData = {
                id: currentUserId,
                nombre: userName,
                correo: userEmail,
                gamertag: userGamertag
            };

            if (currentUserId) {
                openDeleteModal();
            }
        }
    });

    // Abrir modal de eliminación
    function openDeleteModal() {
        if (deleteModal && deleteUserIdInput) {
            // Establecer los datos del usuario en el formulario
            deleteUserIdInput.value = currentUserData.id;
            deleteUserNombreInput.value = currentUserData.nombre;
            deleteUserEmailInput.value = currentUserData.correo;

            // Actualizar el contenido del modal con información del usuario
            updateDeleteModalContent();

            deleteModal.style.display = 'block';
            document.body.style.overflow = 'hidden';
            startCountdown();
        }
    }

    // Actualizar el contenido del modal con información del usuario
    function updateDeleteModalContent() {
        const warningContent = document.querySelector('.warning-content');

        // Remover información anterior si existe
        const existingUserInfo = document.getElementById('userInfoToDelete');
        if (existingUserInfo) {
            existingUserInfo.remove();
        }

        // Crear elemento con la información del usuario
        const userInfoDiv = document.createElement('div');
        userInfoDiv.id = 'userInfoToDelete';
        userInfoDiv.className = 'user-info-delete';
        userInfoDiv.innerHTML = `
            <div class="user-details-delete">
                <strong>Usuario a eliminar:</strong>
                <div>ID: ${currentUserData.id}</div>
                <div>Nombre: ${currentUserData.nombre}</div>
                <div>Email: ${currentUserData.correo}</div>
                <div>Gamertag: ${currentUserData.gamertag}</div>
            </div>
        `;

        // Insertar después del h3
        const h3Element = warningContent.querySelector('h3');
        warningContent.insertBefore(userInfoDiv, h3Element.nextSibling);
    }

    // Cerrar modal de eliminación
    function closeDeleteModal() {
        if (deleteModal) {
            deleteModal.style.display = 'none';
        }
        document.body.style.overflow = 'auto';
        resetCountdown();
    }

    if (closeDeleteBtn) {
        closeDeleteBtn.addEventListener('click', closeDeleteModal);
    }

    if (cancelDeleteBtn) {
        cancelDeleteBtn.addEventListener('click', closeDeleteModal);
    }

    // Cerrar modal al hacer click fuera
    window.addEventListener('click', function(e) {
        if (deleteModal && e.target === deleteModal) {
            closeDeleteModal();
        }
    });

    // Cerrar con ESC
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && deleteModal && deleteModal.style.display === 'block') {
            closeDeleteModal();
        }
    });

    // Iniciar contador
    function startCountdown() {
        let timeLeft = COUNTDOWN_TIME;
        confirmDeleteBtn.disabled = true;
        confirmDeleteBtn.style.cursor = 'not-allowed';
        deleteButtonText.textContent = `Eliminar Usuario (${timeLeft}s)`;

        // Resetear progreso
        countdownProgress.style.width = '0%';

        countdownInterval = setInterval(function() {
            timeLeft--;

            // Actualizar texto y progreso
            countdownTimer.textContent = timeLeft;
            deleteButtonText.textContent = `Eliminar Usuario (${timeLeft}s)`;

            // Actualizar barra de progreso
            const progressPercentage = ((COUNTDOWN_TIME - timeLeft) / COUNTDOWN_TIME) * 100;
            countdownProgress.style.width = `${progressPercentage}%`;

            // Cambiar color cuando queda poco tiempo
            if (timeLeft <= 2) {
                countdownProgress.style.background = 'linear-gradient(90deg, #ff4757, #ff3742)';
            }

            // Finalizar contador
            if (timeLeft <= 0) {
                clearInterval(countdownInterval);
                confirmDeleteBtn.disabled = false;
                confirmDeleteBtn.style.cursor = 'pointer';
                deleteButtonText.textContent = 'Eliminar Usuario';
                countdownProgress.style.width = '100%';
            }
        }, 1000);
    }

    // Resetear contador
    function resetCountdown() {
        if (countdownInterval) {
            clearInterval(countdownInterval);
        }
        countdownTimer.textContent = COUNTDOWN_TIME;
        countdownProgress.style.width = '0%';
        countdownProgress.style.background = 'linear-gradient(90deg, var(--color-primary), #6233b8)';
        confirmDeleteBtn.disabled = true;
        deleteButtonText.textContent = 'Eliminar Usuario';
    }

    // Prevenir envío del formulario si el botón está deshabilitado
    if (deleteUserForm) {
        deleteUserForm.addEventListener('submit', function(e) {
            if (confirmDeleteBtn.disabled) {
                e.preventDefault();
                return false;
            }

            // Mostrar estado de carga
            confirmDeleteBtn.disabled = true;
            confirmDeleteBtn.classList.add('loading');
            deleteButtonText.textContent = 'Eliminando...';

            // El formulario se enviará normalmente después de esto
            return true;
        });
    }

    // También prevenir clic directo en el botón si está deshabilitado
    if (confirmDeleteBtn) {
        confirmDeleteBtn.addEventListener('click', function(e) {
            if (this.disabled) {
                e.preventDefault();
                e.stopPropagation();
                return false;
            }
        });
    }

    const createRolSelect = document.getElementById('createRol');
    const createExpInput = document.getElementById('createExp');
    const createRangoDisplay = document.getElementById('createRangoDisplay');
    const createRangoHidden = document.getElementById('createRango');

       // La función original a modificar
    function updateRangoOnCreate() {
        const rol = createRolSelect ? createRolSelect.options[createRolSelect.selectedIndex].text : '';
        const xp = parseInt(createExpInput.value) || 0;

        let nuevoRangoNombre;

        const esRolAvanzado = rol.includes('Profesor') || rol.includes('Master');

        if (esRolAvanzado) {
            nuevoRangoNombre = 'Materia Oscura I';
            if (xp === 0) { createExpInput.value = 500000; }

        }

        else {
            nuevoRangoNombre = determinarRango(xp);
        }

        if (createRangoDisplay) {
            createRangoDisplay.value = nuevoRangoNombre;
        }
        if (createRangoHidden) {
            createRangoHidden.value = nuevoRangoNombre;
        }
    }

    if (createRolSelect) createRolSelect.addEventListener('change', updateRangoOnCreate);
    if (createExpInput) createExpInput.addEventListener('input', updateRangoOnCreate);


    const editExpInput = document.getElementById('editExp');
    const editRangoDisplay = document.getElementById('editRangoDisplay');
    const editRangoHidden = document.getElementById('editRango');

    // Función para actualizar el Rango en la edición
    function updateRangoOnEdit() {
        const xp = parseInt(editExpInput.value) || 0;

        // Reutilizamos la función determinarRango (debe estar disponible globalmente)
        const nuevoRango = determinarRango(xp);

        // Actualizar campos
        if (editRangoDisplay) editRangoDisplay.value = nuevoRango;
        if (editRangoHidden) editRangoHidden.value = nuevoRango;
    }


    // Event Listener para Experiencia en el Modal de Edición
    if (editExpInput) {
        editExpInput.addEventListener('input', updateRangoOnEdit);
    }

});


    // Función auxiliar que debe estar en tu script (fuera del DOMContentLoaded)
    function determinarRango(exp) {
        const xp = parseInt(exp) || 0;

        // Se recorre desde el rango más alto al más bajo
        if (xp >= 1000001) return 'Materia Oscura III';
        if (xp >= 750000) return 'Materia Oscura II';
        if (xp >= 500000) return 'Materia Oscura I';
        if (xp >= 300001) return 'Heroico III';
        if (xp >= 280001) return 'Heroico II';
        if (xp >= 260001) return 'Heroico I';
        if (xp >= 220001) return 'Diamante III';
        if (xp >= 200001) return 'Diamante II';
        if (xp >= 180001) return 'Diamante I';
        if (xp >= 160001) return 'Oro III';
        if (xp >= 140001) return 'Oro II';
        if (xp >= 120001) return 'Oro I';
        if (xp >= 100001) return 'Plata III';
        if (xp >= 80001) return 'Plata II';
        if (xp >= 60001) return 'Plata I';
        if (xp >= 40001) return 'Bronce III';
        if (xp >= 20001) return 'Bronce II';

        return 'Bronce I';
    }
