</style>

<script>
    // SOLO UN DOMContentLoaded - combina todo aquí
document.addEventListener('DOMContentLoaded', function() {
    // === FILTROS Y BÚSQUEDA ===
    const claseFilter = document.getElementById('clase-filter');
    const rolFilter = document.getElementById('rol-filter');
    const estadoFilter = document.getElementById('estado-filter');
    const experienciaFilter = document.getElementById('experiencia-filter');
    const userSearch = document.getElementById('user-search');
    const searchButton = document.querySelector('.search-button');
    const tableRows = document.querySelectorAll('.table-row');

    // Función principal de filtrado
    function filterUsers() {
        const claseValue = claseFilter.value;
        const rolValue = rolFilter.value;
            const estadoValue = estadoFilter.value;
        const experienciaValue = experienciaFilter.value;
        const searchValue = userSearch.value.toLowerCase().trim();

        tableRows.forEach(row => {
            let showRow = true;

            // Filtro por clase
            if (claseValue && showRow) {
                const clasesContainer = row.querySelector('.clases-container');
                const hasClase = Array.from(clasesContainer.querySelectorAll('.clase-badge'))
                    .some(badge => {
                        const claseId = badge.textContent.trim();
                        return claseId === claseValue;
                    });
                if (!hasClase) showRow = false;
            }

            // Filtro por rol
            if (rolValue && showRow) {
                const rolBadge = row.querySelector('.rol-badge');
                const userRol = rolBadge.textContent.trim();
                if (userRol !== rolValue) showRow = false;
            }

                // Filtro por estado
             if (estadoValue && showRow) {
                const statusBadge = row.querySelector('.status-badge');
                const userEstado = statusBadge.textContent.trim().toLowerCase();

                if (estadoValue === 'activo' && userEstado !== 'activo') {
                    showRow = false;
                } else if (estadoValue === 'inactivo' && userEstado !== 'inactivo') {
                    showRow = false;
                }
            }


            // Filtro por experiencia
            if (experienciaValue && showRow) {
                const xpDisplay = row.querySelector('.xp-display');
                const userXP = parseInt(xpDisplay.textContent.replace(/,/g, ''));

                switch(experienciaValue) {
                    case '0-1000':
                        if (userXP > 1000) showRow = false;
                        break;
                    case '1001-5000':
                        if (userXP < 1001 || userXP > 5000) showRow = false;
                        break;
                    case '5001-10000':
                        if (userXP < 5001 || userXP > 10000) showRow = false;
                        break;
                    case '10001+':
                        if (userXP < 10001) showRow = false;
                        break;
                }
            }

            // Filtro por búsqueda
            if (searchValue && showRow) {
                const userName = row.querySelector('.user-fullname').textContent.toLowerCase();
                const userEmail = row.querySelector('.col-email').textContent.toLowerCase();
                const userGamertag = row.querySelector('.gamertag-badge').textContent.toLowerCase();
                const userId = row.querySelector('.col-id').textContent.toLowerCase();

                const matchesSearch = userName.includes(searchValue) ||
                                    userEmail.includes(searchValue) ||
                                    userGamertag.includes(searchValue) ||
                                    userId.includes(searchValue);

                if (!matchesSearch) showRow = false;
            }

            // Mostrar u ocultar la fila
            row.style.display = showRow ? 'grid' : 'none';
        });

        // Mostrar mensaje si no hay resultados
        showNoResultsMessage();
    }

    // Función para mostrar mensaje cuando no hay resultados
    function showNoResultsMessage() {
        const visibleRows = Array.from(tableRows).filter(row => row.style.display !== 'none');
        const tableBody = document.querySelector('.table-body');

        // Remover mensaje anterior si existe
        const existingMessage = document.querySelector('.no-results-message');
        if (existingMessage) {
            existingMessage.remove();
        }

        if (visibleRows.length === 0) {
            const message = document.createElement('div');
            message.className = 'no-results-message';
            message.innerHTML = `
                <div class="no-results-content">
                    <i class="fas fa-search"></i>
                    <h3>No se encontraron usuarios</h3>
                    <p>Intenta ajustar los filtros o términos de búsqueda</p>
                </div>
            `;
            tableBody.appendChild(message);
        }
    }

    // Event listeners para los filtros
    if (claseFilter) claseFilter.addEventListener('change', filterUsers);
    if (rolFilter) rolFilter.addEventListener('change', filterUsers);
    if (estadoFilter) estadoFilter.addEventListener('change', filterUsers);
    if (experienciaFilter) experienciaFilter.addEventListener('change', filterUsers);

    // Event listeners para la búsqueda
    if (searchButton) searchButton.addEventListener('click', filterUsers);
    if (userSearch) {
        userSearch.addEventListener('keyup', function(e) {
            if (e.key === 'Enter') {
                filterUsers();
            }
        });
        userSearch.addEventListener('input', filterUsers);
    }

    // Función para limpiar filtros
    function clearFilters() {
        if (claseFilter) claseFilter.value = '';
        if (rolFilter) rolFilter.value = '';
        if (estadoFilter) estadoFilter.value = '';
        if (experienciaFilter) experienciaFilter.value = '';
        if (userSearch) userSearch.value = '';
        filterUsers();
    }

    // Botón de limpiar filtros
    const clearFiltersBtn = document.getElementById('clear-filters');
    if (clearFiltersBtn) {
        clearFiltersBtn.addEventListener('click', clearFilters);
    }

    // Inicializar filtros al cargar la página
    filterUsers();

    // Drag scroll
    const tableContainer = document.querySelector('.users-table-container');
    if (tableContainer) {
        let isDragging = false;
        let startX;
        let scrollLeft;

        tableContainer.addEventListener('mousedown', (e) => {
            isDragging = true;
            tableContainer.classList.add('dragging');
            startX = e.pageX - tableContainer.offsetLeft;
            scrollLeft = tableContainer.scrollLeft;
        });

        tableContainer.addEventListener('mouseleave', () => {
            isDragging = false;
            tableContainer.classList.remove('dragging');
        });

        tableContainer.addEventListener('mouseup', () => {
            isDragging = false;
            tableContainer.classList.remove('dragging');
        });

        tableContainer.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            e.preventDefault();
            const x = e.pageX - tableContainer.offsetLeft;
            const walk = (x - startX) * 2;
            tableContainer.scrollLeft = scrollLeft - walk;
        });

        tableContainer.addEventListener('touchstart', (e) => {
            isDragging = true;
            tableContainer.classList.add('dragging');
            startX = e.touches[0].pageX - tableContainer.offsetLeft;
            scrollLeft = tableContainer.scrollLeft;
        });

        tableContainer.addEventListener('touchend', () => {
            isDragging = false;
            tableContainer.classList.remove('dragging');
        });

        tableContainer.addEventListener('touchmove', (e) => {
            if (!isDragging) return;
            const x = e.touches[0].pageX - tableContainer.offsetLeft;
            const walk = (x - startX) * 2;
            tableContainer.scrollLeft = scrollLeft - walk;
        });

        tableContainer.addEventListener('selectstart', (e) => {
            if (isDragging) {
                e.preventDefault();
            }
        });
    }

    // Toggle passwords en la tabla
    document.querySelectorAll('.toggle-password').forEach(function(icon) {
        icon.addEventListener('click', function() {
            const passwordField = this.parentElement;
            const isVisible = passwordField.classList.contains('visible');
            const realPassword = passwordField.getAttribute('data-password');
            const textElement = passwordField.querySelector('.password-text') ||
                               document.createElement('span');

            if (!passwordField.querySelector('.password-text')) {
                textElement.className = 'password-text';
                passwordField.appendChild(textElement);
            }

            if (isVisible) {
                this.className = 'fas fa-eye toggle-password';
                textElement.textContent = ' ••••••••';
                passwordField.classList.remove('visible');
            } else {
                this.className = 'fas fa-eye-slash toggle-password';
                textElement.textContent = ` ${realPassword}`;
                passwordField.classList.add('visible');
            }
        });
    });

    // Asignar data-id a las filas
    const rows = document.querySelectorAll('.table-row');
    rows.forEach((row, index) => {
        row.setAttribute('data-id', (index + 1).toString().padStart(3, '0'));
    });

    // === MODAL FUNCTIONALITY ===
    const modal = document.getElementById('editUserModal');
    const closeBtn = document.querySelector('.close');
    const cancelBtn = document.querySelector('.btn-cancel');
    const editForm = document.getElementById('editUserForm');

    // Event listener para botones de edición CON VERIFICACIÓN
    document.addEventListener('click', function(e) {
        if (!e.target) return;

        let btnEdit = null;

        if (e.target.classList && e.target.classList.contains('btn-edit')) {
            btnEdit = e.target;
        } else if (e.target.parentElement &&
                   e.target.parentElement.classList &&
                   e.target.parentElement.classList.contains('btn-edit')) {
            btnEdit = e.target.parentElement;
        }

        if (btnEdit && modal) {
            const userId = btnEdit.getAttribute('data-userid');
            if (userId) {
                loadUserData(btnEdit, userId);
                modal.style.display = 'block';
                document.body.style.overflow = 'hidden';
            }
        }
    });

    // Cerrar modal
    function closeModal() {
        if (modal) {
            modal.style.display = 'none';
        }
        document.body.style.overflow = 'auto';
    }

    if (closeBtn) {
        closeBtn.addEventListener('click', closeModal);
    }

    if (cancelBtn) {
        cancelBtn.addEventListener('click', closeModal);
    }

    // Cerrar modal al hacer click fuera
    window.addEventListener('click', function(e) {
        if (modal && e.target === modal) {
            closeModal();
        }
    });

    // Cerrar con ESC
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal && modal.style.display === 'block') {
            closeModal();
        }
    });

    // Toggle para mostrar/ocultar contraseña en el formulario
    document.querySelectorAll('.toggle-password-input').forEach(function(icon) {
        icon.addEventListener('click', function() {
            const passwordInput = this.previousElementSibling;
            if (passwordInput && passwordInput.type) {
                if (passwordInput.type === 'password') {
                    passwordInput.type = 'text';
                    this.className = 'fas fa-eye-slash toggle-password-input';
                } else {
                    passwordInput.type = 'password';
                    this.className = 'fas fa-eye toggle-password-input';
                }
            }
        });
    });

    // Función para cargar datos del usuario
    function loadUserData(btn, userId) {
        if (!btn) return;

        try {
            const nombre = btn.getAttribute('data-nombre') || '';
            const correo = btn.getAttribute('data-correo') || '';
            const gamertag = btn.getAttribute('data-gamertag') || '';
            const password = btn.getAttribute('data-password') || '';
            const activo = btn.getAttribute('data-activo') || 'true';
            const exp = btn.getAttribute('data-exp') || '0';
            const racha = btn.getAttribute('data-racha') || '0';
            const licencia = btn.getAttribute('data-licencia') || '';
            const fechaVencimiento = btn.getAttribute('data-fechavencimiento') || '';
            const clasesString = btn.getAttribute('data-clases') || '';

            const userRow = btn.closest('.table-row');
            const rolTexto = userRow ? userRow.querySelector('.rol-badge').textContent.trim() : '';
            const rangoActual = userRow ? userRow.querySelector('.rango-badge').textContent.trim() : 'Bronce I';

            // Convertir string de clases a array
            const userClases = clasesString ? clasesString.split(',') : [];

            // Llenar el formulario
            const userIdInput = document.getElementById('editUserId');
            if (userIdInput) userIdInput.value = userId;

            const nombreInput = document.getElementById('editNombre');
            if (nombreInput) nombreInput.value = nombre;

            const correoInput = document.getElementById('editCorreo');
            if (correoInput) correoInput.value = correo;

            const gamertagInput = document.getElementById('editGamerTag');
            if (gamertagInput) gamertagInput.value = gamertag;

            const passwordInput = document.getElementById('editPassword');
            if (passwordInput) passwordInput.value = password || '';

            // Seleccionar rol
            const rolSelect = document.getElementById('editRol');
            if (rolSelect) {
                rolSelect.selectedIndex = -1;
                let rolEncontrado = false;
                for (let i = 0; i < rolSelect.options.length; i++) {
                    const option = rolSelect.options[i];
                    if (option.value === rolTexto || option.text === rolTexto) {
                        option.selected = true;
                        rolEncontrado = true;
                        break;
                    }
                }
                if (!rolEncontrado && rolSelect.options.length > 0) {
                    rolSelect.options[0].selected = true;
                }
            }

            const activoSelect = document.getElementById('editActivo');
            if (activoSelect) activoSelect.value = activo === 'True' ? 'true' : 'false';

            const expInput = document.getElementById('editExp');
            if (expInput) expInput.value = exp || '0';

            const rachaInput = document.getElementById('editRacha');
            if (rachaInput) rachaInput.value = racha || '0';

            const rangoDisplay = document.getElementById('editRangoDisplay');
            const rangoHidden = document.getElementById('editRango');

            if (rangoDisplay) rangoDisplay.value = rangoActual;
            if (rangoHidden) rangoHidden.value = rangoActual;

            const licenciaSelect = document.getElementById('editLicencia');
            if (licenciaSelect) licenciaSelect.value = licencia || 'Básica';

            const fechaInput = document.getElementById('editFechaVencimiento');
            if (fechaInput) fechaInput.value = fechaVencimiento || '';

            // Limpiar y marcar checkboxes de clases
            document.querySelectorAll('.clase-checkbox').forEach(checkbox => {
                checkbox.checked = false;
            });

            // Marcar las clases del usuario
            userClases.forEach(claseNombre => {
                const checkboxLabel = Array.from(document.querySelectorAll('.checkbox-label'))
                    .find(label => {
                        const labelText = label.textContent.trim();
                        return labelText === claseNombre;
                    });

                if (checkboxLabel) {
                    const checkbox = checkboxLabel.querySelector('.clase-checkbox');
                    if (checkbox) {
                        checkbox.checked = true;
                    }
                }
            });

            // Limpiar mensajes de error al cargar nuevos datos
            limpiarMensajesError();

        } catch (error) {
            console.error('Error al cargar datos del usuario:', error);
        }
    }

    // === VALIDACIÓN DEL FORMULARIO ===
    if (editForm) {
        editForm.addEventListener('submit', function(e) {
            e.preventDefault();
            
            if (validarFormulario()) {
                this.submit();
            }
        });
    }

    // Función de validación completa
    function validarFormulario() {
        let esValido = true;
        const mensajesError = [];

        // Limpiar mensajes de error anteriores
        limpiarMensajesError();

        // 1. Validar campos requeridos
        const nombre = document.getElementById('editNombre').value.trim();
        const correo = document.getElementById('editCorreo').value.trim();
        const gamertag = document.getElementById('editGamerTag').value.trim();
        const rol = document.getElementById('editRol').value;
        const licencia = document.getElementById('editLicencia').value;
            const pass = document.getElementById('editPassword').value;

        if (!nombre) {
            mostrarError('editNombre', 'El nombre completo es requerido');
            esValido = false;
            mensajesError.push('El nombre completo es requerido');
        } else if (nombre.length < 10 || nombre.length > 40) {
            mostrarError('editNombre', 'El nombre debe tener entre 10 y 40 caracteres');
            esValido = false;
            mensajesError.push('El nombre debe tener entre 10 y 40 caracteres');
        }


        if (!correo) {
            mostrarError('editCorreo', 'El correo electrónico es requerido');
            esValido = false;
            mensajesError.push('El correo electrónico es requerido');
        } else if (!correo.includes('.') || correo.length < 10 || correo.length >40) {
            mostrarError('editCorreo', 'El formato del correo no es válido, y/o debe contener entre 10 y 40 caracteres');
            esValido = false;
            mensajesError.push('El formato del correo no es válido');
        }

        if (!gamertag) {
            mostrarError('editGamerTag', 'El gamertag es requerido');
            esValido = false;
            mensajesError.push('El gamertag es requerido');
        } else if (gamertag.length < 7 || gamertag.length > 10) {
            mostrarError('editGamerTag', 'El gamertag debe tener entre 7 y 10 caracteres');
            esValido = false;
            mensajesError.push('El gamertag debe tener entre 7 y 10 caracteres');
        }

        if (!rol) {
            mostrarError('editRol', 'El rol es requerido');
            esValido = false;
            mensajesError.push('El rol es requerido');
        }

        if (!licencia) {
            mostrarError('editLicencia', 'La licencia es requerida');
            esValido = false;
            mensajesError.push('La licencia es requerida');
        }

        // 2. Validar que al menos una clase esté seleccionada
        const clasesSeleccionadas = document.querySelectorAll('.clase-checkbox:checked');
        if (clasesSeleccionadas.length === 0) {
            mostrarErrorClases('Debe seleccionar al menos una clase');
            esValido = false;
            mensajesError.push('Debe seleccionar al menos una clase');
        }

       

        // 4. Validar números positivos
        const exp = document.getElementById('editExp').value;
        const racha = document.getElementById('editRacha').value;

        if (exp && parseInt(exp) < 0) {
            mostrarError('editExp', 'La experiencia no puede ser negativa');
            esValido = false;
            mensajesError.push('La experiencia no puede ser negativa');
        }

        if (racha && parseInt(racha) < 0) {
            mostrarError('editRacha', 'La racha no puede ser negativa');
            esValido = false;
            mensajesError.push('La racha no puede ser negativa');
        }

    if (!pass) {
        mostrarError('editPassword', 'La contraseña es requerida');
        esValido = false;
        mensajesError.push('La contraseña es requerida');
    } else if (pass.length < 7 || pass.length > 10) {
        mostrarError('editPassword', 'La contraseña debe contener entre 7 a 10 caracteres');
        esValido = false;
        mensajesError.push('La contraseña debe contener entre 7 a 10 caracteres');
    }

        // Mostrar mensaje general de error si hay problemas
        if (!esValido) {
            mostrarMensajeErrorGeneral('Por favor, corrige los errores en el formulario: ' + mensajesError.join(', '));
        }

        return esValido;
    }

    // Función para mostrar error en un campo específico
    function mostrarError(campoId, mensaje) {
        const campo = document.getElementById(campoId);
        const grupo = campo.closest('.form-group');
        
        // Remover error anterior
        const errorAnterior = grupo.querySelector('.error-message');
        if (errorAnterior) {
            errorAnterior.remove();
        }
        
        // Agregar estilo de error al campo
        campo.style.borderColor = '#ff4757';
        
        // Crear mensaje de error
        const errorElement = document.createElement('div');
        errorElement.className = 'error-message';
        errorElement.style.color = '#ff4757';
        errorElement.style.fontSize = '0.8rem';
        errorElement.style.marginTop = '0.3rem';
        errorElement.innerHTML = `<i class="fas fa-exclamation-circle"></i> ${mensaje}`;
        
        grupo.appendChild(errorElement);
    }

    // Función para mostrar error en las clases
    function mostrarErrorClases(mensaje) {
        const clasesContainer = document.querySelector('.clases-checkbox-container');
        const grupoClases = clasesContainer.closest('.form-group');
        
        // Remover error anterior
        const errorAnterior = grupoClases.querySelector('.error-message');
        if (errorAnterior) {
            errorAnterior.remove();
        }
        
        // Crear mensaje de error
        const errorElement = document.createElement('div');
        errorElement.className = 'error-message';
        errorElement.style.color = '#ff4757';
        errorElement.style.fontSize = '0.8rem';
        errorElement.style.marginTop = '0.5rem';
        errorElement.innerHTML = `<i class="fas fa-exclamation-circle"></i> ${mensaje}`;
        
        grupoClases.appendChild(errorElement);
    }

    // Función para mostrar mensaje de error general
    function mostrarMensajeErrorGeneral(mensaje) {
        // Remover mensaje anterior
        const mensajeAnterior = document.querySelector('.alert-error-general');
        if (mensajeAnterior) {
            mensajeAnterior.remove();
        }
        
        // Crear mensaje de error general
        const errorGeneral = document.createElement('div');
        errorGeneral.className = 'alert-error-general';
        errorGeneral.style.background = 'linear-gradient(135deg, #ff4757, #ff3742)';
        errorGeneral.style.color = 'white';
        errorGeneral.style.padding = '1rem';
        errorGeneral.style.borderRadius = '0.5rem';
        errorGeneral.style.marginBottom = '1rem';
        errorGeneral.style.marginTop = '1rem';
        errorGeneral.innerHTML = `
            <i class="fas fa-exclamation-triangle"></i> 
            <strong>Error:</strong> ${mensaje}
        `;

        const formActions = editForm.querySelector('.form-actions');
        if (formActions && formActions.parentNode) {
            editForm.insertBefore(errorGeneral, formActions);
        } else {
       
            editForm.appendChild(errorGeneral);
        }
    }

    // Función para limpiar todos los mensajes de error
    function limpiarMensajesError() {
        // Limpiar mensajes de error de campos
        document.querySelectorAll('.error-message').forEach(error => error.remove());
        
        // Limpiar estilos de error
        document.querySelectorAll('.form-input, .form-select').forEach(campo => {
            campo.style.borderColor = '';
        });
        
        // Limpiar mensaje de error general
        const mensajeAnterior = document.querySelector('.alert-error-general');
        if (mensajeAnterior) {
            mensajeAnterior.remove();
        }
    }

    // Validación en tiempo real para campos críticos
    document.getElementById('editNombre')?.addEventListener('blur', validarCampoRequerido);
    document.getElementById('editCorreo')?.addEventListener('blur', validarEmailEnTiempoReal);
    document.getElementById('editGamerTag')?.addEventListener('blur', validarCampoRequerido);

    function validarCampoRequerido(e) {
        const campo = e.target;
        if (!campo.value.trim()) {
            mostrarError(campo.id, `El ${campo.previousElementSibling.textContent.replace(':', '')} es requerido`);
        } else {
            limpiarError(campo.id);
        }
    }

    function validarEmailEnTiempoReal(e) {
        const campo = e.target;
        const email = campo.value.trim();
        
        if (!email) {
            mostrarError(campo.id, 'El correo electrónico es requerido');
        } else {
            limpiarError(campo.id);
        }
    }

    function limpiarError(campoId) {
