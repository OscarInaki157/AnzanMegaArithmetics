@model AnzanMegaArithmetics.Models.ListUsersModel
@{
    ViewBag.Title = "Panel Administrador";
    Layout = "_LayoutDashboard";
}

<div class="admin-container">

    <div class="admin-header">
        <a href="@Url.Action("PanelAdministrador", "Dashboard")" class="back-button">
            <i class="fas fa-arrow-left"></i>
            Regresar
        </a>
    </div>

  
    <div class="filter-section">

        <div class="filter-bar">
            <div class="filter-group">
                <label for="clase-filter">Filtrar por clase:</label>
                <select id="clase-filter" class="filter-select">
                    <option value="">Todas las clases</option>
                    @foreach (var clase in Model.Clases)
                    {
                       
                        <option value="@clase.Nombre">@clase.Nombre</option>
                    }
                </select>
            </div>

            <div class="filter-group">
                <label for="rol-filter">Filtrar por rol:</label>
                <select id="rol-filter" class="filter-select">
                    <option value="">Todos los roles</option>
                    @foreach (var rol in Model.Roles)
                    {
                        <option value="@rol.Rol">@rol.Rol</option>
                    }
                </select>
            </div>

            <div class="filter-group">
                <label for="experiencia-filter">Filtrar por experiencia:</label>
                <select id="experiencia-filter" class="filter-select">
                    <option value="">Toda la experiencia</option>
                    <option value="0-1000">0 - 1,000 XP</option>
                    <option value="1001-5000">1,001 - 5,000 XP</option>
                    <option value="5001-10000">5,001 - 10,000 XP</option>
                    <option value="10001+">Más de 10,000 XP</option>
                </select>
            </div>

            <div class="filter-group">
                <button id="clear-filters" class="clear-filters-button">
                    <i class="fas fa-times"></i>
                    Limpiar Filtros
                </button>
            </div>
        </div>

        <div class="search-section">
            <div class="search-box">
                <input type="text" id="user-search" placeholder="Buscar usuario..." class="search-input">
                <button class="search-button">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="action-section">
        <button class="add-user-button">
            <i class="fas fa-plus"></i>
            Agregar Nuevo Usuario
        </button>
    </div>

    
    <div class="users-table-container">
        <div class="table-header">
            <div class="col-id">ID</div>
            <div class="col-rol">Rol</div>
            <div class="col-name">Nombre</div>
            <div class="col-email">Correo</div>
            <div class="col-gamertag">Gamertag</div>
            <div class="col-password">Contraseña</div>
            <div class="col-activo">Activo</div>
            <div class="col-racha">Racha</div>
            <div class="col-exp">Exp</div>
            <div class="col-ultimacnx">Última Conexión</div>
            <div class="col-licencia">Licencia</div>
            <div class="col-clases">Clases</div>
            <div class="col-actions">Acciones</div>
        </div>

        <div class="table-body">
            @foreach (var usuario in Model.UsuariosFinales)
            {
                <div class="table-row">
                    <div class="col-id">@usuario.Id_Usuario.ToString("D3")</div>

                    <div class="col-rol">
                        <span class="rol-badge">@usuario.Id_Rol</span>
                    </div>

                    <div class="col-name">
                        <div class="user-info">
                            <div class="user-details">
                                <div class="user-fullname">@usuario.Nombre</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-email">@usuario.Correo</div>

                    <div class="col-gamertag">
                        <span class="gamertag-badge">@usuario.Gamer_Tag</span>
                    </div>

                    <div class="col-password">
                        <div class="password-field" data-password="@usuario.Pass">
                            <i class="fas fa-eye toggle-password"></i>
                            <span class="password-text">••••••••</span>
                        </div>
                    </div>

                    <div class="col-activo">
                        <span class="status-badge @(usuario.Activo ? "activo" : "inactivo")">
                            @(usuario.Activo ? "Activo" : "Inactivo")
                        </span>
                    </div>

                    <div class="col-racha">
                        <span class="racha-badge">@usuario.Racha</span>
                    </div>

                    <div class="col-exp">
                        <div class="xp-display">@usuario.Exp</div>
                        <div class="xp-bar">
                            @{
                                var porcentaje = Math.Min((usuario.Exp / 100000.0) * 100, 100);
                            }
                            <div class="xp-progress" style="width: @porcentaje%"></div>
                        </div>
                    </div>

                    <div class="col-ultimacnx">
                        <span class="fecha-text">@usuario.Ultima_Cnx.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>

                    <div class="col-licencia">
                        <div class="licencia-fecha">
                            @usuario.Fecha_Asignacion_Licencia.Value.ToString("dd/MM/yyyy")
                        </div>
                        <span class="licencia-badge">@usuario.Licencia</span>
                        <div class="licencia-fecha">
                            @usuario.Fecha_Vencimiento_Licencia.Value.ToString("dd/MM/yyyy")
                        </div>
                    </div>

                    <div class="col-clases">
                        <div class="clases-container">
                            @foreach (var clase in usuario.Clases)
                            {
                                <span class="clase-badge @clase.ToLower().Replace(" ", "")">@clase</span>
                            }
                        </div>
                    </div>

                    <div class="col-actions">
                        <button class="btn-edit"
                                data-userid="@usuario.Id_Usuario"
                                data-nombre="@usuario.Nombre"
                                data-correo="@usuario.Correo"
                                data-gamertag="@usuario.Gamer_Tag"
                                data-password="@usuario.Pass"
                                data-rol="@usuario.Id_Rol"
                                data-activo="@usuario.Activo"
                                data-exp="@usuario.Exp"
                                data-racha="@usuario.Racha"
                                data-licencia="@usuario.Licencia"
                                data-fechavencimiento="@usuario.Fecha_Vencimiento_Licencia?.ToString("yyyy-MM-dd")"
                                data-clases="@string.Join(",", usuario.Clases)">
                            <i class="fas fa-edit"></i>
                            Modificar
                        </button>
                        <button class="btn-delete" data-userid="@usuario.Id_Usuario">
                            <i class="fas fa-trash"></i>
                            Eliminar
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* modificar modal *@
<div id="editUserModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Modificar Usuario</h2>
            <span class="close">&times;</span>
        </div>
        <div class="modal-body">
            <form id="editUserForm" class="edit-user-form">
                <input type="hidden" id="editUserId" name="Id_Usuario">

                <div class="form-row">
                    <div class="form-group">
                        <label for="editNombre">Nombre completo:</label>
                        <input type="text" id="editNombre" name="Nombre" class="form-input" required>
                    </div>

                    <div class="form-group">
                        <label for="editCorreo">Correo electrónico:</label>
                        <input type="email" id="editCorreo" name="Correo" class="form-input" required>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="editGamerTag">Gamertag:</label>
                        <input type="text" id="editGamerTag" name="Gamer_Tag" class="form-input" required>
                    </div>

                    <div class="form-group">
                        <label for="editPassword">Contraseña:</label>
                        <div class="password-input-container">
                            <input type="password" id="editPassword" name="Pass" class="form-input">
                            <i class="fas fa-eye toggle-password-input"></i>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="editRol">Rol:</label>
                        <select id="editRol" name="Id_Rol" class="form-select" required>
                            @foreach (var rol in Model.Roles)
                            {
                                <option value="@rol.Id_Rol">@rol.Rol</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="editActivo">Estado:</label>
                        <select id="editActivo" name="Activo" class="form-select" required>
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="editExp">Experiencia (XP):</label>
                        <input type="number" id="editExp" name="Exp" class="form-input" min="0">
                    </div>

                    <div class="form-group">
                        <label for="editRacha">Racha:</label>
                        <input type="number" id="editRacha" name="Racha" class="form-input" min="0">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="editLicencia">Licencia:</label>
                        <select id="editLicencia" name="Licencia" class="form-select" required>
                            @foreach (var lic in Model.Licencias)
                            {
                                <option value="@lic.Nombre">@lic.Nombre</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="editFechaVencimiento">Fecha Vencimiento Licencia:</label>
                        <input type="date" id="editFechaVencimiento" name="Fecha_Vencimiento_Licencia" class="form-input">
                    </div>
                </div>

                <div class="form-group full-width">
                    <label>Clases asignadas:</label>
                    <div class="clases-checkbox-container">
                        @foreach (var clase in Model.Clases)
                        {
                            <label class="checkbox-label">
                                <input type="checkbox" name="Clases" value="@clase.Id_Clase" class="clase-checkbox">
                                <span class="checkmark"></span>
                                @clase.Nombre
                            </label>
                        }
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn-cancel">Cancelar</button>
                    <button type="submit" class="btn-update">
                        <i class="fas fa-save"></i>
                        Actualizar Usuario
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>

    /* Estilos para la modal */
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(5px);
    }

    .modal-content {
        background-color: var(--color-card-bg);
        margin: 2% auto;
        padding: 0;
        border-radius: 1rem;
        width: 90%;
        max-width: 800px;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        animation: modalSlideIn 0.3s ease-out;
    }

    @@keyframes modalSlideIn {
        from

    {
        opacity: 0;
        transform: translateY(-50px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .modal-header {
        color: white;
        padding: 1.5rem 2rem;
        border-radius: 1rem 1rem 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .modal-header h2 {
            margin: 0;
            font-size: 1.5rem;
        }

    .close {
        color: white;
        font-size: 2rem;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .close:hover {
            transform: scale(1.1);
            opacity: 0.8;
        }

    .modal-body {
        padding: 2rem;
    }

    /* Estilos del formulario */
    .edit-user-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-weight: 600;
            color: var(--color-primary);
            font-size: 0.9rem;
        }

    .form-input, .form-select {
        background-color: var(--color-sidebar);
        color: var(--color-light);
        border: 1px solid rgba(76, 76, 255, 0.3);
        border-radius: 0.5rem;
        padding: 0.8rem 1rem;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        width: 100%;
    }

        .form-input:focus, .form-select:focus {
            outline: none;
            border-color: var(--color-primary);
            box-shadow: 0 0 0 2px rgba(76, 76, 255, 0.2);
        }

    /* Contenedor para input de contraseña */
    .password-input-container {
        position: relative;
    }

        .password-input-container .form-input {
            padding-right: 3rem;
        }

    .toggle-password-input {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--color-primary);
        cursor: pointer;
        font-size: 0.9rem;
    }

    /* Checkboxes para clases */
    .clases-checkbox-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 0.8rem;
        margin-top: 0.5rem;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        font-size: 0.9rem;
        color: var(--color-light);
    }

    .clase-checkbox {
        display: none;
    }

    .checkmark {
        width: 20px;
        height: 20px;
        border: 2px solid rgba(76, 76, 255, 0.5);
        border-radius: 0.3rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .checkmark::-webkit-scrollbar{
        display:none;
    }

        .checkmark:after {
            content: "✓";
            color: white;
            font-size: 0.8rem;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

    .clase-checkbox:checked + .checkmark {
        background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
        border-color: var(--color-primary);
    }

        .clase-checkbox:checked + .checkmark:after {
            opacity: 1;
        }

    /* Botones del formulario */
    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .btn-cancel, .btn-update {
        padding: 0.8rem 1.5rem;
        border: none;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

    .btn-cancel {
        background-color: rgba(255, 255, 255, 0.1);
        color: var(--color-light);
    }

        .btn-cancel:hover {
            background-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

    .btn-update {
        background: linear-gradient(135deg, #00cc66, #00b359);
        color: white;
    }

        .btn-update:hover {
            background: linear-gradient(135deg, #00b359, #00994d);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 204, 102, 0.4);
        }


    .no-results-message {
        grid-column: 1 / -1;
        text-align: center;
        padding: 3rem 2rem;
        color: var(--color-light);
    }

    .no-results-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

        .no-results-content i {
            font-size: 3rem;
            color: var(--color-primary);
            opacity: 0.7;
        }

        .no-results-content h3 {
            font-size: 1.5rem;
            color: var(--color-primary);
            margin: 0;
        }

        .no-results-content p {
            font-size: 1rem;
            opacity: 0.8;
            margin: 0;
        }

    .clear-filters-button {
        background: linear-gradient(135deg, #ff4757, #ff3742);
        color: white;
        border: none;
        padding: 0.6rem 1rem;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        margin-top: 1.5rem;
    }

        .clear-filters-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 71, 87, 0.4);
        }
    .admin-container {
        padding: 2rem;
        color: var(--color-light);
        max-width: 1400px;
        margin: 0 auto;
    }

   
    .admin-header {
        margin-bottom: 2rem;
    }

    .back-button {
        background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
        color: white;
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 2rem;
