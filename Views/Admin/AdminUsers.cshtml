<script>
       // Funcionalidad para filtros y búsqueda
    document.addEventListener('DOMContentLoaded', function() {
        const claseFilter = document.getElementById('clase-filter');
        const rolFilter = document.getElementById('rol-filter');
        const experienciaFilter = document.getElementById('experiencia-filter');
        const userSearch = document.getElementById('user-search');
        const searchButton = document.querySelector('.search-button');
        const tableRows = document.querySelectorAll('.table-row');

        // Función principal de filtrado
        function filterUsers() {
            const claseValue = claseFilter.value;
            const rolValue = rolFilter.value;
            const experienciaValue = experienciaFilter.value;
            const searchValue = userSearch.value.toLowerCase().trim();

            tableRows.forEach(row => {
                let showRow = true;

                // Filtro por clase
                if (claseValue && showRow) {
                    const clasesContainer = row.querySelector('.clases-container');
                    const hasClase = Array.from(clasesContainer.querySelectorAll('.clase-badge'))
                        .some(badge => {
                            const claseId = badge.textContent.trim();
                            return claseId === claseValue;
                        });
                    if (!hasClase) showRow = false;
                }

                // Filtro por rol
                if (rolValue && showRow) {
                    const rolBadge = row.querySelector('.rol-badge');
                    const userRol = rolBadge.textContent.trim();
                    if (userRol !== rolValue) showRow = false;
                }

                // Filtro por experiencia
                if (experienciaValue && showRow) {
                    const xpDisplay = row.querySelector('.xp-display');
                    const userXP = parseInt(xpDisplay.textContent.replace(/,/g, ''));

                    switch(experienciaValue) {
                        case '0-1000':
                            if (userXP > 1000) showRow = false;
                            break;
                        case '1001-5000':
                            if (userXP < 1001 || userXP > 5000) showRow = false;
                            break;
                        case '5001-10000':
                            if (userXP < 5001 || userXP > 10000) showRow = false;
                            break;
                        case '10001+':
                            if (userXP < 10001) showRow = false;
                            break;
                    }
                }

                // Filtro por búsqueda
                if (searchValue && showRow) {
                    const userName = row.querySelector('.user-fullname').textContent.toLowerCase();
                    const userEmail = row.querySelector('.col-email').textContent.toLowerCase();
                    const userGamertag = row.querySelector('.gamertag-badge').textContent.toLowerCase();
                    const userId = row.querySelector('.col-id').textContent.toLowerCase();

                    const matchesSearch = userName.includes(searchValue) ||
                                        userEmail.includes(searchValue) ||
                                        userGamertag.includes(searchValue) ||
                                        userId.includes(searchValue);

                    if (!matchesSearch) showRow = false;
                }

                // Mostrar u ocultar la fila
                row.style.display = showRow ? 'grid' : 'none';
            });

            // Mostrar mensaje si no hay resultados
            showNoResultsMessage();
        }

        // Función para mostrar mensaje cuando no hay resultados
        function showNoResultsMessage() {
            const visibleRows = Array.from(tableRows).filter(row => row.style.display !== 'none');
            const tableBody = document.querySelector('.table-body');

            // Remover mensaje anterior si existe
            const existingMessage = document.querySelector('.no-results-message');
            if (existingMessage) {
                existingMessage.remove();
            }

            if (visibleRows.length === 0) {
                const message = document.createElement('div');
                message.className = 'no-results-message';
                message.innerHTML = `
                    <div class="no-results-content">
                        <i class="fas fa-search"></i>
                        <h3>No se encontraron usuarios</h3>
                        <p>Intenta ajustar los filtros o términos de búsqueda</p>
                    </div>
                `;
                tableBody.appendChild(message);
            }
        }

        // Event listeners para los filtros
        claseFilter.addEventListener('change', filterUsers);
        rolFilter.addEventListener('change', filterUsers);
        experienciaFilter.addEventListener('change', filterUsers);

        // Event listeners para la búsqueda
        searchButton.addEventListener('click', filterUsers);
        userSearch.addEventListener('keyup', function(e) {
            if (e.key === 'Enter') {
                filterUsers();
            }
        });

        // Búsqueda en tiempo real
        userSearch.addEventListener('input', filterUsers);

        // Función para limpiar filtros
        function clearFilters() {
            claseFilter.value = '';
            rolFilter.value = '';
            experienciaFilter.value = '';
            userSearch.value = '';
            filterUsers();
        }

        // Botón de limpiar filtros (si existe)
        const clearFiltersBtn = document.getElementById('clear-filters');
        if (clearFiltersBtn) {
            clearFiltersBtn.addEventListener('click', clearFilters);
        }

        // Inicializar filtros al cargar la página
        filterUsers();

        // Tu código existente para drag scroll y contraseñas...
        const tableContainer = document.querySelector('.users-table-container');
        let isDragging = false;
        let startX;
        let scrollLeft;

        tableContainer.addEventListener('mousedown', (e) => {
            isDragging = true;
            tableContainer.classList.add('dragging');
            startX = e.pageX - tableContainer.offsetLeft;
            scrollLeft = tableContainer.scrollLeft;
        });

        tableContainer.addEventListener('mouseleave', () => {
            isDragging = false;
            tableContainer.classList.remove('dragging');
        });

        tableContainer.addEventListener('mouseup', () => {
            isDragging = false;
            tableContainer.classList.remove('dragging');
        });

        tableContainer.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            e.preventDefault();
            const x = e.pageX - tableContainer.offsetLeft;
            const walk = (x - startX) * 2;
            tableContainer.scrollLeft = scrollLeft - walk;
        });

        tableContainer.addEventListener('touchstart', (e) => {
            isDragging = true;
            tableContainer.classList.add('dragging');
            startX = e.touches[0].pageX - tableContainer.offsetLeft;
            scrollLeft = tableContainer.scrollLeft;
        });

        tableContainer.addEventListener('touchend', () => {
            isDragging = false;
            tableContainer.classList.remove('dragging');
        });

        tableContainer.addEventListener('touchmove', (e) => {
            if (!isDragging) return;
            const x = e.touches[0].pageX - tableContainer.offsetLeft;
            const walk = (x - startX) * 2;
            tableContainer.scrollLeft = scrollLeft - walk;
        });

        tableContainer.addEventListener('selectstart', (e) => {
            if (isDragging) {
                e.preventDefault();
            }
        });

        document.querySelectorAll('.toggle-password').forEach(function(icon) {
            icon.addEventListener('click', function() {
                const passwordField = this.parentElement;
                const isVisible = passwordField.classList.contains('visible');
                const realPassword = passwordField.getAttribute('data-password');
                const textElement = passwordField.querySelector('.password-text') ||
                                   document.createElement('span');

                if (!passwordField.querySelector('.password-text')) {
                    textElement.className = 'password-text';
                    passwordField.appendChild(textElement);
                }

                if (isVisible) {
                    this.className = 'fas fa-eye toggle-password';
                    textElement.textContent = ' ••••••••';
                    passwordField.classList.remove('visible');
                } else {
                    this.className = 'fas fa-eye-slash toggle-password';
                    textElement.textContent = ` ${realPassword}`;
                    passwordField.classList.add('visible');
                }
            });
        });

        const rows = document.querySelectorAll('.table-row');
        rows.forEach((row, index) => {
            row.setAttribute('data-id', (index + 1).toString().padStart(3, '0'));
        });
    });



        // Funcionalidad para la modal de modificar usuario
    document.addEventListener('DOMContentLoaded', function() {
        const modal = document.getElementById('editUserModal');
        const closeBtn = document.querySelector('.close');
        const cancelBtn = document.querySelector('.btn-cancel');
        const editForm = document.getElementById('editUserForm');

            
    document.addEventListener('click', function(e) {
        if (e.target.classList.contains('btn-edit') ||
            e.target.parentElement.classList.contains('btn-edit')) {

            const btn = e.target.classList.contains('btn-edit') ? e.target : e.target.parentElement;
            const userId = btn.getAttribute('data-userid');

            loadUserData(btn, userId);
            modal.style.display = 'block';
            document.body.style.overflow = 'hidden';
        }
    });

        // Cerrar modal
        function closeModal() {
            modal.style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        closeBtn.addEventListener('click', closeModal);
        cancelBtn.addEventListener('click', closeModal);

        // Cerrar modal al hacer click fuera del contenido
        window.addEventListener('click', function(e) {
            if (e.target === modal) {
                closeModal();
            }
        });

        // Cerrar modal con ESC key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && modal.style.display === 'block') {
                closeModal();
            }
        });

        // Toggle para mostrar/ocultar contraseña en el formulario
        document.querySelectorAll('.toggle-password-input').forEach(function(icon) {
            icon.addEventListener('click', function() {
                const passwordInput = this.previousElementSibling;
                if (passwordInput.type === 'password') {
                    passwordInput.type = 'text';
                    this.className = 'fas fa-eye-slash toggle-password-input';
                } else {
                    passwordInput.type = 'password';
                    this.className = 'fas fa-eye toggle-password-input';
                }
            });
        });

       
    function loadUserData(btn, userId) {
        // Obtener todos los datos de los atributos data del botón
        const nombre = btn.getAttribute('data-nombre');
        const correo = btn.getAttribute('data-correo');
        const gamertag = btn.getAttribute('data-gamertag');
        const password = btn.getAttribute('data-password');
        const activo = btn.getAttribute('data-activo');
        const exp = btn.getAttribute('data-exp');
        const racha = btn.getAttribute('data-racha');
        const licencia = btn.getAttribute('data-licencia');
        const fechaVencimiento = btn.getAttribute('data-fechavencimiento');
        const clasesString = btn.getAttribute('data-clases');

        const userRow = btn.closest('.table-row');
        const rolTexto = userRow.querySelector('.rol-badge').textContent.trim();


        // Convertir string de clases a array
        const userClases = clasesString ? clasesString.split(',') : [];

        // Llenar el formulario
        document.getElementById('editUserId').value = userId;
        document.getElementById('editNombre').value = nombre || '';
        document.getElementById('editCorreo').value = correo || '';
        document.getElementById('editGamerTag').value = gamertag || '';
        document.getElementById('editPassword').value = password || '';

        const rolSelect = document.getElementById('editRol');
        rolSelect.selectedIndex = -1;
        let rolEncontrado = false;
        for (let i = 0; i < rolSelect.options.length; i++) {
            const option = rolSelect.options[i];

            // Comparar tanto el valor como el texto de la opción
            if (option.value === rolTexto || option.text === rolTexto) {
                option.selected = true;
                rolEncontrado = true;
                break;
            }
        }

        if (!rolEncontrado && rolSelect.options.length > 0) {
        rolSelect.options[0].selected = true;
    }
       

        document.getElementById('editActivo').value = activo === 'True' ? 'true' : 'false';
        document.getElementById('editExp').value = exp || '0';
        document.getElementById('editRacha').value = racha || '0';
        document.getElementById('editLicencia').value = licencia || 'Básica';
        document.getElementById('editFechaVencimiento').value = fechaVencimiento || '';

        // Limpiar y marcar checkboxes de clases
        document.querySelectorAll('.clase-checkbox').forEach(checkbox => {
            checkbox.checked = false;
        });

        // Marcar las clases del usuario
        userClases.forEach(claseNombre => {
            const checkboxLabel = Array.from(document.querySelectorAll('.checkbox-label'))
                .find(label => {
                    const labelText = label.textContent.trim();
                    return labelText === claseNombre;
                });

            if (checkboxLabel) {
                const checkbox = checkboxLabel.querySelector('.clase-checkbox');
                if (checkbox) {
                    checkbox.checked = true;
                }
            }
        });

        console.log('Datos cargados:', {
            userId, nombre, correo, gamertag, password, rolTexto, activo, exp, racha, licencia, fechaVencimiento, userClases
        });
    }

        // Manejar envío del formulario
        editForm.addEventListener('submit', function(e) {
            e.preventDefault();

            // Aquí iría la lógica para enviar los datos al servidor
            const formData = new FormData(this);
            const userData = Object.fromEntries(formData.entries());

            console.log('Datos a actualizar:', userData);

            // Simular actualización (reemplazar con llamada AJAX real)
            alert('Usuario actualizado correctamente (esto es una simulación)');
            closeModal();

            // En una implementación real, aquí harías:
            // fetch('/api/usuarios/actualizar', {
            //     method: 'POST',
            //     headers: { 'Content-Type': 'application/json' },
            //     body: JSON.stringify(userData)
            // })
            // .then(response => response.json())
            // .then(data => {
            //     if (data.success) {
            //         alert('Usuario actualizado correctamente');
            //         closeModal();
            //         // Recargar la página o actualizar la tabla
            //         location.reload();
            //     }
            // });
        });
    });
</script>