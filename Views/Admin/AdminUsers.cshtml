@model AnzanMegaArithmetics.Models.ListUsersModel
@{
    ViewBag.Title = "Panel Administrador";
    Layout = "_LayoutAdmin";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="admin-container">

    <div class="admin-header">
        <a href="@Url.Action("PanelAdministrador", "Dashboard")" class="back-button">
            <i class="fas fa-arrow-left"></i>
            Regresar
        </a>
    </div>

  
    <div class="filter-section">

        <div class="filter-bar">
            <div class="filter-group">
                <label for="clase-filter">Filtrar por clase:</label>
                <select id="clase-filter" class="filter-select">
                    <option value="">Todas las clases</option>
                    @foreach (var clase in Model.Clases)
                    {
                       
                        <option value="@clase.Nombre">@clase.Nombre</option>
                    }
                </select>
            </div>

            <div class="filter-group">
                <label for="estado-filter">Filtrar por estado:</label>
                <select id="estado-filter" class="filter-select">
                    <option value="">Todos los estados</option>
                    <option value="activo">Activo</option>
                    <option value="inactivo">Inactivo</option>
                </select>
            </div>

            <div class="filter-group">
                <label for="rol-filter">Filtrar por rol:</label>
                <select id="rol-filter" class="filter-select">
                    <option value="">Todos los roles</option>
                    @foreach (var rol in Model.Roles)
                    {
                        <option value="@rol.Rol">@rol.Rol</option>
                    }
                </select>
            </div>

            <div class="filter-group">
                <label for="experiencia-filter">Filtrar por experiencia:</label>
                <select id="experiencia-filter" class="filter-select">
                    <option value="">Toda la experiencia</option>
                    <option value="0-1000">0 - 1,000 XP</option>
                    <option value="1001-5000">1,001 - 5,000 XP</option>
                    <option value="5001-10000">5,001 - 10,000 XP</option>
                    <option value="10001+">Más de 10,000 XP</option>
                </select>
            </div>

            <div class="filter-group">
                <button id="clear-filters" class="clear-filters-button">
                    <i class="fas fa-times"></i>
                    Limpiar Filtros
                </button>
            </div>
        </div>

        <div class="search-section">
            <div class="search-box">
                <input type="text" id="user-search" placeholder="Buscar usuario..." class="search-input">
                <button class="search-button">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="action-section">
        <button class="add-user-button" id="btnAddUser">
            <i class="fas fa-plus"></i>
            Agregar Nuevo Usuario
        </button>
    </div>

    
    <div class="users-table-container">
        <div class="table-header">
            <div class="col-id">ID</div>
            <div class="col-rol">Rol</div>
            <div class="col-name">Nombre</div>
            <div class="col-rango">Rango</div>
            <div class="col-email">Correo</div>
            <div class="col-gamertag">Gamertag</div>
            <div class="col-password">Contraseña</div>
            <div class="col-activo">Activo</div>
            <div class="col-racha">Racha</div>
            <div class="col-exp">Exp</div>
            <div class="col-ultimacnx">Última Conexión</div>
            <div class="col-licencia">Licencia</div>
            <div class="col-clases">Clases</div>
            <div class="col-actions">Acciones</div>
        </div>

        <div class="table-body">
            @foreach (var usuario in Model.UsuariosFinales)
            {
                <div class="table-row">
                    <div class="col-id">@usuario.Id_Usuario.ToString("D3")</div>

                    <div class="col-rol">
                        <span class="rol-badge">@usuario.Id_Rol</span>
                    </div>

                    <div class="col-name">
                        <div class="user-info">
                            <div class="user-details">
                                <div class="user-fullname">@usuario.Nombre</div>
                            </div>
                        </div>
                    </div>

                    @{
                        string nombreRango = usuario.Rango_Actual ?? "Bronce I";
                        string rangoClase = "bronze";

                        if (nombreRango.Contains("Materia Oscura", StringComparison.OrdinalIgnoreCase)) { rangoClase = "dark-matter"; }
                        else if (nombreRango.Contains("Heroico", StringComparison.OrdinalIgnoreCase)) { rangoClase = "heroic"; }
                        else if (nombreRango.Contains("Diamante", StringComparison.OrdinalIgnoreCase)) { rangoClase = "diamond"; }
                        else if (nombreRango.Contains("Oro", StringComparison.OrdinalIgnoreCase)) { rangoClase = "gold"; }
                        else if (nombreRango.Contains("Plata", StringComparison.OrdinalIgnoreCase)) { rangoClase = "silver"; }
                        else { rangoClase = "bronze"; }
                    }

                    <div class="col-rango">
                        <span class="rango-badge @rangoClase" title="@usuario.Rango_Actual">@usuario.Rango_Actual</span>
                    </div>

                    <div class="col-email">@usuario.Correo</div>

                    <div class="col-gamertag">
                        <span class="gamertag-badge">@usuario.Gamer_Tag</span>
                    </div>

                    <div class="col-password">
                        <div class="password-field" data-password="@usuario.Pass">
                            <i class="fas fa-eye toggle-password"></i>
                            <span class="password-text">••••••••</span>
                        </div>
                    </div>

                    <div class="col-activo">
                        <span class="status-badge @(usuario.Activo ? "activo" : "inactivo")">
                            @(usuario.Activo ? "Activo" : "Inactivo")
                        </span>
                    </div>

                    <div class="col-racha">
                        <span class="racha-badge">@usuario.Racha</span>
                    </div>

                    <div class="col-exp">
                        <div class="xp-display">@usuario.Exp</div>
                        <div class="xp-bar">
                            @{
                                var porcentaje = Math.Min((usuario.Exp / 100000.0) * 100, 100);
                            }
                            <div class="xp-progress" style="width: @porcentaje%"></div>
                        </div>
                    </div>

                    <div class="col-ultimacnx">
                        <span class="fecha-text">@usuario.Ultima_Cnx.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>

                    <div class="col-licencia">
                        <div class="licencia-fecha">
                            @usuario.Fecha_Asignacion_Licencia.Value.ToString("dd/MM/yyyy")
                        </div>
                        <span class="licencia-badge">@usuario.Licencia</span>
                        <div class="licencia-fecha">
                            @usuario.Fecha_Vencimiento_Licencia.Value.ToString("dd/MM/yyyy")
                        </div>
                    </div>

                    <div class="col-clases">
                        <div class="clases-container">
                            @foreach (var clase in usuario.Clases)
                            {
                                <span class="clase-badge @clase.ToLower().Replace(" ", "")">@clase</span>
                            }
                        </div>
                    </div>

                    <div class="col-actions">
                        <button class="btn-edit"
                                data-userid="@usuario.Id_Usuario"
                                data-nombre="@usuario.Nombre"
                                data-correo="@usuario.Correo"
                                data-gamertag="@usuario.Gamer_Tag"
                                data-password="@usuario.Pass"
                                data-rol="@usuario.Id_Rol"
                                data-activo="@usuario.Activo"
                                data-exp="@usuario.Exp"
                                data-racha="@usuario.Racha"
                                data-licencia="@usuario.Licencia"
                                data-fechavencimiento="@usuario.Fecha_Vencimiento_Licencia?.ToString("yyyy-MM-dd")"
                                data-clases="@string.Join(",", usuario.Clases)">
                            <i class="fas fa-edit"></i>
                            Modificar
                        </button>
                        <button class="btn-delete" data-userid="@usuario.Id_Usuario">
                            <i class="fas fa-trash"></i>
                            Eliminar
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* modificar modal *@
<div id="editUserModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Modificar Usuario</h2>
            <span class="close">&times;</span>
        </div>
        <div class="modal-body">
            @* formulario editar *@
            <form id="editUserForm" class="edit-user-form" method="post" action="/Admin/ActualizarUsuario">
                <input type="hidden" id="editUserId" name="Id_Usuario">

                <div class="form-row">
                    <div class="form-group">
                        <label for="editNombre">Nombre completo:</label>
                        <input type="text" id="editNombre" name="Nombre" class="form-input" required>
                    </div>

                    <div class="form-group">
                        <label for="editCorreo">Correo electrónico:</label>
                        <input type="email" id="editCorreo" name="Correo" class="form-input" required>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="editGamerTag">Gamertag:</label>
                        <input type="text" id="editGamerTag" name="Gamer_Tag" class="form-input" required>
                    </div>

                    <div class="form-group">
                        <label for="editPassword">Contraseña:</label>
                        <div class="password-input-container">
                            <input type="password" id="editPassword" name="Pass" class="form-input">
                            <i class="fas fa-eye toggle-password-input"></i>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="editRol">Rol:</label>
                        <select id="editRol" name="Id_Rol" class="form-select" required>
                            @foreach (var rol in Model.Roles)
                            {
                                <option value="@rol.Id_Rol">@rol.Rol</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="editActivo">Estado:</label>
                        <select id="editActivo" name="Activo" class="form-select" required>
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="editExp">Experiencia (XP):</label>
                        <input type="number" id="editExp" name="Exp" class="form-input" min="0">
                    </div>

                    <div class="form-group">
                        <label for="editRacha">Racha:</label>
                        <input type="number" id="editRacha" name="Racha" class="form-input" min="0">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="editRangoDisplay">Rango Actual:</label>
                        <input type="text" id="editRangoDisplay" class="form-input" readonly value="">
                        <input type="hidden" id="editRango" name="Rango_Actual" value="">
                    </div>

                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="editLicencia">Licencia:</label>
                        <select id="editLicencia" name="Licencia" class="form-select" required>
                            @foreach (var lic in Model.Licencias)
                            {
                                <option value="@lic.Nombre">@lic.Nombre</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="editFechaVencimiento">Fecha Vencimiento Licencia:</label>
                        <input type="date" id="editFechaVencimiento" name="Fecha_Vencimiento_Licencia" class="form-input">
                    </div>
                </div>

                <div class="form-group full-width">
                    <label>Clases asignadas:</label>

                    <div class="clases-checkbox-container">
                        @foreach (var clase in Model.Clases)
                        {
                            <label class="checkbox-label">
                                <input type="checkbox" name="ClasesSeleccionadas[]" value="@clase.Id_Clase" class="clase-checkbox">
                                <span class="checkmark"></span>
                                @clase.Nombre
                            </label>
                        }
                    </div>

                </div>

                <div class="form-actions">
                    <button type="button" class="btn-cancel">Cancelar</button>
                    <button type="submit" class="btn-update">
                        <i class="fas fa-save"></i>
                        Actualizar Usuario
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Modal para crear nuevo usuario *@
<div id="createUserModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Crear Nuevo Usuario</h2>
            <span class="close-create">&times;</span>
        </div>
        <div class="modal-body">
            <form id="createUserForm" class="edit-user-form" method="post" action="/Admin/CrearUsuario">
                <div class="form-row">
                    <div class="form-group">
                        <label for="createNombre">Nombre completo:</label>
                        <input type="text" id="createNombre" name="Nombre" class="form-input" required>
                    </div>

                    <div class="form-group">
                        <label for="createCorreo">Correo electrónico:</label>
                        <input type="email" id="createCorreo" name="Correo" class="form-input" required>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="createGamerTag">Gamertag:</label>
                        <input type="text" id="createGamerTag" name="Gamer_Tag" class="form-input" required>
                    </div>

                    <div class="form-group">
                        <label for="createPassword">Contraseña:</label>
                        <div class="password-input-container">
                            <input type="password" id="createPassword" name="Pass" class="form-input" required>
                            <i class="fas fa-eye toggle-password-input-create"></i>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="createRol">Rol:</label>
                        <select id="createRol" name="Id_Rol" class="form-select" required>
                            @foreach (var rol in Model.Roles)
                            {
                                <option value="@rol.Id_Rol">@rol.Rol</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="createActivo">Estado:</label>
                        <select id="createActivo" name="Activo" class="form-select" required>
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="createExp">Experiencia (XP):</label>
                        <input type="number" id="createExp" name="Exp" class="form-input" min="0" value="0">
                    </div>

                    <div class="form-group">
                        <label for="createRacha">Racha:</label>
                        <input type="number" id="createRacha" name="Racha" class="form-input" min="0" value="0">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="createLicencia">Licencia:</label>
                        <select id="createLicencia" name="Licencia" class="form-select" required>
                            
                            @foreach (var lic in Model.Licencias)
                            {
                                <option value="@lic.Nombre">@lic.Nombre</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="createRangoDisplay">Rango Inicial Asignado:</label>
                        <input type="text" id="createRangoDisplay" class="form-input" readonly value="Bronce I">
                        <input type="hidden" id="createRango" name="Rango_Actual" value="Bronce I">
                    </div>

                    
                </div>

                <div class="form-group full-width">
                    <p class="small-info-note">
                        <i class="fas fa-info-circle"></i>
                        Nota: Si es "Alumno", el rango inicial es **Bronce I** (0 XP) automaticamente. Si es "Profesor", se asigna a **Materia Oscura I** (500,000 XP) automáticamente. La XP se puede ajustar manualmente, lo que puede afectar el rango inicial (No recomendado al crear un nuevo usuario).
                    </p>
                </div>

                <div class="form-group full-width">
                    <label>Clases asignadas:</label>
                    <div class="clases-checkbox-container">
                        @foreach (var clase in Model.Clases)
                        {
                            <label class="checkbox-label">
                                <input type="checkbox" name="ClasesSeleccionadas[]" value="@clase.Id_Clase" class="clase-checkbox-create">
                                <span class="checkmark"></span>
                                @clase.Nombre
                            </label>
                        }
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn-cancel-create">Cancelar</button>
                    <button type="submit" class="btn-create">
                        <i class="fas fa-user-plus"></i>
                        Crear Usuario
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Modal para eliminar usuario *@
<div id="deleteUserModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Eliminar Usuario</h2>
            <span class="close-delete">&times;</span>
        </div>
        <div class="modal-body">
            <form id="deleteUserForm" method="post" action="@Url.Action("EliminarUsuario", "Admin")">
                
                <input type="hidden" id="deleteUserId" name="Id_Usuario" value="">
                <input type="hidden" id="deleteUserNombre" name="Nombre" value="">
                <input type="hidden" id="deleteUserEmail" name="Correo" value="">

                <div class="delete-warning">
                    <div class="warning-icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="warning-content">
                        <h3>¡Atención!</h3>
                        <p>Esta acción no se puede deshacer. Se eliminarán todos los registros del usuario, incluyendo:</p>
                        <ul>
                            <li>Datos personales del usuario</li>
                            <li>Todos sus registros de tareas, prácticas, recompensas</li>
                            <li>Progreso y estadísticas</li>
                            <li>Se borrará el usuario de la o las clases a las que pertenece</li>
                            <li>No se podrá recuperar el registro de su licencia de software</li>
                        </ul>
                        <p class="warning-highlight">Esta operación es irreversible.</p>
                    </div>
                </div>

                <div class="countdown-section">
                    <div class="countdown-text">
                        El botón de eliminación se habilitará en:
                        <span id="countdown-timer" class="countdown-number">5</span> segundos
                    </div>
                    <div class="countdown-bar">
                        <div id="countdown-progress" class="countdown-progress"></div>
                    </div>
                </div>

                <div class="delete-actions">
                    <button type="button" class="btn-cancel-delete">
                        <i class="fas fa-times"></i>
                        Cancelar
                    </button>
                    <button type="submit" id="btnConfirmDelete" class="btn-confirm-delete" disabled>
                        <i class="fas fa-trash"></i>
                        <span id="delete-button-text">Eliminar Usuario</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>

    /* Estilos para la información del usuario en el modal de eliminación */
    .user-info-delete {
        background: rgba(255, 255, 255, 0.05);
        padding: 1rem;
        border-radius: 0.5rem;
        margin: 1rem 0;
        border-left: 3px solid var(--color-primary);
    }

    .user-details-delete {
        color: var(--color-light);
        font-size: 0.9rem;
    }

        .user-details-delete strong {
            color: var(--color-primary);
            display: block;
            margin-bottom: 0.5rem;
            font-size: 1rem;
        }

        .user-details-delete div {
            margin: 0.2rem 0;
            padding-left: 0.5rem;
        }
    /* Estilos para el modal de eliminación */
    #deleteUserForm {
        margin: 0;
        padding: 0;
    }

    .delete-warning {
        display: flex;
        gap: 1.5rem;
        padding: 1.5rem;
        background: rgba(255, 71, 87, 0.1);
        border-radius: 0.8rem;
        border-left: 4px solid #ff4757;
        margin-bottom: 1.5rem;
    }

    .warning-icon {
        flex-shrink: 0;
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #ff4757, #ff3742);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
    }

    .warning-content h3 {
        color: #ff4757;
        margin: 0 0 0.8rem 0;
        font-size: 1.3rem;
    }

    .warning-content p {
        margin: 0.5rem 0;
        color: var(--color-light);
        line-height: 1.5;
    }

    .warning-content ul {
        margin: 0.8rem 0;
        padding-left: 1.5rem;
        color: var(--color-light);
    }

    .warning-content li {
        margin: 0.3rem 0;
    }

    .warning-highlight {
        font-weight: 600;
        color: #ff4757 !important;
        font-size: 1rem;
    }

    .countdown-section {
        background: rgba(255, 255, 255, 0.05);
        padding: 1.2rem;
        border-radius: 0.8rem;
        margin-bottom: 1.5rem;
    }

    .countdown-text {
        text-align: center;
        color: var(--color-light);
        margin-bottom: 1rem;
        font-size: 1rem;
    }

    .countdown-number {
        font-weight: 700;
        color: var(--color-primary);
        font-size: 1.2rem;
    }

    .countdown-bar {
        width: 100%;
        height: 6px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 3px;
        overflow: hidden;
    }

    .countdown-progress {
        height: 100%;
        background: linear-gradient(90deg, var(--color-primary), #6233b8);
        border-radius: 3px;
        width: 0%;
        transition: width 1s linear;
    }

    .delete-actions {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .btn-cancel-delete {
        background-color: rgba(255, 255, 255, 0.1);
        color: var(--color-light);
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

        .btn-cancel-delete:hover {
            background-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

    .btn-confirm-delete {
        background: linear-gradient(135deg, #ff4757, #ff3742);
        color: white;
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

        .btn-confirm-delete:disabled {
            background: rgba(255, 71, 87, 0.3);
            cursor: not-allowed;
            transform: none;
            opacity: 0.6;
        }

        .btn-confirm-delete:not(:disabled):hover {
            background: linear-gradient(135deg, #ff3742, #ff2e2e);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 71, 87, 0.4);
        }

    .close-delete {
        color: white;
        font-size: 2rem;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .close-delete:hover {
            transform: scale(1.1);
            opacity: 0.8;
        }

    .btn-confirm-delete.loading {
        position: relative;
        color: transparent;
    }

        .btn-confirm-delete.loading::after {
