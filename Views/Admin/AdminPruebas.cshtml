@model List<AnzanMegaArithmetics.Models.PruebasDBModel>
@{
    ViewBag.Title = "Administración de Pruebas";
    Layout = "_LayoutAdmin";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="admin-container">
    <div class="admin-header">
        <a href="@Url.Action("PanelAdministrador", "Dashboard")" class="back-button">
            <i class="fas fa-arrow-left"></i>
            Regresar
        </a>
    </div>

    <!-- Sección de Filtros -->
    <div class="filter-section">
        <div class="filter-bar">
            <div class="filter-group">
                <label for="usuario-filter">Filtrar por usuario:</label>
                <select id="usuario-filter" class="filter-select">
                    <option value="">Todos los usuarios</option>
                    <!-- Se llenará dinámicamente con JavaScript -->
                </select>
            </div>

            <div class="filter-group">
                <label for="clase-filter">Filtrar por clase:</label>
                <select id="clase-filter" class="filter-select">
                    <option value="">Todas las clases</option>
                    <!-- Se llenará dinámicamente con JavaScript -->
                </select>
            </div>

            <div class="filter-group">
                <label for="estado-filter">Filtrar por estado:</label>
                <select id="estado-filter" class="filter-select">
                    <option value="">Todos los estados</option>
                    <option value="activo">Activo</option>
                    <option value="inactivo">Inactivo</option>
                </select>
            </div>

            <div class="filter-group">
                <label for="fecha-filter">Filtrar por fecha:</label>
                <select id="fecha-filter" class="filter-select">
                    <option value="">Todas las fechas</option>
                    <option value="hoy">Hoy</option>
                    <option value="ayer">Ayer</option>
                    <option value="semana">Esta semana</option>
                    <option value="mes">Este mes</option>
                </select>
            </div>

            <div class="filter-group">
                <label for="rendimiento-filter">Filtrar por rendimiento:</label>
                <select id="rendimiento-filter" class="filter-select">
                    <option value="">Todo el rendimiento</option>
                    <option value="excelente">Excelente (80-100%)</option>
                    <option value="bueno">Bueno (60-79%)</option>
                    <option value="regular">Regular (40-59%)</option>
                    <option value="bajo">Bajo (0-39%)</option>
                </select>
            </div>

            <div class="filter-group">
                <button id="clear-filters" class="clear-filters-button">
                    <i class="fas fa-times"></i>
                    Limpiar Filtros
                </button>
            </div>
        </div>

        <div class="search-section">
            <div class="search-box">
                <input type="text" id="prueba-search" placeholder="Buscar por ID de prueba..." class="search-input">
                <button class="search-button">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Tabla de Pruebas -->
    <div class="users-table-container">
        <div class="table-header">
            <div class="col-id">ID Prueba</div>
            <div class="col-usuario">ID Usuario</div>
            <div class="col-clase">ID Clase</div>
            <div class="col-tipo">Tipo</div>
            <div class="col-estado">Estado</div>
            <div class="col-tiempo">Tiempo</div>
            <div class="col-preguntas">Total Preguntas</div>
            <div class="col-correctas">Correctas</div>
            <div class="col-porcentaje">Porcentaje</div>
            <div class="col-fecha">Fecha</div>
            <div class="col-experiencia">Experiencia</div>
            <div class="col-actions">Acciones</div>
        </div>

        <div class="table-body">
            @foreach (var prueba in Model)
            {
                var porcentaje = prueba.Total_Preguntas > 0 ?
                (prueba.Respuestas_Correctas * 100.0 / prueba.Total_Preguntas) : 0;

                <div class="table-row" data-prueba-id="@prueba.Id_Prueba" data-usuario-id="@prueba.Id_Usuario"
                     data-clase-id="@prueba.Ids_Clases" data-activo="@prueba.Activo" data-tipo="@prueba.Tipo_Prueba"
                     data-porcentaje="@porcentaje" data-fecha="@prueba.Fecha.ToString("yyyy-MM-dd")">

                    <div class="col-id">@prueba.Id_Prueba.ToString("D3")</div>

                    <div class="col-usuario">
                        <span class="usuario-badge">@prueba.Id_Usuario.ToString("D3")</span>
                    </div>

                    <div class="col-clase">
                        <span class="clase-badge">@prueba.Ids_Clases</span>
                    </div>

                    <div class="col-tipo">
                        <span class="tipo-badge">
                            @prueba.Tipo_Prueba
                        </span>
                    </div>

                    <div class="col-estado">
                        <span class="status-badge @(prueba.Activo ? "activo" : "inactivo")">
                            @(prueba.Activo ? "Activo" : "Inactivo")
                        </span>
                    </div>

                    <div class="col-tiempo">
                        <span class="tiempo-badge">@prueba.Tiempo.ToString(@"hh\:mm\:ss")</span>
                    </div>

                    <div class="col-preguntas">
                        <div class="preguntas-display">@prueba.Total_Preguntas</div>
                    </div>

                    <div class="col-correctas">
                        <div class="correctas-display">@prueba.Respuestas_Correctas</div>
                    </div>

                    <div class="col-porcentaje">
                        <div class="xp-display">@porcentaje.ToString("F1")%</div>
                        <div class="xp-bar">
                            <div class="xp-progress" style="width: @(porcentaje > 100 ? 100 : porcentaje)%"></div>
                        </div>
                    </div>

                    <div class="col-fecha">
                        <span class="fecha-text">@prueba.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>

                    <div class="col-experiencia">
                        <span class="experiencia-badge">
                            @prueba.ExperienciaAdquirida XP
                        </span>
                    </div>

                    <div class="col-actions">
                        <button class="btn-edit btn-view" data-pruebaid="@prueba.Id_Prueba">
                            <i class="fas fa-eye"></i>
                            Ver
                        </button>
                        <button class="btn-delete" data-pruebaid="@prueba.Id_Prueba">
                            <i class="fas fa-trash"></i>
                            Eliminar
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal para Ver Detalles de Prueba -->
<div id="viewPruebaModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Detalles de Prueba</h2>
            <span class="close">&times;</span>
        </div>
        <div class="modal-body">
            <form class="edit-user-form">
                <div class="form-row">
                    <div class="form-group">
                        <label>ID de Prueba:</label>
                        <span id="detailIdPrueba" class="form-input detail-value"></span>
                    </div>
                    <div class="form-group">
                        <label>ID de Usuario:</label>
                        <span id="detailIdUsuario" class="form-input detail-value"></span>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>ID de Clase:</label>
                        <span id="detailIdClase" class="form-input detail-value"></span>
                    </div>
                    <div class="form-group">
                        <label>Estado:</label>
                        <span id="detailEstado" class="form-input detail-value"></span>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Tiempo:</label>
                        <span id="detailTiempo" class="form-input detail-value"></span>
                    </div>
                    <div class="form-group">
                        <label>Fecha:</label>
                        <span id="detailFecha" class="form-input detail-value"></span>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Total Preguntas:</label>
                        <span id="detailTotalPreguntas" class="form-input detail-value"></span>
                    </div>
                    <div class="form-group">
                        <label>Respuestas Correctas:</label>
                        <span id="detailCorrectas" class="form-input detail-value"></span>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group full-width">
                        <label>Porcentaje de Acierto:</label>
                        <div class="col-experiencia">
                            <div id="detailPorcentaje" class="xp-display"></div>
                            <div class="xp-bar">
                                <div id="detailPorcentajeBar" class="xp-progress"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group full-width">
                        <label>Experiencia Adquirida:</label>
                        <span id="detailExperiencia" class="form-input experiencia-value"></span>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn-cancel btn-close-modal">Cerrar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal para Eliminar Prueba -->
<div id="deletePruebaModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Eliminar Prueba</h2>
            <span class="close-delete">&times;</span>
        </div>
        <div class="modal-body">
            <form id="deletePruebaForm" method="post" action="@Url.Action("EliminarPrueba", "Admin")">
                <input type="hidden" id="deletePruebaId" name="Id_Prueba">

                <div class="delete-warning">
                    <div class="warning-icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="warning-content">
                        <h3>¡Atención!</h3>
                        <p>¿Estás seguro de que deseas eliminar esta prueba? Esta acción no se puede deshacer.</p>
                        <div class="user-info-delete">
                            <div class="user-details-delete">
                                <strong>Información de la prueba:</strong>
                                <div>ID: <span id="deletePruebaInfoId"></span></div>
                                <div>Usuario: <span id="deletePruebaInfoUsuario"></span></div>
                                <div>Fecha: <span id="deletePruebaInfoFecha"></span></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="delete-actions">
                    <button type="button" class="btn-cancel-delete">
                        <i class="fas fa-times"></i>
                        Cancelar
                    </button>
                    <button type="submit" class="btn-confirm-delete">
                        <i class="fas fa-trash"></i>
                        Eliminar Prueba
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>

    /* Estilos para la información del usuario en el modal de eliminación */
    .user-info-delete {
        background: rgba(255, 255, 255, 0.05);
        padding: 1rem;
        border-radius: 0.5rem;
        margin: 1rem 0;
        border-left: 3px solid var(--color-primary);
    }

    .user-details-delete {
        color: var(--color-light);
        font-size: 0.9rem;
    }

        .user-details-delete strong {
            color: var(--color-primary);
            display: block;
            margin-bottom: 0.5rem;
            font-size: 1rem;
        }

        .user-details-delete div {
            margin: 0.2rem 0;
            padding-left: 0.5rem;
        }
    /* Estilos para el modal de eliminación */
    #deleteUserForm {
        margin: 0;
        padding: 0;
    }

    .delete-warning {
        display: flex;
        gap: 1.5rem;
        padding: 1.5rem;
        background: rgba(255, 71, 87, 0.1);
        border-radius: 0.8rem;
        border-left: 4px solid #ff4757;
        margin-bottom: 1.5rem;
    }

    .warning-icon {
        flex-shrink: 0;
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #ff4757, #ff3742);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
    }

    .warning-content h3 {
        color: #ff4757;
        margin: 0 0 0.8rem 0;
        font-size: 1.3rem;
    }

    .warning-content p {
        margin: 0.5rem 0;
        color: var(--color-light);
        line-height: 1.5;
    }

    .warning-content ul {
        margin: 0.8rem 0;
        padding-left: 1.5rem;
        color: var(--color-light);
    }

    .warning-content li {
        margin: 0.3rem 0;
    }

    .warning-highlight {
        font-weight: 600;
        color: #ff4757 !important;
        font-size: 1rem;
    }

    .countdown-section {
        background: rgba(255, 255, 255, 0.05);
        padding: 1.2rem;
        border-radius: 0.8rem;
        margin-bottom: 1.5rem;
    }

    .countdown-text {
        text-align: center;
        color: var(--color-light);
        margin-bottom: 1rem;
        font-size: 1rem;
    }

    .countdown-number {
        font-weight: 700;
        color: var(--color-primary);
        font-size: 1.2rem;
    }

    .countdown-bar {
        width: 100%;
        height: 6px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 3px;
        overflow: hidden;
    }

    .countdown-progress {
        height: 100%;
        background: linear-gradient(90deg, var(--color-primary), #6233b8);
        border-radius: 3px;
        width: 0%;
        transition: width 1s linear;
    }

    .delete-actions {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .btn-cancel-delete {
        background-color: rgba(255, 255, 255, 0.1);
        color: var(--color-light);
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

        .btn-cancel-delete:hover {
            background-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

    .btn-confirm-delete {
        background: linear-gradient(135deg, #ff4757, #ff3742);
        color: white;
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

        .btn-confirm-delete:disabled {
            background: rgba(255, 71, 87, 0.3);
            cursor: not-allowed;
            transform: none;
            opacity: 0.6;
        }

        .btn-confirm-delete:not(:disabled):hover {
            background: linear-gradient(135deg, #ff3742, #ff2e2e);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 71, 87, 0.4);
        }

    .close-delete {
        color: white;
        font-size: 2rem;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .close-delete:hover {
            transform: scale(1.1);
            opacity: 0.8;
        }

    .btn-confirm-delete.loading {
        position: relative;
        color: transparent;
    }

        .btn-confirm-delete.loading::after {
            content: '';
            position: absolute;
            width: 20px;
            height: 20px;
            border: 2px solid transparent;
            border-top: 2px solid white;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    /* Botón cancelar - FORMULARIO CREAR */
    .btn-cancel-create {
        background-color: rgba(255, 255, 255, 0.1);
        color: var(--color-light);
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

        .btn-cancel-create:hover {
            background-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }
    /* Contenedor para input de contraseña - CREAR USUARIO */
    #createUserForm .password-input-container {
        position: relative;
    }

        #createUserForm .password-input-container .form-input {
            padding-right: 3rem;
        }

    .toggle-password-input-create {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--color-primary);
        cursor: pointer;
        font-size: 0.9rem;
        z-index: 2;
    }

    /* Checkboxes para clases - FORMULARIO CREAR */
    #createUserForm .clase-checkbox-create {
        display: none;
    }

        #createUserForm .clase-checkbox-create:checked + .checkmark {
            background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
            border-color: var(--color-primary);
        }

            #createUserForm .clase-checkbox-create:checked + .checkmark:after {
                opacity: 1;
            }

    /* Estilos específicos para el modal de crear */
    .btn-create {
        background: linear-gradient(135deg, #00cc66, #00b359);
        color: white;
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

        .btn-create:hover {
            background: linear-gradient(135deg, #00b359, #00994d);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 204, 102, 0.4);
        }

    .close-create {
        color: white;
        font-size: 2rem;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .close-create:hover {
            transform: scale(1.1);
            opacity: 0.8;
        }

    .is-valid {
        border-color: #28a745 !important;
        background-image: url("data:image/svg+xml,..."); /* Icono check */
    }

    .is-invalid {
        border-color: #dc3545 !important;
        background-image: url("data:image/svg+xml,..."); /* Icono error */
    }

    .error-email {
        display: block;
        width: 100%;
        margin-top: 0.25rem;
        font-size: 0.875rem;
        color: #dc3545;
    }

    /* Estilos para la modal */
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(5px);
    }

    .modal-content {
        background-color: var(--color-card-bg);
        margin: 2% auto;
        padding: 0;
        border-radius: 1rem;
        width: 90%;
        max-width: 800px;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        animation: modalSlideIn 0.3s ease-out;
    }

    @@keyframes modalSlideIn {
        from {
            opacity: 0;
            transform: translateY(-50px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .modal-header {
        color: white;
        padding: 1.5rem 2rem;
        border-radius: 1rem 1rem 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .modal-header h2 {
            margin: 0;
            font-size: 1.5rem;
        }

    .close {
        color: white;
        font-size: 2rem;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .close:hover {
            transform: scale(1.1);
            opacity: 0.8;
        }

    .modal-body {
        padding: 2rem;
    }

    /* Estilos del formulario */
    .edit-user-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-weight: 600;
            color: var(--color-primary);
            font-size: 0.9rem;
        }

    .form-input, .form-select {
        background-color: var(--color-sidebar);
        color: var(--color-light);
        border: 1px solid rgba(76, 76, 255, 0.3);
        border-radius: 0.5rem;
        padding: 0.8rem 1rem;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        width: 100%;
    }

        .form-input:focus, .form-select:focus {
            outline: none;
            border-color: var(--color-primary);
            box-shadow: 0 0 0 2px rgba(76, 76, 255, 0.2);
        }

    /* Contenedor para input de contraseña */
    .password-input-container {
        position: relative;
    }

        .password-input-container .form-input {
            padding-right: 3rem;
        }

    .toggle-password-input {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--color-primary);
        cursor: pointer;
        font-size: 0.9rem;
    }

    /* Checkboxes para clases */
    .clases-checkbox-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 0.8rem;
        margin-top: 0.5rem;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        font-size: 0.9rem;
        color: var(--color-light);
    }

    .clase-checkbox {
        display: none;
    }

    .checkmark {
        width: 20px;
        height: 20px;
        border: 2px solid rgba(76, 76, 255, 0.5);
        border-radius: 0.3rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .checkmark::-webkit-scrollbar {
            display: none;
        }

        .checkmark:after {
            content: "✓";
            color: white;
            font-size: 0.8rem;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

    .clase-checkbox:checked + .checkmark {
        background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
        border-color: var(--color-primary);
    }

        .clase-checkbox:checked + .checkmark:after {
            opacity: 1;
        }

    /* Botones del formulario */
    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .btn-cancel, .btn-update {
        padding: 0.8rem 1.5rem;
        border: none;
