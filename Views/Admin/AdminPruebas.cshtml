<script>
    document.addEventListener('DOMContentLoaded', function() {
        // === FILTROS Y BÚSQUEDA ===
        const usuarioFilter = document.getElementById('usuario-filter');
        const claseFilter = document.getElementById('clase-filter');
        const estadoFilter = document.getElementById('estado-filter');
        const fechaFilter = document.getElementById('fecha-filter');
        const rendimientoFilter = document.getElementById('rendimiento-filter');
        const pruebaSearch = document.getElementById('prueba-search');
        const searchButton = document.querySelector('.search-button');
        const tableRows = document.querySelectorAll('.table-row');
        const clearFiltersBtn = document.getElementById('clear-filters');

        // Llenar filtros dinámicamente
        function populateFilters() {
            const usuarios = new Set();
            const clases = new Set();

            tableRows.forEach(row => {
                const usuarioId = row.getAttribute('data-usuario-id');
                const claseId = row.getAttribute('data-clase-id');

                if (usuarioId) usuarios.add(usuarioId);
                if (claseId) clases.add(claseId);
            });

            // Llenar filtro de usuarios
            usuarios.forEach(usuarioId => {
                const option = document.createElement('option');
                option.value = usuarioId;
                option.textContent = `Usuario ${usuarioId}`;
                usuarioFilter.appendChild(option);
            });

            // Llenar filtro de clases
            clases.forEach(claseId => {
                const option = document.createElement('option');
                option.value = claseId;
                option.textContent = `Clase ${claseId}`;
                claseFilter.appendChild(option);
            });
        }

        // Función principal de filtrado
        function filterPruebas() {
            const usuarioValue = usuarioFilter.value;
            const claseValue = claseFilter.value;
            const estadoValue = estadoFilter.value;
            const fechaValue = fechaFilter.value;
            const rendimientoValue = rendimientoFilter.value;
            const searchValue = pruebaSearch.value.toLowerCase().trim();

            const today = new Date();
            today.setHours(0, 0, 0, 0);

            tableRows.forEach(row => {
                let showRow = true;

                // Filtro por usuario
                if (usuarioValue && showRow) {
                    const usuarioId = row.getAttribute('data-usuario-id');
                    if (usuarioId !== usuarioValue) showRow = false;
                }

                // Filtro por clase
                if (claseValue && showRow) {
                    const claseId = row.getAttribute('data-clase-id');
                    if (claseId !== claseValue) showRow = false;
                }

                // Filtro por estado
                if (estadoValue && showRow) {
                    const activo = row.getAttribute('data-activo');
                    if (estadoValue === 'activo' && activo !== 'True') showRow = false;
                    if (estadoValue === 'inactivo' && activo !== 'False') showRow = false;
                }

                // Filtro por fecha
                if (fechaValue && showRow) {
                    const fechaStr = row.getAttribute('data-fecha');
                    const fechaPrueba = new Date(fechaStr);
                    fechaPrueba.setHours(0, 0, 0, 0);

                    switch(fechaValue) {
                        case 'hoy':
                            if (fechaPrueba.getTime() !== today.getTime()) showRow = false;
                            break;
                        case 'ayer':
                            const yesterday = new Date(today);
                            yesterday.setDate(yesterday.getDate() - 1);
                            if (fechaPrueba.getTime() !== yesterday.getTime()) showRow = false;
                            break;
                        case 'semana':
                            const weekAgo = new Date(today);
                            weekAgo.setDate(weekAgo.getDate() - 7);
                            if (fechaPrueba < weekAgo) showRow = false;
                            break;
                        case 'mes':
                            const monthAgo = new Date(today);
                            monthAgo.setMonth(monthAgo.getMonth() - 1);
                            if (fechaPrueba < monthAgo) showRow = false;
                            break;
                    }
                }

                // Filtro por rendimiento
                if (rendimientoValue && showRow) {
                    const porcentaje = parseFloat(row.getAttribute('data-porcentaje'));

                    switch(rendimientoValue) {
                        case 'excelente':
                            if (porcentaje < 80) showRow = false;
                            break;
                        case 'bueno':
                            if (porcentaje < 60 || porcentaje >= 80) showRow = false;
                            break;
                        case 'regular':
                            if (porcentaje < 40 || porcentaje >= 60) showRow = false;
                            break;
                        case 'bajo':
                            if (porcentaje >= 40) showRow = false;
                            break;
                    }
                }

                // Filtro por búsqueda
                if (searchValue && showRow) {
                    const pruebaId = row.querySelector('.col-id').textContent.toLowerCase();
                    const usuarioId = row.querySelector('.col-usuario').textContent.toLowerCase();

                    const matchesSearch = pruebaId.includes(searchValue) ||
                                        usuarioId.includes(searchValue);

                    if (!matchesSearch) showRow = false;
                }

                // Mostrar u ocultar la fila
                row.style.display = showRow ? 'grid' : 'none';
            });

            // Mostrar mensaje si no hay resultados
            showNoResultsMessage();
        }

        // Función para mostrar mensaje cuando no hay resultados
        function showNoResultsMessage() {
            const visibleRows = Array.from(tableRows).filter(row => row.style.display !== 'none');
            const tableBody = document.querySelector('.table-body');

            // Remover mensaje anterior si existe
            const existingMessage = document.querySelector('.no-results-message');
            if (existingMessage) {
                existingMessage.remove();
            }

            if (visibleRows.length === 0) {
                const message = document.createElement('div');
                message.className = 'no-results-message';
                message.innerHTML = `
                    <div class="no-results-content">
                        <i class="fas fa-search"></i>
                        <h3>No se encontraron pruebas</h3>
                        <p>Intenta ajustar los filtros o términos de búsqueda</p>
                    </div>
                `;
                tableBody.appendChild(message);
            }
        }

        // Función para limpiar filtros
        function clearFilters() {
            usuarioFilter.value = '';
            claseFilter.value = '';
            estadoFilter.value = '';
            fechaFilter.value = '';
            rendimientoFilter.value = '';
            pruebaSearch.value = '';
            filterPruebas();
        }

        // Event listeners
        usuarioFilter.addEventListener('change', filterPruebas);
        claseFilter.addEventListener('change', filterPruebas);
        estadoFilter.addEventListener('change', filterPruebas);
        fechaFilter.addEventListener('change', filterPruebas);
        rendimientoFilter.addEventListener('change', filterPruebas);
        searchButton.addEventListener('click', filterPruebas);
        clearFiltersBtn.addEventListener('click', clearFilters);

        pruebaSearch.addEventListener('keyup', function(e) {
            if (e.key === 'Enter') {
                filterPruebas();
            }
        });
        pruebaSearch.addEventListener('input', filterPruebas);

        // Inicializar filtros
        populateFilters();
        filterPruebas();

        // === MODAL VER DETALLES ===
        const viewModal = document.getElementById('viewPruebaModal');
        const closeViewBtn = document.querySelector('.close-view');
        const closeModalBtn = document.querySelector('.btn-close-modal');

        // Event listener para botones de ver
        document.addEventListener('click', function(e) {
            if (!e.target) return;

            let btnView = null;

            if (e.target.classList && e.target.classList.contains('btn-view')) {
                btnView = e.target;
            } else if (e.target.parentElement &&
                       e.target.parentElement.classList &&
                       e.target.parentElement.classList.contains('btn-view')) {
                btnView = e.target.parentElement;
            }

            if (btnView && viewModal) {
                const pruebaId = btnView.getAttribute('data-pruebaid');
                if (pruebaId) {
                    loadPruebaDetails(pruebaId);
                    viewModal.style.display = 'block';
                    document.body.style.overflow = 'hidden';
                }
            }
        });

        // Cargar detalles de la prueba
        function loadPruebaDetails(pruebaId) {
            const row = document.querySelector(`.table-row[data-prueba-id="${pruebaId}"]`);
            if (!row) return;

            const idPrueba = row.querySelector('.col-id').textContent;
            const idUsuario = row.querySelector('.col-usuario').textContent;
            const idClase = row.querySelector('.col-clase').textContent;
            const estado = row.querySelector('.status-badge').textContent;
            const tiempo = row.querySelector('.tiempo-badge').textContent;
            const totalPreguntas = row.querySelector('.col-preguntas').textContent;
            const correctas = row.querySelector('.col-correctas').textContent;
            const porcentaje = row.getAttribute('data-porcentaje');
            const fecha = row.querySelector('.fecha-text').textContent;
            const experiencia = row.querySelector('.experiencia-badge').textContent;

            // Llenar el modal
            document.getElementById('detailIdPrueba').textContent = idPrueba;
            document.getElementById('detailIdUsuario').textContent = idUsuario;
            document.getElementById('detailIdClase').textContent = idClase;
            document.getElementById('detailEstado').textContent = estado;
            document.getElementById('detailTiempo').textContent = tiempo;
            document.getElementById('detailTotalPreguntas').textContent = totalPreguntas;
            document.getElementById('detailCorrectas').textContent = correctas;
            document.getElementById('detailPorcentaje').textContent = parseFloat(porcentaje).toFixed(1) + '%';
            document.getElementById('detailFecha').textContent = fecha;
            document.getElementById('detailExperiencia').textContent = experiencia;

            // Actualizar barra de progreso
            const progressBar = document.getElementById('detailPorcentajeBar');
            progressBar.style.width = `${Math.min(parseFloat(porcentaje), 100)}%`;
        }

        // Cerrar modal de ver
        function closeViewModal() {
            if (viewModal) {
                viewModal.style.display = 'none';
            }
            document.body.style.overflow = 'auto';
        }

        if (closeViewBtn) {
            closeViewBtn.addEventListener('click', closeViewModal);
        }

        if (closeModalBtn) {
            closeModalBtn.addEventListener('click', closeViewModal);
        }

        // === MODAL ELIMINAR PRUEBA ===
        const deleteModal = document.getElementById('deletePruebaModal');
        const closeDeleteBtn = document.querySelector('.close-delete');
        const cancelDeleteBtn = document.querySelector('.btn-cancel-delete');
        const deletePruebaForm = document.getElementById('deletePruebaForm');
        const deletePruebaIdInput = document.getElementById('deletePruebaId');

        // Event listener para botones de eliminar
        document.addEventListener('click', function(e) {
            if (!e.target) return;

            let btnDelete = null;

            if (e.target.classList && e.target.classList.contains('btn-delete')) {
                btnDelete = e.target;
            } else if (e.target.parentElement &&
                       e.target.parentElement.classList &&
                       e.target.parentElement.classList.contains('btn-delete')) {
                btnDelete = e.target.parentElement;
            }

            if (btnDelete && deleteModal) {
                const pruebaId = btnDelete.getAttribute('data-pruebaid');
                if (pruebaId) {
                    loadPruebaDeleteInfo(pruebaId);
                    deleteModal.style.display = 'block';
                    document.body.style.overflow = 'hidden';
                }
            }
        });

        // Cargar información para eliminar
        function loadPruebaDeleteInfo(pruebaId) {
            const row = document.querySelector(`.table-row[data-prueba-id="${pruebaId}"]`);
            if (!row) return;

            const idPrueba = row.querySelector('.col-id').textContent;
            const idUsuario = row.querySelector('.col-usuario').textContent;
            const fecha = row.querySelector('.fecha-text').textContent;

            // Llenar el formulario y la información
            deletePruebaIdInput.value = pruebaId;
            document.getElementById('deletePruebaInfoId').textContent = idPrueba;
            document.getElementById('deletePruebaInfoUsuario').textContent = idUsuario;
            document.getElementById('deletePruebaInfoFecha').textContent = fecha;
        }

        // Cerrar modal de eliminar
        function closeDeleteModal() {
            if (deleteModal) {
                deleteModal.style.display = 'none';
            }
            document.body.style.overflow = 'auto';
        }

        if (closeDeleteBtn) {
            closeDeleteBtn.addEventListener('click', closeDeleteModal);
        }

        if (cancelDeleteBtn) {
            cancelDeleteBtn.addEventListener('click', closeDeleteModal);
        }

        // Cerrar modales al hacer click fuera
        window.addEventListener('click', function(e) {
            if (viewModal && e.target === viewModal) {
                closeViewModal();
            }
            if (deleteModal && e.target === deleteModal) {
                closeDeleteModal();
            }
        });

        // Cerrar con ESC
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                if (viewModal && viewModal.style.display === 'block') {
                    closeViewModal();
                }
                if (deleteModal && deleteModal.style.display === 'block') {
                    closeDeleteModal();
                }
            }
        });

        // Drag scroll para la tabla (igual que en usuarios)
        const tableContainer = document.querySelector('.users-table-container');
        if (tableContainer) {
            let isDragging = false;
            let startX;
            let scrollLeft;

            tableContainer.addEventListener('mousedown', (e) => {
                isDragging = true;
                tableContainer.classList.add('dragging');
                startX = e.pageX - tableContainer.offsetLeft;
                scrollLeft = tableContainer.scrollLeft;
            });

            tableContainer.addEventListener('mouseleave', () => {
                isDragging = false;
                tableContainer.classList.remove('dragging');
            });

            tableContainer.addEventListener('mouseup', () => {
                isDragging = false;
                tableContainer.classList.remove('dragging');
            });

            tableContainer.addEventListener('mousemove', (e) => {
                if (!isDragging) return;
                e.preventDefault();
                const x = e.pageX - tableContainer.offsetLeft;
                const walk = (x - startX) * 2;
                tableContainer.scrollLeft = scrollLeft - walk;
            });
        }
    });
</script>