<style>

    body {
        background-color: var(--color-bg);
        color: var(--color-tex);
    }

    .cerebro-marca {
        position: fixed;
        top: 30%;
        width: 25rem;
        opacity: 0.1;
        z-index: -1;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    .izquierdo {
        left: 0;
        transform: translateX(-55%);
    }

    .derecho {
        right: 0;
        transform: translateX(55%);
    }

    .titulo-seccion {
        text-align: center;
        color: var(--color-light);
        margin: 0;
        font-size: 1.5rem;
        font-weight: 600;
    }

    .contador {
        color: #ffffff;
        font-weight: bold;
        font-size: 1.6rem;
        animation: pulse 1s infinite ease-in-out;
    }

    .top-bar {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.7rem;
        background-color: var(--bg-color);
        box-shadow: 0 0 20px rgba(0,0,0,0.3);
        flex-wrap: wrap;
        gap: 1rem;
        border-radius: 25px;
        margin-top: -2.3rem;
    }

    .btn-finalizar {
        background-color: #df312c;
        color: white;
        padding: 0.6rem 1rem;
        border: none;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        cursor: pointer;
