            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(76, 76, 255, 0.3);
        }


    .ejercicio-wrapper {
        margin: 0 auto;
        text-align: center;
        padding: 1rem;
    }

    .pantalla-dividida {
        display: flex;
        width: 100%;
        gap: 1rem;
        margin: 1rem 0;
        justify-content: center;
        align-items: center;
        flex-direction: row;
    }

    .izquierda, .derecha {
        flex: 1;
        display: flex;
        width: 50%;
    }

    .izquierda {
        justify-content: center;
        align-items: center;
    }

    .derecha {
        align-items: center;
        display: flex;
        flex-direction: column;
    }

    .contenedor-pregunta {
        flex: 1;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        justify-content: center;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        place-items: center;
        width: 100%;
        margin: 0 auto;
    }

    .elemento-pregunta {
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.05));
        border-radius: 1.2rem;
        border: 2px solid rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 140px;
        min-height: 140px;
        width: 100%;
        height: 100%;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .elemento-pregunta::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));
            opacity: 0.7;
        }

        .elemento-pregunta.activa {
            animation: brillo 2s infinite ease-in-out;
            border: 3px solid var(--color-primary);
            box-shadow: 0 0 25px rgba(76, 76, 255, 0.5);
            transform: scale(1.05);
        }

        .elemento-pregunta.completada {
            border: 3px solid #28a745;
            background: rgba(40, 167, 69, 0.1);
            box-shadow: 0 0 15px rgba(40, 167, 69, 0.3);
        }

    @@keyframes brillo {
        0% {
            box-shadow: 0 0 15px rgba(76, 76, 255, 0.5);
        }

        50% {
            box-shadow: 0 0 30px rgba(76, 76, 255, 0.8);
        }

        100% {
            box-shadow: 0 0 15px rgba(76, 76, 255, 0.5);
        }
    }


    /* NÚMEROS - TAMAÑO UNIFORME */
    .numero-pregunta {
        font-size: 4.5rem;
        font-weight: 800;
        color: white;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5), 0 0 20px rgba(255, 255, 255, 0.1);
        font-family: 'Arial', sans-serif;
        line-height: 1;
    }

    /* FIGURAS - TAMAÑO UNIFORME */
    .figura-pregunta {
        width: 7rem;
        height: 7rem;
        object-fit: contain;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5)) brightness(1.1) contrast(1.1);
        transition: transform 0.3s ease;
    }

        .figura-pregunta:hover {
            transform: scale(1.1);
        }

    .contenedor-respuestas {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1rem;
        padding: 1rem;
        width: 100%;
        /*        max-width: 700px; */
        margin: 0 auto;
    }

    .opcion-respuesta {
        padding: 1.5rem;
        border-radius: 1rem;
        border: 2px solid rgba(255, 255, 255, 0.15);
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 110px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
        position: relative;
        overflow: hidden;
        background-color: #4c4cff;
    }

        .opcion-respuesta:hover {
            transform: translateY(-3px);
            border-color: var(--color-primary);
            box-shadow: 0 10px 30px rgba(76, 76, 255, 0.3);
        }

        .opcion-respuesta.seleccionada {
            background: linear-gradient(145deg, rgba(40, 167, 69, 0.25), rgba(40, 167, 69, 0.15));
            border-color: #28a745;
            transform: scale(1.08);
            box-shadow: 0 8px 25px rgba(40, 167, 69, 0.4);
        }

    .figura-respuesta {
        width: 8rem;
        height: 4rem;
        object-fit: contain;
        filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.4));
        transition: transform 0.3s ease;
    }

    .opcion-respuesta:hover .figura-respuesta {
        transform: scale(1.15);
    }

    .numero-respuesta {
        font-size: 2.8rem;
        font-weight: 700;
        color: white;
        text-shadow: 0 2px 3px rgba(0, 0, 0, 0.5);
        transition: transform 0.3s ease;
    }

    .opcion-respuesta:hover .numero-respuesta {
        transform: scale(1.1);
    }

    .respuesta-seleccionada {
        font-size: 1.2rem;
        font-weight: bold;
        color: #28a745 !important;
        animation: aparecer 0.5s ease;
    }

    @@keyframes aparecer {
        from {
            opacity: 0;
            transform: translateX(-10px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }



    @@media (max-width: 768px) {



