        transition: all 0.25s ease-in-out;
    }

        .tag:hover {
            background-color: var(--color-primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 0 15px rgba(76, 76, 255, 0.6);
        }

        .tag .remove {
            margin-left: 8px;
            font-weight: bold;
            cursor: pointer;
        }

    .dropdown-toggle {
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 1.4rem;
        color: #ccc;
        user-select: none;
    }

    .dropdown-options {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background-color: #1b1e3c;
        border: 1px solid #555;
        border-radius: 0.5rem;
        margin-top: 6px;
        z-index: 10;
        display: none;
        max-height: 180px;
        overflow-y: auto;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.5);
    }

    .option {
        padding: 10px 15px;
        font-size: 0.95rem;
        color: var(--color-light);
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .option:hover {
            background-color: var(--color-primary-dark);
        }

        .option.special {
            font-weight: bold;
            background-color: #292c4f;
            color: var(--color-primary);
        }

            .option.special:hover {
                background-color: #3737e8;
                color: white;
            }

    .input-error {
        border: 2px solid var(--color-danger) !important;
    }


    .elslider {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 70%;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .form-grid-three-columns {
            flex-direction: column;
        }

        .form-header {
            flex-direction: column;
            gap: 1rem;
            text-align: center;
        }

        .btn-dashboard {
            width: 100%;
            margin-bottom: 1rem;
        }

        .btn.btn-primary {
            font-size: 1rem;
        }

        form#formConfigSR select,
        form#formConfigSR input[type="number"] {
            width: 100%;
        }

        .top-bar-config {
            flex-direction: column;
        }

        .tag-input {
            width: 100%;
        }

        .elslider {
            width: 100%;
        }
    }
</style>


<script>
    function setupTagInput(prefix) {
        const container = document.getElementById(`tagInput${prefix}`);
        const dropdown = document.getElementById(`dropdown${prefix}`);
        const tagsContainer = document.getElementById(`tagsContainer${prefix}`);
        const hiddenInput = document.getElementById(`inputHidden${prefix}`);

        // Obtener valores iniciales del input hidden
        let initialValues = hiddenInput.value;
        let tags = initialValues ? initialValues.split(',') : [];

        container.addEventListener("click", () => {
            dropdown.style.display = dropdown.style.display === "block" ? "none" : "block";
        });

        dropdown.querySelectorAll(".option").forEach(option => {
            const value = option.getAttribute("data-value");
            const action = option.getAttribute("data-action");

            if (action === "add-all") {
                option.addEventListener("click", () => {
                    tags = [...Array(9).keys()].map(i => (i + 1).toString());
                    renderTags();
                });
            } else if (action === "remove-all") {
                option.addEventListener("click", () => {
                    tags = [];
                    renderTags();
                });
            } else if (value !== null) {
                option.addEventListener("click", () => {
                    if (!tags.includes(value)) {
                        tags.push(value);
                        renderTags();
                    }
                });
            }
        });

        function renderTags() {
            tagsContainer.innerHTML = "";
            tags.forEach(val => {
                const tag = document.createElement("div");
                tag.className = "tag";
                tag.innerHTML = `${val}<span class="remove">&times;</span>`;

                tag.addEventListener("click", () => {
                    tags = tags.filter(t => t !== val);
                    renderTags();
                });

                tagsContainer.appendChild(tag);
            });
            hiddenInput.value = tags.join(",");

            if (prefix === "Suma") {
                document.getElementById("tagInputSuma").classList.remove("input-error");
            }
            if (prefix === "Resta") {
                document.getElementById("tagInputResta").classList.remove("input-error");
            }
        }

        // Renderizar tags iniciales
        renderTags();

        document.addEventListener("click", (e) => {
            if (!container.contains(e.target)) {
                dropdown.style.display = "none";
            }
        });
    }

    function actualizarVisibilidadOperaciones() {
        const tipo = document.getElementById("tipoOperacionSelect").value;
        const containerSuma = document.getElementById("containerSuma");
        const containerResta = document.getElementById("containerResta");

        containerSuma.style.display = (tipo === "suma" || tipo === "ambos") ? "block" : "none";
        containerResta.style.display = (tipo === "ambos") ? "block" : "none";
    }

    // Inicializar cuando el DOM esté completamente cargado
    document.addEventListener("DOMContentLoaded", function () {
        
        // console.log("Valor hidden Suma:", document.getElementById("inputHiddenSuma").value);
        // console.log("Valor hidden Resta:", document.getElementById("inputHiddenResta").value);

        setupTagInput("Suma");
        setupTagInput("Resta");

        // Configurar el evento de cambio para el tipo de operación
        document.getElementById("tipoOperacionSelect").addEventListener("change", actualizarVisibilidadOperaciones);

        // Inicializar la visibilidad
        actualizarVisibilidadOperaciones();

        // Validación del formulario
        document.getElementById("formConfigSR").addEventListener("submit", function (e) {
            const tipo = document.getElementById("tipoOperacionSelect").value;
            const digitosSuma = document.getElementById("inputHiddenSuma").value;
            const digitosResta = document.getElementById("inputHiddenResta").value;

            let error = false;

            if (tipo === "suma" && digitosSuma === "") {
                document.getElementById("tagInputSuma").classList.add("input-error");
                error = true;
            }

            if (tipo === "ambos") {
                if (digitosSuma === "") {
                    document.getElementById("tagInputSuma").classList.add("input-error");
                    error = true;
                }
                if (digitosResta === "") {
                    document.getElementById("tagInputResta").classList.add("input-error");
                    error = true;
                }
            }

            if (error) {
                e.preventDefault();
                alert("Debes seleccionar al menos un dígito en los campos correspondientes a SUMA y/o RESTA según el tipo de operación.");
            }
        });
    });

    function regresarAlDashboard() {
        window.location.href = '@Url.Action("LimpiarYDashboard", "Cuadros")';
    }
</script>
