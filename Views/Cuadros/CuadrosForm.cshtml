@model AnzanMegaArithmetics.Models.ConfCuadrosModel
@{
    ViewBag.Title = "Cuadros de velocidad - Práctica";
    Layout = "_LayoutCuadros";

    var tiempo = Model.TiempoMeditacion;
}

<div id="contenedorConfiguracionFlash">

    <form method="post" action="/Cuadros/ConcentracionPractica" id="formConfigSR" class="formulario-flash">

        <div class="form-header">
            <button type="button" class="btn-dashboard" onclick="regresarAlDashboard()">
                <i class="fas fa-home"></i> Regresar al Dashboard
            </button>
            <h2>Ajustes cuadros de velocidad</h2>
        </div>

        <div class="form-grid-three-columns">
            <div class="form-column">
           
                <div>
                    <label asp-for="CantidadRejillas"></label>
                    <select asp-for="CantidadRejillas">
                        @for (int i = 1; i <= 3; i++)
                        {
                            <option value="@i" selected="@(Model.CantidadRejillas == i)">@i</option>
                        }
                    </select>
                </div>

                <div>
                    <label asp-for="DimensionRejilla"></label>
                    <select asp-for="DimensionRejilla">
                        <option value="10X5" selected>10 X 5</option>
                        <option value="5X10">5 X 10</option>
                        <option value="10X7">10 X 7</option>
                        <option value="7X10">7 X 10</option>
                        <option value="9X10">9 X 10</option>
                        <option value="10X10">10 X 10</option>
                    </select>
                </div>

                <div>
                    <label asp-for="TipoIluminacion"></label>
                    <select asp-for="TipoIluminacion">
                        <option value="ninguna" selected>Ninguna</option>
                        <option value="horizontal">Horizontal</option>
                        <option value="vertical">Vertical</option>
                    </select>
                </div>

            </div>

            <div class="form-column">

                <div>
                    <label>Tipo de operación:</label>
                    <select name="tipoOperacion" id="tipoOperacionSelect">
                        <option value="suma" selected="@(Model.TipoOperacion == "suma")">Suma</option>
                        <option value="ambos" selected="@(Model.TipoOperacion == "ambos")">Suma y Resta</option>
                    </select>
                </div>

                <div id="containerSuma">
                    <label class="label-operacion">Dígitos permitidos en SUMA:</label>
                    <div class="tag-input" id="tagInputSuma">
                        <div class="tags-container" id="tagsContainerSuma"></div>
                        <div class="dropdown-toggle">▾</div>
                        <div class="dropdown-options" id="dropdownSuma">
                            <div class="option special" data-action="add-all">➕ Agregar todos</div>
                            <div class="option special" data-action="remove-all">➖ Quitar todos</div>
                            @for (int i = 1; i <= 9; i++)
                            {
                                <div class="option" data-value="@i">@i</div>
                            }
                        </div>
                        <input type="hidden" name="digitosSuma" id="inputHiddenSuma" value="@Model.DigitosSuma" />
                    </div>
                </div>

                <div id="containerResta">
                    <label class="label-operacion">Dígitos permitidos en RESTA:</label>
                    <div class="tag-input" id="tagInputResta">
                        <div class="tags-container" id="tagsContainerResta"></div>
                        <div class="dropdown-toggle">▾</div>
                        <div class="dropdown-options" id="dropdownResta">
                            <div class="option special" data-action="add-all">➕ Agregar todos</div>
                            <div class="option special" data-action="remove-all">➖ Quitar todos</div>
                            @for (int i = 1; i <= 9; i++)
                            {
                                <div class="option" data-value="@i">@i</div>
                            }
                        </div>
                        <input type="hidden" name="digitosResta" id="inputHiddenResta" value="@Model.DigitosResta" />
                    </div>
                </div>

                <div>
                    <label asp-for="TiempoMeditacion">Tiempo de concentración:</label>
                    <select asp-for="TiempoMeditacion" required>
                        @foreach (var val in new[] { 0, 3, 5, 8, 10 })
                        {
                            <option value="@val">@val @(val == 0 ? "(sin concentración)" : "")</option>
                        }
                    </select>
                </div>


                <div>
                    <button type="submit" class="btn btn-primary">⚡ Iniciar ejercicios</button>
                </div>

            </div>

        </div>
    </form>

</div>


<style>

    body {
        background-color: var(--color-bg);
        color: var(--color-tex);
    }

    .top-bar-config {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        max-width: 85%;
        margin: -1rem auto 1rem auto;
        padding: 0 1rem;
    }

        .top-bar-config h2 {
            margin: 0;
            font-size: clamp(1.4rem, 2vw, 1.7rem);
            font-weight: 600;
            /* color: var(--color-light); */
        }

    .form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #444;
    }

        .form-header h2 {
            margin: 0;
            font-size: clamp(1.4rem, 2vw, 1.7rem);
            font-weight: 600;
        }


    form#formConfigSR input[type="range"] {
        background-color: #292c4f;
    }


    .formulario-flash {
        max-width: 95%;
        margin: 0 auto;
        padding: 1.3rem;
        border-radius: 1rem;
        background-color: var(--bg-color);
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.4);
        animation: fadeIn 0.4s ease;
        margin-top: -1.5rem;
    }

    .checks {
        flex-direction: row;
        display: flex;
        gap: 2rem;
        padding: 0.5rem;
        align-items: center;
    }

    .form-grid-three-columns {
        display: flex;
        gap: 2rem;
        justify-content: space-between;
    }


    .form-grid {
        display: flex;
        flex-wrap: wrap;
    }

    .form-column {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    form#formConfigSR label {
        display: block;
        margin-bottom: 0.4rem;
        font-weight: 600;
        font-size: 1rem;
    }

    form#formConfigSR select,
    form#formConfigSR input[type="number"] {
        width: 70%;
        padding: 0.5rem 0.6rem;
        border: none;
        border-radius: 0.5rem;
        background-color: #292c4f;
        color: white;
        font-size: 1rem;
    }

    form#formConfigSR input[type="radio"] {
        accent-color: var(--color-primary);
        transform: scale(1.1);
    }

    .btn.btn-primary {
        background: #28a745;
        color: white;
        padding: 0.9rem 1.5rem;
        font-size: 1.1rem;
        font-weight: bold;
        border: none;
        border-radius: 0.6rem;
        cursor: pointer;
        transition: all 0.3s ease;
        width: 100%;
        box-shadow: 0 4px 12px rgba(76, 175, 80, 0.4);
        text-shadow: 0 1px 1px rgba(0, 0, 0, 0.2);
        letter-spacing: 0.5px;
    }

        .btn.btn-primary:hover {
            background: #2ecc71;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(46, 204, 113, 0.5);
        }


    .btn-dashboard {
        background-color: var(--color-primary);
        color: white;
        padding: 0.7rem 1.5rem;
        border: none;
        border-radius: 0.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(76, 76, 255, 0.3);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
    }

        .btn-dashboard i {
            font-size: 1.1rem;
        }

    .dashboard-button-wrapper {
        display: flex;
        justify-content: center;
        margin-bottom: 2rem;
    }

    .btn-dashboard:hover {
        background-color: var(--color-primary-dark);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(76, 76, 255, 0.5);
    }

    .tag-input {
        border: 1px solid #555;
        border-radius: 0.5rem;
        padding: 0.6rem 0.8rem;
