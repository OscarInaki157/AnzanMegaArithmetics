</style>



@section Scripts {
    <script>
        // Variables iniciales en estado de espera
        let startTime = null;
        let tiempoFinal = 0;
        let tiempoCorriendo = false;
        let intervalo = null;
        let tiempoDetenido = false;

        // Elementos del DOM
        let contadorElement = document.getElementById('contador');
        let respuestaInput = document.getElementById('respuestaInput');
        let celdasNumeros = document.querySelectorAll('.numero-celda');
        let formulario = document.querySelector('.form-respuesta');
        let btnIniciar = document.getElementById('btnIniciar');

        // Inicializamos el texto a 0
        contadorElement.textContent = "0.000";

        function formatearTiempo(segundosTotales) {
            let minutos = Math.floor(segundosTotales / 60);
            let segundos = segundosTotales % 60;

            if (minutos > 0) {
                let segundosFormateados = segundos < 10 ? "0" + segundos.toFixed(3) : segundos.toFixed(3);
                return minutos + ":" + segundosFormateados;
            } else {
                return segundosTotales.toFixed(3);
            }
        }

        function actualizarTiempo() {
             if (tiempoCorriendo) {
                 let tiempoTranscurrido = (Date.now() - startTime) / 1000;
                 contadorElement.textContent = formatearTiempo(tiempoTranscurrido);
             }
         }

         // NUEVA FUNCION: Arranca el ejercicio
         function iniciarEjercicio() {
             // 1. Ocultar el botón Iniciar
             btnIniciar.style.display = 'none';

             // 2. Mostrar los números reales leyendo el atributo data-numero
             celdasNumeros.forEach(celda => {
                 celda.textContent = celda.getAttribute('data-numero');
                 celda.classList.remove('estado-oculto');
             });

             // 3. Habilitar input y enfocar
             respuestaInput.disabled = false;
             respuestaInput.focus();

             // 4. Iniciar el tiempo
             startTime = Date.now();
             tiempoCorriendo = true;
             tiempoDetenido = false;
             intervalo = setInterval(actualizarTiempo, 10);
         }

         // Función para detener el tiempo y ocultar números actualizada
         function detenerTiempoYOcultarNumeros() {
             if (tiempoCorriendo) {
                 tiempoCorriendo = false;
                 tiempoDetenido = true;
                 tiempoFinal = (Date.now() - startTime) / 1000;
                 clearInterval(intervalo);

                 // Ocultamos los números usando la clase CSS
                 celdasNumeros.forEach(celda => {
                     celda.textContent = '-';
                     celda.classList.add('estado-oculto');
                 });

                 let tiempoFormateado = formatearTiempo(tiempoFinal);
                 contadorElement.textContent = tiempoFormateado;

                 let spanHistorialActual = document.getElementById('valor-tiempo-actual');
                 if (spanHistorialActual) {
                     spanHistorialActual.textContent = tiempoFormateado;
                 }
             }
         }


        // Detectar input del usuario
        respuestaInput.addEventListener('input', function() {
            if (tiempoCorriendo && this.value.length > 0) {
                detenerTiempoYOcultarNumeros();
            }
        });

        respuestaInput.addEventListener('keydown', function(e) {
            if (tiempoCorriendo && !e.ctrlKey && !e.altKey && !e.metaKey) {
                if (e.key.length === 1 || e.key === 'Backspace' || e.key === 'Delete') {
                    detenerTiempoYOcultarNumeros();
                }
            }
        });

        // Prevenir envío normal del formulario
        formulario.addEventListener('submit', function(e) {
            e.preventDefault();
            prepararYEnviarFormulario();
        });

        // Función principal para preparar y enviar
        function prepararYEnviarFormulario() {
            const respuestaUsuario = respuestaInput.value;
            const respuestaFinal = respuestaUsuario === '' ? -1 : parseInt(respuestaUsuario);

            if (!tiempoDetenido) {
                tiempoFinal = (Date.now() - startTime) / 1000;
                clearInterval(intervalo);
            }

            document.getElementById('respuestaUsuarioInput').value = respuestaFinal;
            document.getElementById('tiempoRespuestaInput').value = tiempoFinal.toFixed(3);

            // DEBUG: Mostrar datos que se enviarán
            // console.log('Enviando:', {
            //     RespuestaUsuario: respuestaFinal,
            //     TiempoRespuesta: tiempoFinal.toFixed(3)
            // });

            // Enviar formulario programáticamente
            formulario.submit();
        }

        // Función para finalizar
        function finalizarPractica() {
            confirmarFinalizacion(); 
        }

      

        function confirmarFinalizacion() {
           
                // Crear formulario para finalizar
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '@Url.Action("FinalizarDesdeEjercicio", "Cuadros")';

                document.body.appendChild(form);
                form.submit();
            
        }

        // Enviar con Enter
        respuestaInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                prepararYEnviarFormulario();
            }
        });

        respuestaInput.addEventListener('paste', function(e) {
            e.preventDefault();
            if (tiempoCorriendo) {
                detenerTiempoYOcultarNumeros();
            }
            alert('No se permite pegar texto.');
        });

        respuestaInput.addEventListener('drop', function(e) {
            e.preventDefault();
            if (tiempoCorriendo) {
                detenerTiempoYOcultarNumeros();
            }
            alert('No se permite arrastrar texto.');
        });

        document.addEventListener('DOMContentLoaded', function() {
            // Enfocamos el botón de iniciar en lugar del input
            let btnIniciar = document.getElementById('btnIniciar');
            if(btnIniciar) {
                btnIniciar.focus();
            }
        });
    </script>
}