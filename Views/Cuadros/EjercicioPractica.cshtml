</style>



@section Scripts {
    <script>
        let startTime = Date.now();
        let tiempoFinal = 0;
        let tiempoCorriendo = true;
        let contadorElement = document.getElementById('contador');
        let respuestaInput = document.getElementById('respuestaInput');
        let celdasNumeros = document.querySelectorAll('.numero-celda');
        let tiempoDetenido = false;
        let formulario = document.querySelector('.form-respuesta');

        // Función para actualizar el contador de tiempo
        function actualizarTiempo() {
            if (tiempoCorriendo) {
                let tiempoTranscurrido = (Date.now() - startTime) / 1000;
                contadorElement.textContent = tiempoTranscurrido.toFixed(3);
            }
        }

        let intervalo = setInterval(actualizarTiempo, 10);
        actualizarTiempo();

        // Función para detener el tiempo y ocultar números
        function detenerTiempoYOcultarNumeros() {
            if (tiempoCorriendo) {
                tiempoCorriendo = false;
                tiempoDetenido = true;
                tiempoFinal = (Date.now() - startTime) / 1000;
                clearInterval(intervalo);

                celdasNumeros.forEach(celda => {
                    celda.textContent = '-';
                    celda.style.color = '#888';
                    celda.style.background = 'linear-gradient(145deg, #3a3c5f, #2a2c4f)';
                });

                contadorElement.textContent = tiempoFinal.toFixed(3);
            }
        }

        // Detectar input del usuario
        respuestaInput.addEventListener('input', function() {
            if (tiempoCorriendo && this.value.length > 0) {
                detenerTiempoYOcultarNumeros();
            }
        });

        respuestaInput.addEventListener('keydown', function(e) {
            if (tiempoCorriendo && !e.ctrlKey && !e.altKey && !e.metaKey) {
                if (e.key.length === 1 || e.key === 'Backspace' || e.key === 'Delete') {
                    detenerTiempoYOcultarNumeros();
                }
            }
        });

        // Prevenir envío normal del formulario
        formulario.addEventListener('submit', function(e) {
            e.preventDefault();
            prepararYEnviarFormulario();
        });

        // Función principal para preparar y enviar
        function prepararYEnviarFormulario() {
            const respuestaUsuario = respuestaInput.value;
            const respuestaFinal = respuestaUsuario === '' ? -1 : parseInt(respuestaUsuario);

            if (!tiempoDetenido) {
                tiempoFinal = (Date.now() - startTime) / 1000;
                clearInterval(intervalo);
            }

            document.getElementById('respuestaUsuarioInput').value = respuestaFinal;
            document.getElementById('tiempoRespuestaInput').value = tiempoFinal.toFixed(3);

            // DEBUG: Mostrar datos que se enviarán
            // console.log('Enviando:', {
            //     RespuestaUsuario: respuestaFinal,
            //     TiempoRespuesta: tiempoFinal.toFixed(3)
            // });

            // Enviar formulario programáticamente
            formulario.submit();
        }

        // Función para finalizar
        function finalizarConRespuesta() {
            if (confirm('¿Estás seguro de que quieres finalizar?')) {
                const respuestaFinal = respuestaInput.value === '' ? -1 : parseInt(respuestaInput.value);

                if (!tiempoDetenido) {
                    tiempoFinal = (Date.now() - startTime) / 1000;
                    clearInterval(intervalo);
                    celdasNumeros.forEach(celda => {
                        celda.textContent = '-';
                        celda.style.color = '#888';
                        celda.style.background = 'linear-gradient(145deg, #3a3c5f, #2a2c4f)';
                    });
                }

                document.getElementById('respuestaUsuarioInput').value = respuestaFinal;
                document.getElementById('tiempoRespuestaInput').value = tiempoFinal.toFixed(3);
                formulario.submit();
            }
        }

        // Enviar con Enter
        respuestaInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                prepararYEnviarFormulario();
            }
        });

        document.addEventListener('DOMContentLoaded', function() {
            respuestaInput.focus();
        });

        respuestaInput.addEventListener('paste', function(e) {
            e.preventDefault();
            if (tiempoCorriendo) {
                detenerTiempoYOcultarNumeros();
            }
            alert('No se permite pegar texto.');
        });

        respuestaInput.addEventListener('drop', function(e) {
            e.preventDefault();
            if (tiempoCorriendo) {
                detenerTiempoYOcultarNumeros();
            }
            alert('No se permite arrastrar texto.');
        });
    </script>
}