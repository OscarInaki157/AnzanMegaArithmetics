@model AnzanMegaArithmetics.Models.EjercicioCuadrosModel
@{
    ViewBag.Title = "Ejercicio de cuadros de velocidad";
    Layout = "_LayoutCuadros";


    var configuracion = ViewBag.Configuracion as AnzanMegaArithmetics.Models.ConfCuadrosModel;
    //numero del ejercicio actual
    var numeroEjercicio = Model.NumeroEjercicio;
    var totalEjercicios = configuracion?.CantidadRejillas ?? 1;
    var porcentaje = (numeroEjercicio * 100) / totalEjercicios;

    int filas, columnas;
    var dimension = configuracion.DimensionRejilla.Split('X');
    filas = int.Parse(dimension[0]);
    columnas = int.Parse(dimension[1]);

    //iluminacion
    List<int> celdasIluminadas = new List<int>();

    if (Model.Iluminacion == "horizontal")
    {
        for (int fila = 0; fila < filas; fila++)
        {
            if (fila % 2 == 0)
            {
                for (int columna = 0; columna < columnas; columna++)
                {
                    celdasIluminadas.Add(fila * columnas + columna);
                }
            }
        }
    }
    else if (Model.Iluminacion == "vertical")
    {
        for (int columna = 0; columna < columnas; columna++)
        {
            if (columna % 2 == 0)
            {
                for (int fila = 0; fila < filas; fila++)
                {
                    celdasIluminadas.Add(fila * columnas + columna);
                }
            }
        }
    }
}

<div class="top-bar">
    <form id="formFinalizar" class="form-fin" onsubmit="return false;">
        <button type="button" class="btn-finalizar" onclick="finalizarPractica()">
            ❌ <span>Finalizar</span>
        </button>
    </form>

    <div class="barra-progreso-contenedor">
        <div class="barra-progreso">
            <div class="progreso-interno" style="width:@porcentaje%"></div>
            <span class="progreso-texto">@Model.NumeroEjercicio / @totalEjercicios</span>
        </div>
    </div>

    <div class="info-tiempo">
         <span>⏱ <span id="contador" class="contador">0.000</span> s</span>
    </div>
</div>

<div class="ejercicio-wrapper">

    <img src="/Content/Images/logosr.png" class="cerebro-marca izquierdo" />
    <img src="/Content/Images/logosr.png" class="cerebro-marca derecho" />



    <div class="ejercicio-container">
        <!-- Panel izquierdo: Rejilla de números -->
        <div class="panel-izquierdo">
            <div class="rejilla-container">
                <div class="rejilla-grid" style="grid-template-columns: repeat(@columnas, 1fr);">
                    @for (int i = 0; i < Model.Rejilla.Count; i++)
                    {
                        <div class="numero-celda @(celdasIluminadas.Contains(i) ? "iluminado" : "") estado-oculto" data-numero="@Model.Rejilla[i]">
                            -
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Panel derecho: Formulario de respuesta -->
        <div class="panel-derecho">
            <div class="tiempos-historial">
                @{
                    var respuestasHist = ViewBag.Respuestas as List<AnzanMegaArithmetics.Models.RCuadrosModel> ?? new List<AnzanMegaArithmetics.Models.RCuadrosModel>();

                    for (int i = 0; i < totalEjercicios; i++)
                    {
                        string displayTime = "--:--";

                        if (i < respuestasHist.Count)
                        {
                            double t = respuestasHist[i].TiempoRespuesta;
                            int min = (int)(t / 60);
                            double sec = t % 60;

                            displayTime = min > 0 ? $"{min}:{sec.ToString("00.000")}" : $"{sec.ToString("0.000")}";
                        }

                        string claseActual = (i == numeroEjercicio - 1) ? "tiempo-actual" : "";
                        string idValorActual = (i == numeroEjercicio - 1) ? "valor-tiempo-actual" : "";

                        <div class="tiempo-item @claseActual">
                            <span class="tiempo-numero">@(i + 1):</span>
                            <span id="@idValorActual" class="tiempo-valor">@displayTime</span>
                        </div>
                    }
                }
            </div>
            <div class="formulario-respuesta">

                <button type="button" id="btnIniciar" class="btn-iniciar" onclick="iniciarEjercicio()">
                    Iniciar
                </button>

                <form asp-action="EjercicioPractica" method="post" class="form-respuesta">
                    <input type="hidden" name="RespuestaUsuario" id="respuestaUsuarioInput" />
                    <input type="hidden" name="TiempoRespuesta" id="tiempoRespuestaInput" />

                    <div class="input-group">
                        <input type="number" id="respuestaInput" class="input-respuesta" min="0" step="1" autocomplete="off" autofocus/>
                    </div>

                    <button type="submit" class="btn-enviar">
                        <span class="btn-text">Enviar Respuesta</span>
                    </button>
                </form>

            </div>
        </div>
    </div>


</div>

