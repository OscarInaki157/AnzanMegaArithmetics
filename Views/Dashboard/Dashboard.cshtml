@{
    ViewBag.Title = "Neuroactividades";
    Layout = "_LayoutDashboard";
}
<style>

    /* ===== TOP SECTION ===== */
    .dashboard-top {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 2rem;
        justify-content: center;
        align-items: stretch;
    }

    .user-info-card,
    .user-welcome-card {
        width: calc(50% - 0.5rem);
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: space-evenly;
        border-radius: 1rem;
    }

    .user-info-card {
        background-color: var(--color-card-bg);
        color: var(--color-light);
        padding: 1.5rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        gap: 1rem;
        font-size: 1.1rem;
    }

        .user-info-card p {
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.7rem;
        }

        .user-info-card i {
            font-size: 1.3rem;
        }

    .user-welcome-card {
        background: linear-gradient(to top, var(--color-card-bg) 50%, transparent 50%);
        padding: 1rem;
        align-items: center;
        justify-content: center;
        box-shadow: none;
    }

    .image-wrapper {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100%;
    }

        .image-wrapper img {
            max-width: 200px;
            height: auto;
            object-fit: contain;
            z-index: 2;
        }

    /* Ocultar en móviles */
    .hide-on-mobile {
        display: block;
    }

    /* ===== TARJETAS DE MÓDULOS ===== */

    .modulo-link {
        background-color: var(--color-primary);
        color: white;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 1.2rem;
        text-decoration: none;
        transition: transform 0.2s ease;
    }

        .modulo-link:hover {
            background-color: var(--color-primary-dark);
            transform: scale(1.1);
        }

    .containers-wrapper {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
    }

    .rounded-container {
        background-color: var(--color-card-bg);
        color: var(--color-light);
        border-radius: 1.5rem;
        width: calc(50% - 0.5rem);
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        padding: 2rem 1.5rem;
        position: relative;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        transition: transform 0.2s ease-in-out;
    }

        .rounded-container:hover {
            transform: translateY(-5px);
        }

    .container-image {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        overflow: hidden;
        margin-bottom: 1rem;
        align-self: center;
        box-shadow: 0 0 10px rgba(0,0,0,0.3);
    }

        .container-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .container-text {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

        .container-text h1 {
            font-size: 1.8rem;
            margin: 0.5rem 0;
            text-align: center;
        }

        .container-text p {
            font-size: 1.1rem;
            margin-bottom: 2rem;
            color: var(--color-light);
            text-align: center;
        }

        /* Botón estilo flecha */
        .container-text .arrow-button {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            font-size: 1.6rem;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background-color: var(--color-primary);
            color: white;
            border: none;
            cursor: pointer;
            align-self: center;
            transition: transform 0.2s ease;
        }

            .container-text .arrow-button:hover {
                transform: scale(1.1);
                background-color: var(--color-primary-dark);
            }

    /* Menú desplegable con íconos */
    .dropdown-menu {
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        background-color: var(--color-card-bg);
        border-radius: 1rem;
        padding: 1rem;
        width: 90%;
        box-shadow: 0 10px 20px rgba(0,0,0,0.3);
        display: none;
        z-index: 10;
    }

        .dropdown-menu a {
            display: flex;
            align-items: center;
            color: white;
            font-size: 1rem;
            text-decoration: none;
            padding: 0.8rem 1rem;
            border-radius: 0.5rem;
            transition: background-color 0.3s;
        }

            .dropdown-menu a i {
                margin-right: 0.6rem;
                font-size: 1.2rem;
            }

            .dropdown-menu a:hover {
                background-color: var(--color-accent);
            }

    .modulos-wrapper {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
        align-items:start;
        padding-top:1rem;
    }


    .modulo-card {
        background-color: var(--color-card-bg);
        color: var(--color-light);
        border-radius: 1.5rem;
        width: 100%;
        box-sizing: border-box;
        padding: 1.5rem;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
        display: flex;
        flex-direction: column;
        position: relative;
        transition: transform 0.2s ease-in-out;
    }

        .modulo-card:hover {
            transform: translateY(-6px);
            border: 2px solid #4c4cff;
            box-shadow: 0 0 20px rgba(76, 76, 255, 0.3);
        }

    .modulo-header {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        overflow:visible;
        padding-right:0.1rem;
    }

    .modulo-image {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        overflow: hidden;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
        flex-shrink: 0;
        background-color:white;
        display:flex;
        justify-content:center;
        align-items:center;
    }

        .modulo-image img {
            width: 70%;
            height: 70%;
            object-fit: contain;
        }

    .modulo-text {
        flex-grow: 1;
    }

        .modulo-text h2 {
            font-size: 1.4rem;
            margin: 0;
            color: var(--color-light);
        }

        .modulo-text p {
            font-size: 1rem;
            margin: 0.3rem 0 0;
            color: var(--color-light);
        }

    .modulo-toggle {
        background-color: var(--color-primary);
        border: none;
        color: white;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        font-size: 1.2rem;
        cursor: pointer;
        transition: transform 0.2s ease;
    }

        .modulo-toggle:hover {
            background-color: var(--color-primary-dark);
            transform: scale(1.1);
        }

    .modulo-menu {
        margin-top: 1rem;
        background-color: var(--color-bg);
        width: 100%;
        padding: 1rem;
        border-radius: 1rem;
        display: none;
        box-shadow: 0 10px 20px rgba(0,0,0,0.3);
    }

        .modulo-menu a {
            display: flex;
            align-items: center;
            color: white;
            text-decoration: none;
            padding: 0.8rem;
            border-radius: 0.5rem;
            transition: background-color 0.3s;
            font-size: 1rem;
        }

            .modulo-menu a i {
                margin-right: 0.6rem;
                font-size: 1.2rem;
            }

            .modulo-menu a:hover {
                background-color: var(--color-hover);
            }

    .speech-bubble {
        position: relative;
        top: -10%;
        left: -2%;
        background-color: var(--color-primary);
        color: white;
        padding: 0.5rem;
        border-radius: 1.2rem;
        font-size: 0.7rem;
        max-width: 10rem;
        z-index: 3;
        font-weight: 500;
        text-align: center;
    }

    .contenedorR{
        display:flex;
        width:100%;
        flex-direction:row;
        justify-content: space-evenly;
    }
    .R1{
        background-color: #4c4cff;
        width: 30%;
        height: 6rem;
        border-radius: 1rem;
        justify-content: center;
        align-items: center;
        display: flex;
    }
    .R2{
        background-color: #4e6e5d;
        width: 30%;
        height: 6rem;
        border-radius: 1rem;
        justify-content: center;
        align-items: center;
        display: flex;
    }

    .R3 {
        background-color: #D72638;
        width: 30%;
        height: 6rem;
        border-radius: 1rem;
        justify-content: center;
        align-items: center;
        display: flex;
    }

    .txt{
        color:white;
        font-size:1.3rem;
        text-align:center;
    }


    /* ===== Responsive ===== */
    @@media (max-width: 768px) {

    .modulos-wrapper {
        grid-template-columns: 1fr;
        padding:0.5rem;
    }

    .user-info-card, .user-welcome-card
    {
        width: 100%;
    }

    .containers-wrapper {
        flex-direction: column;
    }

    .rounded-container {
        width: 100%;
        align-items: center;
    }

    .container-text {
        align-items: center;
    }

    .dropdown-menu {
        top: auto;
        bottom: -60px;
        right: auto;
        left: 50%;
        transform: translateX(-50%);
    }

    .hide-on-mobile {
        display: none;
    }

    .dashboard-top {
        flex-direction: column;
    }

        .modulo-card {
            width: 100%;
        }

        .modulo-header {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .modulo-text h2 {
            font-size: 1.3rem;
        }

        .modulo-menu {
            width: 100%;
            left: 0;
            transform: none;
        }

    }
</style>



<div class="dashboard-top">
    <div class="user-welcome-card hide-on-mobile">
        <div class="image-wrapper">
            <div class="speech-bubble">
                @ViewBag.FraseBienvenida
            </div>
            <img src="/Content/Images/ProfS.png" alt="Profesor saludando" />
            <p class="names" style="color:#ffffff; font-size:1.5rem; position: absolute; top: 25%; left: 30%;"><strong>Jerry</strong></p>
        </div>
    </div>
    <div class="user-info-card">
        <p><i class="fa-solid fa-user-tie"></i> <strong>Nombre:</strong> @ViewBag.Nombre</p>
        <p><i class="fa-solid fa-landmark"></i> <strong>Clase:</strong> @ViewBag.Clase</p>
        @* <p><i class="fas fa-envelope"></i> <strong>Usuario:</strong> @ViewBag.Usuario</p> *@
        <p><i class="fa-solid fa-gamepad"></i> <strong>Gamertag:</strong> Gamertag</p>
        <div class="contenedorR">
            <div class="R3">
                <p class="txt"><strong>🔥<br />1</strong></p>
            </div>
            <div class="R2">
                <p class="txt"><strong>🎖️<br />Plata</strong></p>
            </div>
            <div class="R1">
                <p class="txt"><strong>✨<br />1872XP</strong></p>
            </div>
        </div>
    </div>
</div>

<div class="modulos-wrapper">
    <!-- FINGERMATH -->
    <div class="modulo-card">
        <div class="modulo-header">
            <div class="modulo-image">
                <img src="/Content/Images/ManosF.gif" alt="Fingermath" />
            </div>
            <div class="modulo-text">
                <h2>Fingermath</h2>
                <p>Lectura y escritura</p>
            </div>
            <button class="modulo-toggle" data-menu-id="fingermath-menu">
                <i class="fas fa-chevron-down"></i>
            </button>
        </div>
        <div id="fingermath-menu" class="modulo-menu">
            <a href="@Url.Action("LecturaFinger", "Fingermath")">
                <i class="fas fa-eye"></i> Ejercicios Lectura
            </a>
            <a href="@Url.Action("EscrituraFinger", "Fingermath")">
                <i class="fas fa-pencil-alt"></i> Ejercicios Escritura
            </a>
        </div>
    </div>

    <!-- SOROBAN -->
    <div class="modulo-card">
        <div class="modulo-header">
            <div class="modulo-image">
                <img src="/Content/Images/abacoicon.gif" alt="Soroban" />
            </div>
            <div class="modulo-text">
                <h2>Soroban</h2>
                <p>Lectura y escritura</p>
            </div>
            <button class="modulo-toggle" data-menu-id="soroban-menu">
                <i class="fas fa-chevron-down"></i>
            </button>
        </div>
        <div id="soroban-menu" class="modulo-menu">
            <a href="@Url.Action("LecturaSoroban", "Soroban")">
                <i class="fas fa-eye"></i> Ejercicios Lectura
            </a>
            <a href="@Url.Action("EscrituraSoroban", "Soroban")">
                <i class="fas fa-pencil-alt"></i> Ejercicios Escritura
            </a>
        </div>
    </div>

    <!-- SUMA Y RESTA -->
    <div class="modulo-card">
        <div class="modulo-header">
            <div class="modulo-image">
                <img src="/Content/Images/SRlottie.gif" alt="Suma y Resta" />
            </div>
            <div class="modulo-text">
                <h2>Suma y Resta</h2>
                <p>Ejercicios</p>
            </div>
            <a href="@Url.Action("FormularioSR", "SumaResta")" class="modulo-link">
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>

    <!-- NÚMEROS FLASH -->
    <div class="modulo-card">
        <div class="modulo-header">
            <div class="modulo-image">
                <img src="/Content/Images/Flashicon.gif" alt="Anzan Flash" />
            </div>
            <div class="modulo-text">
                <h2>Números Flash</h2>
                <p>Mentes Flash</p>
            </div>
            <a href="@Url.Action("FormularioFlash", "Flash")" class="modulo-link">
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>

    @* Multiplicacion *@
    <div class="modulo-card">
        <div class="modulo-header">
            <div class="modulo-image">
                <img src="/Content/Images/multip.gif" alt="Soroban" />
            </div>
            <div class="modulo-text">
                <h2>Multiplicación</h2>
                <p>Tablas de multiplicar y competencia</p>
            </div>
            <button class="modulo-toggle" data-menu-id="multi-menu">
                <i class="fas fa-chevron-down"></i>
            </button>
        </div>
        <div id="multi-menu" class="modulo-menu">
            <a href="@Url.Action("TablasForm", "Multiplicacion")">
                <i class="fa-solid fa-x"></i> Tablas de multiplicar
            </a>
            <a href="@Url.Action("MultiplicacionForm", "Multiplicacion")">
                <i class="fa-solid fa-circle-xmark"></i> Multiplicación
            </a>
            <a href="@Url.Action("FormCompetenciaMulti", "Multiplicacion")" ">
                <i class="fa-solid fa-trophy"></i> Ejercicios de competencia
            </a>
        </div>
    </div>

    @* Division *@
    <div class="modulo-card">
        <div class="modulo-header">
            <div class="modulo-image">
                <img src="/Content/Images/division.gif" alt="Division" />
            </div>
            <div class="modulo-text">
                <h2>División</h2>
                <p>Ejercicios de división</p>
            </div>
            <a href="#" class="modulo-link">
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>

</div>


<script>
    function toggleMenu(menuId, event) {
        event.preventDefault();
        const menu = document.getElementById(menuId);
        const isVisible = menu.style.display === 'block';

        // Oculta todos los menús antes de mostrar el seleccionado
        document.querySelectorAll('.modulo-menu').forEach(m => m.style.display = 'none');

        // Muestra u oculta el menú correspondiente
        menu.style.display = isVisible ? 'none' : 'block';
    }

    document.addEventListener('DOMContentLoaded', function () {
        const toggleButtons = document.querySelectorAll('.modulo-toggle');
        toggleButtons.forEach(button => {
            button.addEventListener('click', function (event) {
                const menuId = this.dataset.menuId;
                toggleMenu(menuId, event);
            });
        });

        // Cierra el menú si se hace clic fuera
        document.addEventListener('click', function (event) {
            document.querySelectorAll('.modulo-menu').forEach(menu => {
                const button = document.querySelector(`[data-menu-id="${menu.id}"]`);
                const isClickInsideMenu = menu.contains(event.target);
                const isClickOnButton = button && button.contains(event.target);

                if (!isClickInsideMenu && !isClickOnButton) {
                    menu.style.display = 'none';
                }
            });
        });
    });
</script>

