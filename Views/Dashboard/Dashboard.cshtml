@{
    ViewBag.Title = "Neuroactividades";
    Layout = "_LayoutDashboard";
}

<div class="dashboard-top">
    <div class="user-welcome-card hide-on-mobile">
        <div class="image-wrapper">
            <div class="speech-bubble">
                @ViewBag.FraseBienvenida
            </div>
            <img src="/Content/Images/ProfS.png" alt="Profesor saludando" />
            <p class="names" style="color:#ffffff; font-size:1.5rem; position: absolute; top: 25%; left: 30%;"><strong>Jerry</strong></p>
        </div>
    </div>
    <div class="user-info-card">
        <p><i class="fa-solid fa-user-tie"></i>@ViewBag.Nombre</p>
        <p><i class="fa-solid fa-landmark"></i> <strong>Clase:</strong> @ViewBag.Clase</p>
        @* <p><i class="fas fa-envelope"></i> <strong>Usuario:</strong> @ViewBag.Usuario</p> *@
        <p><i class="fa-solid fa-gamepad"></i> <strong>Gamertag:</strong> Gamertag</p>
        <div class="contenedorR">
            <div class="R3">
                <p class="txt"><strong>🔥<br />1</strong></p>
            </div>
            <div class="R2">
                <p class="txt"><strong>🎖️<br />Plata</strong></p>
            </div>
            <div class="R1">
                <p class="txt"><strong>✨<br /><span id="xp-counter">0</span>XP</strong></p>
            </div>
        </div>
    </div>
</div>

<div class="modulos-wrapper">
    <!-- FINGERMATH -->
    <div class="modulo-card">
        <div class="modulo-header">
            <div class="modulo-image">
                <img src="/Content/Images/ManosF.gif" alt="Fingermath" />
            </div>
            <div class="modulo-text">
                <h2>Fingermath</h2>
                <p>Lectura y escritura</p>
            </div>
            <button class="modulo-toggle" data-menu-id="fingermath-menu">
                <i class="fas fa-chevron-down"></i>
            </button>
        </div>
        <div id="fingermath-menu" class="modulo-menu">
            <a href="@Url.Action("LecturaFinger", "Fingermath")">
                <i class="fas fa-eye"></i> Ejercicios Lectura
            </a>
            <a href="@Url.Action("EscrituraFinger", "Fingermath")">
                <i class="fas fa-pencil-alt"></i> Ejercicios Escritura
            </a>
        </div>
    </div>

    <!-- SOROBAN -->
    <div class="modulo-card">
        <div class="modulo-header">
            <div class="modulo-image">
                <img src="/Content/Images/abacoicon.gif" alt="Soroban" />
            </div>
            <div class="modulo-text">
                <h2>Soroban</h2>
                <p>Lectura y escritura</p>
            </div>
            <button class="modulo-toggle" data-menu-id="soroban-menu">
                <i class="fas fa-chevron-down"></i>
            </button>
        </div>
        <div id="soroban-menu" class="modulo-menu">
            <a href="@Url.Action("LecturaSoroban", "Soroban")">
                <i class="fas fa-eye"></i> Ejercicios Lectura
            </a>
            <a href="@Url.Action("EscrituraSoroban", "Soroban")">
                <i class="fas fa-pencil-alt"></i> Ejercicios Escritura
            </a>
        </div>
    </div>

    <!-- SUMA Y RESTA -->
    <div class="modulo-card">
        <div class="modulo-header">
            <div class="modulo-image">
                <img src="/Content/Images/SRlottie.gif" alt="Suma y Resta" />
            </div>
            <div class="modulo-text">
                <h2>Suma y Resta</h2>
                <p>Ejercicios</p>
            </div>
            <a href="@Url.Action("FormularioSR", "SumaResta")" class="modulo-link">
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>

    <!-- NÚMEROS FLASH -->
    <div class="modulo-card">
        <div class="modulo-header">
            <div class="modulo-image">
                <img src="/Content/Images/Flashicon.gif" alt="Anzan Flash" />
            </div>
            <div class="modulo-text">
                <h2>Números Flash</h2>
                <p>Mentes Flash</p>
            </div>
            <a href="@Url.Action("FormularioFlash", "Flash")" class="modulo-link">
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>

    @* Multiplicacion *@
    <div class="modulo-card">
        <div class="modulo-header">
            <div class="modulo-image">
                <img src="/Content/Images/multip.gif" alt="Soroban" />
            </div>
            <div class="modulo-text">
                <h2>Multiplicación</h2>
                <p>Tablas de multiplicar y competencia</p>
            </div>
            <button class="modulo-toggle" data-menu-id="multi-menu">
                <i class="fas fa-chevron-down"></i>
            </button>
        </div>
        <div id="multi-menu" class="modulo-menu">
            <a href="@Url.Action("TablasForm", "Multiplicacion")">
                <i class="fa-solid fa-x"></i> Tablas de multiplicar
            </a>
            <a href="@Url.Action("MultiplicacionForm", "Multiplicacion")">
                <i class="fa-solid fa-circle-xmark"></i> Multiplicación
            </a>
            <a href="@Url.Action("FormCompetenciaMulti", "Multiplicacion")" ">
                <i class="fa-solid fa-trophy"></i> Ejercicios de competencia
            </a>
        </div>
    </div>

    @* Division *@
    <div class="modulo-card">
        <div class="modulo-header">
            <div class="modulo-image">
                <img style="transform:rotate(45deg);" src="/Content/Images/division.gif" alt="Division" />
            </div>
            <div class="modulo-text">
                <h2>División</h2>
                <p>Ejercicios de división</p>
            </div>
            <a href="#" class="modulo-link">
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>

</div>
