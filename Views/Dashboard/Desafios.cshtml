@model AnzanMegaArithmetics.Models.LoginResponseModel
@{
    ViewBag.Title = "Desafios Rápidos";
    Layout = "_LayoutDashboard";
}


<!-- Barra Superior - Información Personal -->
<div class="user-top-info">
    <div class="user-left-section">
        <div class="user-name">
            @Model.Nombre
        </div>
        <div class="user-meta-row">
            <span class="gamertag">
                <i class="fa-solid fa-gamepad"></i>
                <strong>Gamertag:</strong> @Model.Gamer_Tag
            </span>
            <span class="license">
                <i class="fa-solid fa-id-card"></i>
                <strong>Licencia:</strong> @Model.Licencia
            </span>
            <span class="license">
                <i class="fa-solid fa-landmark"></i>
                <strong>Tus clases:</strong> @string.Join(", ", Model.Clases)
            </span>
        </div>
    </div>

    <div class="user-right-section">
        <div class="user-coins">
            <i class="fa-solid fa-coins"></i>
            <strong>Mind coins:</strong> <span id="user-coins">0</span>
        </div>
        <div class="last-connection">
            <i class="fa-solid fa-clock"></i>
            Última conexión: @Model.Ultima_Cnx
        </div>
    </div>
</div>

<div class="dashboard-top">
    <div class="user-welcome-card">
        <div class="welcome-container">
            <div class="speech-bubble">
                @Model.Frase_Bienvenida
            </div>
            <div class="character-section">
                <img src="/Content/Images/ProfS.png" alt="Profesor saludando" class="professor-img" />
                <p class="character-name"><strong>Jerry</strong></p>
            </div>
        </div>
    </div>
    <div class="user-info-card">
        @*  <p><strong>Licencia @Model.Licencia</strong></p>
        <p>Última conexión: @Model.Ultima_Cnx</p>
        <p><i class="fa-solid fa-user-tie"></i>@Model.Nombre</p>
        <p><i class="fa-solid fa-landmark"></i> <strong>Tus clases:</strong> @string.Join(", ", Model.Clases)</p>
        <p><i class="fas fa-envelope"></i> <strong>Usuario:</strong> @ViewBag.Usuario</p>
        <p><i class="fa-solid fa-gamepad"></i> <strong>Gamertag:</strong> @Model.Gamer_Tag</p> *@
        <div class="contenedorR">
            <div class="R3">
                <p class="txt"><strong>🔥<br />@Model.Racha</strong></p>
            </div>
            <div class="R2">
                <p class="txt"><strong>🎖️<br />Bronce I</strong></p>
            </div>
            <div class="R1">
                <p class="txt"><strong>✨<br /><span id="xp-counter">@Model.Exp</span></strong></p>
            </div>
        </div>

        <div class="xp-progress-container">
            <div class="xp-bar">
                <div class="xp-progress" id="xp-progress-bar" data-xp="@Model.Exp"></div>
            </div>
            <div class="xp-next-level">
                <i class="fas fa-arrow-up"></i>
                <span id="xp-next-level-text">Próximo nivel en: @(20000 - (Model.Exp % 20000)) XP</span>
            </div>
        </div>

    </div>
</div>


<div class="modulos-wrapper">
    
    @* Calendario Mental *@
    <div class="modulo-card">
        <div class="modulo-header">
            <div class="modulo-image">
                <img src="/Content/Images/Calendario.gif" alt="Calendario" />
            </div>
            <div class="modulo-text">
                <h2>Calendario Mental</h2>
                <p>Ejercicios</p>
            </div>
            <button class="modulo-toggle" data-menu-id="Calendar-menu">
                <i class="fas fa-chevron-down"></i>
            </button>
        </div>
        <div id="Calendar-menu" class="modulo-menu">
            <a href="@Url.Action("CompetenciaCalendario","Calendario")">
                <i class="fa-solid fa-trophy"></i> Modo Competencia
            </a>
            <a href="@Url.Action("FormularioCalendario", "Calendario")">
                <i class="fas fa-pencil-alt"></i> Modo Práctica
            </a>
        </div>
    </div>

    @* cuadros de velocidad *@
    <div class="modulo-card">
        <div class="modulo-header">
            <div class="modulo-image">
                <img src="/Content/Images/Flashicon.gif" alt="Cuadros" />
            </div>
            <div class="modulo-text">
                <h2>Cuadros de velocidad</h2>
                <p>Ejercicios de cálculo veloces</p>
            </div>
            <button class="modulo-toggle" data-menu-id="Cuadros-menu">
                <i class="fas fa-chevron-down"></i>
            </button>
        </div>
        <div id="Cuadros-menu" class="modulo-menu">

            <a href="#" onclick="submitCompetenciaForm()">
                <i class="fa-solid fa-trophy"></i> Modo Competencia
            </a>

            <a href="@Url.Action("CuadrosForm", "Cuadros")">
                <i class="fas fa-pencil-alt"></i> Modo Práctica
            </a>
        </div>
    </div>

    <form id="competenciaForm" asp-action="CuadrosCompetencia" asp-controller="Cuadros" method="post" style="display: none;">
    </form>

    @* Raices y potencias *@
    <div class="modulo-card">
        <div class="modulo-header">
            <div class="modulo-image">
                <img src="/Content/Images/raices.gif" alt="potencias" />
            </div>
            <div class="modulo-text">
                <h2>Números al cuadrado</h2>
                <p>Ejercicios de potencias</p>
            </div>
            <button class="modulo-toggle" data-menu-id="Potencia-menu">
                <i class="fas fa-chevron-down"></i>
            </button>
        </div>
        <div id="Potencia-menu" class="modulo-menu">
            <a href="@Url.Action("CompetenciaPotencias", "Potencias")">
                <i class="fa-solid fa-trophy"></i> Modo Competencia
            </a>
            <a href="@Url.Action("FormularioPotencias", "Potencias")">
                <i class="fas fa-pencil-alt"></i> Modo Práctica
            </a>
        </div>
    </div>


    <div class="modulo-card">
        <div class="modulo-header">
            <div class="modulo-image">
                <img src="/Content/Images/raices.gif" alt="potencias" />
            </div>
            <div class="modulo-text">
                <h2>Raices cuadradas</h2>
                <p>Ejercicios de raices cuadradas</p>
            </div>
            <button class="modulo-toggle" data-menu-id="Raices-menu">
                <i class="fas fa-chevron-down"></i>
            </button>
        </div>
        <div id="Raices-menu" class="modulo-menu">
            <a href="@Url.Action("CompetenciaRaices", "Raices")">
                <i class="fa-solid fa-trophy"></i> Modo Competencia
            </a>
            <a href="@Url.Action("FormularioRaices", "Raices")">
                <i class="fas fa-pencil-alt"></i> Modo Práctica
            </a>
        </div>
    </div>

    @* matematicas con dados *@
    <div class="modulo-card">
        <div class="modulo-header">
            <div class="modulo-image">
                <img src="/Content/Images/dados.gif" alt="Division" />
            </div>
            <div class="modulo-text">
                <h2>Matemáticas con dados</h2>
                <p>Ejercicios</p>
            </div>
            <a href="@Url.Action("FormularioDados", "Dados")" class="modulo-link">
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>

</div>

<script>
    function submitCompetenciaForm() {
        document.getElementById('competenciaForm').submit();
    }
</script>