@using AnzanMegaArithmetics.Models
@model AnzanMegaArithmetics.Models.LoginResponseModel
@{
    ViewBag.Title = "Ranking";
    Layout = "_LayoutDashboard";


    string rangoNombre = Model.Rango_Actual ?? "Bronce I";
    string rangoClase = "";
    if (rangoNombre.Contains("Materia Oscura", StringComparison.OrdinalIgnoreCase)) { rangoClase = "dark-matter"; }
    else if (rangoNombre.Contains("Heroico", StringComparison.OrdinalIgnoreCase)) { rangoClase = "heroic"; }
    else if (rangoNombre.Contains("Diamante", StringComparison.OrdinalIgnoreCase)) { rangoClase = "diamond"; }
    else if (rangoNombre.Contains("Oro", StringComparison.OrdinalIgnoreCase)) { rangoClase = "gold"; }
    else if (rangoNombre.Contains("Plata", StringComparison.OrdinalIgnoreCase)) { rangoClase = "silver"; }
    else { rangoClase = "bronze"; }
}

<div class="user-top-info">
    <div class="user-left-section">
        <div class="user-name">@Model.Nombre</div>
        <div class="user-meta-row">
            <span class="gamertag"><i class="fa-solid fa-gamepad"></i> <strong>Gamertag:</strong> @Model.Gamer_Tag</span>
            <span class="license"><i class="fa-solid fa-id-card"></i> <strong>Licencia:</strong> @Model.Licencia</span>
            <span class="license"><i class="fa-solid fa-landmark"></i> <strong>Tus clases:</strong> @string.Join(", ", Model.Clases)</span>
        </div>
    </div>
    <div class="user-right-section">
        <div class="last-connection"><i class="fa-solid fa-clock"></i> Última conexión: @Model.Ultima_Cnx</div>
    </div>
</div>

<div class="dashboard-top">
    <div class="user-welcome-card">
        <div class="welcome-container">
            <div class="speech-bubble">@Model.Frase_Bienvenida</div>
            <div class="character-section">
                <img src="/Content/Images/ProfS.png" alt="Profesor saludando" class="professor-img" />
                <p class="character-name"><strong>Lucca</strong></p>
            </div>
        </div>
    </div>
    <div class="user-info-card">
        <div class="contenedorR">
            <div class="R3" id="racha-container">
                <p class="txt">
                    <strong>
                        <span class="fire-icon" id="fire-icon">🔥</span><br />
                        <span id="racha-counter">0</span>
                    </strong>
                </p>
            </div>
            <div class="R2 @rangoClase"><p class="txt"><strong>🎖️<br />@Model.Rango_Actual</strong></p></div>
            <div class="R1" id="xp-container">
                <p class="txt">
                    <strong>
                        <span class="star-icon" id="star-icon">✨</span><br />
                        <span id="xp-counter">0</span>
                    </strong>
                </p>
            </div>
        </div>
        <div class="xp-progress-container">
            <div class="xp-bar">
                <span id="xp-next-level-text" class="xp-text-overlay" style="color:white;">
                    Próximo nivel en: @(20000 - (Model.Exp % 20000)) XP
                </span>
                <div class="xp-progress" id="xp-progress-bar" data-xp="@Model.Exp"></div>
            </div>
        </div>
    </div>
</div>

<div class="dashboard-bottom">
    <div class="global-ranking-container" id="rankingCardContainer">

        <div class="ranking-header" style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 1rem; margin-bottom: 1rem;">
            <button class="slider-nav-btn" onclick="cambiarSlideDashboard(-1)">
                <i class="fa-solid fa-chevron-left"></i>
            </button>

            <div style="text-align: center; flex: 1; overflow: hidden;">
                <h2 class="ranking-title slide-anim" id="lblDashTitle" style="font-size: 1.5rem; margin: 0;">Cargando...</h2>
                <div class="ranking-subtitle slide-anim" id="lblDashSubtitle" style="font-size: 0.85rem; color: #a0a0c0;">...</div>
                <div id="dashDots" class="slider-dots" style="justify-content: center; margin-top: 5px; display: flex; gap: 4px;"></div>

                <div id="dashFilters" class="ranking-filters" style="margin-top: 10px; display: flex; justify-content: center; gap: 8px;">
                    <button class="filter-btn active" data-periodo="Global" onclick="filtrarRankingDashboard('Global', this)">Global</button>
                    <button class="filter-btn" data-periodo="Mensual" onclick="filtrarRankingDashboard('Mensual', this)">Mensual</button>
                    <button class="filter-btn" data-periodo="Semanal" onclick="filtrarRankingDashboard('Semanal', this)">Semanal</button>
                </div>
            </div>

            <button class="slider-nav-btn" onclick="cambiarSlideDashboard(1)">
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </div>

        <div id="dashTableContainer" class="ranking-list-container" style="min-height: 200px;">
            <div class="loading-state">
                <i class="fa-solid fa-circle-notch fa-spin"></i>
            </div>
        </div>

        <div class="view-all-container">
            <button type="button" class="btn-view-all" id="btnVerMasDash" onclick="abrirModalDesdeDashboard()">
                Ver Ranking Completo <i class="fa-solid fa-arrow-right"></i>
            </button>
        </div>
    </div>
</div>

<div id="modalRankingGlobal" class="custom-modal-overlay">
    <div class="custom-modal-content">
        <div class="custom-modal-header">
            <div class="header-top-row">
                <div class="slider-header-container">
                    @* <button class="slider-nav-btn" onclick="cambiarSlideModal(-1)">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button> *@

                    <div class="slider-title-wrapper">
                        <h3 id="lblModalTitle" class="slider-title">Ranking</h3>
                        @* <div id="modalDots" class="slider-dots" style="justify-content:center; display:flex; gap:4px; margin-top:4px;"></div> *@
                    </div>

                    @* <button class="slider-nav-btn" onclick="cambiarSlideModal(1)">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button> *@
                </div>

                <button class="close-modal-btn" onclick="cerrarModalRanking()">&times;</button>
            </div>

            <div id="modalFilters" class="ranking-filters" style="margin-bottom:1rem; display: flex; justify-content: center; gap: 8px;">
                <button class="filter-btn active" data-periodo="Global"
                        onclick="sincronizarFiltro('Global', this)">
                    Global
                </button>
                <button class="filter-btn" data-periodo="Mensual"
                        onclick="sincronizarFiltro('Mensual', this)">
                    Mensual
                </button>
                <button class="filter-btn" data-periodo="Semanal"
                        onclick="sincronizarFiltro('Semanal', this)">
                    Semanal
                </button>
            </div>

            <div class="search-container">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input type="text"
                       id="inputBusquedaRanking"
                       class="search-input"
                       placeholder="Buscar jugador en esta lista..."
                       onkeyup="filtrarRankingModal()">
            </div>
        </div>
        <div class="custom-modal-body">
            <div id="modalContentContainer">
                <div class="loading-state">
                    <i class="fa-solid fa-circle-notch fa-spin"></i> Cargando datos completos...
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // --- VARIABLES GLOBALES ---
    const myUserId = @Model.Id_Usuario;

    // 1. Datos del Dashboard (Top 10) - Vienen directo del Controller
    let dashData = @Html.Raw(ViewBag.RankingJson ?? "[]");
    let dashIndex = 0;
    let dashPeriodo = 'Global';
    let dashCache = {};

    let dashOriginalData = [];
    // 2. Datos del Modal (Top 50) - Se cargarán via AJAX
    let modalData = [];
    let modalIndex = 0;
    let rankingCompletoCargado = false;

    // --- AL INICIAR LA PÁGINA ---
    document.addEventListener("DOMContentLoaded", function() {
        if(dashData && dashData.length > 0) {
            dashData.forEach(cat => {
                cat.Datos.forEach((u, i) => u.RankOriginal = i + 1);
            });
            dashOriginalData = JSON.parse(JSON.stringify(dashData));
            renderDashboard();
            generarDots('dashDots', dashData.length, dashIndex);
        } else {
            document.getElementById('dashTableContainer').innerHTML = '<div class="no-data" style="text-align:center; padding:2rem;">Sin datos.</div>';
        }
    });

    // ==========================================
    // LÓGICA DEL DASHBOARD (SLIDER PEQUEÑO)
    // ==========================================
    function cambiarSlideDashboard(dir) {
        dashIndex += dir;
        if(dashIndex >= dashData.length) dashIndex = 0;
        if(dashIndex < 0) dashIndex = dashData.length - 1;

        dashPeriodo = 'Global';

        const originalSlide = dashOriginalData[dashIndex];
        dashData[dashIndex].Datos = originalSlide.Datos;
        dashData[dashIndex].Titulo = originalSlide.Titulo;

        document.querySelectorAll('#dashFilters .filter-btn').forEach(btn => btn.classList.remove('active'));

        const isRacha = dashData[dashIndex].Titulo.includes("Racha");

        if (!isRacha) {
            const activeBtn = document.querySelector(`#dashFilters .filter-btn[data-periodo="${dashPeriodo}"]`);
            if (activeBtn) {
                activeBtn.classList.add('active');
            } else {
                dashPeriodo = 'Global';
                document.querySelector('#dashFilters .filter-btn[data-periodo="Global"]').classList.add('active');
            }
        } else {
            dashPeriodo = 'Global';
        }

        renderDashboard();
        actualizarDots('dashDots', dashIndex);
    }

    // ==========================================
    // LÓGICA DEL DASHBOARD (SLIDER PEQUEÑO)
    // ==========================================

    function getPodiumHtml(u, cls, crown=false) {

        const isRacha = dashData[dashIndex] && dashData[dashIndex].Titulo.includes("Racha");

        let rankNumber = '';
        if (cls === 'first-place') {
            rankNumber = '1';
        } else if (cls === 'second-place') {
            rankNumber = '2';
        } else if (cls === 'third-place') {
            rankNumber = '3';
        }

        const rankNumberHtml = rankNumber
            ? `<div class="podium-rank-number">${rankNumber}</div>`
            : '';

        const valueToDisplay = isRacha ? (u.Racha || 0) : (u.Exp || 0);
        const valueUnit = isRacha ? ' Días' : ' XP';

        return `<div class="podium-column ${cls}">
                <div class="podium-player-card">
                    ${crown ? '<div class="crown-icon">👑</div>' : ''}
                    <div class="podium-avatar"><i class="fa-solid fa-user"></i></div>
                    <div class="podium-name">${u.Nombre}</div>
                    <div class="podium-xp">${formatNumber(valueToDisplay)}${valueUnit}</div>
                </div>
                ${rankNumberHtml}
                <div class="podium-block">${crown ? '<div class="shine-effect"></div>' : ''}</div>
            </div>`;
    }

     // ==========================================
    // LÓGICA DE FILTRADO AJAX Y SINCRONIZACIÓN (CENTRAL)
    // ==========================================
 
    function filtrarRankingDashboard(periodo, button, isModal = false) {
        const catActual = dashData[dashIndex];
        if (!catActual || !catActual.Titulo) return;

        // 1. Determinar la cantidad de registros a solicitar (10 para dash, 50 si el modal está abierto)
        const modalAbierto = (document.getElementById('modalRankingGlobal').style.display === 'flex');
        // Si el modal está abierto, pedimos el Top 50, si no, solo el Top 10 para el dashboard.
        const cantidadSolicitada = modalAbierto ? 50 : 10;

        // 1.1 Marcar el botón activo del DASHBOARD (Solo si viene del Dashboard directamente)
        if (!isModal && button) {
            document.querySelectorAll('#dashFilters .filter-btn').forEach(btn => btn.classList.remove('active'));
            button.classList.add('active');
        }

        // ⭐️ LÓGICA DE RESTAURACIÓN GLOBAL ⭐️
        if (periodo === 'Global') {
            // Evita recargar si ya estamos en Global y no es una llamada de sincronización forzada desde el modal
            if (dashPeriodo === 'Global' && !isModal) return;

            dashPeriodo = 'Global';

            const originalSlide = dashOriginalData[dashIndex];

            // Dashboard: Restaura el Top 10 original (Global)
            catActual.Datos = originalSlide.Datos;
            catActual.Titulo = originalSlide.Titulo;

            renderDashboard();

            // === SINCRONIZACIÓN MODAL ===
            if (rankingCompletoCargado && modalAbierto) {
                // El modal debe usar la DATA GLOBAL COMPLETA (Top 50+) de su copia de seguridad inicial.
                const modalOriginalData = modalData[modalIndex].Datos;

                modalData[modalIndex].Filtrados = modalOriginalData;
                renderModal();

                // Asegurar que el filtro Global en el modal esté activo visualmente
                document.querySelectorAll('#modalFilters .filter-btn').forEach(btn => btn.classList.remove('active'));
                document.querySelector(`#modalFilters .filter-btn[data-periodo="Global"]`).classList.add('active');
            }
            return;
        }

        // Si el periodo es el mismo Y la cantidad solicitada es Top 10, no recargamos.
        // Se permite recargar si el filtro es el mismo pero se acaba de abrir el modal (isModal=true)
        if (dashPeriodo === periodo && cantidadSolicitada === 10 && !isModal) return;

        // 2. Establecer el nuevo periodo y preparar caché
        const actividadNombre = catActual.Titulo.replace('📊 ', '').replace('🌍 ', '').trim();
        // La clave de caché incluye la cantidad para diferenciar Top 10 Mensual de Top 50 Mensual.
        const cacheKey = `${actividadNombre}_${periodo}_${cantidadSolicitada}`;
        dashPeriodo = periodo;

        const dashContainer = document.getElementById('dashTableContainer');
        const modalContainer = document.getElementById('modalContentContainer');


        // 3. Usar caché si está disponible
        if (dashCache[cacheKey]) {
            const dataFromCache = dashCache[cacheKey];

            // DASHBOARD: Solo Top 10
            catActual.Datos = dataFromCache.Datos.slice(0, 10);
            renderDashboard();
            document.getElementById('lblDashTitle').innerText = dataFromCache.Titulo;

            // === SINCRONIZACIÓN MODAL (desde caché) ===
            if (rankingCompletoCargado && modalAbierto) {
                 // MODAL: Usa todos los datos del caché (que serán 50 si se guardó así)
                 modalData[modalIndex].Filtrados = dataFromCache.Datos;
                 renderModal();
            }
            return;
        }

        // 4. Si no está en caché, llamar a AJAX y mostrar spinners
        dashContainer.innerHTML = '<div class="loading-state"><i class="fa-solid fa-circle-notch fa-spin"></i> Cargando...</div>';
        if (modalAbierto) {
            modalContainer.innerHTML = '<div class="loading-state"><i class="fa-solid fa-circle-notch fa-spin"></i> Cargando datos completos...</div>';
        }

        // Llamada AJAX
        fetch(`@Url.Action("ObtenerRankingFiltrado", "Dashboard")?periodo=${periodo}&actividad=${actividadNombre}&cantidad=${cantidadSolicitada}`)
            .then(r => {
                 if (!r.ok) {
                     // Manejar errores HTTP
                     throw new Error(`Error HTTP: ${r.status}`);
                 }
                 return r.json();
            })
            .then(data => {
                 if (!data.Datos || data.Datos.length === 0) {
                      // Manejo de no datos
                      dashContainer.innerHTML = '<div class="no-data" style="text-align:center; padding:1rem;">Aún no hay registros en este periodo.</div>';
                      document.getElementById('lblDashTitle').innerText = data.Titulo || catActual.Titulo + ` (${periodo})`;
                      if (modalAbierto) {
                          modalContainer.innerHTML = '<div class="no-data" style="text-align:center; padding:1rem;">Aún no hay registros en este periodo.</div>';
                      }
                      return;
                 }

                 // Pre-procesar Ranking Filtrado (RankOriginal)
                 data.Datos.forEach((u, i) => u.RankOriginal = i + 1);

                 // Almacenar en la caché
                 dashCache[cacheKey] = data;

                 // DASHBOARD: Actualizar los datos del slide activo (solo Top 10)
                 catActual.Datos = data.Datos.slice(0, 10);
                 renderDashboard();
                 document.getElementById('lblDashTitle').innerText = data.Titulo;

                 // === SINCRONIZACIÓN MODAL (desde AJAX) ===
                 if (rankingCompletoCargado && modalAbierto) {
                     // MODAL: Usa todos los datos devueltos por la API (Top 50)
                     modalData[modalIndex].Filtrados = data.Datos;
                     renderModal();
                 }
            })
            .catch(e => {
                 // Manejo de errores de conexión/JSON
                 dashContainer.innerHTML = `<div class="no-data">Error al cargar el ranking ${periodo}.</div>`;
                 if (modalAbierto) {
                     modalContainer.innerHTML = `<div class="no-data">Error al cargar el ranking completo ${periodo}.</div>`;
                 }
                 console.error("Error al cargar ranking filtrado:", e);
            });
    }

    function renderDashboard() {
        const cat = dashData[dashIndex];
        const isRacha = cat.Titulo.includes("Racha"); // Detectamos el tipo de slide

        // 1. GESTIÓN DE BOTONES DE FILTRO
        const filterContainer = document.getElementById('dashFilters');
        const filterButtons = filterContainer.querySelectorAll('.filter-btn');

        if (isRacha) {
            filterContainer.style.display = 'none';

        } else {
            // Mostrar los botones si no es Racha
            filterContainer.style.display = 'flex';

            // Asegurarse de que el botón activo actual esté marcado
            filterButtons.forEach(btn => {
                if (btn.dataset.periodo === dashPeriodo) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });
        }

        // 1. Separar TOP 3 del RESTO
        const top3 = cat.Datos.filter(u => u.RankOriginal <= 3);
        const restOfPlayers = cat.Datos.filter(u => u.RankOriginal > 3);

        // Animación Texto
        const tituloEl = document.getElementById('lblDashTitle');
        const subEl = document.getElementById('lblDashSubtitle');
        tituloEl.style.opacity = 0; subEl.style.opacity = 0;

        setTimeout(() => {
            tituloEl.innerText = cat.Titulo;
            // Subtítulo condicional
            if (isRacha) {
                subEl.innerText = "Los jugadores con la racha de días más larga";
            } else {
                subEl.innerText = cat.Titulo.includes("Global") ? "Los jugadores con más experiencia total" : "Top jugadores en esta actividad";
            }
            tituloEl.style.opacity = 1; subEl.style.opacity = 1;
        }, 150);

        const container = document.getElementById('dashTableContainer');
        let html = '';

        if (!cat.Datos || cat.Datos.length === 0) {
            container.innerHTML = '<div class="no-data" style="text-align:center; padding:1rem;">Aún no hay registros.</div>';
            return;
        }

        // 2. GENERAR EL PODIO (ya usa getPodiumHtml, que ahora es condicional)
        if (top3.length > 0) {
            let p1 = top3.find(u => u.RankOriginal === 1);
            let p2 = top3.find(u => u.RankOriginal === 2);
            let p3 = top3.find(u => u.RankOriginal === 3);

            html += `<div class="podium-container">`;
            if(p2) html += getPodiumHtml(p2, 'second-place');
            if(p1) html += getPodiumHtml(p1, 'first-place', true);
            if(p3) html += getPodiumHtml(p3, 'third-place');
            html += `</div>`;
        }

        // 3. GENERAR LA LISTA (4 al 10)
        html += '<div class="ranking-list-container" style="padding: 0;">';

        const jugadoresParaLista = top3.length === 0 ? cat.Datos : restOfPlayers;

        jugadoresParaLista.forEach(user => {
            // Valores para la lista condicional
            const valueToDisplay = isRacha ? user.Racha : user.Exp;
            const valueUnit = isRacha ? ' Días' : ' XP';

            const rankClass = getRankClassFromRankName(user.Rango_Actual);
            const rankDisplay = user.Rango_Actual;

            const isMe = user.Id_Usuario === myUserId ? 'background: rgba(76, 76, 255, 0.15); border-left: 3px solid var(--color-primary);' : '';
            html += `
            <div class="list-row" style="padding: 0.8rem 1rem; grid-template-columns: 40px 1fr 100px; ${isMe}">
                <div class="list-rank" style="color:var(--color-primary); font-weight:bold;">#${user.RankOriginal}</div>
                <div class="list-player" style="display:flex; gap:10px; align-items:center;">
                    <div class="list-avatar-small" style="width:30px; height:30px;"><i class="fa-solid fa-user"></i></div>
                    <div class="list-info">
                        <span class="list-name" style="font-size:0.9rem;">${user.Nombre}</span>
                        <span class="list-name" style="font-size:0.7rem; font-weight:500; font-style:italic;">${user.Gamer_Tag}</span>
                        <span class="list-tag" style="font-size:0.7rem;">
                            <span class="level-badge ${rankClass}" style="display: flex; justify-content: center; align-items: center; margin-top: 0.5rem; width: fit-content;">${rankDisplay}</span>
                        </span>
                    </div>
                </div>
                <div class="list-xp-col" style="text-align:right;">
                    <div class="xp-text">${formatNumber(valueToDisplay)}${valueUnit}</div>
                </div>
            </div>`;
        });

        html += '</div>';
        container.innerHTML = html;
    }

    // ==========================================
    // LÓGICA DEL MODAL (SLIDER GRANDE)
    // ==========================================

    function abrirModalDesdeDashboard() {
        const modal = document.getElementById('modalRankingGlobal');
        modal.style.display = 'flex';

        // 1. Sincronizar índice inicial del slide y limpiar búsqueda
        modalIndex = dashIndex;
        document.getElementById('inputBusquedaRanking').value = "";

         const catActual = dashData[dashIndex]; // Ojo, usamos dashData, pero el título será el mismo que modalData[modalIndex].Titulo si está cargado
         const isRacha = catActual && catActual.Titulo.includes("Racha");
         document.getElementById('modalFilters').style.display = isRacha ? 'none' : 'flex';

        // 2. SINCRONIZAR FILTROS DEL MODAL con el estado actual del DASHBOARD (dashPeriodo)
        document.querySelectorAll('#modalFilters .filter-btn').forEach(btn => btn.classList.remove('active'));
        const modalActiveBtn = document.querySelector(`#modalFilters .filter-btn[data-periodo="${dashPeriodo}"]`);
        if (modalActiveBtn) {
            modalActiveBtn.classList.add('active');
        }

        // Obtenemos el botón del dashboard (aunque la función filtrar lo usará solo para activar el estilo)
        const dashButton = document.querySelector(`#dashFilters .filter-btn[data-periodo="${dashPeriodo}"]`);

        if (!rankingCompletoCargado) {
            // 3. Carga inicial del modal (ObtenerRankingJson trae la data Global Top 50+)
            document.getElementById('modalContentContainer').innerHTML =
                '<div class="loading-state"><i class="fa-solid fa-circle-notch fa-spin"></i> Cargando datos completos...</div>';

            fetch('@Url.Action("ObtenerRankingJson", "Dashboard")')
                .then(r => r.json())
                .then(data => {
                    // Almacenar data global completa (base para el modal)
                    modalData = data.map(slide => {
                        const datosConRank = slide.Datos.map((u, i) => ({ ...u, RankOriginal: i + 1 }));
                        return {
                            Titulo: slide.Titulo,
                            Datos: datosConRank, // Data base completa (Global)
                            Filtrados: datosConRank // Data que se muestra actualmente
                        };
                    });
                    rankingCompletoCargado = true;
                    generarDots('modalDots', modalData.length, modalIndex);

                    // Después de la carga inicial (GLOBAL TOP 50):
                    // 3.1. Sincronizar con el filtro actual del Dashboard (si no es Global)
                    if (dashPeriodo !== 'Global') {
                         // Llamamos a filtrarRankingDashboard para cargar la data filtrada (Top 50)
                         filtrarRankingDashboard(dashPeriodo, dashButton, /* isModal = */ true);
                    } else {
                         // Si es Global, usamos la data inicial que acabamos de cargar
                         modalData[modalIndex].Filtrados = modalData[modalIndex].Datos;
                         renderModal();
                    }
                })
                .catch(e => {
                     document.getElementById('modalContentContainer').innerHTML = '<p class="no-data">Error cargando datos.</p>';
                     console.error("Error al cargar ranking completo:", e);
                });
        } else {
            // 4. Si ya estaba cargado, sincronizar la vista del modal con el estado actual (dashPeriodo)
            generarDots('modalDots', modalData.length, modalIndex);

            if (dashPeriodo !== 'Global') {
                // Si el dashboard está filtrado, forzamos la recarga/uso de caché de los datos FILTRADOS (Top 50)
                filtrarRankingDashboard(dashPeriodo, dashButton, /* isModal = */ true);
            } else {
                // Si es Global, mostramos la data Global sin filtrar (la copia de seguridad en modalData[modalIndex].Datos)
                modalData[modalIndex].Filtrados = modalData[modalIndex].Datos;
                renderModal();
            }
        }
    }

    function cerrarModalRanking() {
        document.getElementById('modalRankingGlobal').style.display = 'none';
    }

    function cambiarSlideModal(dir) {
        if(!rankingCompletoCargado) return;

        modalIndex += dir;
        if(modalIndex >= modalData.length) modalIndex = 0;
        if(modalIndex < 0) modalIndex = modalData.length - 1;

        // Limpiar búsqueda al cambiar
        document.getElementById('inputBusquedaRanking').value = "";


        modalData[modalIndex].Filtrados = modalData[modalIndex].Datos;
        dashPeriodo = 'Global';

         const isRacha = modalData[modalIndex].Titulo.includes("Racha");
         document.getElementById('modalFilters').style.display = isRacha ? 'none' : 'flex';

         if (!isRacha) {
             document.querySelectorAll('#modalFilters .filter-btn').forEach(btn => btn.classList.remove('active'));
             document.querySelector(`#modalFilters .filter-btn[data-periodo="Global"]`).classList.add('active');

             document.querySelectorAll('#dashFilters .filter-btn').forEach(btn => btn.classList.remove('active'));
             document.querySelector(`#dashFilters .filter-btn[data-periodo="Global"]`).classList.add('active');
         }

        renderModal();
        actualizarDots('modalDots', modalIndex);
    }

    function renderModal() {
        const cat = modalData[modalIndex];

        // Titulo Modal
        const titEl = document.getElementById('lblModalTitle');
        titEl.style.opacity = 0;
        setTimeout(() => { titEl.innerText = cat.Titulo; titEl.style.opacity = 1; }, 100);

        construirTablaModal(cat.Filtrados);
    }

    function filtrarRankingModal() {
        const txt = document.getElementById('inputBusquedaRanking').value.toLowerCase();
        const cat = modalData[modalIndex];

        cat.Filtrados = cat.Datos.filter(u =>
            u.Nombre.toLowerCase().includes(txt) ||
            (u.Gamer_Tag && u.Gamer_Tag.toLowerCase().includes(txt))
        );

        construirTablaModal(cat.Filtrados);
    }


    // ==========================================
    // LÓGICA DEL MODAL (SIN PODIO)
    // ==========================================

    function construirTablaModal(usuarios) {
        const container = document.getElementById('modalContentContainer');
        const cat = modalData[modalIndex];
        const isRacha = cat.Titulo.includes("Racha"); // Detectamos el tipo de slide

        if (!usuarios || usuarios.length === 0) {
            container.innerHTML = '<div class="loading-state">No hay resultados.</div>';
            return;
        }

        let html = '<div class="ranking-list-container" style="background:transparent; padding:0;">';

        // Definir el estilo de la grilla (oculta la columna de badge si es racha)
        const gridStyle = isRacha
            ? 'grid-template-columns: 50px 1.5fr 1fr;'
            : 'grid-template-columns: 50px 1.5fr 100px 1fr;';

        usuarios.forEach(u => {
            const isMe = u.Id_Usuario === myUserId ? 'current-user-row' : '';

            // MANEJO CONDICIONAL DE VALORES Y COLUMNAS
            const valueToDisplay = isRacha ? u.Racha : u.Exp;
            const valueUnit = isRacha ? ' Días' : ' XP';
            const xpText = `${formatNumber(valueToDisplay || 0)}${valueUnit}`;
            const pct = isRacha ? 0 : (u.Exp % 20000) * 100 / 20000;

            // Rango desde el servidor
            const rankClass = getRankClassFromRankName(u.Rango_Actual);
            const rankDisplay = u.Rango_Actual;

            // Contenido de la columna de valor (solo valor si es racha, valor + barra si es XP)
            const valueContent = isRacha ?
                `<div class="xp-text" style="font-size: 1rem; color: var(--color-primary);">${xpText}</div>` :
                `
                <div class="xp-text">${xpText}</div>
                <div class="exp-bar-bg"><div class="exp-bar-fill" style="width: ${pct}%"></div></div>
                `;

            // Columna de Badge (oculta si es racha) - CORREGIDO
            const badgeCol = isRacha ? '' : `
                <div class="list-badge-col">
                    <div class="level-badge ${rankClass}">${rankDisplay}</div>
                </div>
            `;
            // FIN MANEJO CONDICIONAL

            html += `
                <div class="list-row ${isMe}" style="${gridStyle}">
                    <div class="list-rank">#${u.RankOriginal}</div>
                    <div class="list-player">
                        <div class="list-avatar-small"><i class="fa-solid fa-user"></i></div>
                        <div class="list-info">
                            <span class="list-name">${u.Nombre}</span>
                            <span class="list-tag">${u.Gamer_Tag || '--'}</span>
                        </div>
                    </div>
                    ${badgeCol}
                    <div class="list-xp-col" style="${isRacha ? 'text-align: right;' : ''}">
                        ${valueContent}
                    </div>
                </div>`;
        });

        html += '</div>';
        container.innerHTML = html;
    }

    // --- HELPERS ---
    function formatNumber(n) { return n ? n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",") : "0"; }

    function getRankClassFromRankName(rankName) {
        if (!rankName) return "bronze";
        if (rankName.includes("Materia Oscura")) return "dark-matter";
        if (rankName.includes("Heroico")) return "heroic";
        if (rankName.includes("Diamante")) return "diamond";
        if (rankName.includes("Oro")) return "gold";
        if (rankName.includes("Plata")) return "silver";
        return "bronze";
    }

    function getPodiumHtml(u, cls, crown=false) {

        const isRacha = dashData[dashIndex] && dashData[dashIndex].Titulo.includes("Racha");

        let rankNumber = '';
        if (cls === 'first-place') {
            rankNumber = '1';
        } else if (cls === 'second-place') {
            rankNumber = '2';
        } else if (cls === 'third-place') {
            rankNumber = '3';
        }

        const rankNumberHtml = rankNumber
            ? `<div class="podium-rank-number">${rankNumber}</div>`
            : '';

        const valueToDisplay = isRacha ? (u.Racha || 0) : (u.Exp || 0);
        const valueUnit = isRacha ? ' Días' : ' XP';

        return `<div class="podium-column ${cls}">
                <div class="podium-player-card">
                    ${crown ? '<div class="crown-icon">👑</div>' : ''}
                    <div class="podium-avatar"><i class="fa-solid fa-user"></i></div>
                    <div class="podium-name">${u.Nombre}</div>
                    <span class="list-name" style="font-size:0.7rem; font-weight:500; font-style:italic;">${u.Gamer_Tag}</span>
                    <div class="podium-xp">${formatNumber(valueToDisplay)}${valueUnit}</div>
                </div>
                ${rankNumberHtml}
                <div class="podium-block">${crown ? '<div class="shine-effect"></div>' : ''}</div>
            </div>`;
    }

    function generarDots(containerId, count, activeIdx) {
        const c = document.getElementById(containerId);
        if(!c) return;
        c.innerHTML = '';
        for(let i=0; i<count; i++) {
            c.innerHTML += `<div class="dot ${i===activeIdx?'active':''}"></div>`;
        }
    }
    function actualizarDots(containerId, activeIdx) {
        const dots = document.querySelectorAll(`#${containerId} .dot`);
        dots.forEach((d, i) => {
            if(i === activeIdx) d.classList.add('active');
            else d.classList.remove('active');
        });
    }

    window.onclick = function(event) {
        if (event.target == document.getElementById('modalRankingGlobal')) cerrarModalRanking();
    }

   function sincronizarFiltro(periodo, button) {

        document.querySelectorAll('#modalFilters .filter-btn').forEach(btn => btn.classList.remove('active'));
        button.classList.add('active');

        const dashButton = document.querySelector(`#dashFilters .filter-btn[data-periodo="${periodo}"]`);

        filtrarRankingDashboard(periodo, dashButton, true);
    }
</script>

