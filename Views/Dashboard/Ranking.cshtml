@using AnzanMegaArithmetics.Models
@model AnzanMegaArithmetics.Models.LoginResponseModel
@{
    ViewBag.Title = "Ranking";
    Layout = "_LayoutDashboard";
}

<div class="user-top-info">
    <div class="user-left-section">
        <div class="user-name">@Model.Nombre</div>
        <div class="user-meta-row">
            <span class="gamertag"><i class="fa-solid fa-gamepad"></i> <strong>Gamertag:</strong> @Model.Gamer_Tag</span>
            <span class="license"><i class="fa-solid fa-id-card"></i> <strong>Licencia:</strong> @Model.Licencia</span>
            <span class="license"><i class="fa-solid fa-landmark"></i> <strong>Tus clases:</strong> @string.Join(", ", Model.Clases)</span>
        </div>
    </div>
    <div class="user-right-section">
        <div class="last-connection"><i class="fa-solid fa-clock"></i> Última conexión: @Model.Ultima_Cnx</div>
    </div>
</div>

<div class="dashboard-top">
    <div class="user-welcome-card">
        <div class="welcome-container">
            <div class="speech-bubble">@Model.Frase_Bienvenida</div>
            <div class="character-section">
                <img src="/Content/Images/ProfS.png" alt="Profesor saludando" class="professor-img" />
                <p class="character-name"><strong>Jerry</strong></p>
            </div>
        </div>
    </div>
    <div class="user-info-card">
        <div class="contenedorR">
            <div class="R3"><p class="txt"><strong>🔥<br />@Model.Racha</strong></p></div>
            <div class="R2"><p class="txt"><strong>🎖️<br />Bronce I</strong></p></div>
            <div class="R1"><p class="txt"><strong>✨<br /><span id="xp-counter">@Model.Exp</span></strong></p></div>
        </div>
        <div class="xp-progress-container">
            <div class="xp-bar">
                <div class="xp-progress" id="xp-progress-bar" data-xp="@Model.Exp"></div>
            </div>
            <div class="xp-next-level">
                <i class="fas fa-arrow-up"></i>
                <span id="xp-next-level-text">Próximo nivel en: @(20000 - (Model.Exp % 20000)) XP</span>
            </div>
        </div>
    </div>
</div>

<div class="dashboard-bottom">
    <div class="global-ranking-container" id="rankingCardContainer">

        <div class="ranking-header" style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 1rem; margin-bottom: 1rem;">

            <button class="slider-nav-btn" onclick="cambiarSlideDashboard(-1)">
                <i class="fa-solid fa-chevron-left"></i>
            </button>

            <div style="text-align: center; flex: 1; overflow: hidden;">
                <h2 class="ranking-title slide-anim" id="lblDashTitle" style="font-size: 1.5rem; margin: 0;">Cargando...</h2>
                <div class="ranking-subtitle slide-anim" id="lblDashSubtitle" style="font-size: 0.85rem; color: #a0a0c0;">...</div>

                <div id="dashDots" class="slider-dots" style="justify-content: center; margin-top: 5px; display: flex; gap: 4px;"></div>
            </div>

            <button class="slider-nav-btn" onclick="cambiarSlideDashboard(1)">
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </div>

        <div id="dashTableContainer" class="ranking-list-container" style="min-height: 200px;">
            <div class="loading-state">
                <i class="fa-solid fa-circle-notch fa-spin"></i>
            </div>
        </div>

        <div class="view-all-container">
            <button type="button" class="btn-view-all" id="btnVerMasDash" onclick="abrirModalDesdeDashboard()">
                Ver Ranking Completo <i class="fa-solid fa-arrow-right"></i>
            </button>
        </div>
    </div>
</div>

<div id="modalRankingGlobal" class="custom-modal-overlay">
    <div class="custom-modal-content">
        <div class="custom-modal-header">
            <div class="header-top-row">
                <div class="slider-header-container">
                    <button class="slider-nav-btn" onclick="cambiarSlideModal(-1)">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>

                    <div class="slider-title-wrapper">
                        <h3 id="lblModalTitle" class="slider-title">Ranking</h3>
                        <div id="modalDots" class="slider-dots" style="justify-content:center; display:flex; gap:4px; margin-top:4px;"></div>
                    </div>

                    <button class="slider-nav-btn" onclick="cambiarSlideModal(1)">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>

                <button class="close-modal-btn" onclick="cerrarModalRanking()">&times;</button>
            </div>

            <div class="search-container">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input type="text"
                       id="inputBusquedaRanking"
                       class="search-input"
                       placeholder="Buscar jugador en esta lista..."
                       onkeyup="filtrarRankingModal()">
            </div>
        </div>
        <div class="custom-modal-body">
            <div id="modalContentContainer">
                <div class="loading-state">
                    <i class="fa-solid fa-circle-notch fa-spin"></i> Cargando datos completos...
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // --- VARIABLES GLOBALES ---
    const myUserId = @Model.Id_Usuario;

    // 1. Datos del Dashboard (Top 10) - Vienen directo del Controller
    let dashData = @Html.Raw(ViewBag.RankingJson ?? "[]");
    let dashIndex = 0;

    // 2. Datos del Modal (Top 50) - Se cargarán via AJAX
    let modalData = [];
    let modalIndex = 0;
    let rankingCompletoCargado = false;

    // --- AL INICIAR LA PÁGINA ---
    document.addEventListener("DOMContentLoaded", function() {
        if(dashData && dashData.length > 0) {
            // Pre-procesar Ranking Original (1, 2, 3...)
            dashData.forEach(cat => {
                cat.Datos.forEach((u, i) => u.RankOriginal = i + 1);
            });
            renderDashboard();
            generarDots('dashDots', dashData.length, dashIndex);
        } else {
            document.getElementById('dashTableContainer').innerHTML = '<div class="no-data" style="text-align:center; padding:2rem;">Sin datos.</div>';
        }
    });

    // ==========================================
    // LÓGICA DEL DASHBOARD (SLIDER PEQUEÑO)
    // ==========================================
    function cambiarSlideDashboard(dir) {
        dashIndex += dir;
        if(dashIndex >= dashData.length) dashIndex = 0;
        if(dashIndex < 0) dashIndex = dashData.length - 1;

        renderDashboard();
        actualizarDots('dashDots', dashIndex);
    }

        // ==========================================
    // LÓGICA DEL DASHBOARD (SLIDER PEQUEÑO)
    // ==========================================

    // Helper para generar el HTML del podio (reutilizado)
    function getPodiumHtml(u, cls, crown=false) {
        // [Se mantiene exactamente igual que en el helper]
        return `<div class="podium-column ${cls}">
            <div class="podium-player-card">
                ${crown ? '<div class="crown-icon">👑</div>' : ''}
                <div class="podium-avatar"><i class="fa-solid fa-user"></i></div>
                <div class="podium-name">${u.Nombre}</div>
                <div class="podium-xp">${formatNumber(u.Exp)} XP</div>
            </div>
            <div class="podium-block">${crown ? '<div class="shine-effect"></div>' : ''}</div>
        </div>`;
    }

    function renderDashboard() {
        const cat = dashData[dashIndex];

        // 1. Separar TOP 3 del RESTO
        const top3 = cat.Datos.filter(u => u.RankOriginal <= 3);
        const restOfPlayers = cat.Datos.filter(u => u.RankOriginal > 3);

        // Animación Texto
        const tituloEl = document.getElementById('lblDashTitle');
        const subEl = document.getElementById('lblDashSubtitle');
        tituloEl.style.opacity = 0; subEl.style.opacity = 0;

        setTimeout(() => {
            tituloEl.innerText = cat.Titulo;
            subEl.innerText = cat.Titulo.includes("Global") ? "Los jugadores con más experiencia total" : "Top jugadores en esta actividad";
            tituloEl.style.opacity = 1; subEl.style.opacity = 1;
        }, 150);

        const container = document.getElementById('dashTableContainer');
        let html = '';

        if (!cat.Datos || cat.Datos.length === 0) {
            container.innerHTML = '<div class="no-data" style="text-align:center; padding:1rem;">Aún no hay registros.</div>';
            return;
        }

        // 2. GENERAR EL PODIO (SOLO EN EL DASHBOARD)
        if (top3.length > 0) {
            let p1 = top3.find(u => u.RankOriginal === 1);
            let p2 = top3.find(u => u.RankOriginal === 2);
            let p3 = top3.find(u => u.RankOriginal === 3);

            html += `<div class="podium-container">`;
            if(p2) html += getPodiumHtml(p2, 'second-place');
            if(p1) html += getPodiumHtml(p1, 'first-place', true);
            if(p3) html += getPodiumHtml(p3, 'third-place');
            html += `</div>`;
        }

        // 3. GENERAR LA LISTA (SOLO LOS PUESTOS DEL 4 al 10)
        html += '<div class="ranking-list-container" style="padding: 0;">';

        // Si no hay podio, mostramos al menos 10 filas, si hay podio, mostramos el resto.
        const jugadoresParaLista = top3.length === 0 ? cat.Datos : restOfPlayers;

        jugadoresParaLista.forEach(user => {
            const isMe = user.Id_Usuario === myUserId ? 'background: rgba(76, 76, 255, 0.15); border-left: 3px solid var(--color-primary);' : '';
            html += `
            <div class="list-row" style="padding: 0.8rem 1rem; grid-template-columns: 40px 1fr 100px; ${isMe}">
                <div class="list-rank" style="color:var(--color-primary); font-weight:bold;">#${user.RankOriginal}</div>
                <div class="list-player" style="display:flex; gap:10px; align-items:center;">
                    <div class="list-avatar-small" style="width:30px; height:30px;"><i class="fa-solid fa-user"></i></div>
                    <div class="list-info">
                        <span class="list-name" style="font-size:0.9rem;">${user.Nombre}</span>
                        <span class="list-tag" style="font-size:0.7rem;">${user.Gamer_Tag || ''}</span>
                    </div>
                </div>
                <div class="list-xp-col" style="text-align:right;">
                    <div class="xp-text">${formatNumber(user.Exp)} XP</div>
                </div>
            </div>`;
        });

        html += '</div>';
        container.innerHTML = html;
    }

    // ==========================================
    // LÓGICA DEL MODAL (SLIDER GRANDE)
    // ==========================================

    // Abre el modal y sincroniza con la categoría que estabas viendo
    function abrirModalDesdeDashboard() {
        const modal = document.getElementById('modalRankingGlobal');
        modal.style.display = 'flex';

        // Sincronizar índice inicial
        modalIndex = dashIndex;

        if (!rankingCompletoCargado) {
            fetch('@Url.Action("ObtenerRankingJson", "Dashboard")')
                .then(r => r.json())
                .then(data => {
                    modalData = data.map(slide => {
                        const datosConRank = slide.Datos.map((u, i) => ({ ...u, RankOriginal: i + 1 }));
                        return {
                            Titulo: slide.Titulo,
                            Datos: datosConRank,
                            Filtrados: datosConRank
                        };
                    });
                    rankingCompletoCargado = true;
                    generarDots('modalDots', modalData.length, modalIndex);
                    renderModal();
                })
                .catch(e => {
                    document.getElementById('modalContentContainer').innerHTML = '<p class="no-data">Error cargando datos.</p>';
                });
        } else {
            // Si ya estaba cargado, solo actualizamos la vista al índice correcto
            generarDots('modalDots', modalData.length, modalIndex);
            renderModal();
        }
    }

    function cerrarModalRanking() {
        document.getElementById('modalRankingGlobal').style.display = 'none';
    }

    function cambiarSlideModal(dir) {
        if(!rankingCompletoCargado) return;

        modalIndex += dir;
        if(modalIndex >= modalData.length) modalIndex = 0;
        if(modalIndex < 0) modalIndex = modalData.length - 1;

        // Limpiar búsqueda al cambiar
        document.getElementById('inputBusquedaRanking').value = "";
        modalData[modalIndex].Filtrados = modalData[modalIndex].Datos;

        renderModal();
        actualizarDots('modalDots', modalIndex);
    }

    function renderModal() {
        const cat = modalData[modalIndex];

        // Titulo Modal
        const titEl = document.getElementById('lblModalTitle');
        titEl.style.opacity = 0;
        setTimeout(() => { titEl.innerText = cat.Titulo; titEl.style.opacity = 1; }, 100);

        construirTablaModal(cat.Filtrados);
    }

    function filtrarRankingModal() {
        const txt = document.getElementById('inputBusquedaRanking').value.toLowerCase();
        const cat = modalData[modalIndex];

        cat.Filtrados = cat.Datos.filter(u =>
            u.Nombre.toLowerCase().includes(txt) ||
            (u.Gamer_Tag && u.Gamer_Tag.toLowerCase().includes(txt))
        );

        construirTablaModal(cat.Filtrados);
    }

        // ==========================================
    // LÓGICA DEL MODAL (SIN PODIO)
    // ==========================================

    function construirTablaModal(usuarios) {
        const container = document.getElementById('modalContentContainer');

        if (!usuarios || usuarios.length === 0) {
            container.innerHTML = '<div class="loading-state">No hay resultados.</div>';
            return;
        }

        // En el modal, solo queremos la lista completa.
        let html = '<div class="ranking-list-container" style="background:transparent; padding:0;">';

        // La lista itera sobre TODOS los usuarios (del 1 al 50+)
        usuarios.forEach(u => {
             const isMe = u.Id_Usuario === myUserId ? 'current-user-row' : '';
             const pct = (u.Exp % 20000) * 100 / 20000;

             html += `
                <div class="list-row ${isMe}">
                    <div class="list-rank">#${u.RankOriginal}</div>
                    <div class="list-player">
                        <div class="list-avatar-small"><i class="fa-solid fa-user"></i></div>
                        <div class="list-info">
                            <span class="list-name">${u.Nombre}</span>
                            <span class="list-tag">${u.Gamer_Tag || '--'}</span>
                        </div>
                    </div>
                    <div class="list-badge-col">
                        <div class="level-badge ${getRankBadgeClass(u.Exp)}">${getRankName(u.Exp)}</div>
                    </div>
                    <div class="list-xp-col">
                        <div class="xp-text">${formatNumber(u.Exp)} XP</div>
                        <div class="exp-bar-bg"><div class="exp-bar-fill" style="width: ${pct}%"></div></div>
                    </div>
                </div>`;
        });

        html += '</div>';
        container.innerHTML = html;
    }

    // --- HELPERS ---
    function formatNumber(n) { return n ? n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",") : "0"; }

    function getPodiumHtml(u, cls, crown=false) {
        return `<div class="podium-column ${cls}">
            <div class="podium-player-card">
                ${crown ? '<div class="crown-icon">👑</div>' : ''}
                <div class="podium-avatar"><i class="fa-solid fa-user"></i></div>
                <div class="podium-name">${u.Nombre}</div>
                <div class="podium-xp">${formatNumber(u.Exp)} XP</div>
            </div>
            <div class="podium-block">${crown ? '<div class="shine-effect"></div>' : ''}</div>
        </div>`;
    }

    function generarDots(containerId, count, activeIdx) {
        const c = document.getElementById(containerId);
        if(!c) return;
        c.innerHTML = '';
        for(let i=0; i<count; i++) {
            c.innerHTML += `<div class="dot ${i===activeIdx?'active':''}"></div>`;
        }
    }
    function actualizarDots(containerId, activeIdx) {
        const dots = document.querySelectorAll(`#${containerId} .dot`);
        dots.forEach((d, i) => {
            if(i === activeIdx) d.classList.add('active');
            else d.classList.remove('active');
        });
    }

    // Tus funciones GetRankName / GetRankBadgeClass originales
    function getRankBadgeClass(exp) { if (exp >= 500000) return "dark-matter"; if (exp >= 260001) return "heroic"; if (exp >= 180001) return "diamond"; if (exp >= 120001) return "gold"; if (exp >= 60001) return "silver"; return "bronze"; }
    function getRankName(exp) { if (exp > 1000000) return "☄️ Materia Oscura III"; if (exp >= 500000) return "☄️ Materia I"; if (exp >= 220001) return "💎 Diamante"; if (exp >= 120001) return "🥇 Oro"; if (exp >= 40001) return "🥉 Bronce"; return "🥉 Bronce I"; }

    window.onclick = function(event) {
        if (event.target == document.getElementById('modalRankingGlobal')) cerrarModalRanking();
    }
</script>

<style>
    /* Estilos Optimizado para las Flechas de Navegación */
    .slider-nav-btn {
        /* Fondo semi-transparente para integrarse al ambiente oscuro */
        background: rgba(255, 255, 255, 0.05);
        /* Borde sutil */
        border: 1px solid rgba(76, 76, 255, 0.3);
        /* Color principal azul que usas */
        color: var(--color-primary, #4facfe);
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 1rem;
        /* Suavizado en las transiciones */
        transition: all 0.3s ease-in-out;
        /* Sombra sutil para darle profundidad */
        box-shadow: 0 0 5px rgba(0, 0, 0, 0.5);
    }

        /* Efecto Hover: Brillo y color más intenso */
        .slider-nav-btn:hover {
            background: var(--color-primary, #4facfe);
            color: white;
            box-shadow: 0 0 15px rgba(76, 76, 255, 0.7);
        }

        .slider-header-container{
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }

    /* Estilos de los Dots (indicadores inferiores) - Asegurarse que se vean bien */
    .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: rgba(255,255,255,0.2);
        transition: background-color 0.3s, box-shadow 0.3s;
    }

        .dot.active {
            background-color: var(--color-primary, #4facfe);
            box-shadow: 0 0 5px var(--color-primary, #4facfe);
        }
    /* Estilos para el Buscador en Modal */
    .header-top-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        margin-bottom: 1rem;
    }

    .search-container {
        position: relative;
        width: 100%;
        max-width: 100%;
    }

    .search-input {
        width: 100%;
        padding: 0.8rem 1rem 0.8rem 2.8rem; /* Espacio a la izq para el icono */
        border-radius: 2rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background-color: rgba(0, 0, 0, 0.2);
        color: white;
        font-size: 0.95rem;
        outline: none;
        transition: all 0.3s ease;
    }

        .search-input:focus {
            background-color: rgba(0, 0, 0, 0.4);
            border-color: var(--color-primary);
            box-shadow: 0 0 10px rgba(76, 76, 255, 0.2);
        }

        .search-input::placeholder {
            color: #a0a0c0;
        }

    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--color-primary);
        font-size: 1rem;
        pointer-events: none; /* Para que el clic pase al input */
    }
    .view-all-container {
        display: flex;
        justify-content: center;
        padding-top: 1rem;
        border-top: 1px solid rgba(255,255,255,0.1);
        margin-top: 0.5rem;
    }

    .btn-view-all {
        background: transparent;
        border: 2px solid var(--color-primary, #4facfe);
        color: #fff;
        padding: 0.5rem 1.5rem;
        border-radius: 20px;
        cursor: pointer;
        font-weight: bold;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

        .btn-view-all:hover {
            background: var(--color-primary, #4facfe);
            box-shadow: 0 0 15px rgba(79, 172, 254, 0.4);
            transform: translateY(-2px);
        }

    .custom-modal-overlay {
        display: none; /* Oculto por defecto */
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        /* Fondo oscuro basado en tu header con transparencia */
        background-color: rgba(1, 15, 54, 0.85);
        z-index: 9999;
        backdrop-filter: blur(4px);
        justify-content: center;
        align-items: center;
        animation: fadeIn 0.3s;
    }

    .custom-modal-content {
        background-color: var(--color-card-bg); /* #010f36 */
        color: var(--color-light);
        width: 90%;
        max-width: 800px;
        height: 85vh;
        border-radius: 1rem;
        border: 1px solid var(--color-hover); /* #3b3c8f */
        box-shadow: 0 10px 40px rgba(0,0,0,0.6);
        display: flex;
        flex-direction: column;
    }

    .custom-modal-header {
        padding: 1.5rem;
        border-bottom: 2px solid var(--color-hover);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: rgba(0,0,0,0.2);
        border-top-left-radius: 1rem;
        border-top-right-radius: 1rem;
        display: flex;
        flex-direction: column;
    }

        .custom-modal-header h3 {
            margin: 0;
            color: #ffffff;
            font-size: 1.5rem;
            font-weight: 600;
        }

    .close-modal-btn {
        background: transparent;
        border: none;
        padding: 0;
        margin: 0;
        color: var(--color-light);
        font-size: 2rem;
        font-weight: normal;
        line-height: 1;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px; 
        height: 40px; 
        overflow: hidden;

        transition: color 0.2s, transform 0.2s;
    }

        .close-modal-btn:hover {
            color: var(--color-danger);
        }

    .custom-modal-body {
        flex: 1;
        overflow-y: auto;
        padding: 0; /* Sin padding para que la lista toque los bordes */
    }

        /* Scrollbar del Modal */
        .custom-modal-body::-webkit-scrollbar {
            width: 8px;
        }

        .custom-modal-body::-webkit-scrollbar-track {
            background: var(--color-sidebar);
        }

        .custom-modal-body::-webkit-scrollbar-thumb {
            background: var(--color-primary);
            border-radius: 4px;
        }

            .custom-modal-body::-webkit-scrollbar-thumb:hover {
                background: var(--color-primary-dark);
            }

    .loading-state {
        text-align: center;
        padding: 3rem;
        color: var(--color-light);
        font-size: 1.2rem;
    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
    }

    to {
        opacity: 1;
    }

    }


    .ranking-list-container {
        background: rgba(0, 0, 0, 0.2);
        border-radius: 12px;
        padding: 0.5rem;
    }

    .list-row {
        display: grid;
        grid-template-columns: 50px 1.5fr 100px 1fr;
        align-items: center;
        gap: 1rem;
        padding: 0.8rem 1.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        transition: background 0.2s;
    }

        .list-row:last-child {
            border-bottom: none;
        }

        .list-row:hover {
            background-color: var(--color-hover); /* Efecto hover azulado */
        }

        .list-row.current-user-row {
            background: rgba(76, 76, 255, 0.15);
            border-left: 3px solid var(--color-primary);
        }

    .list-rank {
        font-weight: bold;
        color: var(--color-primary); /* #4c4cff */
