@using AnzanMegaArithmetics.Models
@model AnzanMegaArithmetics.Models.LoginResponseModel
@{
    ViewBag.Title = "Ranking";
    Layout = "_LayoutDashboard";
}

<div class="user-top-info">
    <div class="user-left-section">
        <div class="user-name">@Model.Nombre</div>
        <div class="user-meta-row">
            <span class="gamertag"><i class="fa-solid fa-gamepad"></i> <strong>Gamertag:</strong> @Model.Gamer_Tag</span>
            <span class="license"><i class="fa-solid fa-id-card"></i> <strong>Licencia:</strong> @Model.Licencia</span>
            <span class="license"><i class="fa-solid fa-landmark"></i> <strong>Tus clases:</strong> @string.Join(", ", Model.Clases)</span>
        </div>
    </div>
    <div class="user-right-section">
        <div class="last-connection"><i class="fa-solid fa-clock"></i> Última conexión: @Model.Ultima_Cnx</div>
    </div>
</div>

<div class="dashboard-top">
    <div class="user-welcome-card">
        <div class="welcome-container">
            <div class="speech-bubble">@Model.Frase_Bienvenida</div>
            <div class="character-section">
                <img src="/Content/Images/ProfS.png" alt="Profesor saludando" class="professor-img" />
                <p class="character-name"><strong>Jerry</strong></p>
            </div>
        </div>
    </div>
    <div class="user-info-card">
        <div class="contenedorR">
            <div class="R3"><p class="txt"><strong>🔥<br />@Model.Racha</strong></p></div>
            <div class="R2"><p class="txt"><strong>🎖️<br />Bronce I</strong></p></div>
            <div class="R1"><p class="txt"><strong>✨<br /><span id="xp-counter">@Model.Exp</span></strong></p></div>
        </div>
        <div class="xp-progress-container">
            <div class="xp-bar">
                <div class="xp-progress" id="xp-progress-bar" data-xp="@Model.Exp"></div>
            </div>
            <div class="xp-next-level">
                <i class="fas fa-arrow-up"></i>
                <span id="xp-next-level-text">Próximo nivel en: @(20000 - (Model.Exp % 20000)) XP</span>
            </div>
        </div>
    </div>
</div>

<div class="dashboard-bottom">
    <div class="global-ranking-container">
        <div class="ranking-header">
            <h2 class="ranking-title">🏆 Top Globales</h2>
            <div class="ranking-subtitle">Los jugadores con más experiencia en la plataforma</div>
        </div>

        @{
            var ranking = ViewBag.Ranking as List<AnzanMegaArithmetics.Models.RankingUsersModel>;
            var currentUserId = Model.Id_Usuario;

            // Funciones Helpers (C#) para la vista inicial
            string GetRankBadgeClass(int exp)
            {
                if (exp >= 500000) return "dark-matter";
                if (exp >= 260001 && exp <= 320000) return "heroic";
                if (exp >= 180001 && exp <= 260000) return "diamond";
                if (exp >= 120001 && exp <= 180000) return "gold";
                if (exp >= 60001 && exp <= 120000) return "silver";
                return "bronze";
            }
            string GetRankName(int exp)
            {
                if (exp > 1000000) return "☄️ Materia Oscura III";
                if (exp >= 750000) return "☄️ Materia Oscura II";
                if (exp >= 500000) return "☄️ Materia Oscura I";
                if (exp >= 300001) return "🔥 Heroico III";
                if (exp >= 280001) return "🔥 Heroico II";
                if (exp >= 260001) return "🔥 Heroico I";
                if (exp >= 220001) return "💎 Diamante III";
                if (exp >= 200001) return "💎 Diamante II";
                if (exp >= 180001) return "💎 Diamante I";
                if (exp >= 160001) return "🥇 Oro III";
                if (exp >= 140001) return "🥇 Oro II";
                if (exp >= 120001) return "🥇 Oro I";
                if (exp >= 100001) return "🥈 Plata III";
                if (exp >= 80001) return "🥈 Plata II";
                if (exp >= 60001) return "🥈 Plata I";
                if (exp >= 40001) return "🥉 Bronce III";
                if (exp >= 20001) return "🥉 Bronce II";
                return "🥉 Bronce I";
            }

            var top3 = ranking != null ? ranking.Take(3).ToList() : new List<AnzanMegaArithmetics.Models.RankingUsersModel>();
            var restOfPlayers = ranking != null ? ranking.Skip(3).ToList() : new List<AnzanMegaArithmetics.Models.RankingUsersModel>();
        }

        @if (top3.Any())
        {
            <div class="podium-container">
                <div class="podium-column second-place">
                    @if (top3.Count >= 2)
                    {
                        var p2 = top3[1];
                        <div class="podium-player-card">
                            <div class="podium-avatar"><i class="fa-solid fa-user"></i></div>
                            <div class="podium-name">@p2.Nombre</div>
                            <div class="level-badge @GetRankBadgeClass(p2.Exp)" style="font-size: 0.6rem; margin: 2px 0;">@GetRankName(p2.Exp)</div>
                            <div class="podium-xp">@p2.Exp.ToString("N0") XP</div>
                        </div>
                        <div class="podium-block"></div>
                    }
                </div>
                <div class="podium-column first-place">
                    @if (top3.Count >= 1)
                    {
                        var p1 = top3[0];
                        <div class="podium-player-card">
                            <div class="crown-icon">👑</div>
                            <div class="podium-avatar"><i class="fa-solid fa-user"></i></div>
                            <div class="podium-name">@p1.Nombre</div>
                            <div class="level-badge @GetRankBadgeClass(p1.Exp)" style="font-size: 0.7rem; margin: 4px 0;">@GetRankName(p1.Exp)</div>
                            <div class="podium-xp">@p1.Exp.ToString("N0") XP</div>
                        </div>
                        <div class="podium-block"><div class="shine-effect"></div></div>
                    }
                </div>
                <div class="podium-column third-place">
                    @if (top3.Count >= 3)
                    {
                        var p3 = top3[2];
                        <div class="podium-player-card">
                            <div class="podium-avatar"><i class="fa-solid fa-user"></i></div>
                            <div class="podium-name">@p3.Nombre</div>
                            <div class="level-badge @GetRankBadgeClass(p3.Exp)" style="font-size: 0.6rem; margin: 2px 0;">@GetRankName(p3.Exp)</div>
                            <div class="podium-xp">@p3.Exp.ToString("N0") XP</div>
                        </div>
                        <div class="podium-block"></div>
                    }
                </div>
            </div>
        }

        <div class="ranking-list-container">
            @if (restOfPlayers.Any())
            {
                var currentRank = 4;
                foreach (var user in restOfPlayers)
                {
                    var isCurrentUser = user.Id_Usuario == currentUserId;
                    int xpCiclo = 20000;
                    int xpEnBarraTabla = user.Exp % xpCiclo;
                    var progressPercentage = (double)xpEnBarraTabla * 100 / xpCiclo;

                    <div class="list-row @(isCurrentUser ? "current-user-row" : "")">
                        <div class="list-rank">@currentRank</div>
                        <div class="list-player">
                            <div class="list-avatar-small"><i class="fa-solid fa-user"></i></div>
                            <div class="list-info">
                                <span class="list-name">@user.Nombre</span>
                                <span class="list-tag">@user.Gamer_Tag</span>
                            </div>
                        </div>
                        <div class="list-badge-col"><div class="level-badge @GetRankBadgeClass(user.Exp)">@GetRankName(user.Exp)</div></div>
                        <div class="list-xp-col">
                            <div class="xp-text">@user.Exp.ToString("N0") XP</div>
                            <div class="exp-bar-bg"><div class="exp-bar-fill" style="width: @(progressPercentage.ToString("0"))%"></div></div>
                        </div>
                    </div>
                    currentRank++;
                }
            }
            else if (!top3.Any())
            {
                <div class="no-data">No hay datos de ranking disponibles</div>
            }
        </div>

        <div class="view-all-container">
            <button type="button" class="btn-view-all" onclick="abrirModalRanking()">
                Ver Ranking Completo <i class="fa-solid fa-list"></i>
            </button>
        </div>
    </div>
</div>

<div id="modalRankingGlobal" class="custom-modal-overlay">
    <div class="custom-modal-content">
        <div class="custom-modal-header">
            <div class="header-top-row">
                <h3>🌍 Ranking Global Completo</h3>
                <button class="close-modal-btn" onclick="cerrarModalRanking()">&times;</button>
            </div>

            <div class="search-container">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input type="text"
                       id="inputBusquedaRanking"
                       class="search-input"
                       placeholder="Buscar jugador por nombre..."
                       onkeyup="filtrarRanking()">
            </div>
        </div>
        <div class="custom-modal-body">
            <div id="modalContentContainer">
                <div class="loading-state">
                    <i class="fa-solid fa-circle-notch fa-spin"></i> Cargando datos...
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    // 1. VARIABLE GLOBAL PARA GUARDAR LOS DATOS ORIGINALES
    let todosLosUsuarios = [];
    let rankingCargado = false;

    // --- Helpers de Badges y Formato ---
    function getRankBadgeClass(exp) {
        if (exp >= 500000) return "dark-matter";
        if (exp >= 260001 && exp <= 320000) return "heroic";
        if (exp >= 180001 && exp <= 260000) return "diamond";
        if (exp >= 120001 && exp <= 180000) return "gold";
        if (exp >= 60001 && exp <= 120000) return "silver";
        return "bronze";
    }

    function getRankName(exp) {
        if (exp > 1000000) return "☄️ Materia Oscura III";
        if (exp >= 750000) return "☄️ Materia Oscura II";
        if (exp >= 500000) return "☄️ Materia Oscura I";
        if (exp >= 300001) return "🔥 Heroico III";
        if (exp >= 280001) return "🔥 Heroico II";
        if (exp >= 260001) return "🔥 Heroico I";
        if (exp >= 220001) return "💎 Diamante III";
        if (exp >= 200001) return "💎 Diamante II";
        if (exp >= 180001) return "💎 Diamante I";
        if (exp >= 160001) return "🥇 Oro III";
        if (exp >= 140001) return "🥇 Oro II";
        if (exp >= 120001) return "🥇 Oro I";
        if (exp >= 100001) return "🥈 Plata III";
        if (exp >= 80001) return "🥈 Plata II";
        if (exp >= 60001) return "🥈 Plata I";
        if (exp >= 40001) return "🥉 Bronce III";
        if (exp >= 20001) return "🥉 Bronce II";
        return "🥉 Bronce I";
    }

    function formatNumber(num) {
        if (num === null || num === undefined) return "0";
        return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    }

    // --- Lógica del Modal ---

    function abrirModalRanking() {
        const modal = document.getElementById('modalRankingGlobal');
        modal.style.display = 'flex';

        // Enfocar el input automáticamente
        setTimeout(() => {
            const input = document.getElementById('inputBusquedaRanking');
            if(input) input.focus();
        }, 100);

        if (!rankingCargado) {
            fetch('@Url.Action("ObtenerRankingJson", "Dashboard")')
                .then(response => response.json())
                .then(data => {
                    // 2. GUARDAR RANKING ORIGINAL
                    // Mapeamos los datos para añadir la propiedad 'RankOriginal'
                    // Esto asegura que el #10 siga siendo el #10 aunque filtre la lista.
                    todosLosUsuarios = data.map((user, index) => ({
                        ...user,
                        RankOriginal: index + 1
                    }));

                    construirTabla(todosLosUsuarios);
                    rankingCargado = true;
                })
                .catch(err => {
                    console.error(err);
                    document.getElementById('modalContentContainer').innerHTML = '<p class="no-data">Error al cargar datos.</p>';
                });
        }
    }

    function cerrarModalRanking() {
        document.getElementById('modalRankingGlobal').style.display = 'none';
        // Opcional: Limpiar el input al cerrar para que la prox vez salga todo limpio
        // document.getElementById('inputBusquedaRanking').value = "";
        // construirTabla(todosLosUsuarios);
    }

    // --- 3. FUNCIÓN DE FILTRADO ---
    function filtrarRanking() {
        const texto = document.getElementById('inputBusquedaRanking').value.toLowerCase();

        const usuariosFiltrados = todosLosUsuarios.filter(user =>
            user.Nombre.toLowerCase().includes(texto) ||
            (user.Gamer_Tag && user.Gamer_Tag.toLowerCase().includes(texto))
        );

        construirTabla(usuariosFiltrados);
    }

    function construirTabla(usuarios) {
        const container = document.getElementById('modalContentContainer');
        const currentUserId = @Model.Id_Usuario;

        // Validar si no hay resultados
        if (usuarios.length === 0) {
            container.innerHTML = `
                <div class="loading-state">
                    <i class="fa-solid fa-user-slash" style="font-size: 2rem; margin-bottom: 1rem; opacity: 0.5;"></i><br>
                    No se encontraron jugadores.
                </div>`;
            return;
        }

        let html = '<div class="ranking-list-container" style="background:transparent; padding:0;">';

        usuarios.forEach((user) => {
            // USAMOS EL RANK ORIGINAL, NO EL INDEX DEL FOREACH
            const rank = user.RankOriginal;

            const badge = getRankBadgeClass(user.Exp);
            const rankName = getRankName(user.Exp);
            const userExp = user.Exp || 0;
            const isMe = user.Id_Usuario === currentUserId ? 'current-user-row' : '';

            const xpCiclo = 20000;
            const xpBarra = userExp % xpCiclo;
            const porcentaje = (xpBarra * 100) / xpCiclo;

            html += `
                <div class="list-row ${isMe}">
                    <div class="list-rank">#${rank}</div>

                    <div class="list-player">
                        <div class="list-avatar-small">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <div class="list-info">
                            <span class="list-name">${user.Nombre}</span>
                            <span class="list-tag">${user.Gamer_Tag || 'Sin Gamertag'}</span>
                        </div>
                    </div>

                    <div class="list-badge-col">
                        <div class="level-badge ${badge}">${rankName}</div>
                    </div>

                    <div class="list-xp-col">
                        <div class="xp-text">${formatNumber(userExp)} XP</div>
                        <div class="exp-bar-bg">
                            <div class="exp-bar-fill" style="width: ${porcentaje.toFixed(0)}%"></div>
                        </div>
                    </div>
                </div>
            `;
        });

        html += '</div>';
        container.innerHTML = html;
    }

    window.onclick = function(event) {
        if (event.target == document.getElementById('modalRankingGlobal')) cerrarModalRanking();
    }
</script>

