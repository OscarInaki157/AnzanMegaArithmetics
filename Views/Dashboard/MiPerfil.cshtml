        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .success-message-box {
        background-color: rgba(0, 255, 0, 0.15);
        border: 1px solid var(--color-success);
        color: var(--color-success);
    }

    .error-message-box {
        background-color: rgba(255, 0, 0, 0.15);
        border: 1px solid #ff4d4f; /* Rojo de error */
        color: #ff4d4f;
    }

    .daily-challenges-container {
        width: calc(50% - 0.5rem);
        background-color: var(--color-card-bg);
        border-radius: 1rem;
        padding: 1.5rem;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
        color: var(--color-light);
    }

    .challenges-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 0.8rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 1rem;
    }

    .challenges-title {
        font-size: 1.5rem;
        margin: 0;
    }

    .challenges-counter {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--color-light);
    }

    .challenges-list {
        display: flex; /* Cambiado a flex para control total en móviles */
        flex-direction: column;
        gap: 1rem;
    }

    .challenge-item {
        display: flex;
        align-items: center;
        padding: 0.8rem 1rem;
        border-radius: 0.8rem;
        background-color: rgba(255, 255, 255, 0.05);
        border: 1px solid transparent;
        transition: all 0.3s ease;
        justify-content: space-between;
        gap: 10px; /* Espacio mínimo entre texto y botón */
        min-height: 70px; /* Asegura un tamaño consistente */
        flex-direction:column;
        text-align:center;
    }

        /* === ESTADOS VISUALES === */

        .challenge-item.pending {
            border-color: rgba(255, 165, 0, 0.3); /* Naranja/Amarillo: Pendiente */
            opacity: 0.8;
        }

        .challenge-item.ready-to-claim {
            border-color: var(--color-primary); /* Azul Primario: Listo para reclamar */
            background-color: rgba(76, 76, 255, 0.1);
            box-shadow: 0 0 10px rgba(76, 76, 255, 0.3);
        }

        .challenge-item.completed {
            background-color: rgba(0, 255, 0, 0.1); /* Verde: Reclamado */
            border-color: rgba(0, 255, 0, 0.3);
            opacity: 0.7;
        }

    .challenge-status {
        width: 30px;
        height: 30px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        margin-right: 1rem;
        flex-shrink: 0;
    }

    .challenge-item.pending .challenge-status {
        background-color: var(--color-accent);
        color: white;
    }

    .challenge-item.ready-to-claim .challenge-status {
        background: linear-gradient(45deg, #FFD700, #FFA500); /* Estrella Dorada/XP */
        color: #1a1a1a;
        font-size: 1.2rem;
    }

    .challenge-item.completed .challenge-status {
        background-color: var(--color-success);
        color: white;
        font-size: 1.2rem;
    }

    .challenge-content {
        flex-grow: 1;
        flex-shrink: 1; /* Permite que se ajuste */
        min-width: 0; /* Truco de Flexbox para que el texto respete el contenedor */
    }

    .challenge-name {
        font-size: 0.95rem;
        font-weight: 500;
        margin-bottom: 0.3rem;
        white-space: normal; /* Permite saltos de línea */
        /* line-height: 1.2; */
        word-break: break-word; /* Rompe palabras muy largas si es necesario */
    }

    .challenge-reward {
        font-size: 0.85rem;
        color: var(--color-primary);
        font-weight: 600;
    }

    .claim-btn, .claimed-text {
        flex-shrink: 0; /* Evita que el botón se haga flaquito */
        width: 110px; /* Ancho fijo opcional para que todos los botones se vean iguales */
        text-align: center;
        justify-content: center;
    }

    /* === ESTILOS DEL BOTÓN === */
    .claim-btn {
        background: var(--color-primary);
        color: white;
        border: none;
        padding: 0.6rem 1rem;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
        font-size: 0.85rem;
        flex-shrink: 0;
    }

        .claim-btn[disabled] {
            background: #555;
            cursor: not-allowed;
            opacity: 0.6;
        }

    .claimed-text {
        color: var(--color-success);
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        white-space: nowrap;
        font-size: 0.9rem;
        flex-shrink: 0;
    }

    /* Agregar esto a tu CSS existente */
    .user-indicator {
        position: absolute;
        bottom: -2px;
        right: -2px;
        background: var(--color-primary);
        color: white;
        border-radius: 50%;
        width: 16px;
        height: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.6rem;
        font-weight: bold;
        border: 2px solid var(--color-card-bg);
    }

    .no-data {
        color: #a0a0c0;
        font-style: italic;
    }

    .dashboard-top {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
        align-items: stretch;
        width: 100%;
    }

    .dashboard-bottom {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
        align-items: stretch;
        width: 100%;
        margin-top: 1rem;
    }

    /* Nuevo contenedor de bienvenida */
    .user-welcome-card {
        width: calc(50% - 0.5rem);
        background-color: var(--color-card-bg);
        color: var(--color-light);
        border-radius: 1rem;
        padding: 2rem;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
    }

    .welcome-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .profile-circle {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        overflow: hidden;
        border: 4px solid var(--color-primary);
        box-shadow: 0 0 15px rgba(76, 76, 255, 0.5);
        background-color: white;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .profile-circle img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .welcome-message {
        font-size: 1.8rem;
        margin: 0;
        color: var(--color-light);
        font-weight: 600;
    }

    .welcome-subtitle {
        font-size: 1.1rem;
        margin: 0;
        font-weight: 500;
    }

    /* Contenedor existente de información del usuario */
    .user-info-card {
        width: calc(50% - 0.5rem);
        background-color: var(--color-card-bg);
        color: var(--color-light);
        padding: 1.5rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        border-radius: 1rem;
        gap: 1rem;
        font-size: 1.1rem;
        display: flex;
        flex-direction: column;
        justify-content: space-evenly;
    }

    /* ===== CONTENEDOR DE AVATARES ===== */
    .avatars-container {
        width: calc(50% - 0.5rem);
        background-color: var(--color-card-bg);
        border-radius: 1rem;
        padding: 1.5rem;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
        color: var(--color-light);
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }

    /* Nueva sección de Eventos */
    .events-section {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        width: 100%;
    }

    .events-title {
        font-size: 1.3rem;
        margin-bottom: 1rem;
        text-align: center;
        color: var(--color-light);
    }

    .event-card {
        display: flex;
        align-items: center;
        padding: 1.2rem;
        border-radius: 1rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        gap: 1rem;
    }

        .event-card.locked {
            background-color: rgba(59, 60, 143, 0.3);
            border: 2px dashed var(--color-hover);
        }

    .event-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-shrink: 0;
    }

    .event-card.locked .event-icon {
        background-color: var(--color-sidebar);
        color: var(--color-light);
        font-size: 1.5rem;
    }

    .event-content {
        flex-grow: 1;
    }

    .event-name {
        font-size: 1.1rem;
        margin: 0 0 0.3rem 0;
        font-weight: 600;
    }

    .event-description {
        font-size: 0.9rem;
        margin: 0;
        color: #a0a0c0;
    }

    .event-card.locked .event-name {
        color: #a0a0c0;
    }

    .global-ranking-container {
        width: calc(50% - 0.5rem);
        margin-top: 0;
        background-color: var(--color-card-bg);
        border-radius: 1rem;
        padding: 1.5rem;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
        color: var(--color-light);
    }

    /* Responsive para móviles */
    @@media (max-width: 768px) {
        .dashboard-top {
            flex-direction: column;
        }

        .dashboard-bottom {
            flex-direction: column;
        }

        .user-welcome-card,
        .user-info-card,
        .avatars-container,
        .global-ranking-container {
            width: 100%;
        }

        .welcome-message {
            font-size: 1.5rem;
        }

        .profile-circle {
            width: 100px;
            height: 100px;
        }

        .events-section {
            margin-top: 1.5rem;
            padding-top: 1.2rem;
        }

        .event-card {
            padding: 1rem;
        }

        .event-icon {
            width: 50px;
            height: 50px;
            font-size: 1.3rem;
        }

        .daily-challenges-container{
            width: 100%;
        }

