@model AnzanMegaArithmetics.Models.LoginResponseModel
@{
    ViewBag.Title = "Mi perfil";
    Layout = "_LayoutDashboard";

    var dailyChallenges = ViewBag.DailyChallenges as List<AnzanMegaArithmetics.Models.DailyChallengeViewModel>;

    int retosCompletados = dailyChallenges?.Count(r => r.FueReclamado || r.EsCompletado) ?? 0;
    int totalRetos = dailyChallenges?.Count ?? 0;



    string rangoNombre = Model.Rango_Actual ?? "Bronce I";
    string rangoClase = "";
    if (rangoNombre.Contains("Materia Oscura", StringComparison.OrdinalIgnoreCase)) { rangoClase = "dark-matter"; }
    else if (rangoNombre.Contains("Heroico", StringComparison.OrdinalIgnoreCase)) { rangoClase = "heroic"; }
    else if (rangoNombre.Contains("Diamante", StringComparison.OrdinalIgnoreCase)) { rangoClase = "diamond"; }
    else if (rangoNombre.Contains("Oro", StringComparison.OrdinalIgnoreCase)) { rangoClase = "gold"; }
    else if (rangoNombre.Contains("Plata", StringComparison.OrdinalIgnoreCase)) { rangoClase = "silver"; }
    else { rangoClase = "bronze"; }
}

<div class="user-top-info">
    <div class="user-left-section">
        <div class="user-name">
            @Model.Nombre
        </div>
        <div class="user-meta-row">
            <span class="gamertag">
                <i class="fa-solid fa-gamepad"></i>
                <strong>Gamertag:</strong> @Model.Gamer_Tag
            </span>
            <span class="license">
                <i class="fa-solid fa-id-card"></i>
                <strong>Licencia:</strong> @Model.Licencia
            </span>
            <span class="license">
                <i class="fa-solid fa-landmark"></i>
                <strong>Tus clases:</strong> @string.Join(", ", Model.Clases)
            </span>
        </div>
    </div>

    <div class="user-right-section">
        <div class="last-connection">
            <i class="fa-solid fa-clock"></i>
            Última conexión: @Model.Ultima_Cnx
        </div>
    </div>
</div>


<div class="dashboard-top">
    <div class="user-welcome-card">
        <div class="welcome-container">
            <div class="profile-circle">
                <img src="/Content/Images/ProfS.png" alt="Foto de perfil" />
            </div>
            <h2 class="welcome-message">¡Hola @Model.Nombre!</h2>
            <p><i class="fas fa-envelope"></i> @Model.Correo</p>
        </div>
    </div>

    <div class="user-info-card">
        <div class="contenedorR">
            <div class="R3" id="racha-container">
                <p class="txt">
                    <strong>
                        <span class="fire-icon" id="fire-icon">🔥</span><br />
                        <span id="racha-counter">0</span>
                    </strong>
                </p>
            </div>
            <div class="R2 @rangoClase">
                <p class="txt"><strong>🎖️<br />@Model.Rango_Actual</strong></p>
            </div>
            <div class="R1" id="xp-container">
                <p class="txt">
                    <strong>
                        <span class="star-icon" id="star-icon">✨</span><br />
                        <span id="xp-counter">0</span>
                    </strong>
                </p>
            </div>
        </div>

        <div class="xp-progress-container">
            <div class="xp-bar">
                <span id="xp-next-level-text" class="xp-text-overlay" style="color:white;">
                    Próximo nivel en: @(20000 - (Model.Exp % 20000)) XP
                </span>
                <div class="xp-progress" id="xp-progress-bar" data-xp="@Model.Exp"></div>
            </div>
        </div>

    </div>
</div>


<div class="dashboard-bottom">

    <div class="daily-challenges-container">
        <div class="challenges-header">
            <h2 class="challenges-title">🎯 Retos Diarios</h2>
            <div class="challenges-counter" id="daily-challenges-counter">
                <i class="fas fa-check-circle"></i>
                <span>@retosCompletados / @totalRetos Completados</span>
            </div>
        </div>

        <div class="challenges-list">

            @if (dailyChallenges != null && dailyChallenges.Any())
            {
                foreach (var reto in dailyChallenges)
                {
                    // Lógica de estado para CSS e iconos
                    var statusClass = reto.FueReclamado ? "completed" : (reto.EsCompletado ? "ready-to-claim" : "pending");
                    var iconClass = reto.FueReclamado ? "fas fa-check" : (reto.EsCompletado ? "fa-solid fa-circle-check" : "fas fa-arrow-right");

                    <div class="challenge-item @statusClass" id="reto-@reto.IdReto">
                        @* <div class="challenge-status">
                            <i class="@iconClass"></i>
                        </div> *@
                        <div class="challenge-content">
                            <div class="challenge-name">@reto.Descripcion</div>
                            <div class="challenge-reward">Recompensa: @reto.RecompensaXP XP</div>
                        </div>

                        @if (reto.FueReclamado)
                        {
                            <span class="claimed-text"><i class="fas fa-check"></i> Reclamado</span>
                        }
                        else
                        {
                            using (Html.BeginForm("ClaimReward", "Dashboard", FormMethod.Post, new { @class = "claim-form" }))
                            {
                              
                                @Html.Hidden("retoId", reto.IdReto)

                                <button type="submit"
                                        class="claim-btn btn-primary"
                                        @if (!reto.EsCompletado)
                                        {
                                                            <text>disabled</text>
                                                    }
                                            >
                                                @if (reto.EsCompletado)
                                                {
                                                        <text>Reclamar XP</text>
                                                }
                                                else
                                                {
                                                        <text>Pendiente</text>
                                                }
                                </button>
                            }
                            
                        }
                    </div>
                }
            }
            else
            {
                <p class="no-data">No hay retos disponibles hoy.</p>
            }
        </div>
    </div>




    <div class="avatars-container">
        <h2 class="avatars-title">Mis Avatares</h2>
        <div class="avatars-grid">

            <div class="avatar-item unlocked">
                <div class="avatar-icon">
                    <img src="/Content/Images/ProfS.png" alt="Avatar Jerry" />
                </div>
                <p class="avatar-name">Jerry</p>
            </div>

            <div class="avatar-item locked">
                <div class="avatar-icon">
                    <i class="fas fa-lock"></i>
                </div>
                <p class="avatar-name">???</p>
            </div>

            <div class="avatar-item locked">
                <div class="avatar-icon">
                    <i class="fas fa-lock"></i>
                </div>
                <p class="avatar-name">???</p>
            </div>

        </div>

        <div class="events-section">
            <h3 class="events-title">📅 Eventos</h3>
            <div class="event-card locked">
                <div class="event-icon">
                    <i class="fas fa-lock"></i>
                </div>
                <div class="event-content">
                    <h4 class="event-name">Próximamente</h4>
                    <p class="event-description">Nuevos eventos emocionantes se avecinan</p>
                </div>
            </div>
        </div>
    </div>

</div>


<style>

    .user-welcome-card::before{
        border:none;
    }

    .user-welcome-card{
        border: 0.2rem solid #4c4cff;
    }

    /* Estilos para mensajes de TempData */
    .alert {
        padding: 1rem;
        margin-bottom: 1rem;
        border-radius: 0.5rem;
