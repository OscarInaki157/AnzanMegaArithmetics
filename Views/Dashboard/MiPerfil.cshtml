        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .ranking-title {
        font-size: 1.8rem;
        margin: 0 0 0.5rem 0;
    }

    .ranking-subtitle {
        font-size: 0.9rem;
        color: #a0a0c0;
        font-weight: 500;
    }

    .ranking-table {
        width: 100%;
    }

    .table-header {
        display: grid;
        grid-template-columns: 60px 1fr 120px 100px;
        gap: 1rem;
        padding: 0.8rem 1rem;
        background-color: rgba(59, 60, 143, 0.3);
        border-radius: 0.8rem;
        margin-bottom: 0.5rem;
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--color-primary);
    }

    .table-body {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .table-row {
        display: grid;
        grid-template-columns: 60px 1fr 120px 100px;
        gap: 1rem;
        padding: 1rem;
        border-radius: 0.8rem;
        background-color: rgba(255, 255, 255, 0.05);
        transition: all 0.3s ease;
        border: 1px solid transparent;
    }

        .table-row:hover {
            background-color: rgba(76, 76, 255, 0.1);
            border-color: rgba(76, 76, 255, 0.3);
            transform: translateY(-2px);
        }

        .table-row.top-1 {
            background: linear-gradient(135deg, rgba(255, 215, 0, 0.15), rgba(255, 215, 0, 0.05));
            border: 1px solid rgba(255, 215, 0, 0.3);
        }

        .table-row.top-2 {
            background: linear-gradient(135deg, rgba(192, 192, 192, 0.15), rgba(192, 192, 192, 0.05));
            border: 1px solid rgba(192, 192, 192, 0.3);
        }

        .table-row.top-3 {
            background: linear-gradient(135deg, rgba(205, 127, 50, 0.15), rgba(205, 127, 50, 0.05));
            border: 1px solid rgba(205, 127, 50, 0.3);
        }

        .table-row.current-user {
            background: linear-gradient(135deg, rgba(76, 76, 255, 0.2), rgba(76, 76, 255, 0.1));
            border: 2px solid var(--color-primary);
            position: relative;
        }

            .table-row.current-user::before {
                content: "Tú";
                position: absolute;
                background: var(--color-primary);
                color: white;
                padding: 2px 8px;
                border-radius: 10px;
                font-size: 0.7rem;
                font-weight: 600;
            }

    .rank-col {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .rank-badge {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.9rem;
    }

        .rank-badge.gold {
            background: linear-gradient(135deg, #FFD700, #FFA500);
            color: #000;
            box-shadow: 0 0 10px rgba(255, 215, 0, 0.5);
        }

        .rank-badge.silver {
            background: linear-gradient(135deg, #C0C0C0, #A0A0A0);
            color: #000;
            box-shadow: 0 0 10px rgba(192, 192, 192, 0.5);
        }

        .rank-badge.bronze {
            background: linear-gradient(135deg, #CD7F32, #A56C2C);
            color: #fff;
            box-shadow: 0 0 10px rgba(205, 127, 50, 0.5);
        }

    .rank-number {
        font-weight: 600;
        color: var(--color-light);
    }

    .player-col {
        display: flex;
        align-items: center;
    }

