        justify-content: center;
        align-items: center;
        margin-bottom: 0.8rem;
        overflow: hidden;
    }

    .avatar-item.locked .avatar-icon {
        background-color: var(--color-sidebar);
        color: var(--color-light);
        font-size: 2rem;
