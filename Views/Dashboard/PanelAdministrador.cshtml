@{
    ViewBag.Title = "Panel Administrador";
    Layout = "_LayoutDashboard";
}

<div class="admin-panel">
   
 <!-- Estadísticas Rápidas -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-content">
                <h3>@ViewBag.UsersCount</h3>
                <p>Usuarios Totales</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="fas fa-book"></i>
            </div>
            <div class="stat-content">
                <h3>@ViewBag.ClasesCount</h3>
                <p>Clases Activas</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="fas fa-chart-line"></i>
            </div>
            <div class="stat-content">
                <h3>85%</h3>
                <p>Usuarios Activos</p>
            </div>
        </div>
    </div>

    <!-- Botones Principales -->
    <div class="actions-grid">
        <a href="@Url.Action("AdminUsers", "Admin")" class="action-card users-card">
            <div class="action-icon">
                <i class="fas fa-users"></i>
            </div>
            <div class="action-content">
                <h3>Gestión de Usuarios</h3>
                <span class="action-badge">Crear, editar y administrar usuarios</span>
            </div>
            <div class="action-arrow">
                <i class="fas fa-chevron-right"></i>
            </div>
        </a>

        <a href="@Url.Action("GestionClases", "Admin")" class="action-card classes-card">
            <div class="action-icon">
                <i class="fas fa-book"></i>
            </div>
            <div class="action-content">
                <h3>Gestión de Clases</h3>
                <span class="action-badge">Administrar clases</span>
            </div>
            <div class="action-arrow">
                <i class="fas fa-chevron-right"></i>
            </div>
        </a>
    </div>

</div>

<style>
    .admin-panel {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
    }

    .admin-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .admin-header h1 {
        font-size: 2.5rem;
        color: var(--color-light);
        margin-bottom: 0.5rem;
    }

    .admin-header p {
        color: #a0a0c0;
        font-size: 1.1rem;
    }

    /* Estadísticas */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 1rem;
        padding-top:1rem;
    }

    .stat-card {
        background: var(--color-card-bg);
        border-radius: 1rem;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(76, 76, 255, 0.1);
        transition: transform 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-2px);
    }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .stat-card:nth-child(1) .stat-icon {
        background: linear-gradient(135deg, #4c4cff, #3737e8);
        color: white;
    }

    .stat-card:nth-child(2) .stat-icon {
        background: linear-gradient(135deg, #10B981, #059669);
        color: white;
    }

    .stat-card:nth-child(3) .stat-icon {
        background: linear-gradient(135deg, #F59E0B, #D97706);
        color: white;
    }

    .stat-content h3 {
        font-size: 2rem;
        margin: 0;
        color: var(--color-light);
    }

    .stat-content p {
        margin: 0;
        color: #a0a0c0;
        font-size: 0.9rem;
    }

    /* Botones Principales */
    .actions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        padding-top:1rem;
    }

    .action-card {
        background: var(--color-card-bg);
        border-radius: 1rem;
        padding: 2rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        text-decoration: none;
        color: inherit;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        border: 2px solid transparent;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .action-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(76, 76, 255, 0.1), transparent);
        transition: left 0.5s ease;
    }

    .action-card:hover::before {
        left: 100%;
    }

    .action-card:hover {
        transform: translateY(-3px);
        border-color: var(--color-primary);
        box-shadow: 0 8px 25px rgba(76, 76, 255, 0.3);
    }

    .users-card {
        border-left: 4px solid #4c4cff;
    }

    .classes-card {
        border-left: 4px solid #10B981;
    }

    .action-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        flex-shrink: 0;
    }

    .users-card .action-icon {
        background: linear-gradient(135deg, #4c4cff, #3737e8);
        color: white;
    }

    .classes-card .action-icon {
        background: linear-gradient(135deg, #10B981, #059669);
        color: white;
    }

    .action-content {
        display: flex;
        flex-direction: column;
    }

    .action-content h3 {
        font-size: 1.5rem;
        margin: 0 0 0.5rem 0;
        color: var(--color-light);
    }

    .action-content p {
        margin: 0 0 0.5rem 0;
        color: #a0a0c0;
        font-size: 0.9rem;
    }

    .action-badge {
        background: rgba(76, 76, 255, 0.2);
        color: var(--color-primary);
        padding: 0.3rem 0.8rem;
        border-radius: 1rem;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .action-arrow {
        color: #a0a0c0;
        font-size: 1.2rem;
        transition: transform 0.3s ease;
    }

    .action-card:hover .action-arrow {
        transform: translateX(5px);
        color: var(--color-primary);
    }

    /* Actividad Reciente */
    .recent-activity {
        background: var(--color-card-bg);
        border-radius: 1rem;
        padding: 2rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .recent-activity h3 {
        color: var(--color-light);
        margin-bottom: 1.5rem;
        font-size: 1.3rem;
    }

    .activity-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-item i {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(76, 76, 255, 0.2);
        color: var(--color-primary);
        flex-shrink: 0;
    }

    .activity-content p {
        margin: 0;
        color: var(--color-light);
        font-size: 0.95rem;
    }

    .activity-content span {
        color: #a0a0c0;
        font-size: 0.8rem;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .admin-panel {
            padding: 1rem;
        }

        .admin-header h1 {
            font-size: 2rem;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .actions-grid {
            grid-template-columns: 1fr;
        }

        .action-card {
            padding: 1.5rem;
        }

        .action-icon {
            width: 60px;
            height: 60px;
            font-size: 1.5rem;
        }
    }
</style>