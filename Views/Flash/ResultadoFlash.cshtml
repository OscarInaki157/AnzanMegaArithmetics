@model AnzanMegaArithmetics.Models.RFlashModel
@{
    ViewBag.Title = "Resultados";
    Layout = "_LayoutFlash";
}

<div class="resultado-container">
    <h1>🧮 Resultado del Ejercicio</h1>

    <p><strong>Operación:</strong> @Model.OperacionTexto</p>
    <p><strong>Tu respuesta:</strong> @Model.RespuestaUsuario</p>
    <p><strong>Respuesta correcta:</strong> @Model.RespuestaCorrecta</p>

    @if (Model.EsCorrecto)
    {
        <p style="color: #4caf50; font-weight: bold;">✅ ¡Correcto!</p>
    }
    else
    {
        <p style="color: #e53935; font-weight: bold;">❌ Incorrecto</p>
    }

    <div style="margin-top: 30px;">
        <a href="/Flash/FormularioFlash" class="btn btn-secondary">🔁 Repetir</a>
        <a href="/Dashboard/Dashboard" class="btn btn-primary">🏠 Volver al inicio</a>
    </div>
</div>

<style>
    .resultado-container {
        text-align: center;
        margin-top: 10vh;
        color: white;
        font-family: 'Segoe UI', sans-serif;
    }

        .resultado-container h1 {
            font-size: 2.5rem;
            margin-bottom: 20px;
        }

        .resultado-container p {
            font-size: 1.4rem;
            margin: 10px 0;
        }

    .btn {
        padding: 10px 25px;
        font-size: 1rem;
        border-radius: 8px;
        margin: 10px;
        text-decoration: none;
        display: inline-block;
    }

    .btn-primary {
        background-color: #4caf50;
        color: white;
    }

    .btn-secondary {
        background-color: #607d8b;
        color: white;
    }

    .btn:hover {
        opacity: 0.85;
    }
</style>

