@{
    ViewBag.Title = "Número Flash";
    Layout = "_LayoutFlash";
    var velocidad = ViewBag.Velocidad;
    var totalEjercicios = ViewBag.TotalEjercicios;
    var secuenciaJson = ViewBag.Secuencia.ToString();

    var colorA_key = ViewBag.ColorA as string ?? "color1";
    var colorB_key = ViewBag.ColorB as string ?? "color2";

    Func<string, (string hex, string rgb)> getColorMapping = (key) => key switch
    {
        "color1" => ("#ffffff", "255, 255, 255"),
        "color2" => ("#28a745", "40, 167, 69"),
        _ => ("#ffffff", "255, 255, 255")
    };

    var mappingA = getColorMapping(colorA_key);
    var mappingB = getColorMapping(colorB_key);

    var colorA_hex = mappingA.hex;
    var shadowA_rgb = mappingA.rgb;

    var colorB_hex = mappingB.hex;
    var shadowB_rgb = mappingB.rgb;
}

<div class="top-bar">
    <form method="post" action="/Flash/FinalizarDesdeEjercicio" class="form-fin">
        <button type="submit" class="btn-finalizar">
            ❌ <span>Finalizar</span>
        </button>
    </form>

    <div id="iconoSonido" class="icono-sonido">
        
    </div>

</div>

<div class="flash-wrapper">
    <div class="numero-flash color-a" id="numeroFlash"></div>
</div>


<style>

    .color-a {
        color: @colorA_hex;
        text-shadow: 0 0 40px rgba( @shadowA_rgb, 0.9), 0 0 20px rgba( @shadowA_rgb, 0.7);
    }

    .color-b {
        color: @colorB_hex;
        text-shadow: 0 0 40px rgba( @shadowB_rgb, 0.9), 0 0 20px rgba( @shadowB_rgb, 0.7);
    }

    .sombra-alterna {
        text-shadow: 0 0 10px rgba(255, 255, 255, 0.8), 0 0 30px #ccff00, 0 0 50px rgba(204, 255, 0, 0.6), 0 0 70px rgba(204, 255, 0, 0.3);
        transform: scale(1.05);
        transition: transform 0.1s ease-out;
    }

    body {
        background-color: var(--color-bg);
        color: var(--color-tex);
    }

    .contador {
        color: #ffffff;
        font-weight: bold;
        font-size: 1.6rem;
        animation: pulse 1s infinite ease-in-out;
    }

    .top-bar {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.7rem;
        background-color: #1b1e3c;
        box-shadow: 0 0 20px rgba(0,0,0,0.3);
        flex-wrap: wrap;
        gap: 1rem;
        border-radius: 25px;
        margin-top: -2.3rem;
        position:relative;
        z-index:10;
    }

    .btn-finalizar {
        background-color: #df312c;
        color: white;
        padding: 0.6rem 1rem;
        border: none;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 0 10px rgba(255, 0, 0, 0.5);
    }

        .btn-finalizar:hover {
            background-color: #b22222;
            transform: scale(1.05);
        }

    .barra-progreso-contenedor {
        flex: 1;
        max-width: 420px;
    }

    .icono-sonido {
        font-size: 1.6rem;
        cursor: default;
        transition: transform 0.3s;
        user-select: none;
    }

        .icono-sonido.activo {
            color: #00ff88;
            text-shadow: 0 0 10px rgba(0, 255, 136, 0.5);
        }


   
    .info-tiempo {
        font-size: 1rem;
        color: #d1d1f0;
        font-weight: 500;
    }

    .form-fin {
        margin: 0;
    }

    .ejercicio-wrapper {
        margin: 0 auto;
        text-align: center;
        padding: 1rem;
    }

    .flash-wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        height: calc(100vh - 7rem);
    }

    .numero-flash {
        font-size: clamp(12rem, 23rem, 30rem);
        font-weight: bold;
        outline: none;
        word-break: break-word;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        width: 100%;
        margin-top: -8rem;
    }


    @@keyframes bounce {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.2);
        }

        100% {
            transform: scale(1.15);
        }
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.2);
            opacity: 0.7;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    @@media (max-width: 768px) {

        .info-tiempo {
            margin: 0 auto;
        }

        .btn-finalizar {
            padding: 7px 7px;
            font-size: 0.9rem;
        }

         .numero-flash {
            font-size: 7.5rem;
        }
        

    }
</style>

@section Scripts {
    <script>
        // --- Variables de Configuración ---
        const numeros = @Html.Raw(ViewBag.Secuencia.ToString());
        const velocidad = parseFloat("@ViewBag.Velocidad");
        const tiempoPorNumero = velocidad * 1000;
        const activarSonido = @(((bool)ViewBag.ActivarSonido) ? "true" : "false");
        const mostrarNumeros = @(((bool)ViewBag.MostrarNumeros) ? "true" : "false");
        const activarDictado = @(((bool)ViewBag.ActivarDictado) ? "true" : "false");

        // --- Variables de Estado ---
        let indiceActual = -1;
        let tiempoInicializado = false;
        let tiempoInicioDictado = 0;
        const numeroFlash = document.getElementById("numeroFlash");

        // Audio y Síntesis
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const synth = window.speechSynthesis;

        // --- FUNCIONES ---

        function reproducirBeep() {
            const oscillator = audioCtx.createOscillator();
            const gainNode = audioCtx.createGain();
            oscillator.type = 'sine';
            oscillator.frequency.setValueAtTime(880, audioCtx.currentTime);
            gainNode.gain.setValueAtTime(0.05, audioCtx.currentTime);
            oscillator.connect(gainNode);
            gainNode.connect(audioCtx.destination);
            oscillator.start();
            oscillator.stop(audioCtx.currentTime + 0.1);
        }

        function leerNumero(i, numero) {
            if (!activarDictado || !synth) return;

            synth.cancel();

            const utterance = new SpeechSynthesisUtterance();
            utterance.lang = 'es-MX';
            utterance.rate = 0.8;
            utterance.volume = 1.0;
            utterance.text = numero.toString();

            tiempoInicioDictado = performance.now();

            let yaAvanzo = false;

            const ejecutarAvance = () => {
                if (!yaAvanzo) {
                    yaAvanzo = true;
                    const duracionReal = performance.now() - tiempoInicioDictado;
                    let espera = tiempoPorNumero - duracionReal;
                    if (espera < 50) espera = 50;
                    setTimeout(avanzarSecuencia, espera);
                }
            };

            utterance.onend = ejecutarAvance;

            setTimeout(() => {
                if (!yaAvanzo) {
                    console.log("Safari/Browser encallado: Forzando avance.");
                    ejecutarAvance();
                }
            }, tiempoPorNumero + 300);

            synth.speak(utterance);
        }

        function mostrarVisual(numero) {
            if (mostrarNumeros) {
                numeroFlash.textContent = numero;
                numeroFlash.style.visibility = "visible";
            } else {
                numeroFlash.textContent = "";
                numeroFlash.style.visibility = "hidden";
            }
        }

        function actualizarColor(i) {
            // 1. Detectamos si los colores seleccionados son el mismo
            const colorA = "@colorA_key";
            const colorB = "@colorB_key";
            const sonIguales = (colorA === colorB);

            // 2. Alternancia normal de clases
            numeroFlash.classList.toggle("color-a", i % 2 === 0);
            numeroFlash.classList.toggle("color-b", i % 2 !== 0);

            // 3. Si son iguales, alternamos la sombra especial en los números impares
            if (sonIguales) {
                numeroFlash.classList.toggle("sombra-alterna", i % 2 !== 0);
            } else {
                numeroFlash.classList.remove("sombra-alterna");
            }
        }

        function avanzarSecuencia() {
            indiceActual++;

            if (indiceActual >= numeros.length) {
                finalizarSecuencia();
                return;
            }

            const numero = numeros[indiceActual];

            // UI
            mostrarVisual(numero);
            actualizarColor(indiceActual);
            if (activarSonido) reproducirBeep();

            // Dictado
            if (activarDictado) {
                leerNumero(indiceActual, numero);
            } else {
                // Si no hay dictado, usamos un simple timeout basado en la velocidad
                setTimeout(avanzarSecuencia, tiempoPorNumero);
            }
        }

        function finalizarSecuencia() {
            numeroFlash.textContent = "";
            numeroFlash.style.visibility = "hidden";
            if (synth) synth.cancel();

            setTimeout(() => {
                window.location.href = "/Flash/RespuestaFlash";
            }, 500);
        }

        function iniciarEjercicio() {
            const iconoSonido = document.getElementById("iconoSonido");
            if (activarDictado) {
                iconoSonido.textContent = "🎤";
                iconoSonido.classList.add("activo");
            } else if (activarSonido) {
                iconoSonido.textContent = "🔊";
                iconoSonido.classList.add("activo");
            } else {
                iconoSonido.textContent = "🔇";
            }

            // Arrancamos
            avanzarSecuencia();
        }

        // --- EVENTOS DE INICIO ---

        window.onload = function () {
            // Desbloquear audio en móviles/navegadores
            window.addEventListener("pointerdown", () => {
                if (audioCtx.state === "suspended") audioCtx.resume();
                // "Despertar" al sintetizador con un silencio
                if (synth) synth.speak(new SpeechSynthesisUtterance(""));
            }, { once: true });

            // Pequeña espera para asegurar que las voces carguen
            setTimeout(() => {
                if (activarDictado && synth.getVoices().length === 0) {
                    synth.onvoiceschanged = iniciarEjercicio;
                } else {
                    iniciarEjercicio();
                }
            }, 500);
        };
    </script>
}



