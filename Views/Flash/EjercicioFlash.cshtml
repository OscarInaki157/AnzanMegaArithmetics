@{
    ViewBag.Title = "Número Flash";
    Layout = "_LayoutFlash";
    var numeroActual = ViewBag.NumeroActual ?? "0";
    var velocidad = ViewBag.Velocidad ?? 2;
    var ejercicioActual = ViewBag.EjercicioActual ?? 1;
    var totalEjercicios = ViewBag.TotalEjercicios ?? 1;
}

<div class="top-bar">
    <form method="post" action="/Flash/FinalizarDesdeEjercicio" class="form-fin">
        <button type="submit" class="btn-finalizar">
            ❌ <span>Finalizar</span>
        </button>
    </form>

    <div class="info-tiempo">
        <span>⏱ <span id="temporizador" class="contador">@velocidad.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span> s</span>
    </div>
</div>

<div class="flash-wrapper">
    <div class="numero-flash" id="numeroFlash" tabindex="-1">
        @numeroActual
    </div>
</div>


<style>


    .flash-wrapper {
        flex:1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding:1rem;
        min-height:calc(100vh - 10rem);
    }

    .numero-flash {
        font-size: clamp(3rem, 15vw, 12rem);
        font-weight: bold;
        text-shadow: 0 0 20px rgba(255, 255, 255, 0.7);
        animation: zoomIn 0.4s ease-in-out;
        color: var(--color-light);
        outline: none;
        word-break: break-word;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        width: 100%;
    }



    @@keyframes zoomIn {
        from { opacity: 0; transform: scale(0.7); }
        to   { opacity: 1; transform: scale(1); }
    }

    @@keyframes pulse {
        0% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.2); opacity: 0.7; }
        100% { transform: scale(1); opacity: 1; }
    }

    @@media (max-width: 768px) {
        .numero-flash { font-size: 4rem; }
    }


    body {
        background-color: #161a36;
        color: white;
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
        padding: 0;
    }

    .contador {
        color: #ffffff;
        font-weight: bold;
        font-size: 1.6rem;
        animation: pulse 1s infinite ease-in-out;
    }

    .top-bar {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.7rem;
        background-color: #1b1e3c;
        box-shadow: 0 0 20px rgba(0,0,0,0.3);
        flex-wrap: wrap;
        gap: 1rem;
        border-radius: 25px;
        margin-top: -2.3rem;
    }

    .btn-finalizar {
        background-color: #df312c;
        color: white;
        padding: 0.6rem 1rem;
        border: none;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 0 10px rgba(255, 0, 0, 0.5);
    }

        .btn-finalizar:hover {
            background-color: #b22222;
            transform: scale(1.05);
        }

    .barra-progreso-contenedor {
        flex: 1;
        max-width: 420px;
    }

   
    .info-tiempo {
        font-size: 1rem;
        color: #d1d1f0;
        font-weight: 500;
    }

    .form-fin {
        margin: 0;
    }

    .ejercicio-wrapper {
        margin: 0 auto;
        text-align: center;
        padding: 1rem;
    }



    @@keyframes bounce {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.2);
        }

        100% {
            transform: scale(1.15);
        }
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.2);
            opacity: 0.7;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    @@media (max-width: 768px) {

       


        .info-tiempo {
            margin: 0 auto;
        }

        .btn-finalizar {
            padding: 7px 7px;
            font-size: 0.9rem;
        }

        

    }
</style>


@section Scripts {
        <script>
            const velocidad = parseFloat("@velocidad");
            const temporizador = document.getElementById("temporizador");
            const numeroFlash = document.getElementById("numeroFlash");

            numeroFlash.focus();

            let restante = velocidad;
            const intervalo = setInterval(() => {
                restante -= 0.1;
                if (restante <= 0) {
                    clearInterval(intervalo);
                    window.location.href = "/Flash/EjercicioFlash";
                } else {
                    temporizador.textContent = restante.toFixed(1);
                }
            }, 100);

        document.addEventListener("DOMContentLoaded", () => {
            const numeroFlash = document.getElementById("numeroFlash");
            numeroFlash?.focus();
        });

        </script>
}
