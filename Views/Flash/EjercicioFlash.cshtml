@{
    ViewBag.Title = "Número Flash";
    Layout = "_LayoutFlash";
    var velocidad = ViewBag.Velocidad;
    var totalEjercicios = ViewBag.TotalEjercicios;
    var secuenciaJson = ViewBag.Secuencia.ToString();

    var colorA_key = ViewBag.ColorA as string ?? "color1";
    var colorB_key = ViewBag.ColorB as string ?? "color2";

    Func<string, (string hex, string rgb)> getColorMapping = (key) => key switch
    {
        "color1" => ("#ffffff", "255, 255, 255"),
        "color2" => ("#28a745", "40, 167, 69"),
        _ => ("#ffffff", "255, 255, 255")
    };

    var mappingA = getColorMapping(colorA_key);
    var mappingB = getColorMapping(colorB_key);

    var colorA_hex = mappingA.hex;
    var shadowA_rgb = mappingA.rgb;

    var colorB_hex = mappingB.hex;
    var shadowB_rgb = mappingB.rgb;
}

<div class="top-bar">
    <form method="post" action="/Flash/FinalizarDesdeEjercicio" class="form-fin">
        <button type="submit" class="btn-finalizar">
            ❌ <span>Finalizar</span>
        </button>
    </form>

    <div id="iconoSonido" class="icono-sonido">
        
    </div>

</div>

<div class="flash-wrapper">
    <div class="numero-flash color-a" id="numeroFlash"></div>
</div>


<style>

    .color-a {
        color: @colorA_hex;
        text-shadow: 0 0 40px rgba( @shadowA_rgb, 0.9), 0 0 20px rgba( @shadowA_rgb, 0.7);
    }

    .color-b {
        color: @colorB_hex;
        text-shadow: 0 0 40px rgba( @shadowB_rgb, 0.9), 0 0 20px rgba( @shadowB_rgb, 0.7);
    }

    body {
        background-color: var(--color-bg);
        color: var(--color-tex);
    }

    .contador {
        color: #ffffff;
        font-weight: bold;
        font-size: 1.6rem;
        animation: pulse 1s infinite ease-in-out;
    }

    .top-bar {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.7rem;
        background-color: #1b1e3c;
        box-shadow: 0 0 20px rgba(0,0,0,0.3);
        flex-wrap: wrap;
        gap: 1rem;
        border-radius: 25px;
        margin-top: -2.3rem;
        position:relative;
        z-index:10;
    }

    .btn-finalizar {
        background-color: #df312c;
        color: white;
        padding: 0.6rem 1rem;
        border: none;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 0 10px rgba(255, 0, 0, 0.5);
    }

        .btn-finalizar:hover {
            background-color: #b22222;
            transform: scale(1.05);
        }

    .barra-progreso-contenedor {
        flex: 1;
        max-width: 420px;
    }

    .icono-sonido {
        font-size: 1.6rem;
        cursor: default;
        transition: transform 0.3s;
        user-select: none;
    }

        .icono-sonido.activo {
            color: #00ff88;
            text-shadow: 0 0 10px rgba(0, 255, 136, 0.5);
        }


   
    .info-tiempo {
        font-size: 1rem;
        color: #d1d1f0;
        font-weight: 500;
    }

    .form-fin {
        margin: 0;
    }

    .ejercicio-wrapper {
        margin: 0 auto;
        text-align: center;
        padding: 1rem;
    }

    .flash-wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        height: calc(100vh - 7rem);
    }

    .numero-flash {
        font-size: clamp(12rem, 23rem, 30rem);
        font-weight: bold;
        outline: none;
        word-break: break-word;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        width: 100%;
        margin-top: -8rem;
    }


    @@keyframes bounce {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.2);
        }

        100% {
            transform: scale(1.15);
        }
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.2);
            opacity: 0.7;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    @@media (max-width: 768px) {

        .info-tiempo {
            margin: 0 auto;
        }

        .btn-finalizar {
            padding: 7px 7px;
            font-size: 0.9rem;
        }

         .numero-flash {
            font-size: 7.5rem;
        }
        

    }
</style>

@section Scripts {
    <script>
        // --- Variables de Configuración ---
        const numeros = @Html.Raw(ViewBag.Secuencia.ToString());
        const velocidad = parseFloat("@ViewBag.Velocidad");
        const tiempoPorNumero = velocidad * 1000;
        const activarSonido = @(((bool)ViewBag.ActivarSonido) ? "true" : "false");
        const mostrarNumeros = @(((bool)ViewBag.MostrarNumeros) ? "true" : "false");
        const activarDictado = @(((bool)ViewBag.ActivarDictado) ? "true" : "false");

        // --- Variables de Estado y Elementos ---
        let indiceActual = -1;
        let tiempoInicializado = false;
        const numeroFlash = document.getElementById("numeroFlash");

        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        const synth = window.speechSynthesis;
        const utterance = new SpeechSynthesisUtterance();
        utterance.lang = 'es-MX';

        const TTS_BASE_RATE = 2.6;

        // utterance.rate = Math.min(3.0, TTS_BASE_RATE / velocidad);
        utterance.rate = 2.5;

        function reproducirBeep() {
            const oscillator = audioCtx.createOscillator();
            const gainNode = audioCtx.createGain();

            oscillator.type = 'sine';
            oscillator.frequency.setValueAtTime(880, audioCtx.currentTime);
            gainNode.gain.setValueAtTime(0.05, audioCtx.currentTime);

            oscillator.connect(gainNode);
            gainNode.connect(audioCtx.destination);

            oscillator.start();
            oscillator.stop(audioCtx.currentTime + 0.1);
        }

        let tiempoInicioDictado = 0;

        function leerNumero(i, numero) {
            if (synth && activarDictado) {
                let textoDictado = "";

                if (i === 0) {
                    textoDictado = numero.toString();
                }
                else if (numero > 0) {
                    textoDictado = "más " + numero.toString();
                }
                else if (numero < 0) {
                    textoDictado = numero.toString();
                }

                synth.cancel();
                utterance.text = textoDictado;
                tiempoInicioDictado = performance.now();
                synth.speak(utterance);
            }
        }

        function mostrarVisual(numero) {
            if (mostrarNumeros) {
                numeroFlash.textContent = numero >= 0 ? numero : `-${Math.abs(numero)}`;
                numeroFlash.style.visibility = "visible";
            } else {
                numeroFlash.textContent = "";
                numeroFlash.style.visibility = "hidden";
            }
        }

        function actualizarColor(i) {
            if (i % 2 === 0) {
                numeroFlash.classList.remove("color-b");
                numeroFlash.classList.add("color-a");
            } else {
                numeroFlash.classList.remove("color-a");
                numeroFlash.classList.add("color-b");
            }
        }

        function loopPorTiempo(timestamp) {
            if (!tiempoInicializado) tiempoInicializado = timestamp;

            const elapsed = timestamp - tiempoInicializado;
            const index = Math.floor(elapsed / tiempoPorNumero);

            if (index >= numeros.length) {
                finalizarSecuencia();
                return;
            }

            if (index !== indiceActual) {
                const numero = numeros[index];

                mostrarVisual(numero);
                actualizarColor(index);

                if (activarSonido) reproducirBeep();

                if (activarDictado) {
                    synth.cancel();
                    leerNumero(index, numero);
                }

                indiceActual = index;
            }

            requestAnimationFrame(loopPorTiempo);
        }

        function avanzarPorVoz() {
            indiceActual++;

            if (indiceActual >= numeros.length) {
                finalizarSecuencia();
                return;
            }

            const numero = numeros[indiceActual];

            mostrarVisual(numero);
            actualizarColor(indiceActual);

            if (indiceActual >= 0) {
                 leerNumero(indiceActual, numero);
            }
        }

        if (activarDictado) {
            
            utterance.onend = () => {
                const tiempoFinDictado = performance.now();
                const duracionRealDictado = tiempoFinDictado - tiempoInicioDictado;

                const tiempoEsperado = tiempoPorNumero;

                let retardoNecesario = tiempoEsperado - duracionRealDictado;

                if (retardoNecesario < 50) {
                    retardoNecesario = 50;
                }

                setTimeout(() => {
                    avanzarPorVoz();
                }, retardoNecesario);
            };
        }


        function finalizarSecuencia() {
            if (indiceActual === numeros.length - 1 || indiceActual === numeros.length) {
                numeroFlash.textContent = "";
                numeroFlash.style.visibility = "hidden";

                if (synth) synth.cancel();

                // Redireccionar
                setTimeout(() => {
                    window.location.href = "/Flash/RespuestaFlash";
                }, 500);
            }
        }


        function iniciarEjercicio() {
            const iconoSonido = document.getElementById("iconoSonido");

            if (activarDictado) {
                iconoSonido.textContent = "🎤";
                iconoSonido.classList.add("activo");
            } else if (activarSonido) {
                iconoSonido.textContent = "🔊";
                iconoSonido.classList.add("activo");
            } else {
                iconoSonido.textContent = "🔇";
                iconoSonido.classList.remove("activo");
            }

            if (!mostrarNumeros) {
                numeroFlash.style.visibility = "hidden";
            }

            if (activarDictado) {
                avanzarPorVoz();
                leerNumero(indiceActual, numeros[indiceActual]);
            } else {
                requestAnimationFrame(loopPorTiempo);
            }
        }

        window.onload = function () {

            window.addEventListener("pointerdown", () => {
                if (audioCtx.state === "suspended") {
                    audioCtx.resume().then(() => {
                        if (activarSonido) reproducirBeep();
                    });
                }
                if (activarDictado && synth.speaking === false) {
                    synth.speak(new SpeechSynthesisUtterance(""));
                }
            }, { once: true });

            setTimeout(() => {
                if (activarDictado && synth.getVoices().length === 0) {
                     synth.onvoiceschanged = () => {
                         setTimeout(iniciarEjercicio, 500);
                     };
                } else {
                    iniciarEjercicio();
                }
            }, 500);
        };

        window.addEventListener("click", () => {
            if (audioCtx.state === "suspended") {
                 audioCtx.resume();
            }
        }, { once: true });

    </script>
}




