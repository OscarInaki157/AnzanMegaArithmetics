@{
    ViewBag.Title = "Número Flash";
    Layout = "_LayoutFlash";
    var velocidad = ViewBag.Velocidad;
    var totalEjercicios = ViewBag.TotalEjercicios;
    var secuenciaJson = ViewBag.Secuencia.ToString();
}

<div class="top-bar">
    <form method="post" action="/Flash/FinalizarDesdeEjercicio" class="form-fin">
        <button type="submit" class="btn-finalizar">
            ❌ <span>Finalizar</span>
        </button>
    </form>

    <div id="iconoSonido" class="icono-sonido">
        🔊
    </div>


@*     <div class="info-tiempo">
        <span>⏱ <span id="temporizador" class="contador">@velocidad.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span> s</span>
    </div> *@
</div>

<div class="flash-wrapper">
    <div class="numero-flash color-a" id="numeroFlash"></div>
</div>


<style>

    body {
        background-color: var(--color-bg);
        color: var(--color-tex);
    }

    .contador {
        color: #ffffff;
        font-weight: bold;
        font-size: 1.6rem;
        animation: pulse 1s infinite ease-in-out;
    }

    .top-bar {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.7rem;
        background-color: #1b1e3c;
        box-shadow: 0 0 20px rgba(0,0,0,0.3);
        flex-wrap: wrap;
        gap: 1rem;
        border-radius: 25px;
        margin-top: -2.3rem;
        position:relative;
        z-index:10;
    }

    .btn-finalizar {
        background-color: #df312c;
        color: white;
        padding: 0.6rem 1rem;
        border: none;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 0 10px rgba(255, 0, 0, 0.5);
    }

        .btn-finalizar:hover {
            background-color: #b22222;
            transform: scale(1.05);
        }

    .barra-progreso-contenedor {
        flex: 1;
        max-width: 420px;
    }

    .icono-sonido {
        font-size: 1.6rem;
        cursor: default;
        transition: transform 0.3s;
        user-select: none;
    }

        .icono-sonido.activo {
            color: #00ff88;
            text-shadow: 0 0 10px rgba(0, 255, 136, 0.5);
        }


   
    .info-tiempo {
        font-size: 1rem;
        color: #d1d1f0;
        font-weight: 500;
    }

    .form-fin {
        margin: 0;
    }

    .ejercicio-wrapper {
        margin: 0 auto;
        text-align: center;
        padding: 1rem;
    }

    .color-a {
        color: var(--color-light);
        text-shadow: 0 0 20px rgba(255, 255, 255, 0.7);
    }

    .color-b {
        color: #28a745;
        text-shadow: 0 0 15px rgba(124, 252, 181, 0.4);
    }



    .flash-wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        height: calc(100vh - 7rem);
    }

    .numero-flash {
        font-size: clamp(12rem, 23rem, 30rem);
        font-weight: bold;
        outline: none;
        word-break: break-word;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        width: 100%;
        margin-top: -8rem;
    }


    @@keyframes bounce {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.2);
        }

        100% {
            transform: scale(1.15);
        }
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.2);
            opacity: 0.7;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    @@media (max-width: 768px) {

        .info-tiempo {
            margin: 0 auto;
        }

        .btn-finalizar {
            padding: 7px 7px;
            font-size: 0.9rem;
        }

         .numero-flash {
            font-size: 7.5rem;
        }
        

    }
</style>

@section Scripts {
    <script>
        const numeros = @Html.Raw(ViewBag.Secuencia.ToString());
        const velocidad = parseFloat("@ViewBag.Velocidad");
        const tiempoPorNumero = velocidad * 1000;
        const activarSonido = @(((bool)ViewBag.ActivarSonido) ? "true" : "false");

        let tiempoInicio = null;
        let ultimoIndiceMostrado = -1;
        let esperaFinalizada = false;
        const numeroFlash = document.getElementById("numeroFlash");

        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function reproducirBeep() {
            const oscillator = audioCtx.createOscillator();
            const gainNode = audioCtx.createGain();

            oscillator.type = 'sine';
            oscillator.frequency.setValueAtTime(880, audioCtx.currentTime);
            gainNode.gain.setValueAtTime(0.05, audioCtx.currentTime);

            oscillator.connect(gainNode);
            gainNode.connect(audioCtx.destination);

            oscillator.start();
            oscillator.stop(audioCtx.currentTime + 0.1);
        }

        function mostrarNumero(i) {
            const numero = numeros[i];
            numeroFlash.textContent = numero >= 0 ? numero : `-${Math.abs(numero)}`;

            if (i % 2 === 0) {
                numeroFlash.classList.remove("color-b");
                numeroFlash.classList.add("color-a");
            } else {
                numeroFlash.classList.remove("color-a");
                numeroFlash.classList.add("color-b");
            }
            if (activarSonido) {
                reproducirBeep();
            }
        }

        function loop(timestamp) {
            if (!tiempoInicio) tiempoInicio = timestamp;

            const elapsed = timestamp - tiempoInicio;
            const index = Math.floor(elapsed / tiempoPorNumero);

            if (index >= numeros.length) {
                if (!esperaFinalizada) {
                    // Oculta el número visualmente
                    numeroFlash.textContent = "";
                    
                    esperaFinalizada = true;
                    setTimeout(() => {
                        window.location.href = "/Flash/RespuestaFlash";
                    }, 500);
                }
                return; 
            }

            if (index !== ultimoIndiceMostrado) {
                mostrarNumero(index);
                ultimoIndiceMostrado = index;
            }

            requestAnimationFrame(loop);
        }

        window.onload = function () {

            //toque falso
            window.addEventListener("pointerdown", () => {
                if (audioCtx.state === "suspended") {
                    audioCtx.resume().then(() => {
                        reproducirBeep(); // beep inicial fantasma
                    });
                }
            }, { once: true });


            setTimeout(() => {

                const iconoSonido = document.getElementById("iconoSonido");
                if (activarSonido && iconoSonido) {
                    iconoSonido.textContent = "🔊";
                    iconoSonido.classList.add("activo");
                } else {
                    iconoSonido.textContent = "🔇";
                }

                requestAnimationFrame(loop);
            }, 500); 
        };

        window.addEventListener("click", () => {
        if (audioCtx.state === "suspended") {
                audioCtx.resume();
            }
        }, { once: true });

    </script>
}




