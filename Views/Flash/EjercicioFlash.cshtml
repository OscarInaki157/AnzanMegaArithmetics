@{
    ViewBag.Title = "Número Flash";
    Layout = "_LayoutFlash";
    var numeroActual = ViewBag.NumeroActual ?? "0";
    var velocidad = ViewBag.Velocidad ?? 2;
    var ejercicioActual = ViewBag.EjercicioActual ?? 1;
    var totalEjercicios = ViewBag.TotalEjercicios ?? 1;
}

<div class="flash-container">
    <div class="top-bar">
        <form method="post" action="/Flash/FinalizarDesdeEjercicio" style="display: inline;">
            <button type="submit" class="btn btn-danger">Finalizar</button>
        </form>
        <div class="contador-ejercicio" id="temporizador">@velocidad</div>
    </div>

    <div class="numero-flash" id="numeroFlash" tabindex="-1">
        @numeroActual
    </div>
</div>

<style>
    .flash-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 85vh;
        text-align: center;
        color: white;
        font-family: 'Segoe UI', sans-serif;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        width: 80%;
        align-items: center;
        margin-bottom: 20px;
    }

    .contador-ejercicio {
        font-size: 2rem;
        font-weight: bold;
        padding: 10px 20px;
        background: #333;
        border-radius: 8px;
    }

    .numero-flash {
        font-size: 8rem;
        font-weight: bold;
        animation: fadeIn 0.5s ease-in-out;
        outline: none;
    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: scale(0.8);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }

    }

    @@media (max-width: 768px) {
        .numero-flash

    {
        font-size: 4rem;
    }

    }
</style>

@section Scripts {
    <script>
        const tiempo = parseFloat("@velocidad");
        const temporizador = document.getElementById("temporizador");
        const numeroFlash = document.getElementById("numeroFlash");
        numeroFlash.focus();

        let restante = tiempo;

        const interval = setInterval(() => {
            restante -= 1;
            if (restante <= 0) {
                clearInterval(interval);
                window.location.href = "/Flash/EjercicioFlash";
            } else {
                temporizador.textContent = restante.toFixed(0);
            }
        }, 1000);
    </script>
}
