@{
    ViewBag.Title = "Tu respuesta";
    Layout = "_LayoutGeneral";
}

<div class="respuesta-flash-wrapper">
    <div class="respuesta-left">
        <h1 class="titulo-respuesta">🧠 RESPUESTA</h1>
        <form method="post" action="/Flash/ResultadoFlash" class="respuesta-form">
            <input type="text" inputmode="none" name="respuestaUsuario" id="respuestaInput" class="respuesta-input" readonly />

            <button type="submit" class="btn-enviar">ENVIAR</button>
        </form>
    </div>

    <div class="teclado-numerico">
        <div class="fila">
            <button type="button" class="tecla">7</button>
            <button type="button" class="tecla">8</button>
            <button type="button" class="tecla">9</button>
        </div>
        <div class="fila">
            <button type="button" class="tecla">4</button>
            <button type="button" class="tecla">5</button>
            <button type="button" class="tecla">6</button>
        </div>
        <div class="fila">
            <button type="button" class="tecla">1</button>
            <button type="button" class="tecla">2</button>
            <button type="button" class="tecla">3</button>
        </div>
        <div class="fila">
            <button type="button" class="tecla">0</button>
            <button type="button" class="tecla borrar"><i class="fas fa-backspace"></i></button>
            <button type="button" class="tecla enter"><i class="fas fa-check"></i></button>
        </div>

    </div>

</div>

<style>

    body {
        background-color: var(--color-bg);
        color: var(--color-tex);
    }
    
    .respuesta-flash-wrapper {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 2rem;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .respuesta-left, .teclado-numerico {
        flex: 1 1 400px;
        max-width: 600px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .titulo-respuesta {
        font-size: 3rem;
        margin-bottom: 2rem;
        text-shadow: 0 0 8px rgba(255,255,255,0.2);
    }

    .respuesta-form {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        align-items: center;
        width: 100%;
    }

    .respuesta-input {
        font-size: 4rem;
        padding: 1rem 2rem;
        text-align: center;
        border-radius: 15px;
        border: none;
        width: 100%;
        max-width: 400px;
        background-color: var(--color-card-bg);
        color: white;
        box-shadow: 0 0 15px rgba(76, 76, 255, 0.2);
        transition: box-shadow 0.3s ease, transform 0.2s ease;
    }

        .respuesta-input:focus {
            outline: none;
            box-shadow: 0 0 20px rgba(76, 76, 255, 0.5);
            transform: scale(1.02);
        }

    .btn-enviar {
        font-size: 1.8rem;
        padding: 1rem 3rem;
        background-color: var(--color-primary);
        color: white;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        box-shadow: 0 8px 18px rgba(76, 76, 255, 0.3);
        transition: all 0.3s ease;
    }

        .btn-enviar:hover {
            background-color: var(--color-primary-dark);
            transform: translateY(-3px);
            box-shadow: 0 12px 24px rgba(76, 76, 255, 0.5);
        }

    .teclado-numerico {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        width: 100%;
        max-width: 400px;
    }

    .fila {
        display: flex;
        gap: 1rem;
        justify-content: center;
    }

    .tecla i {
        font-size: 1.5rem;
    }


    .tecla {
        flex: 1;
        font-size: 3rem;
        padding: 1rem 2rem 1rem 2rem;
        border-radius: 10px;
        border: none;
        background-color: var(--color-primary);
        color: white;
        cursor: pointer;
        transition: all 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
        justify-content: center;
        align-items: center;
        display: flex;
    }


        .tecla.borrar {
            background-color: var(--color-danger);
        }

        .tecla:hover,
        .tecla.presionada {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.6);
            background-color: #a6a6ff !important;
        }

        .tecla.enter {
            background-color: #28a745;
        }

            .tecla.enter:hover,
            .tecla.enter.presionada {
                background-color: #2ecc71 !important;
                box-shadow: 0 0 20px rgba(46, 204, 113, 0.6);
            }


    .tecla:hover {
        background-color: #a6a6ff;
    }

    .tecla.borrar:hover,
    .tecla.borrar.presionada {
        background-color: #ff6666 !important;
        box-shadow: 0 0 20px rgba(255, 0, 0, 0.6);
    }


    @@media (max-width: 768px) {
        .respuesta-flash-wrapper

    {
        flex-direction: column;
        padding: 1.5rem;
    }

    .titulo-respuesta {
        font-size: 2.4rem;
    }

    .respuesta-input {
        font-size: 3rem;
    }

    .btn-enviar {
        font-size: 1.5rem;
    }

    .tecla {
        font-size: 2rem;
    }

    }
</style>

@section Scripts {
    <script>
        window.onload = function () {
            document.querySelector('.respuesta-flash-wrapper')?.scrollIntoView({
                behavior: 'smooth',
                block: 'center'
            });
        };

        const input = document.getElementById('respuestaInput');

        // Clic en las teclas del teclado numérico
        document.querySelectorAll('.tecla').forEach(btn => {
            btn.addEventListener('click', () => {
                if (btn.classList.contains('borrar')) {
                    input.value = input.value.slice(0, -1);
                } else if (btn.classList.contains('enter')) {
                    document.querySelector('.respuesta-form')?.submit();
                    return;
                } else {
                    input.value += btn.textContent.trim();
                }

                input.focus();

                // Efecto visual
                btn.classList.add('presionada');
                setTimeout(() => btn.classList.remove('presionada'), 150);
            });
        });

        // Teclado físico
        document.addEventListener('keydown', e => {
            const teclaPresionada = e.key;

            if (teclaPresionada >= '0' && teclaPresionada <= '9') {
                input.value += teclaPresionada;

                const btn = Array.from(document.querySelectorAll('.tecla'))
                    .find(b => b.textContent.trim() === teclaPresionada);

                if (btn) {
                    btn.classList.add('presionada');
                    setTimeout(() => btn.classList.remove('presionada'), 150);
                }
            }

            if (teclaPresionada === 'Backspace') {
                input.value = input.value.slice(0, -1);

                const btnBorrar = document.querySelector('.tecla.borrar');
                if (btnBorrar) {
                    btnBorrar.classList.add('presionada');
                    setTimeout(() => btnBorrar.classList.remove('presionada'), 150);
                }

                e.preventDefault();
            }

            if (teclaPresionada === 'Enter') {
                e.preventDefault();
                document.querySelector('.respuesta-form')?.submit();
            }
        });
    </script>
}

