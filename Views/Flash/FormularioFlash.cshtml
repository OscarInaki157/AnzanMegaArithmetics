    }

    .checks {
        flex-direction: row;
        display: flex;
        gap: 2rem;
        padding: 0.5rem;
        align-items: center;
    }

    .form-grid-three-columns {
        display: flex;
        gap: 2rem;
        justify-content: space-between;
    }


    .form-grid {
        display: flex;
        flex-wrap: wrap;
    }

    .form-column {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    form#formConfigSR label {
        display: block;
        margin-bottom: 0.4rem;
        font-weight: 600;
        font-size: 1rem;
    }

    form#formConfigSR select,
    form#formConfigSR input[type="number"] {
        width: 70%;
        padding: 0.5rem 0.6rem;
        border: none;
        border-radius: 0.5rem;
        background-color: #292c4f;
        color: white;
        font-size: 1rem;
    }

    form#formConfigSR input[type="radio"] {
        accent-color: var(--color-primary);
        transform: scale(1.1);
    }

    .btn.btn-primary {
        background: #28a745;
        color: white;
        padding: 0.9rem 1.5rem;
        font-size: 1.1rem;
        font-weight: bold;
        border: none;
        border-radius: 0.6rem;
        cursor: pointer;
        transition: all 0.3s ease;
        width: 100%;
