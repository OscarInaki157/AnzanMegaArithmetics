@model AnzanMegaArithmetics.Models.ConfFlashModel
@{
    ViewBag.Title = "Ejercicios Números Flash";
    Layout = "_LayoutFlash";
    var cantidad = Model.CantidadEjercicios > 0 ? Model.CantidadEjercicios : 3;
    var tiempo = Model.TiempoMeditacion > 0 ? Model.TiempoMeditacion : 3;
    string velocidad = Model.VelocidadPreguntas;
    velocidad = string.IsNullOrWhiteSpace(velocidad) ? "1.0" : velocidad.Replace(",", ".");
}

<div id="contenedorConfiguracionFlash">

<form method="post" action="/Flash/Concentracion" id="formConfigSR" class="formulario-flash">

    <div class="form-header">
            <button type="button" class="btn-dashboard" onclick="regresarAlDashboard()">
                <i class="fas fa-home"></i> Regresar al Dashboard
            </button>
            <h2>Ajustes Números Flash</h2>
    </div>

        <div class="form-grid-three-columns">
        <div class="form-column">
            <div>
                <label id="etiquetaNumeroEjercicios">Número de ejercicios:</label>
                <input type="number"
                           name="cantidadEjercicios"
                           id="cantidadEjerciciosInput"
                           min="2"
                           max="100"
                           value="@(cantidad >= 2 && cantidad <= 100 ? cantidad : 5)"
                           required />
            </div>

            <div>
                <label>Número mínimo de dígitos:</label>
                <select name="minDigitos" id="minDigitosSelect">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <option value="@i" selected="@(Model.MinDigitos == i)">@i</option>
                    }
                </select>
            </div>

            <div>
                <label>Número máximo de dígitos:</label>
                <select name="maxDigitos" id="maxDigitosSelect">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <option value="@i" selected="@(Model.MaxDigitos == i)">@i</option>
                    }
                </select>
            </div>

            <div>
                <label>Velocidad entre números:</label>
                <div class="elslider">
                    <input type="range" id="velocidadSlider" min="0.1" max="10" step="0.1" value="@velocidad" style="flex: 1; background-color: #292c4f;" />
                    <input type="number" id="velocidadInput" name="velocidadPreguntas" min="0.1" max="10" step="0.1" value="@velocidad" style="width: 70px; background-color: #292c4f; color: white; border: none; border-radius: 0.5rem; padding: 0.5rem; font-size: 0.95rem;" />
                </div>
            </div>

        </div>
        
        <div class="form-column">

                <div>
                    <label>Tipo de operación:</label>
                    <select name="tipoOperacion" id="tipoOperacionSelect">
                        <option value="suma" selected="@(Model.TipoOperacion == "suma")">Suma</option>
                        <option value="resta" selected="@(Model.TipoOperacion == "resta")">Resta</option>
                        <option value="ambos" selected="@(Model.TipoOperacion == "ambos")">Suma y Resta</option>
                    </select>
                </div>

                <div id="containerSuma">
                    <label class="label-operacion">Dígitos permitidos en SUMA:</label>
                    <div class="tag-input" id="tagInputSuma">
                        <div class="tags-container" id="tagsContainerSuma"></div>
                        <div class="dropdown-toggle">▾</div>
                        <div class="dropdown-options" id="dropdownSuma">
                            <div class="option special" data-action="add-all">➕ Agregar todos</div>
                            <div class="option special" data-action="remove-all">➖ Quitar todos</div>
                            @for (int i = 1; i <= 9; i++)
                            {
                                <div class="option" data-value="@i">@i</div>
                            }
                        </div>
                        <input type="hidden" name="digitosSuma" id="inputHiddenSuma" value="@Model.DigitosSuma" />
                    </div>
                </div>

                <div id="containerResta">
                    <label class="label-operacion">Dígitos permitidos en RESTA:</label>
                    <div class="tag-input" id="tagInputResta">
                        <div class="tags-container" id="tagsContainerResta"></div>
                        <div class="dropdown-toggle">▾</div>
                        <div class="dropdown-options" id="dropdownResta">
                            <div class="option special" data-action="add-all">➕ Agregar todos</div>
                            <div class="option special" data-action="remove-all">➖ Quitar todos</div>
                            @for (int i = 1; i <= 9; i++)
                            {
                                <div class="option" data-value="@i">@i</div>
                            }
                        </div>
                        <input type="hidden" name="digitosResta" id="inputHiddenResta" value="@Model.DigitosResta" />
                    </div>
                </div>

        </div>

        <div class="form-column">

                <div>
                    <label>Activar sonido:</label>
                    <div class="checks">
                        <label><input type="radio" name="activarSonido" value="true" @(Model.ActivarSonido ? "checked" : "") /> Sí</label>
                        <label><input type="radio" name="activarSonido" value="false" @(!Model.ActivarSonido ? "checked" : "") /> No</label>
                    </div>
                </div>
           

            <div>
                <label>Tiempo de concentración:</label>
                <select name="tiempoMeditacion" required>
                    @foreach (var val in new[] { 0, 3, 5, 8, 10 })
                    {
                        <option value="@val" selected="@(tiempo == val)">@val @(val == 0 ? "(sin concentración)" : "")</option>
                    }
                </select>
            </div>

                <div id="controlColores">
                    <label>Colores de los dígitos:</label>
                    <div class="contenedorColores">
                        <div class="color">
                            <label>Color A:</label>
                            <select name="colorA" id="colorA">
                                <option value="color1" selected="@(Model.ColorA == "color1")">Blanco (default)</option>
                                <option value="color2" selected="@(Model.ColorA == "color2")">Verde (default)</option>
                            </select>
                        </div>
                        <div class="color">
                            <label>Color B:</label>
                            <select name="colorB" id="colorB">
                                <option value="color1" selected="@(Model.ColorB == "color1")">Blanco (default)</option>
                                <option value="color2" selected="@(Model.ColorB == "color2")">Verde (default)</option>
                            </select>
                        </div>
                    </div>

                </div>

            <div>
                <button type="submit" class="btn btn-primary">⚡ Iniciar ejercicios</button>
            </div>

        </div>

    </div>
</form>

</div>


<style>

    .contenedorColores{
        display:flex;
        flex-direction:row;
    }

    .color{
        width:50%;
    }

    body {
        background-color: var(--color-bg);
