            gap: 1rem;
            text-align: center;
        }

        .btn-dashboard {
            width: 100%;
            margin-bottom: 1rem;
        }

        .btn.btn-primary {
            font-size: 1rem;
        }

        form#formConfigSR select,
        form#formConfigSR input[type="number"] {
            width: 100%;
        }

        .top-bar-config {
            flex-direction: column;
        }

        .tag-input {
            width: 100%;
        }

        .elslider {
            width: 100%;
        }
