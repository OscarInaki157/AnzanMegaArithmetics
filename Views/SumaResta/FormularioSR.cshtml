@model AnzanMegaArithmetics.Models.ConfSumaRestaModel
@{
    ViewBag.Title = "Ejercicios Sumas y restas";
    Layout = "_LayoutSR";
    var cantidad = Model.CantidadEjercicios > 0 ? Model.CantidadEjercicios : 5;
    var tiempo = Model.TiempoMeditacion > 0 ? Model.TiempoMeditacion : 3;
    var ambosTrue = Model.DirectaSuma && Model.DirectaResta;
}

<h2 style="text-align:center;">🧮 Configuración - Suma y Resta</h2>

<form method="get" asp-controller="Dashboard" asp-action="Dashboard" style="text-align: center; margin-top: 20px;">
    <button type="submit" class="btn btn-secondary">🏠 Regresar al Dashboard</button>
</form>

<form method="post" action="/SumaResta/ConcentracionSR" id="formConfigSR" style="max-width: 900px; margin: 30px auto; padding: 25px; border: 1px solid #ccc; border-radius: 12px; background-color: #f9f9f9;">
    <div class="form-grid">
        <div class="form-column">
            <div>
                <label>Número de ejercicios:</label>
                <select name="cantidadEjercicios" required>
                    @for (int i = 1; i <= 30; i++)
                    {
                        if (i <= 10 || i % 5 == 0)
                        {
                            <option value="@i" selected="@(cantidad == i)">@i</option>
                        }
                    }
                </select>
            </div>

            <div>
                <label>Tiempo de concentración:</label>
                <select name="tiempoMeditacion" required>
                    @foreach (var val in new[] { 0, 2, 3, 5, 8, 10 })
                    {
                        <option value="@val" selected="@(tiempo == val)">@val @(val == 0 ? "(sin concentración)" : "")</option>
                    }
                </select>
            </div>

            <div>
                <label>Número de operaciones por ejercicio:</label>
                <select name="numeroOperaciones" id="numeroOperacionesSelect">
                    @for (int i = 2; i <= 10; i++)
                    {
                        <option value="@i" selected="@(Model.NumeroOperaciones == i)">@i</option>
                    }
                </select>
            </div>

            <div>
                <label>Número máximo de dígitos:</label>
                <select name="maxDigitos" id="maxDigitosSelect">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <option value="@i" selected="@(Model.MaxDigitos == i)">@i</option>
                    }
                </select>
            </div>

            <div>
                <label>Número mínimo de dígitos:</label>
                <select name="minDigitos" id="minDigitosSelect">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <option value="@i" selected="@(Model.MinDigitos == i)">@i</option>
                    }
                </select>
            </div>

            <div>
                <label>Velocidad por ejercicio (segundos):</label>
                <select name="velocidadPreguntas">
                    @for (int i = 0; i <= 10; i++)
                    {
                        <option value="@i" selected="@(Model.VelocidadPreguntas.Equals(i))">@i @(i == 0 ? "(sin límite)" : "")</option>
                    }
                </select>
            </div>

            <div>
                <label>Valor máximo:</label>
                <input type="number" name="valorMaximo" min="0" value="@Model.ValorMaximo"/>
            </div>

            <div id="usarMaxContainer" style="margin-top: 10px;">
                <label>¿El primer número será generado con respecto al máximo?</label>
                <div>
                    <label>
                        <input type="radio" name="usarMaximoComoBase" value="true" @(Model.UsarMaximoComoBase ? "checked" : "") />
                        Sí
                    </label>
                    <label style="margin-left: 15px;">
                        <input type="radio" name="usarMaximoComoBase" value="false" @(!Model.UsarMaximoComoBase ? "checked" : "") />
                        No
                    </label>
                </div>
            </div>

        </div>

        <div class="form-column">
            <div>
                <label>Tipo de operación:</label>
                <select name="tipoOperacion" id="tipoOperacionSelect">
                    <option value="suma" selected="@(Model.TipoOperacion == "suma")">Suma</option>
                    <option value="resta" selected="@(Model.TipoOperacion == "resta")">Resta</option>
                    <option value="ambos" selected="@(Model.TipoOperacion == "ambos")">Suma y Resta</option>
                </select>
            </div>


            <div id="containerSuma" style="margin-top: 20px;">
                <label style="color:black;">Dígitos permitidos en SUMA:</label>
                <div class="tag-input" id="tagInputSuma">
                    <div class="tags-container" id="tagsContainerSuma"></div>
                    <div class="dropdown-toggle">▾</div>
                    <div class="dropdown-options" id="dropdownSuma">
                        <div class="option special" data-action="add-all">➕ Agregar todos</div>
                        <div class="option special" data-action="remove-all">➖ Quitar todos</div>
                        @for (int i = 1; i <= 9; i++)
                        {
                            <div class="option" data-value="@i">@i</div>
                        }
                    </div>
                    <input type="hidden" name="digitosSuma" id="inputHiddenSuma" value="@Model.DigitosSuma" />
                </div>

                <div style="margin-top: 15px;">
                    <label>¿Activar operaciones directas de SUMA?</label>
                    <div>
                        <label>
                            <input type="radio" name="directaSuma" value="true" @(Model.DirectaSuma ? "checked" : "") />
                            Sí
                        </label>
                        <label style="margin-left: 15px;">
                            <input type="radio" name="directaSuma" value="false" @(!Model.DirectaSuma ? "checked" : "") />
                            No
                        </label>
                    </div>
                </div>


            </div>

            <div id="containerResta" style="margin-top: 20px;">
                <label style="color:black;">Dígitos permitidos en RESTA:</label>
                <div class="tag-input" id="tagInputResta">
                    <div class="tags-container" id="tagsContainerResta"></div>
                    <div class="dropdown-toggle">▾</div>
                    <div class="dropdown-options" id="dropdownResta">
                        <div class="option special" data-action="add-all">➕ Agregar todos</div>
                        <div class="option special" data-action="remove-all">➖ Quitar todos</div>
                        @for (int i = 1; i <= 9; i++)
                        {
                            <div class="option" data-value="@i">@i</div>
                        }
                    </div>
                    <input type="hidden" name="digitosResta" id="inputHiddenResta" value="@Model.DigitosResta" />
                </div>
                
                <div style="margin-top: 15px;">
                    <label>¿Activar operaciones directas de RESTA?</label>
                    <div>
                        <label>
                            <input type="radio" name="directaResta" value="true" @(Model.DirectaResta ? "checked" : "") />
                            Sí
                        </label>
                        <label style="margin-left: 15px;">
                            <input type="radio" name="directaResta" value="false" @(!Model.DirectaResta ? "checked" : "") />
                            No
                        </label>
                    </div>
                </div>


            </div>

            <div id="containerDirectaAmbos" style="margin-top: 20px; display:none;">
                <label>¿Activar operaciones directas de SUMA Y RESTA?</label>
                <div>
                    <label>
                        <input type="radio" name="directaAmbos" value="true" @(ambosTrue ? "checked" : "") /> Sí
                    </label>
                    <label style="margin-left: 15px;">
                        <input type="radio" name="directaAmbos" value="false" @(!ambosTrue ? "checked" : "") /> No
                    </label>
                </div>
            </div>

            
        </div>


    </div>

    <div style="margin-top: 30px; text-align:center;">
        <button type="submit" class="btn btn-primary">Iniciar ejercicios</button>
    </div>
</form>

<style>
    form {
        color: #000000;
    }

    .form-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 30px;
        justify-content: space-between;
    }

    .form-column {
        flex: 1 1 48%;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .tag-input {
        border: 1px solid #ccc;
        border-radius: 6px;
        padding: 5px 10px;
        position: relative;
        background-color: white;
        min-height: 42px;
        transition: border 0.2s ease-in-out;
    }

    .input-error {
        border: 2px solid red !important;
    }

    .tags-container {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .tag {
        background-color: #007bff;
        color: white;
        padding: 4px 10px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        font-size: 14px;
    }

        .tag .remove {
            margin-left: 8px;
            cursor: pointer;
            font-weight: bold;
        }

    .dropdown-toggle {
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 20px;
        cursor: pointer;
        color: #555;
        user-select: none;
    }

    .dropdown-options {
        position: absolute;
        left: 0;
        right: 0;
        top: calc(100% + 5px);
        background-color: #fff;
        border: 1px solid #ccc;
        border-radius: 4px;
        max-height: 180px;
        overflow-y: auto;
        z-index: 1000;
        display: none;
    }

    .option {
        padding: 8px 12px;
        cursor: pointer;
        font-size: 14px;
    }

        .option:hover {
            background-color: #f0f0f0;
        }

        .option.special {
            font-weight: bold;
            background-color: #f7f7f7;
            color: #007bff;
        }

            .option.special:hover {
                background-color: #e9e9e9;
            }
</style>



@section Scripts {
    <script>
        function setupTagInput(prefix) {
            const container = document.getElementById(`tagInput${prefix}`);
            const dropdown = document.getElementById(`dropdown${prefix}`);
            const tagsContainer = document.getElementById(`tagsContainer${prefix}`);
            const hiddenInput = document.getElementById(`inputHidden${prefix}`);

            let tags = [];

            container.addEventListener("click", () => {
                dropdown.style.display = dropdown.style.display === "block" ? "none" : "block";
            });

            dropdown.querySelectorAll(".option").forEach(option => {
                const value = option.getAttribute("data-value");
                const action = option.getAttribute("data-action");

                if (action === "add-all") {
                    option.addEventListener("click", () => {
                        tags = [...Array(9).keys()].map(i => (i + 1).toString());
                        renderTags();
                    });
                } else if (action === "remove-all") {
                    option.addEventListener("click", () => {
                        tags = [];
                        renderTags();
                    });
                } else if (value !== null) {
                    option.addEventListener("click", () => {
                        if (!tags.includes(value)) {
                            tags.push(value);
                            renderTags();
                        }
                    });
                }
            });

            function renderTags() {
                tagsContainer.innerHTML = "";
                tags.forEach(val => {
                    const tag = document.createElement("div");
                    tag.className = "tag";
                    tag.innerHTML = `${val}<span class="remove">&times;</span>`;
                    tag.querySelector(".remove").addEventListener("click", () => {
                        tags = tags.filter(t => t !== val);
                        renderTags();
                    });
                    tagsContainer.appendChild(tag);
                });
                hiddenInput.value = tags.join(",");

                if (prefix === "Suma") {
                    document.getElementById("tagInputSuma").classList.remove("input-error");
                }
                if (prefix === "Resta") {
                    document.getElementById("tagInputResta").classList.remove("input-error");
                }
            }

            document.addEventListener("click", (e) => {
                if (!container.contains(e.target)) {
                    dropdown.style.display = "none";
                }
            });
        }

        setupTagInput("Suma");
        setupTagInput("Resta");

        function actualizarVisibilidadOperaciones() {
            const tipo = document.getElementById("tipoOperacionSelect").value;

            const containerSuma = document.getElementById("containerSuma");
            const containerResta = document.getElementById("containerResta");
            const containerDirectaAmbos = document.getElementById("containerDirectaAmbos");

            containerSuma.style.display = (tipo === "suma" || tipo === "ambos") ? "block" : "none";
            containerResta.style.display = (tipo === "resta" || tipo === "ambos") ? "block" : "none";
            containerDirectaAmbos.style.display = tipo === "ambos" ? "block" : "none";

            const directaSumaOptions = document.querySelectorAll('input[name="directaSuma"]');
            const directaRestaOptions = document.querySelectorAll('input[name="directaResta"]');

            if (tipo === "ambos") {
                // Ocultar opciones individuales
                directaSumaOptions.forEach(el => el.closest("div").parentElement.style.display = "none");
                directaRestaOptions.forEach(el => el.closest("div").parentElement.style.display = "none");

                const directaAmbos = document.querySelector('input[name="directaAmbos"]:checked')?.value;
                directaSumaOptions.forEach(r => r.checked = (r.value === directaAmbos));
                directaRestaOptions.forEach(r => r.checked = (r.value === directaAmbos));
            } else {
                directaSumaOptions.forEach(el => el.closest("div").parentElement.style.display = "block");
                directaRestaOptions.forEach(el => el.closest("div").parentElement.style.display = "block");
            }
        }

        document.querySelectorAll('input[name="directaAmbos"]').forEach(el => {
            el.addEventListener("change", () => {
                const val = el.value;
                document.querySelectorAll('input[name="directaSuma"]').forEach(r => {
                    r.checked = (r.value === val);
                });
                document.querySelectorAll('input[name="directaResta"]').forEach(r => {
                    r.checked = (r.value === val);
                });
                actualizarSelectOperacionesDirectas();
            });
        });

        document.getElementById("tipoOperacionSelect").addEventListener("change", actualizarVisibilidadOperaciones);
        actualizarVisibilidadOperaciones();

        let valorPrevioOperaciones = 3;

        function actualizarSelectOperacionesDirectas() {
            const chkSuma = document.querySelector('input[name="directaSuma"]:checked');
            const chkResta = document.querySelector('input[name="directaResta"]:checked');
            const select = document.getElementById("numeroOperacionesSelect");

            const directaActiva = (chkSuma?.value === "true") || (chkResta?.value === "true");

            if (!directaActiva) {
                select.innerHTML = "";
                for (let i = 2; i <= 10; i++) {
                    const opt = document.createElement("option");
                    opt.value = i;
                    opt.textContent = i;
                    if (i == valorPrevioOperaciones) opt.selected = true;
                    select.appendChild(opt);
                }
            } else {
                valorPrevioOperaciones = select.value;
                select.innerHTML = "";
                [2, 3].forEach(num => {
                    const opt = document.createElement("option");
                    opt.value = num;
                    opt.textContent = num;
                    if (num == 3) opt.selected = true;
                    select.appendChild(opt);
                });
            }
        }

        document.querySelectorAll('input[name="directaSuma"]').forEach(el =>
            el.addEventListener("change", actualizarSelectOperacionesDirectas));
        document.querySelectorAll('input[name="directaResta"]').forEach(el =>
            el.addEventListener("change", actualizarSelectOperacionesDirectas));
        actualizarSelectOperacionesDirectas();

        function sincronizarDirectaAmbos() {
            const suma = document.querySelector('input[name="directaSuma"][value="true"]').checked;
            const resta = document.querySelector('input[name="directaResta"][value="true"]').checked;

            const directaAmbosTrue = document.querySelector('input[name="directaAmbos"][value="true"]');
            const directaAmbosFalse = document.querySelector('input[name="directaAmbos"][value="false"]');

            if (suma && resta) {
                if (directaAmbosTrue) directaAmbosTrue.checked = true;
            } else {
                if (directaAmbosFalse) directaAmbosFalse.checked = true;
            }

            actualizarSelectOperacionesDirectas();
        }

        function sincronizarTodosDirectos(origen, valor) {
            document.querySelectorAll('input[name="directaSuma"]').forEach(r => r.checked = (r.value === valor));
            document.querySelectorAll('input[name="directaResta"]').forEach(r => r.checked = (r.value === valor));
            document.querySelectorAll('input[name="directaAmbos"]').forEach(r => r.checked = (r.value === valor));
            actualizarSelectOperacionesDirectas();
        }

        document.querySelectorAll('input[name="directaSuma"], input[name="directaResta"], input[name="directaAmbos"]').forEach(el => {
            el.addEventListener("change", function () {
                const valor = this.value;
                sincronizarTodosDirectos(this.name, valor);
            });
        });

        document.querySelectorAll('input[name="directaSuma"]').forEach(el =>
            el.addEventListener("change", sincronizarDirectaAmbos));
        document.querySelectorAll('input[name="directaResta"]').forEach(el =>
            el.addEventListener("change", sincronizarDirectaAmbos));

        const minDigitosSelect = document.getElementById("minDigitosSelect");
        const maxDigitosSelect = document.getElementById("maxDigitosSelect");

        function actualizarMaximos() {
            const minValue = parseInt(minDigitosSelect.value);
            let maxValue = parseInt(maxDigitosSelect.value);

            if (minValue > maxValue) {
                maxDigitosSelect.value = minValue;
                maxValue = minValue;
            }

            Array.from(maxDigitosSelect.options).forEach(option => {
                option.disabled = parseInt(option.value) < minValue;
            });
        }

        function actualizarMinimos() {
            const maxValue = parseInt(maxDigitosSelect.value);
            let minValue = parseInt(minDigitosSelect.value);

            if (minValue > maxValue) {
                minDigitosSelect.value = maxValue;
                minValue = maxValue;
            }

            Array.from(minDigitosSelect.options).forEach(option => {
                option.disabled = parseInt(option.value) > maxValue;
            });
        }

        minDigitosSelect.addEventListener("change", actualizarMaximos);
        maxDigitosSelect.addEventListener("change", actualizarMinimos);
        actualizarMaximos();
        actualizarMinimos();

        document.getElementById("formConfigSR").addEventListener("submit", function (e) {
            const tipo = document.getElementById("tipoOperacionSelect").value;

            const containerSuma = document.getElementById("tagsContainerSuma");
            const containerResta = document.getElementById("tagsContainerResta");

            const digitosSuma = Array.from(containerSuma.children).map(el => el.innerText.replace("×", "")).join(",");
            const digitosResta = Array.from(containerResta.children).map(el => el.innerText.replace("×", "")).join(",");

            document.getElementById("inputHiddenSuma").value = digitosSuma;
            document.getElementById("inputHiddenResta").value = digitosResta;

            const tagInputSuma = document.getElementById("tagInputSuma");
            const tagInputResta = document.getElementById("tagInputResta");

            tagInputSuma.classList.remove("input-error");
            tagInputResta.classList.remove("input-error");

            let error = false;

            if (tipo === "suma" && digitosSuma === "") {
                tagInputSuma.classList.add("input-error");
                error = true;
            }

            if (tipo === "resta" && digitosResta === "") {
                tagInputResta.classList.add("input-error");
                error = true;
            }

            if (tipo === "ambos") {
                if (digitosSuma === "") {
                    tagInputSuma.classList.add("input-error");
                    error = true;
                }
                if (digitosResta === "") {
                    tagInputResta.classList.add("input-error");
                    error = true;
                }
            }

            if (error) {
                e.preventDefault();
                alert("Debes seleccionar al menos un dígito en los campos correspondientes a SUMA y/o RESTA según el tipo de operación.");
            }

            if (!error) {
                const numOperaciones = parseInt(document.getElementById("numeroOperacionesSelect").value);
                const minDig = parseInt(document.getElementById("minDigitosSelect").value);
                const maxDig = parseInt(document.getElementById("maxDigitosSelect").value);
                const rawValor = document.querySelector('input[name="valorMaximo"]').value.trim();
                const valorMaximo = rawValor === "" || isNaN(rawValor) ? 0 : parseInt(rawValor);



                const sumaDigits = digitosSuma.split(",").map(d => d.trim()).filter(d => d !== "" && d !== "0");
                const restaDigits = digitosResta.split(",").map(d => d.trim()).filter(d => d !== "" && d !== "0");


                function posiblesCombinacionesFiltradas(digitos, minDig, maxDig, valorMax) {
                    let total = 0;

                    function backtrack(actual) {
                        if (actual.length >= minDig && actual.length <= maxDig) {
                            if (!actual.startsWith("0")) {
                                const num = parseInt(actual);
                                if (valorMax === 0 || num <= valorMax) {
                                    total++;
                                }
                            }
                        }

                        if (actual.length >= maxDig) return;

                        for (let d of digitos) {
                            backtrack(actual + d);
                        }
                    }

                    for (let d of digitos) {
                        backtrack(d);
                    }

                    return total;
                }


                let combinacionesSuma = posiblesCombinacionesFiltradas(sumaDigits, minDig, maxDig, valorMaximo);
                let combinacionesResta = posiblesCombinacionesFiltradas(restaDigits, minDig, maxDig, valorMaximo);

                let combinacionesSuficientes = true;

                if (tipo === "suma" && combinacionesSuma < (numOperaciones - 1)) {
                    combinacionesSuficientes = false;
                }

                if (tipo === "resta" && combinacionesResta < (numOperaciones - 1)) {
                    combinacionesSuficientes = false;
                }

                if (tipo === "ambos" && (combinacionesSuma + combinacionesResta) < (numOperaciones - 1)) {
                    combinacionesSuficientes = false;
                }

                if (!combinacionesSuficientes) {
                    e.preventDefault();
                    alert("La configuración no permite generar suficientes combinaciones válidas. Ajusta los dígitos permitidos, el número de dígitos o el valor máximo.");
                }
            }

        });

        function precargarDigitos(prefix, valores) {
            const tagsContainer = document.getElementById(`tagsContainer${prefix}`);
            const hiddenInput = document.getElementById(`inputHidden${prefix}`);

            let tags = valores;

            function renderTags() {
                tagsContainer.innerHTML = "";
                tags.forEach(val => {
                    const tag = document.createElement("div");
                    tag.className = "tag";
                    tag.innerHTML = `${val}<span class="remove">&times;</span>`;
                    tag.querySelector(".remove").addEventListener("click", () => {
                        tags = tags.filter(t => t !== val);
                        renderTags();
                    });
                    tagsContainer.appendChild(tag);
                });
                hiddenInput.value = tags.join(",");
            }

            renderTags();
        }

        const valoresSuma = '@(Model.DigitosSuma ?? "")'.split(',').filter(x => x !== '');
        const valoresResta = '@(Model.DigitosResta ?? "")'.split(',').filter(x => x !== '');

        precargarDigitos("Suma", valoresSuma);
        precargarDigitos("Resta", valoresResta);

        document.addEventListener("DOMContentLoaded", function () {
            actualizarVisibilidadOperaciones();
            sincronizarDirectaAmbos();
            actualizarSelectOperacionesDirectas();

            const sumaTrue = document.querySelector('input[name="directaSuma"][value="true"]').checked;
            const restaTrue = document.querySelector('input[name="directaResta"][value="true"]').checked;

            const directaAmbosTrue = document.querySelector('input[name="directaAmbos"][value="true"]');
            const directaAmbosFalse = document.querySelector('input[name="directaAmbos"][value="false"]');

            if (sumaTrue && restaTrue) {
                if (directaAmbosTrue) directaAmbosTrue.checked = true;
            } else {
                if (directaAmbosFalse) directaAmbosFalse.checked = true;
            }

        });


        function actualizarVisibilidadUsarMaximo() {
            const valorMaximoInput = document.querySelector('input[name="valorMaximo"]');
            const usarMaxContainer = document.getElementById("usarMaxContainer");

            const valor = parseInt(valorMaximoInput.value) || 0;

            usarMaxContainer.style.display = valor === 0 ? "none" : "block";
        }

        const inputValorMaximo = document.querySelector('input[name="valorMaximo"]');
        inputValorMaximo.addEventListener("input", actualizarVisibilidadUsarMaximo);
        actualizarVisibilidadUsarMaximo();

    </script>
}