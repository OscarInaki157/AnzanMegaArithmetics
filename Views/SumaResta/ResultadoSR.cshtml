@using AnzanMegaArithmetics.Models
@{
    ViewBag.Title = "Resumen de Ejercicios Suma y Resta";
    Layout = "_LayoutSR";

    var resultadosJson = TempData["Resultados"] as string;
    var resultados = string.IsNullOrEmpty(resultadosJson)
        ? new List<RSumaRestaModel>()
        : System.Text.Json.JsonSerializer.Deserialize<List<RSumaRestaModel>>(resultadosJson);

    var total = resultados.Count;
    var correctos = resultados.Count(r => r.EsCorrecto && r.Respondido);
    var noRespondidos = resultados.Count(r => !r.Respondido);
    var incorrectos = resultados.Count(r => r.Respondido && !r.EsCorrecto);
    var porcentaje = total > 0 ? (int)((double)correctos / total * 100) : 0;

    string barraColor = porcentaje >= 80 ? "#28a745" : porcentaje >= 50 ? "#ffc107" : "#dc3545";
}

<style>
    body {
        background-color: #161a36;
        color: #d1d1f0;
        font-family: 'Segoe UI', sans-serif;
    }

    h1 {
        text-align: center;
        font-size: 2.5rem;
        margin-top: 30px;
    }

    hr {
        border-color: #4c4cff;
        width: 80%;
        margin: 20px auto;
    }

    .botones-centrados {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin: 30px 0;
        flex-wrap: wrap;
    }

        .botones-centrados button {
            padding: 12px 20px;
            font-size: 1rem;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s ease;
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.3);
        }

    .btn-primary {
        background-color: #4c4cff;
        color: white;
    }

        .btn-primary:hover {
            background-color: #3737e8;
            transform: translateY(-2px);
        }

    .btn-secondary {
        background-color: #292c4f;
        color: white;
    }

        .btn-secondary:hover {
            background-color: #1b1e3c;
            transform: translateY(-2px);
        }

    .btn-success {
        background-color: #28a745;
        color: white;
    }

        .btn-success:hover {
            background-color: #218838;
            transform: translateY(-2px);
        }

    .resumen-contenedor {
        background-color: #1b1e3c;
        border: 2px solid #4c4cff;
        border-radius: 12px;
        padding: 25px 30px;
        margin: 20px auto;
        box-shadow: 0 0 20px rgba(76, 76, 255, 0.1);
        max-width: 800px;
    }

        .resumen-contenedor p {
            font-size: 1.2rem;
        }

    .barra-progreso {
        margin: 0 auto;
        width: 100%;
        max-width: 300px;
        background-color: #292c4f;
        border-radius: 6px;
        height: 22px;
        overflow: hidden;
    }

    .barra-progreso-interna {
        height: 100%;
        transition: width 0.5s ease;
    }

    details {
        margin-bottom: 14px;
        border-radius: 10px;
        background-color: #2a2d56;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }

    summary {
        padding: 14px 20px;
        cursor: pointer;
        font-weight: bold;
        font-size: 1.2rem;
        background-color: #202349;
        color: #ffffff;
        list-style: none;
        position: relative;
        padding-left: 30px;
    }

        summary::before {
            content: "\25B6";
            position: absolute;
            left: 8px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 1rem;
            transition: transform 0.3s ease;
            color: #d1d1f0;
        }

        summary::marker {
            display: none;
        }

    details[open] summary {
        border-bottom: 1px solid #444;
    }

        details[open] summary::before {
            transform: translateY(-50%) rotate(90deg);
        }

    details div {
        padding: 16px 22px;
        font-size: 1.1rem;
        background-color: #1b1e3c;
    }

        details div p {
            margin-bottom: 10px;
        }

    .correcto {
        color: #28a745;
    }

    .incorrecto {
        color: #dc3545;
    }

    .norespondido {
        color: gray;
    }

    @@media (max-width: 768px) {
        h1 {
            font-size: 2rem;
        }

        .resumen-contenedor {
            padding: 20px;
        }

        .botones-centrados {
            flex-direction: column;
            align-items: center;
        }

            .botones-centrados button {
                width: 100%;
                max-width: 300px;
            }

        summary {
            font-size: 1rem;
        }
    }
</style>

<h1>📊 Resumen de Ejercicios - Suma y Resta</h1>
<hr />

<div class="botones-centrados">
    <form method="post" asp-action="FormularioSR">
        <input type="hidden" name="cantidadEjercicios" value="@TempData.Peek("CantidadEjercicios")" />
        <input type="hidden" name="numeroOperaciones" value="@TempData.Peek("NumeroOperaciones")" />
        <input type="hidden" name="minDigitos" value="@TempData.Peek("MinDigitos")" />
        <input type="hidden" name="maxDigitos" value="@TempData.Peek("MaxDigitos")" />
        <input type="hidden" name="velocidadPreguntas" value="@TempData.Peek("VelocidadPreguntas")" />
        <input type="hidden" name="valorMaximo" value="@TempData.Peek("ValorMaximo")" />
        <input type="hidden" name="usarMaximoComoBase" value="@(Convert.ToBoolean(TempData.Peek("UsarMaximoComoBase")) ? "true" : "false")" />
        <input type="hidden" name="tipoOperacion" value="@TempData.Peek("TipoOperacion")" />
        <input type="hidden" name="tiempoMeditacion" value="@TempData.Peek("TiempoMeditacion")" />
        <input type="hidden" name="digitosSuma" value="@TempData.Peek("DigitosSuma")" />
        <input type="hidden" name="digitosResta" value="@TempData.Peek("DigitosResta")" />
        <input type="hidden" name="directaSuma" value="@(Convert.ToBoolean(TempData.Peek("DirectaSuma")) ? "true" : "false")" />
        <input type="hidden" name="directaResta" value="@(Convert.ToBoolean(TempData.Peek("DirectaResta")) ? "true" : "false")" />
        <button type="submit" class="btn-primary">⚙️ Ir a configuración</button>
    </form>

    <form method="post" asp-action="ConcentracionSR">
        <input type="hidden" name="cantidadEjercicios" value="@TempData.Peek("CantidadEjercicios")" />
        <input type="hidden" name="numeroOperaciones" value="@TempData.Peek("NumeroOperaciones")" />
        <input type="hidden" name="minDigitos" value="@TempData.Peek("MinDigitos")" />
        <input type="hidden" name="maxDigitos" value="@TempData.Peek("MaxDigitos")" />
        <input type="hidden" name="velocidadPreguntas" value="@TempData.Peek("VelocidadPreguntas")" />
        <input type="hidden" name="valorMaximo" value="@TempData.Peek("ValorMaximo")" />
        <input type="hidden" name="usarMaximoComoBase" value="@(Convert.ToBoolean(TempData.Peek("UsarMaximoComoBase")) ? "true" : "false")" />
        <input type="hidden" name="tipoOperacion" value="@TempData.Peek("TipoOperacion")" />
        <input type="hidden" name="tiempoMeditacion" value="@TempData.Peek("TiempoMeditacion")" />
        <input type="hidden" name="digitosSuma" value="@TempData.Peek("DigitosSuma")" />
        <input type="hidden" name="digitosResta" value="@TempData.Peek("DigitosResta")" />
        <input type="hidden" name="directaSuma" value="@(Convert.ToBoolean(TempData.Peek("DirectaSuma")) ? "true" : "false")" />
        <input type="hidden" name="directaResta" value="@(Convert.ToBoolean(TempData.Peek("DirectaResta")) ? "true" : "false")" />
        <button type="submit" class="btn-success">🔁 Repetir (misma configuración)</button>
    </form>

    <form method="get" asp-controller="Dashboard" asp-action="Dashboard">
        <button type="submit" class="btn-secondary">🏠 Regresar al dashboard</button>
    </form>
</div>

<div class="resumen-contenedor">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 40px;">
        <div style="flex: 1;">
            <p>📄 Total de ejercicios: <strong>@total</strong></p>
            <p>✅ Correctos: <strong>@correctos</strong></p>
            <p>❌ Incorrectos: <strong>@incorrectos</strong></p>
            <p>⛔ No respondidos: <strong>@noRespondidos</strong></p>
        </div>
        <div style="flex: 1; text-align: center;">
            <p>🌟 Porcentaje de éxito: <strong>@porcentaje%</strong></p>
            <div class="barra-progreso">
                <div class="barra-progreso-interna" style="width: @porcentaje%; background-color: @barraColor;"></div>
            </div>
        </div>
    </div>
</div>

<div style="max-width: 800px; margin: 0 auto;">
    @for (int i = 0; i < resultados.Count; i++)
    {
        var r = resultados[i];
        var colorClass = !r.Respondido ? "norespondido" : r.EsCorrecto ? "correcto" : "incorrecto";
        var estado = !r.Respondido ? "⛔ No respondió" : r.EsCorrecto ? "✅ Correcto" : "❌ Incorrecto";

        <details>
            <summary class="@colorClass">
                Ejercicio @(i + 1): @estado
            </summary>
            <div>
                <p>🧠 <strong>Ejercicio:</strong> @r.OperacionTexto</p>
                <p>✔️ <strong>Respuesta correcta:</strong> @r.RespuestaCorrecta</p>
                <p>✍️ <strong>Tu respuesta:</strong> @(r.Respondido ? r.RespuestaUsuario.ToString() : "No respondió")</p>
            </div>
        </details>
    }
</div>
