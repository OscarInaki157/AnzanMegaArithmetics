@section Scripts {
    <script>
        const velocidad = parseFloat("@velocidad");
        const contador = document.getElementById("contador");

        if (velocidad > 0 && contador) {
            let tiempo = velocidad;
            const intervalo = setInterval(() => {
                tiempo -= 0.1;
                if (tiempo <= 0) {
                    clearInterval(intervalo);

                    const inputRespuesta = document.querySelector("input[name='respuesta']");
                    const respondido = document.getElementById("respondido");

                    if (inputRespuesta.value.trim() !== "") {
                        respondido.value = "true";
                    } else {
                        respondido.value = "false";
                    }

                    document.getElementById("formRespuesta").submit();
                } else {
                    contador.textContent = tiempo.toFixed(1);
                }
            }, 100);
        }


        const form = document.getElementById("formRespuesta");
        const inputRespuesta = form.querySelector("input[name='respuesta']");
        const respondidoField = document.getElementById("respondido");

        form.addEventListener("submit", function (e) {
            if (!inputRespuesta.value.trim()) {
                respondidoField.value = "false";
            }
        });

        function enviarYFinalizar() {
            const formRespuesta = document.getElementById("formRespuesta");
            const inputRespuesta = formRespuesta.querySelector("input[name='respuesta']");
            const respondido = document.getElementById("respondido");

            if (!inputRespuesta.value.trim()) {
                respondido.value = "false";
            }

            formRespuesta.action = "/SumaResta/FinalizarSR";
            formRespuesta.submit();
            return false; 
        }

         function mostrarTab(tab) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));

            document.querySelector(`.tab-btn[onclick*="${tab}"]`).classList.add('active');
            document.getElementById(`tab-${tab}`).classList.add('active');
        }


        // manos
        function iluminarDedo(num) {
            const punto = document.querySelector(`.punto.dedo${num}`);
            const dedoSvg = document.getElementById(`dedo${num}`);
            punto?.classList.add('iluminado');
            dedoSvg?.classList.add('iluminado');
        }

        function desiluminarDedo(num) {
            const punto = document.querySelector(`.punto.dedo${num}`);
            const dedoSvg = document.getElementById(`dedo${num}`);
            punto?.classList.remove('iluminado');
            dedoSvg?.classList.remove('iluminado');
        }

        function estaIluminado(num) {
            const punto = document.querySelector(`.punto.dedo${num}`);
            return punto?.classList.contains('iluminado');
        }

        document.querySelectorAll('.punto').forEach(p => {
            p.addEventListener('click', function () {
                const clases = [...this.classList];
                const claseDedo = clases.find(c => c.startsWith('dedo') && c !== 'dedo');
                const numDedo = parseInt(claseDedo.replace('dedo', ''));

                const iluminado = estaIluminado(numDedo);

                // Mano izquierda (dedos 1 al 4)
                if (numDedo >= 1 && numDedo <= 4) {
                    if (iluminado) {
                        for (let i = 1; i <= numDedo; i++) desiluminarDedo(i);
                    } else {
                        for (let i = numDedo; i <= 4; i++) iluminarDedo(i);
                    }
                }

                // Pulgar izquierdo y derecho
                if (numDedo === 5 || numDedo === 6) {
                    iluminado ? desiluminarDedo(numDedo) : iluminarDedo(numDedo);
                }

                // Mano derecha (dedos 7 al 10)
                if (numDedo >= 7 && numDedo <= 10) {
                    if (iluminado) {
                        for (let i = numDedo; i <= 10; i++) desiluminarDedo(i);
                    } else {
                        for (let i = 7; i <= numDedo; i++) iluminarDedo(i);
                    }
                }
            });
        });



    </script>
}
