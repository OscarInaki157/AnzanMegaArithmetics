<div class="top-bar">

    <form id="formFinalizar" class="form-fin" method="post" onsubmit="return enviarYFinalizar();">
        <button type="submit" class="btn-finalizar">
            ❌ <span>Finalizar</span>
        </button>
    </form>


    <div class="barra-progreso-contenedor">
        <div class="barra-progreso">
            <div class="progreso-interno" style="width:@porcentaje%"></div>
            <span class="progreso-texto">@ejercicioActual / @totalEjercicios</span>
        </div>
    </div>

    <div class="info-tiempo">
        @if (velocidad > 0)
        {
            <span>⏱ <span id="contador" class="contador">@velocidad.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span> s</span>
        }
        else
        {
            <span class="modo-libre">⏱ <strong>Modo sin límite de tiempo</strong></span>
        }
    </div>
</div>

<div class="ejercicio-wrapper">
    <div class="areaej">

        @* Ejercicio *@

        <div class="Ejercicio">
            <div class="Numeros">
                @for (int i = 0; i < numeros.Count; i++)
                {
                    <div>@(operaciones[i] == "-" ? "-" : "") @numeros[i]</div>
                }
            </div>
            <hr class="linea"/>
            <form method="post" asp-action="ResultadoSR" id="formRespuesta" class="Forms">
                <input type="number" name="respuesta" placeholder="Resultado" autofocus autocomplete="off" class="Resultados"/>
                <input type="hidden" id="respondido" name="respondido" value="true" />
                <br />
                <button type="submit" class="btn-enviar-respuesta">Enviar respuesta</button>
            </form>
        </div>

        @* Bloque interactivo *@

        <div class="ayuda-tabs-container">
            <div class="tabs">
                <button class="tab-btn active" onclick="mostrarTab('manos')">✋ Manos</button>
                <button class="tab-btn" onclick="mostrarTab('soroban')">🧮 Soroban</button>
            </div>
            <div class="tab-content active" id="tab-manos">
                
                <div id="contenedorManos">

                  
