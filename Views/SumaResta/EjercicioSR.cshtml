    }

    .modo-libre {
        color: #ffffff;
    }

    .form-fin {
        margin: 0;
    }

    .ejercicio-wrapper {
        margin: 0 auto;
        text-align: center;
        padding: 1rem;
    }


    .form-respuesta-barra {
        width: 100%;
        margin: 0 auto;
