@model AnzanMegaArithmetics.Models.ConfLecturaFingerModel

@{
    ViewBag.Title = "Fingermath Lectura";
    Layout = "_LayoutFinger";
}

<style>
    :root {
        --color-bg: #161a36;
        --color-card-bg: #1b1e3c;
        --color-primary: #4c4cff;
        --color-primary-dark: #3737e8;
        --color-light: #d1d1f0;
        --color-text: #d1d1f0;
        --color-accent: #6233b8;
        --color-danger: #df312c;
    }

    body {
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
    }

    h2 {
        text-align: center;
        margin-bottom: 1.5rem;
        color: var(--color-light);
        font-weight: 600;
        font-size: 1.8rem;
    }

    #configuracionEjercicios {
        max-width: 550px;
        margin: 1rem auto 2rem auto;
        padding: 2rem;
        border-radius: 1rem;
        background-color: var(--color-card-bg);
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.4);
        color: var(--color-light);
        animation: fadeIn 0.4s ease;
    }

        #configuracionEjercicios div {
            margin-bottom: 1.5rem;
        }

        #configuracionEjercicios label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            font-size: 1rem;
        }

        #configuracionEjercicios input[type="number"],
        #configuracionEjercicios select {
            width: 100%;
            padding: 0.7rem;
            border: none;
            border-radius: 0.5rem;
            background-color: #292c4f;
            color: white;
            font-size: 1rem;
        }

        #configuracionEjercicios input::placeholder {
            color: #a0a0d0;
        }

        #configuracionEjercicios small {
            display: block;
            margin-top: 0.4rem;
            color: #aaa;
            font-size: 0.85rem;
        }

        #configuracionEjercicios button[type="submit"] {
            background-color: var(--color-primary);
            color: white;
            padding: 0.9rem 1.2rem;
            font-size: 1.1rem;
            font-weight: bold;
            border: none;
            border-radius: 0.6rem;
            cursor: pointer;
            transition: transform 0.2s ease, background-color 0.3s ease, box-shadow 0.3s ease;
            width: 100%;
            box-shadow: 0 4px 12px rgba(76, 76, 255, 0.3);
        }

            #configuracionEjercicios button[type="submit"]:hover {
                background-color: var(--color-primary-dark);
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(76, 76, 255, 0.5);
            }

    /* === Botón Dashboard personalizado === */

    .dashboard-button-wrapper {
        display: flex;
        justify-content: center;
        margin-bottom: 2rem;
    }

    .btn-dashboard {
        background-color: var(--color-primary);
        color: white;
        padding: 0.8rem 1.8rem;
        border: none;
        border-radius: 0.6rem;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(76, 76, 255, 0.3);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
    }

        .btn-dashboard i {
            font-size: 1.1rem;
        }

        .btn-dashboard:hover {
            background-color: var(--color-primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(76, 76, 255, 0.5);
        }


    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* === Responsive === */
    @@media (max-width: 600px) {
        #configuracionEjercicios, .btn-dashboard

    {
        padding: 1.5rem;
        font-size: 0.95rem;
    }

    h2 {
        font-size: 1.5rem;
    }

    #configuracionEjercicios button,
    .btn-dashboard {
        font-size: 1rem;
    }

    }
</style>

<div class="dashboard-button-wrapper">
    <form method="get" asp-controller="Dashboard" asp-action="Dashboard">
        <button type="submit" class="btn-dashboard">
            <i class="fas fa-home"></i> Regresar al dashboard
        </button>
    </form>
</div>

<h2>Ajustes Lectura FingerMath</h2>

<form id="configuracionEjercicios" method="post" asp-controller="Fingermath" asp-action="Concentracion">
    <div>
        <label asp-for="CantidadEjercicios"></label>
        <input asp-for="CantidadEjercicios" type="number" min="1"/>
        <span asp-validation-for="CantidadEjercicios" class="text-danger"></span>
        <small>Indica cuántos ejercicios deseas realizar en esta sesión.</small>
    </div>

    <div>
        <label asp-for="TipoPregunta"></label>
        <select asp-for="TipoPregunta">
            <option value="ambas">Ejercicios con ambas manos</option>
            <option value="izquierda">Ejercicios con mano izquierda</option>
            <option value="derecha">Ejercicios con mano derecha</option>
        </select>
        <span asp-validation-for="TipoPregunta" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="VelocidadPreguntas"></label>

        <select asp-for="VelocidadPreguntas">
            <option value="0">0 (sin límite)</option>
            <option value="0.2">0.2</option>
            <option value="0.3">0.3</option>
            <option value="0.4">0.4</option>
            <option value="0.5">0.5</option>
            <option value="0.6">0.6</option>
            <option value="0.7">0.7</option>
            <option value="0.8">0.8</option>
            <option value="0.9">0.9</option>
            <option value="1">1</option>
            <option value="1.5">1.5</option>
            <option value="2">2</option>
            <option value="2.5">2.5</option>
            <option value="3">3</option>
            <option value="3.5">3.5</option>
            <option value="4">4</option>
            <option value="4.5">4.5</option>
            <option value="5">5</option>
            <option value="6">6</option>
            <option value="7">7</option>
            <option value="8">8</option>
            <option value="9">9</option>
            <option value="10">10</option>
        </select>

        <span asp-validation-for="VelocidadPreguntas" class="text-danger"></span>
        <small>Selecciona el tiempo que se mostrará cada ejercicio. 0 = sin límite.</small>
    </div>

    <div>
        <label asp-for="TiempoMeditacion"></label>
        <select asp-for="TiempoMeditacion">
            <option value="0" selected="@(Model.TiempoMeditacion == 0 ? "selected" : null)">0 (sin concentración)</option>
            <option value="2" selected="@(Model.TiempoMeditacion == 2 ? "selected" : null)">2</option>
            <option value="3" selected="@(Model.TiempoMeditacion == 3 ? "selected" : null)">3</option>
            <option value="5" selected="@(Model.TiempoMeditacion == 5 ? "selected" : null)">5</option>
            <option value="8" selected="@(Model.TiempoMeditacion == 8 ? "selected" : null)">8</option>
            <option value="10" selected="@(Model.TiempoMeditacion == 10 ? "selected" : null)">10</option>
        </select>
        <span asp-validation-for="TiempoMeditacion" class="text-danger"></span>
    </div>

    <button type="submit">🚀 Iniciar Ejercicios de Lectura</button>
</form>
