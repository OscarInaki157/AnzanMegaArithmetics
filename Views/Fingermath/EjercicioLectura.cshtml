@{
    ViewBag.Title = "Ejercicio de Lectura Fingermath";
    Layout = "_LayoutFinger";

    var dedosIzquierda = ViewBag.DedosIzquierda as int[] ?? new int[] { };
    var dedosDerecha = ViewBag.DedosDerecha as int[] ?? new int[] { };
    float velocidad = (ViewBag.VelocidadPreguntas);
}
<div class="fin-wrapper">
    <form method="post" asp-action="FinalizarLectura" class="form-fin">
        <button type="submit" class="btn-finalizar">🚪 Finalizar ejercicios</button>
    </form>
</div>


<div class="ejercicio-wrapper">
    <div class="info-panel">
        <p>📄 Ejercicio <strong>@ViewBag.EjercicioActual</strong> de <strong>@ViewBag.TotalEjercicios</strong></p>
        <p>
            @if (velocidad > 0)
            {
                <span>⏱ Tiempo restante: <span id="contador" class="contador">@velocidad.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span> segundos</span>
            }
            else
            {
                <span>⏱ <strong>Modo sin límite de tiempo</strong></span>
            }
        </p>
    </div>

    <div class="manos-wrapper">
        <!-- Mano Izquierda -->
        <div class="mano-container">
            <img src="/Content/Images/mano-izquierda.png" class="mano-img" alt="Mano izquierda" />
            <div class="punto dedo1"></div>
            <div class="punto dedo2"></div>
            <div class="punto dedo3"></div>
            <div class="punto dedo4"></div>
            <div class="punto dedo5"></div>
        </div>

        <!-- Mano Derecha -->
        <div class="mano-container">
            <img src="/Content/Images/mano-derecha.png" class="mano-img" alt="Mano derecha" />
            <div class="punto dedo6"></div>
            <div class="punto dedo7"></div>
            <div class="punto dedo8"></div>
            <div class="punto dedo9"></div>
            <div class="punto dedo10"></div>
        </div>
    </div>

    <form method="post" asp-action="ResultadoLectura" id="formRespuesta" class="form-respuesta">
        <label for="respuesta">RESULTADO:</label>
        <input type="number" id="respuesta" name="respuesta" required />

        <input type="hidden" name="respuestaCorrecta" value="@ViewBag.RespuestaCorrecta" />
        <input type="hidden" id="respondido" name="respondido" value="true" />
        <input type="hidden" name="tipoPregunta" value="@ViewBag.TipoPregunta" />
        <input type="hidden" name="velocidadPreguntas" value="@ViewBag.VelocidadPreguntas" />

        <button type="submit">Enviar respuesta</button>
    </form>
</div>

<style>
    body {
        background-color: #161a36;
        color: white;
        font-family: 'Segoe UI', sans-serif;
    }

    .fin-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 10px;
        margin-bottom: 10px;
    }

    .form-fin {
        margin: 0;
    }


    .ejercicio-wrapper {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px;
        text-align: center;
    }

    .info-panel {
        font-size: 1.2rem;
        margin-bottom: 20px;
        animation: fadeIn 0.6s ease;
    }

    .contador {
        color: #4c4cff;
        font-weight: bold;
        font-size: 1.6rem;
        animation: pulse 1s infinite ease-in-out;
    }

    .btn-finalizar {
        background-color: #df312c;
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 10px;
        font-size: 1rem;
        cursor: pointer;
        transition: transform 0.2s ease;
    }

        .btn-finalizar:hover {
            background-color: #b22222;
            transform: scale(1.05);
        }

    .manos-wrapper {
        display: flex;
        justify-content: center;
        gap: 60px;
        flex-wrap: wrap;
        margin-bottom: 40px;
    }

    .mano-container {
        position: relative;
        width: 250px;
    }

    .mano-img {
        width: 100%;
        height: auto;
    }

    .punto {
        width: 20px;
        height: 20px;
        background-color: gray;
        border-radius: 50%;
        position: absolute;
        opacity: 0.5;
        transition: all 0.3s ease;
    }

        .punto.iluminado {
            background-color: #ff4c4c;
            opacity: 1;
            box-shadow: 0 0 10px #ff4c4c;
        }

    .form-respuesta {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        margin-top: 30px;
    }

        .form-respuesta label {
            font-size: 1.2rem;
            font-weight: bold;
        }

        .form-respuesta input[type="number"] {
            padding: 10px;
            font-size: 1rem;
            border-radius: 8px;
            border: none;
            width: 200px;
            text-align: center;
        }

        .form-respuesta button {
            margin-top: 10px;
            padding: 10px 20px;
            background-color: #4c4cff;
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .form-respuesta button:hover {
                background-color: #3737e8;
                transform: translateY(-2px);
                box-shadow: 0 6px 15px rgba(76, 76, 255, 0.3);
            }

    /* Dedos */
    .dedo1 {
        top: 30px;
        left: 30px;
    }

    .dedo2 {
        top: 10px;
        left: 60px;
    }

    .dedo3 {
        top: 0px;
        left: 100px;
    }

    .dedo4 {
        top: 10px;
        left: 140px;
    }

    .dedo5 {
        top: 30px;
        left: 180px;
    }

    .dedo6 {
        top: 30px;
        left: 30px;
    }

    .dedo7 {
        top: 10px;
        left: 60px;
    }

    .dedo8 {
        top: 0px;
        left: 100px;
    }

    .dedo9 {
        top: 10px;
        left: 140px;
    }

    .dedo10 {
        top: 30px;
        left: 180px;
    }

    @@keyframes pulse {
        0%

    {
        transform: scale(1);
        opacity: 1;
    }

    50% {
        transform: scale(1.2);
        opacity: 0.7;
    }

    100% {
        transform: scale(1);
        opacity: 1;
    }

    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@media (max-width: 768px) {
        .manos-wrapper

    {
        flex-direction: column;
        gap: 30px;
    }

    .mano-container {
        width: 200px;
    }

    .form-respuesta input[type="number"] {
        width: 100%;
        max-width: 300px;
    }

    }
</style>

<script>
    const dedosIzquierda = @Html.Raw(Json.Serialize(ViewBag.DedosIzquierda));
    const dedosDerecha = @Html.Raw(Json.Serialize(ViewBag.DedosDerecha));

    dedosIzquierda.forEach(num => {
        const punto = document.querySelector(`.dedo${num}`);
        if (punto) punto.classList.add('iluminado');
    });

    dedosDerecha.forEach(num => {
        const punto = document.querySelector(`.dedo${num}`);
        if (punto) punto.classList.add('iluminado');
    });

    const velocidad = parseFloat("@String.Format(System.Globalization.CultureInfo.InvariantCulture, "{0:0.0}", ViewBag.VelocidadPreguntas)");
    const contadorElemento = document.getElementById("contador");

    if (velocidad > 0) {
        let tiempoRestante = velocidad;
        contadorElemento.textContent = tiempoRestante.toFixed(1);

        const interval = setInterval(() => {
            tiempoRestante -= 0.1;

            if (tiempoRestante <= 0) {
                clearInterval(interval);
                contadorElemento.textContent = "0.0";
                document.getElementById("respondido").value = "false";

                const formRespuesta = document.getElementById("formRespuesta");
                if (formRespuesta) {
                    formRespuesta.submit();
                }
            } else {
                contadorElemento.textContent = tiempoRestante.toFixed(1);
            }
        }, 100);
    }

    window.onload = () => {
        document.getElementById("respuesta").focus();
    };
</script>
