@{
    ViewBag.Title = "Ejercicio de Escritura - Fingermath";
    Layout = "_LayoutFinger";

    string tipo = ViewBag.TipoPregunta;
    float velocidad = (ViewBag.VelocidadPreguntas);
    int numeroObjetivo = ViewBag.NumeroObjetivo;
}

<h1>✍️ Ejercicio de Escritura</h1>
<p>Ejercicio @ViewBag.EjercicioActual de @ViewBag.TotalEjercicios</p>
<div>
    @if (velocidad > 0)
    {
        <p>
            <strong>Tiempo restante:</strong>
            <span id="contador">@String.Format(System.Globalization.CultureInfo.InvariantCulture, "{0:0.0}", velocidad)</span> segundos
        </p>
    }
    else
    {
        <p><strong>Modo sin límite de tiempo</strong></p>
    }
</div>

<form id="finalizarForm" method="post" asp-action="FinalizarEscritura" style="margin-bottom: 20px;">
    <button type="submit" class="btn btn-danger">🚪 Finalizar</button>
</form>


<h2 style="font-size: 4rem; color: #007bff;">@numeroObjetivo</h2>



<form id="formulario" method="post" asp-action="ResultadoEscritura">
    <input type="hidden" id="respuesta" name="respuesta" />
    <input type="hidden" id="respondido" name="respondido" value="true" />

    <input type="text" id="tecladoInvisible" style="position: absolute; opacity: 0;" />

    <div style="display: flex; gap: 40px; margin-top: 20px; justify-content: center;">
        <div class="mano-container">
            <img src="/Content/Images/mano-izquierda.png" class="mano-img" />
            <div class="punto dedo" data-valor="10" style="top: 30px; left: 30px;"></div>
            <div class="punto dedo" data-valor="10" style="top: 10px; left: 60px;"></div>
            <div class="punto dedo" data-valor="10" style="top: 0px; left: 100px;"></div>
            <div class="punto dedo" data-valor="10" style="top: 10px; left: 140px;"></div>
            <div class="punto dedo" data-valor="50" style="top: 30px; left: 180px;"></div> @* pulgar *@
        </div>

        <div class="mano-container">
            <img src="/Content/Images/mano-derecha.png" class="mano-img" />
            <div class="punto dedo" data-valor="5" style="top: 30px; left: 30px;"></div> @* pulgar *@
            <div class="punto dedo" data-valor="1" style="top: 10px; left: 60px;"></div>
            <div class="punto dedo" data-valor="1" style="top: 0px; left: 100px;"></div>
            <div class="punto dedo" data-valor="1" style="top: 10px; left: 140px;"></div>
            <div class="punto dedo" data-valor="1" style="top: 30px; left: 180px;"></div>
        </div>
    </div>
    <br />
    <button type="submit" class="btn btn-success">Enviar respuesta</button>
</form>

<style>

    .btn-danger {
        background-color: #dc3545;
        color: white;
        padding: 10px 15px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }

    .mano-container {
        position: relative;
        width: 250px;
    }

    .mano-img {
        width: 100%;
        height: auto;
    }

    .punto {
        width: 20px;
        height: 20px;
        background-color: gray;
        border-radius: 50%;
        position: absolute;
        opacity: 0.5;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .punto.iluminado {
            background-color: red;
            opacity: 1;
        }
</style>

<script>
    let suma = 0;
    let finalizando = false;

    const respuestaInput = document.getElementById("respuesta");
    const tecladoInvisible = document.getElementById("tecladoInvisible");

    document.getElementById("finalizarForm")?.addEventListener("submit", () => {
        finalizando = true;
    });

    document.querySelectorAll('.punto').forEach(p => {
        p.addEventListener('click', function () {
            const valor = parseInt(this.dataset.valor);
            if (this.classList.contains('iluminado')) {
                this.classList.remove('iluminado');
                suma -= valor;
            } else {
                this.classList.add('iluminado');
                suma += valor;
            }
            respuestaInput.value = suma;
            setTimeout(() => tecladoInvisible.focus(), 50);
        });
    });

    const velocidad = parseFloat("@String.Format(System.Globalization.CultureInfo.InvariantCulture, "{0:0.0}", velocidad)");
    const contadorElemento = document.getElementById("contador");

    if (velocidad > 0) {
        let tiempoRestante = velocidad;
        contadorElemento.textContent = tiempoRestante.toFixed(1);

        const interval = setInterval(() => {
            tiempoRestante -= 0.1;

            if (tiempoRestante <= 0) {
                clearInterval(interval);
                contadorElemento.textContent = "0.0";
                if (!finalizando) {
                    document.getElementById("respondido").value = "false";
                    document.getElementById("formulario").submit();
                }
            } else {
                contadorElemento.textContent = tiempoRestante.toFixed(1);
            }
        }, 100);
    }

    function enfocarInputInvisible() {
        if (tecladoInvisible) {
            tecladoInvisible.focus();
            requestAnimationFrame(() => {
                if (document.activeElement !== tecladoInvisible) {
                    tecladoInvisible.focus();
                }
            });
        }
    }

    window.onload = enfocarInputInvisible;
</script>