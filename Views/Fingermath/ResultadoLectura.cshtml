@using AnzanMegaArithmetics.Models
@{
    ViewBag.Title = "Resumen de Ejercicios";
    Layout = "_LayoutGeneral";

    var resultadosJson = TempData["Resultados"] as string;
    var resultados = string.IsNullOrEmpty(resultadosJson)
        ? new List<RLecturaFingerModel>()
        : System.Text.Json.JsonSerializer.Deserialize<List<RLecturaFingerModel>>(resultadosJson);

    var total = resultados.Count;
    var correctos = resultados.Count(r => r.EsCorrecto);
    var porcentaje = total > 0 ? (int)((double)correctos / total * 100) : 0;

    string barraColor = porcentaje >= 79 ? "#28a745" : porcentaje >= 49 ? "#ffc107" : "#dc3545";
}

<style>
    body {
        background-color: var(--color-bg);
        color: var(--color-tex);
    }

    h1 {
        text-align: center;
        font-size: 2rem;
        margin-top: 10px;
        margin-bottom: 0.5rem;
    }

    hr {
        border-color: #4c4cff;
        width: 80%;
        margin: 10px auto 30px auto;
    }

    .botones-centrados {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin: 30px 0;
        flex-wrap: wrap;
    }

        .botones-centrados button {
            padding: 12px 20px;
            font-size: 1rem;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s ease;
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.3);
        }

    .btn-primary {
        background-color: #4c4cff;
        color: white;
    }

        .btn-primary:hover {
            background-color: #3737e8;
            transform: translateY(-2px);
        }

    .btn-secondary {
        background-color: #292c4f;
        color: white;
    }

        .btn-secondary:hover {
            background-color: #1b1e3c;
            transform: translateY(-2px);
        }

    .btn-success {
        background-color: #28a745;
        color: white;
    }

        .btn-success:hover {
            background-color: #218838;
            transform: translateY(-2px);
        }

        .resultados{
            display: flex; 
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
        }

        .cont-onl{
            flex: 1 1 50%;
        }

    .resumen-grid-contenedor {
        background-color: #1b1e3c;
        border: 2px solid #4c4cff;
        border-radius: 12px;
        padding: 25px 30px;
        box-shadow: 0 0 20px rgba(76, 76, 255, 0.1);
        margin: 0 auto 30px auto;
        max-width: 1200px;
    }

    .contenedores-resumen {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
    }

    .resultados-con-glow {
        background-color: #1b1e3c;
        border: 2px solid #4c4cff;
        border-radius: 12px;
        padding: 20px 20px;
        box-shadow: 0 0 20px rgba(76, 76, 255, 0.3);
        margin: 0 auto 30px auto;
        max-width: 1200px;
    }


    .card-resumen {
        flex: 1 1 110px;
        max-width: 130px;
        min-width:90px;
        background-color: #292c4f;
        border-radius: 12px;
        padding: 10px;
        text-align: center;
        box-shadow: 0 0 10px rgba(76, 76, 255, 0.4);
        color: white;
        transition: transform 0.3s ease;
    }


        .card-resumen:hover {
            transform: scale(1.05);
        }

    .card-titulo {
        font-size: 1rem;
        font-weight: 500;
        margin-bottom: 10px;
    }

    .card-icono {
        font-size: 1.5rem;
        margin-bottom: 8px;
    }

    .card-valor {
        font-size: 1.6rem;
        font-weight: bold;
    }

    .card-resumen.total {
        background-color: #00acc1;
    }


    .card-resumen.correctos {
        background-color: #28a745;
    }

    .card-resumen.incorrectos {
        background-color: #dc3545;
    }

    .card-resumen.experiencia {
        background-color: #4c4cff;
    }


        .resumen-grid-contenedor p {
            font-size: 1.3rem;
            margin: 10px 0;
        }

    .barra-progreso {
        margin: 0 auto;
        width: 100%;
        max-width: 300px;
        background-color: #292c4f;
        border-radius: 6px;
        height: 22px;
        overflow: hidden;
    }

    .barra-progreso-interna {
        height: 100%;
        transition: width 0.5s ease;
    }

    .container-barrap{
        flex: 1 1 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .grid-acordeones {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        max-width: 1200px;
        margin: 0 auto 50px auto;
        align-items: start;
    }

        .grid-acordeones details {
            background-color: #2a2d56;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }

        .grid-acordeones summary {
            padding: 14px 20px;
            cursor: pointer;
            font-weight: bold;
            background-color: #202349;
            color: white;
            list-style: none;
            position: relative;
            font-size: 1rem;
            border-radius: 10px 10px 0 0;
        }

            .grid-acordeones summary::before {
                content: "▶";
                display: inline-block;
                margin-right: 10px;
                transition: transform 0.3s ease;
            }

        .grid-acordeones details[open] summary::before {
            transform: rotate(90deg);
        }

        .grid-acordeones summary::-webkit-details-marker {
            display: none;
        }

        .grid-acordeones details > div {
            padding: 14px 18px;
            background-color: #1b1e3c;
            color: #d1d1f0;
            font-size: 1rem;
            border-radius: 0 0 10px 10px;
        }

    .correcto summary {
        color: #28a745;
    }

    .incorrecto summary {
        color: #dc3545;
    }

    .no-respondio summary{
        color: #f1c40f;
    }

    .barra-progreso-interna {
        height: 100%;
        width: 0%;
        position: relative;
    }

    .shimmer::after {
        content: "";
        position: absolute;
        top: 0;
        left: -50%;
        height: 100%;
        width: 50%;
        background: linear-gradient(120deg, transparent, rgba(255,255,255,0.6), transparent);
        animation: shimmer 1.5s infinite;
    }

    @@keyframes shimmer {
        0%

    {
        left: -50%;
    }

    100% {
        left: 100%;
    }

    }

    .parpadeo {
        animation: parpadeo 1s infinite;
    }

    @@keyframes parpadeo {
        0%, 100%

    {
        opacity: 1;
    }

    50% {
        opacity: 0.3;
    }

    }

    .estrellas-container {
        position: relative;
        height: 0;
        margin-top: 10px;
        overflow: visible;
    }

    .estrella {
        position: absolute;
        font-size: 18px;
        color: #fcd703;
        animation: volar 1s ease-out forwards;
    }

    @@keyframes volar {
        0%

    {
        transform: translateY(0) scale(1);
        opacity: 1;
    }

    100% {
        transform: translateY(-60px) scale(1.5);
        opacity: 0;
    }

    }



    @@media (max-width: 1200px) {
        .grid-acordeones

    {
        grid-template-columns: repeat(3, 1fr);
    }

    }

    @@media (max-width: 900px) {
        .grid-acordeones

    {
        grid-template-columns: repeat(2, 1fr);
    }

    }

    @@media (max-width: 600px) {
        .grid-acordeones
    {
        grid-template-columns: 1fr;
    }

    h1 {
        font-size: 1.7rem;
    }

    .resultados{
        display: flex;
        flex-direction: column-reverse;
    }

    .botones-centrados {
        flex-direction: row;
        align-items: center;
        flex-wrap: inherit;
        gap: 10px;
        margin: 30px 5px;
    }

        .botones-centrados button {
            width: 100%;
            max-width: 300px;
        }

        .resumen-grid-contenedor p {
            font-size:1rem;
        }

        .card-resumen{
            flex: 1 1 45%;
            max-width: 100%;
        }

        .card-valor{
            font-size:1.2rem;
        }

        .card-icono{
            font-size: 1rem;
        }

        .contenedores-resumen{
            gap: 5px;
            flex-direction: row;
            display: flex;
            flex-wrap: wrap;
        }

        .container-barrap{
            width: 100%;
            margin-bottom: 30px;
        }

        .cont-onl, .container-barrap{
            flex:1 1 100%;
            max-width:100%;
        }

    }
</style>


<h1>📊 Resumen de Ejercicios</h1>
<hr />

<div class="botones-centrados">
    <form method="get" asp-action="LecturaFinger">
        <input type="hidden" name="tipo" value="@TempData.Peek("TipoPregunta")" />
        <input type="hidden" name="velocidad" value="@TempData.Peek("VelocidadPreguntas")" />
        <input type="hidden" name="cantidad" value="@TempData.Peek("CantidadEjercicios")" />
        <button type="submit" class="btn-primary">⚙️ Configuración</button>
    </form>

    <form method="post" asp-action="Concentracion">
        <input type="hidden" name="TipoPregunta" value="@TempData.Peek("TipoPregunta")" />
        <input type="hidden" name="VelocidadPreguntas" value="@TempData.Peek("VelocidadPreguntas")" />
        <input type="hidden" name="CantidadEjercicios" value="@TempData.Peek("CantidadEjercicios")" />
        <input type="hidden" name="TiempoMeditacion" value="@TempData.Peek("TiempoMeditacion")" />
        <button type="submit" class="btn-success">🔁 Repetir</button>
    </form>

    <form method="get" asp-controller="Dashboard" asp-action="Dashboard">
        <button type="submit" class="btn-secondary">🏠 Dashboard</button>
    </form>
</div>

<div class="resultados resultados-con-glow">
    <div class="cont-onl">
        <div class="contenedores-resumen">
            <div class="card-resumen total">
                <div class="card-titulo">TOTAL</div>
                <div class="card-icono">📄</div>
                <div class="card-valor" id="contadorTotal">@total</div>
            </div>
            <div class="card-resumen correctos">
                <div class="card-titulo">CORRECTOS</div>
                <div class="card-icono">✅</div>
                <div class="card-valor" id="contadorCorrectos">@correctos</div>
            </div>
            <div class="card-resumen incorrectos">
                <div class="card-titulo">INCORRECTOS</div>
                <div class="card-icono">❌</div>
                <div class="card-valor" id="contadorIncorrectos">@(total - correctos)</div>
            </div>
            <div class="card-resumen experiencia">
                <div class="card-titulo">XP</div>
                <div class="card-icono">✨</div>
                <div class="card-valor" id="contadorXP">@porcentaje/100 XP</div>
            </div>
        </div>
    </div>

    <div class="container-barrap">
        <p>🎯 Porcentaje de éxito: <strong>@porcentaje%</strong></p>

        <div class="barra-progreso" style="width: 100%; max-width: 300px;">
            <div class="barra-progreso-interna shimmer" id="barraProgreso" style="background-color: @barraColor;"></div>
        </div>
        <div id="estrellas" class="estrellas-container"></div>

    </div>
</div>




<div class="grid-acordeones">
    @for (int i = 0; i < resultados.Count; i++)
    {
        var r = resultados[i];

        var colorClass = r.RespuestaUsuario == -1
        ? "no-respondio"
        : (r.EsCorrecto ? "correcto" : "incorrecto");

        <details class="@colorClass">
            <summary>
                Ejercicio @(i + 1): @(r.RespuestaUsuario == -1 ? "No respondió" : (r.EsCorrecto ? "✅ Correcto" : "❌ Incorrecto"))
            </summary>

            <div>
                <p>🧠 <strong>Tu respuesta:</strong> @(r.RespuestaUsuario == -1 ? "No respondió" : r.RespuestaUsuario.ToString())</p>
                <p>✔️ <strong>Respuesta correcta:</strong> @r.RespuestaCorrecta</p>
            </div>
        </details>
    }
</div>

@section scripts{

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const porcentaje = @porcentaje;
            const barra = document.getElementById("barraProgreso");
            const estrellasContainer = document.getElementById("estrellas");

            let progreso = 0;
            const velocidad = 200;
            const incremento = Math.max(1, porcentaje / (1000 / velocidad));

            const animarBarra = setInterval(() => {
                if (progreso >= porcentaje) {
                    clearInterval(animarBarra);
                    barra.classList.add("parpadeo");
                    lanzarEstrellitas();
                    return;
                }
                progreso += incremento;
                barra.style.width = `${Math.min(progreso, porcentaje)}%`;
            }, velocidad);

            function lanzarEstrellitas() {
                for (let i = 0; i < 15; i++) {
                    const estrella = document.createElement("div");
                    estrella.classList.add("estrella");
                    estrella.innerText = "✨";
                    estrella.style.left = `${Math.random() * 80 + 10}%`;
                    estrellasContainer.appendChild(estrella);

                    setTimeout(() => estrella.remove(), 1000);
                }
            }
        });

        function animateCount(element, endValue, duration = 2000) {
            const start = 0;
            const startTime = performance.now();

            function update(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const value = Math.floor(progress * endValue);
                element.textContent = value;

                if (progress < 1) {
                    requestAnimationFrame(update);
                } else {
                    element.textContent = endValue;
                }
            }

            requestAnimationFrame(update);
        }

        window.addEventListener('DOMContentLoaded', () => {
            animateCount(document.getElementById('contadorTotal'), @total);
            animateCount(document.getElementById('contadorCorrectos'), @correctos);
            animateCount(document.getElementById('contadorIncorrectos'), @(total - correctos));
            animateCount(document.getElementById('contadorXP'), @porcentaje);
        });
    </script>

}

